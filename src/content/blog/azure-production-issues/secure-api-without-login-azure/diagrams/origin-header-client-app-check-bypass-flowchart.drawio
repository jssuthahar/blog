<mxfile host="app.diagrams.net"><diagram name="Origin header check" id="Originheadercheck"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1018" height="614" as="geometry"/></mxCell><mxCell id="start" value="Request reaches the middleware" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="260" height="48" as="geometry"/></mxCell><mxCell id="ornote" value="The condition is an &lt;b&gt;OR&lt;/b&gt;, so this is not one gate.&lt;br&gt;Two independent doors, and either one alone opens it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2933;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="670" y="30" width="310" height="48" as="geometry"/></mxCell><mxCell id="d1" value="Door 1&lt;br&gt;Origin header contains&lt;br&gt;msdevbuild.com?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="340" y="118" width="300" height="104" as="geometry"/></mxCell><mxCell id="d2" value="Door 2&lt;br&gt;X-Client-App header equals&lt;br&gt;msdevbuild-mobile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="340" y="310" width="300" height="104" as="geometry"/></mxCell><mxCell id="c1" value="Anyone can set this:&lt;br&gt;curl -H &quot;Origin: https://msdevbuild.com&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="30" y="138" width="270" height="64" as="geometry"/></mxCell><mxCell id="c2" value="Anyone can set this:&lt;br&gt;curl -H &quot;X-Client-App: msdevbuild-mobile&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1;dashed=1;dashPattern=4 4;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="270" height="64" as="geometry"/></mxCell><mxCell id="allow" value="await next() &#8212; request allowed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="730" y="232" width="250" height="64" as="geometry"/></mxCell><mxCell id="allown" value="&#10007; The outcome you did not want.&lt;br&gt;Either door alone reaches it." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="710" y="304" width="290" height="40" as="geometry"/></mxCell><mxCell id="deny" value="403 Forbidden" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="260" height="48" as="geometry"/></mxCell><mxCell id="denyn" value="Only a caller who set neither header lands here,&lt;br&gt;which is to say: never an attacker." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="556" width="340" height="40" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="no" style="html=1;rounded=0;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d2" target="deny"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="y1" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="allow"><mxGeometry relative="1" x="-0.7" as="geometry"/></mxCell><mxCell id="y2" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="allow"><mxGeometry relative="1" x="-0.7" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>