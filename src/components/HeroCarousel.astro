---
/**
 * A slide carries no summary line on purpose. Every item promoted here is also
 * listed in full further down the same page, and repeating the excerpt in both
 * places registers as duplicate on-page text with search engines. The banner
 * gets the artwork, the label and the title; the card below owns the prose.
 */
export interface Slide {
  /** Category label shown above the title. */
  kind: string;
  title: string;
  href: string;
  external?: boolean;
  image?: string | null;
  meta?: string;
  cta: string;
}

interface Props {
  slides: Slide[];
  label?: string;
}

const { slides, label = 'Featured highlights' } = Astro.props;
---

{slides.length > 0 && (
  <section
    class="carousel relative overflow-hidden rounded-lg border border-default"
    data-carousel
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
  >
    <!-- Tall enough for the 16:9 media plus a three-line title and the CTA;
         slides are absolutely positioned, so the container must reserve it. -->
    <div class="relative" style="min-height: 400px;">
      {slides.map((slide, index) => (
        <article
          class="carousel-slide absolute inset-0 flex flex-col"
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}: ${slide.title}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          {slide.image ? (
            <div class="aspect-[16/9] shrink-0 overflow-hidden bg-subtle">
              <!-- Cover art is content, not decoration: it is usually a title
                   card or diagram, so it carries the item's own name and is
                   indexable in image search. -->
              <img
                src={slide.image}
                alt={slide.title}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                class="size-full object-cover"
              />
            </div>
          ) : (
            <div
              class="aspect-[16/9] shrink-0"
              style="background: linear-gradient(135deg, var(--navy), var(--navy-soft));"
              aria-hidden="true"
            >
            </div>
          )}

          <div class="flex flex-1 flex-col p-5">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span
                class="rounded-full px-2 py-0.5 font-semibold"
                style="background: var(--accent-soft); color: var(--accent);"
              >
                {slide.kind}
              </span>
              {slide.meta && <span class="text-muted">{slide.meta}</span>}
            </div>

            <!-- The title is not a heading, and the link wraps it rather than
                 sitting beside it, both for the same reason: everything on a
                 slide is also a card further down the page. A second heading
                 with identical text would duplicate the page outline, and a
                 bare "Read the post" link would repeat one anchor text across
                 every slide. Wrapping makes the anchor text the item's title. -->
            <a
              href={slide.href}
              rel={slide.external ? 'noopener' : undefined}
              class="group mt-2 flex flex-1 flex-col"
            >
              <p class="line-clamp-3 leading-snug font-semibold tracking-tight group-hover:text-accent">
                {slide.title}
              </p>
              <span class="mt-3 text-sm font-semibold text-accent group-hover:underline">
                {slide.cta} →
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Controls sit below the slide so they never cover content. -->
    <div class="flex items-center gap-3 border-t border-default px-4 py-2.5">
      <button type="button" data-prev class="carousel-btn" aria-label="Previous slide">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button type="button" data-next class="carousel-btn" aria-label="Next slide">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

      <div class="ml-1 flex items-center gap-3" role="tablist" aria-label="Choose slide">
        {slides.map((slide, index) => (
          <button
            type="button"
            data-dot
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Slide ${index + 1}: ${slide.kind}`}
            class="carousel-dot"
          ></button>
        ))}
      </div>

      <button type="button" data-play class="carousel-btn ml-auto" aria-label="Pause automatic rotation">
        <svg class="size-4" data-pause-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="7" y="6" width="3.5" height="12" rx="1" /><rect x="13.5" y="6" width="3.5" height="12" rx="1" />
        </svg>
        <svg class="size-4" data-play-icon style="display:none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13l10-6.5-10-6.5Z" />
        </svg>
      </button>
    </div>
  </section>
)}

<style>
  .carousel-slide {
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .carousel-slide[aria-hidden='false'] {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: 0.375rem;
    color: var(--text-muted);
    transition: background-color 0.15s, color 0.15s;
  }
  .carousel-btn:hover {
    background: var(--bg-subtle);
    color: var(--text);
  }

  /* The visible bar stays 4px, but the tap area is padded out to 24px tall and
     the padding kept transparent with background-clip, so touch targets meet
     the 24px minimum without changing the look. */
  .carousel-dot {
    width: 1.5rem;
    height: 0.25rem;
    box-sizing: content-box;
    padding: 0.625rem 0;
    border-radius: 999px;
    background: var(--border);
    background-clip: content-box;
    transition: background-color 0.2s;
  }
  .carousel-dot[aria-selected='true'] {
    background: var(--accent);
    background-clip: content-box;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transition: none;
    }
  }
</style>

<script>
  function initCarousel() {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;

    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]');
    const pauseIcon = root.querySelector<SVGElement>('[data-pause-icon]');
    const playIcon = root.querySelector<SVGElement>('[data-play-icon]');
    if (slides.length <= 1) return;

    // Auto-rotation is motion the user did not ask for, so it is off entirely
    // when the OS requests reduced motion — not merely slowed down.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer: number | undefined;
    let playing = !reduced.matches;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
      dots.forEach((dot, i) => dot.setAttribute('aria-selected', String(i === index)));
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!playing) return;
      timer = window.setInterval(() => show(index + 1), 6000);
    };

    const setPlaying = (next: boolean) => {
      playing = next;
      // SVG has no `hidden` content attribute in the typed DOM, so toggle
      // display directly rather than fighting the attribute.
      if (pauseIcon) pauseIcon.style.display = next ? '' : 'none';
      if (playIcon) playIcon.style.display = next ? 'none' : '';
      playBtn?.setAttribute(
        'aria-label',
        next ? 'Pause automatic rotation' : 'Resume automatic rotation',
      );
      next ? start() : stop();
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(index - 1);
      start();
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      show(index + 1);
      start();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );
    playBtn?.addEventListener('click', () => setPlaying(!playing));

    // Rotation must not pull content away from someone reading or tabbing it.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', () => playing && start());
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', () => playing && start());

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    reduced.addEventListener('change', (e) => setPlaying(!e.matches));

    show(0);
    setPlaying(playing);
  }

  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>
