rules_version = '2';

// View counters only. No auth, no personal data — the rules themselves are
// the entire security boundary, so they must be strict about what a write
// is allowed to change.
service cloud.firestore {
  match /databases/{database}/documents {

    // The admin console signs in with Firebase Auth and moderates through
    // these rules. Replace ADMIN_UID_HERE with the UID from
    // Authentication → Users, and keep ADMIN.uid in src/config.ts in step.
    // Until it is set, no account matches and every admin path stays closed.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'BVDLfgqNvJSZORv2zRitolBU3Cn2';
    }

    match /views/{slug} {
      // Counts are public.
      allow read: if true;

      // A write may only ever set `count`, and only to exactly one more than
      // its current value (or 1 if the document does not exist yet). That
      // makes the worst case "someone scripts extra page views", not
      // "someone writes arbitrary data or zeroes the counter".
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Per-article reactions (like / love / celebrate / insightful).
    //
    // One document per article holds a count per reaction, incremented with a
    // field transform. The rules pin down exactly what a write may do: touch a
    // single reaction from the fixed set, and only by +1. So the worst case is
    // "someone scripts extra reactions", never arbitrary data or a wiped count.
    match /reactions/{slug} {
      function keys() { return ['like', 'love', 'celebrate', 'insightful']; }
      function bumped(k) {
        return (k in request.resource.data)
            && request.resource.data[k] == ((k in resource.data) ? resource.data[k] + 1 : 1);
      }

      allow read: if true;

      // First reaction creates the doc with exactly one key set to 1.
      allow create: if request.resource.data.keys().hasOnly(keys())
                    && request.resource.data.keys().size() == 1
                    && request.resource.data.values().hasOnly([1]);

      // Later reactions increment exactly one allowed key by exactly one.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys())
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && (bumped('like') || bumped('love') || bumped('celebrate') || bumped('insightful'));

      allow delete: if false;
    }

    // Newsletter subscribers.
    //
    // The document ID is the email address, which makes a repeat signup a
    // no-op instead of a duplicate row.
    match /subscribers/{email} {
      // Never publicly readable — a public read here would publish the entire
      // mailing list to anyone who knows the collection name. The signed-in
      // admin may read the list and remove entries.
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    // Server-stamped, so a client cannot backdate a signup.
                    && request.resource.data.createdAt == request.time;
    }

    // Reader testimonials.
    //
    // Moderation lives entirely in these rules: anyone may submit, but only
    // as `pending`, and only `approved` documents are readable. A client
    // cannot approve its own submission, and a query that does not filter to
    // approved is rejected outright rather than returning a filtered set.
    match /testimonials/{id} {
      // Public sees approved only; the admin sees pending and rejected too.
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                         ['message', 'name', 'company', 'role', 'article',
                          'status', 'featured', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.featured == false
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 1500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.company is string
                    && request.resource.data.company.size() <= 100
                    && request.resource.data.role is string
                    && request.resource.data.role.size() <= 100
                    && request.resource.data.article is string
                    && request.resource.data.article.size() <= 300
                    // Server-stamped, so a submission cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // Moderation: the admin may change status and featured, nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'featured'])
                    && request.resource.data.status in ['pending', 'approved', 'rejected'];

      allow delete: if isAdmin();
    }

    // The submitter's email, kept OUT of the testimonial document.
    //
    // Firestore rules cannot hide individual fields: reading an approved
    // testimonial returns every field it holds. Storing the address alongside
    // the quote would therefore publish it to anyone, and it would be baked
    // into the static HTML by the sync. It lives here instead, where nothing
    // can read it, keyed by the testimonial's own id.
    match /testimonialContacts/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.createdAt == request.time;
    }

    // Event registrations.
    //
    // The document ID is `{eventSlug}__{email}`, which makes a repeat sign-up a
    // no-op instead of a duplicate row. The list holds attendee emails, so it
    // is NEVER publicly readable — only the signed-in admin may read or remove
    // entries (and export them). Anyone may create their own registration, but
    // the rules pin down exactly what a registration document may contain.
    match /eventRegistrations/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasAll(['event', 'eventTitle', 'name', 'email', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['event', 'eventTitle', 'name', 'email', 'org', 'createdAt'])
                    && request.resource.data.event is string
                    && request.resource.data.event.size() >= 1
                    && request.resource.data.event.size() <= 120
                    && request.resource.data.eventTitle is string
                    && request.resource.data.eventTitle.size() <= 200
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && (!('org' in request.resource.data)
                        || (request.resource.data.org is string && request.resource.data.org.size() <= 100))
                    // Server-stamped, so a registration cannot be backdated.
                    && request.resource.data.createdAt == request.time;
    }

    // Contact-form messages.
    //
    // A static site cannot process a POST, so messages are written straight
    // here. They hold the sender's email and message, so the collection is
    // NEVER publicly readable — only the signed-in admin may read, update the
    // status, or delete. Anyone may create a message, but only as `new`, and
    // the rules pin down exactly what it may contain.
    match /contactMessages/{id} {
      allow read, delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    // Phone is optional; when supplied it must be a short string.
                    && (!('phone' in request.resource.data) ||
                        (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 3000
                    // Server-stamped, so a message cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // The admin may only move the status through the fixed set, nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'read', 'archived'];
    }

    // Public registration tally — a single count per event, no personal data.
    //
    // Mirrors `views`: the count is public so a page can show "N registered"
    // without ever reading the private list above. A write may only ever bump
    // `count` by one, so the worst case is an inflated tally, never PII or a
    // wiped counter.
    match /eventRegistrationCounts/{slug} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // PWA install tally — a single public counter, no personal data.
    //
    // Mirrors `views`: incremented once per device the first time the app is
    // opened as an installed PWA (the only cross-platform install signal, since
    // iOS never fires `appinstalled`). Public so /admin can show the number; a
    // write may only ever bump `count` by one, so the worst case is an inflated
    // tally, never PII or a wiped counter.
    match /appInstalls/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Web Push subscriptions (PWA notifications).
    //
    // The document ID is a SHA-256 of the push endpoint, so re-subscribing from
    // the same browser updates one row instead of piling up duplicates. A
    // subscription is an encryption target, not a secret, but the endpoint can
    // be used to send to that browser — so the list is NEVER publicly readable.
    // Only the signed-in admin (and the sender script, using the admin token)
    // may read it; the sender also prunes dead subscriptions, hence admin
    // delete. Anyone may register their own, but the shape is pinned down.
    match /pushSubscriptions/{id} {
      allow read, delete: if isAdmin();

      allow create, update: if request.resource.data.keys().hasOnly(
                                 ['endpoint', 'p256dh', 'auth', 'ua', 'createdAt'])
                            && request.resource.data.endpoint is string
                            && request.resource.data.endpoint.matches('^https://.*')
                            && request.resource.data.endpoint.size() <= 1000
                            && request.resource.data.p256dh is string
                            && request.resource.data.p256dh.size() <= 200
                            && request.resource.data.auth is string
                            && request.resource.data.auth.size() <= 100
                            && request.resource.data.ua is string
                            && request.resource.data.ua.size() <= 300
                            // Server-stamped, so a subscription cannot be backdated.
                            && request.resource.data.createdAt == request.time;
    }

    // Push notification outbox.
    //
    // The admin composes a notification in /admin, which lands here as
    // `pending`. A scheduled GitHub Action signs in as the admin, reads the
    // pending rows, fans each out to every push subscription with the VAPID
    // private key (which lives only in GitHub Secrets, never in the browser),
    // and marks the row `sent` with delivery counts. Only the admin can touch
    // this collection at all — a visitor cannot queue or read notifications.
    match /pushOutbox/{id} {
      allow read, delete: if isAdmin();

      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['title', 'body', 'url', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 1
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 300
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 300
                    // Server-stamped, so a queued notification cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // The sender (as admin) records the outcome — status plus counts, nothing
      // that would change what gets sent.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'sentAt', 'delivered', 'pruned', 'failed'])
                    && request.resource.data.status in ['pending', 'sending', 'sent', 'failed'];
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
