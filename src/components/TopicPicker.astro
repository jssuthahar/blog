---
import { TOPICS } from '../lib/subscribe';

/**
 * "What do you want to get?" checkboxes for a newsletter form. All ticked by
 * default; the form reads them with pickedTopics(form) (lib/subscribe-form.ts).
 */
interface Props {
  /** Unique per page, e.g. the form's source. */
  id: string;
  class?: string;
}
const { id, class: cls } = Astro.props;
---
<fieldset class:list={['topic-picker', cls]}>
  <legend class="text-xs font-semibold text-muted">Send me</legend>
  <div class="mt-1.5 flex flex-wrap gap-2">
    {TOPICS.map((t) => (
      <label class="topic-chip" for={`${id}-${t.id}`}>
        <input type="checkbox" id={`${id}-${t.id}`} name="topics" value={t.id} checked />
        <span>{t.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .topic-picker { border: 0; padding: 0; margin: 0; min-width: 0; }
  .topic-chip {
    display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;
    padding: 0.3rem 0.7rem; border-radius: 999px; border: 1px solid var(--border);
    background: var(--bg); font-size: 0.8rem; font-weight: 600; color: var(--text-muted);
  }
  .topic-chip:has(input:checked) { border-color: var(--accent); color: var(--text); background: var(--accent-soft, var(--bg-subtle)); }
  .topic-chip:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .topic-chip input { accent-color: var(--accent); width: 0.9rem; height: 0.9rem; }
</style>
