---
import { attribution, articleLink, type Testimonial } from '../lib/testimonials';

interface Props {
  testimonial: Testimonial;
  /** Featured quotes get a larger, higher-contrast treatment. */
  highlight?: boolean;
}

const { testimonial, highlight = false } = Astro.props;
const who = attribution(testimonial);
const link = articleLink(testimonial);

const initials = testimonial.name
  .split(' ')
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<figure
  class:list={[
    'flex h-full flex-col rounded-xl border p-6',
    highlight ? 'shadow-lg' : 'border-default',
  ]}
  style={highlight
    ? 'border-color: var(--accent); background: color-mix(in oklch, var(--accent) 4%, var(--bg));'
    : undefined}
  data-testimonial
  data-search={`${testimonial.message} ${testimonial.name} ${who} ${testimonial.article}`.toLowerCase()}
>
  {highlight && (
    <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold" style="background: var(--accent); color: #fff;">
      Featured
    </span>
  )}

  <svg
    class:list={['mb-3', highlight ? 'size-8' : 'size-6']}
    viewBox="0 0 24 24"
    fill="currentColor"
    style="color: var(--accent); opacity: 0.32;"
    aria-hidden="true"
  >
    <path d="M9.5 5C6.5 6.8 5 9.6 5 13.4V19h6.2v-6.2H8.4c0-2.4.9-4.1 2.7-5.2L9.5 5Zm9 0c-3 1.8-4.5 4.6-4.5 8.4V19h6.2v-6.2h-2.8c0-2.4.9-4.1 2.7-5.2L18.5 5Z" />
  </svg>

  <blockquote class:list={['flex-1 leading-relaxed text-pretty', highlight ? 'text-lg' : 'text-sm']}>
    {testimonial.message}
  </blockquote>

  <figcaption class="mt-5 flex items-center gap-3 border-t border-default pt-4">
    <span
      class="flex size-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
      style="background: linear-gradient(135deg, oklch(0.55 0.16 252), oklch(0.42 0.15 285));"
      aria-hidden="true"
    >
      {initials}
    </span>

    <span class="min-w-0">
      <span class="block text-sm font-semibold">{testimonial.name}</span>
      {who && <span class="block text-xs text-muted">{who}</span>}
    </span>
  </figcaption>

  {testimonial.article && (
    <p class="mt-3 truncate text-xs text-muted">
      On:{' '}
      {link ? (
        <a href={link} rel="noopener nofollow" class="text-accent hover:underline">
          {testimonial.article}
        </a>
      ) : (
        testimonial.article
      )}
    </p>
  )}
</figure>
