---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMUNITY, FIREBASE } from '../../config';
import { BADGES } from '../../lib/badges.js';

/**
 * Fallback profile view.
 *
 * A static build can only prerender profiles that existed when it ran, so a
 * profile published since the last sync has no page of its own yet. This route
 * resolves `?h=<handle>` in the browser and renders it live, then hands over to
 * the real /u/<handle>/ page once the nightly sync has run.
 *
 * noindex on purpose: the prerendered page is the canonical one, and this
 * renders nothing without JavaScript.
 */
const enabled = COMMUNITY.enabled && FIREBASE.projectId.length > 0;

// Badge metadata for the client, so labels here match the rest of the site.
const badgeJson = JSON.stringify(
  BADGES.map(({ id, label, description, glyph }) => ({ id, label, description, glyph })),
).replace(/</g, '\\u003c');
---

<BaseLayout title="Reader profile" description="A reader profile on MSDEVBUILD." noindex>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    {enabled ? (
      <>
        <p data-state class="text-sm text-muted">Loading profile…</p>
        <div data-profile hidden></div>
      </>
    ) : (
      <p class="text-sm text-muted">Reader profiles are not switched on for this site yet.</p>
    )}
  </div>

  <script is:inline type="application/json" data-badge-json set:html={badgeJson} />
</BaseLayout>

{enabled && (
  <script>
    import { lookupHandle, getProfile, getStats } from '../../lib/community';

    interface BadgeMeta {
      id: string;
      label: string;
      description: string;
      glyph: string;
    }

    function initFallbackProfile() {
      const state = document.querySelector<HTMLElement>('[data-state]');
      const host = document.querySelector<HTMLElement>('[data-profile]');
      if (!state || !host || host.dataset.bound === '') return;
      host.dataset.bound = '';

      const escapeHtml = (s: string) =>
        String(s).replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
        );

      const badges = (): BadgeMeta[] => {
        try {
          return JSON.parse(document.querySelector('[data-badge-json]')?.textContent ?? '[]');
        } catch {
          return [];
        }
      };

      /** Only ever link out to the two hosts the rules allow. */
      const safeLink = (href: string, host: string) =>
        href.startsWith(`https://${host}/`) || href.startsWith(`https://www.${host}/`) ? href : '';

      (async () => {
        const handle = (new URLSearchParams(location.search).get('h') ?? '').trim().toLowerCase();
        if (!handle) {
          state.textContent = 'No profile requested.';
          return;
        }

        try {
          const owner = await lookupHandle(handle);
          // A private profile reads as "not found" to a visitor, which is the
          // behaviour we want: the rules refuse it and we say no more than that.
          const profile = owner?.uid ? await getProfile(owner.uid) : null;

          if (!profile) {
            state.innerHTML =
              'That profile is not available. <a href="/" class="text-accent hover:underline">Back to the blog</a>.';
            return;
          }

          const stats = owner?.uid ? await getStats(owner.uid).catch(() => null) : null;
          const earned = badges().filter((b) => (stats?.badges ?? []).includes(b.id));

          const skills = String(profile.skills ?? '')
            .split(',')
            .map((s) => s.trim())
            .filter(Boolean)
            .slice(0, 12);

          const links = [
            { label: 'LinkedIn', href: safeLink(profile.linkedin ?? '', 'linkedin.com') },
            { label: 'GitHub', href: safeLink(profile.github ?? '', 'github.com') },
          ].filter((l) => l.href);

          const initial = escapeHtml((profile.name ?? '?').slice(0, 1).toUpperCase());

          host.innerHTML = `
            <p class="eyebrow">Reader profile</p>
            <header class="mt-3 flex flex-wrap items-start gap-5">
              ${
                profile.photo
                  ? `<img src="${escapeHtml(profile.photo)}" alt="" width="72" height="72" loading="lazy" referrerpolicy="no-referrer" class="size-18 shrink-0 rounded-full object-cover ring-1 ring-[var(--border)]" />`
                  : `<span aria-hidden="true" class="grid size-18 shrink-0 place-items-center rounded-full bg-[var(--accent-soft)] text-xl font-semibold text-accent ring-1 ring-[var(--border)]">${initial}</span>`
              }
              <div class="min-w-0 flex-1">
                <h1 class="display text-2xl">${escapeHtml(profile.name ?? '')}</h1>
                <p class="mt-0.5 text-sm text-muted">@${escapeHtml(handle)}</p>
                ${
                  links.length
                    ? `<p class="mt-2 flex flex-wrap gap-3 text-sm">${links
                        .map(
                          (l) =>
                            `<a href="${escapeHtml(l.href)}" rel="nofollow noopener" target="_blank" class="text-accent hover:underline">${l.label}</a>`,
                        )
                        .join('')}</p>`
                    : ''
                }
              </div>
            </header>
            ${profile.bio ? `<p class="mt-6 leading-relaxed">${escapeHtml(profile.bio)}</p>` : ''}
            ${
              skills.length
                ? `<ul class="mt-5 flex flex-wrap gap-2" aria-label="Skills">${skills
                    .map(
                      (s) =>
                        `<li class="rounded-full border border-default px-3 py-1 text-xs text-muted">${escapeHtml(s)}</li>`,
                    )
                    .join('')}</ul>`
                : ''
            }
            <section class="mt-8 grid gap-3 sm:grid-cols-3" aria-label="Activity">
              ${[
                [stats?.appreciations ?? 0, 'Appreciations'],
                [stats?.articlesRead ?? 0, 'Articles read'],
                [earned.length, 'Badges'],
              ]
                .map(
                  ([value, label]) =>
                    `<div class="rounded-lg border border-default p-4"><p class="text-2xl font-semibold tabular-nums">${value}</p><p class="mt-0.5 text-xs text-muted">${label}</p></div>`,
                )
                .join('')}
            </section>
            ${
              earned.length
                ? `<section class="mt-10"><h2 class="text-lg font-semibold tracking-tight">Badges</h2>
                   <ul class="mt-4 grid gap-3 sm:grid-cols-2">${earned
                     .map(
                       (b) =>
                         `<li class="flex items-start gap-3 rounded-lg border border-[var(--accent)] p-3">
                            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[var(--accent-soft)] text-xs font-semibold text-accent">${escapeHtml(b.glyph)}</span>
                            <span class="min-w-0"><span class="block text-sm font-medium">${escapeHtml(b.label)}</span>
                            <span class="block text-xs text-muted">${escapeHtml(b.description)}</span></span>
                          </li>`,
                     )
                     .join('')}</ul></section>`
                : ''
            }`;

          state.hidden = true;
          host.hidden = false;
        } catch {
          state.textContent = 'That profile could not be loaded right now.';
        }
      })();
    }

    initFallbackProfile();
    document.addEventListener('astro:page-load', initFallbackProfile);
  </script>
)}
