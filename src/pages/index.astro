---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppLaunchRedirect from '../components/AppLaunchRedirect.astro';
import Newsletter from '../components/Newsletter.astro';
import SubscribePopup from '../components/SubscribePopup.astro';
import ShareRow from '../components/ShareRow.astro';
import SiteChat from '../components/SiteChat.astro';
import { SITE, ADSENSE_SLOT_DISPLAY } from '../config';
import { CATEGORIES, getPublishedPosts, postUrl, formatDate, readingTime } from '../lib/posts';
import { allArticles, articleCategories, primaryCategory, capturePayload } from '../lib/articles';
import { getShorts, shortUrl } from '../lib/shorts';
import AdUnit from '../components/AdUnit.astro';
import TopicLinks from '../components/TopicLinks.astro';
import RecentlyRead from '../components/RecentlyRead.astro';
import SeriesQuickNav from '../components/SeriesQuickNav.astro';
import CoverArt from '../components/CoverArt.astro';
import ShortPoster from '../components/ShortPoster.astro';
import ViewCount from '../components/ViewCount.astro';

const posts = await getPublishedPosts();

// The blog leads the page: the newest post gets the large card, the next five
// sit beside it as rows.
const [latestPost, ...olderPosts] = posts;
const nextPosts = olderPosts.slice(0, 5);
const latestCategory = latestPost ? CATEGORIES[latestPost.data.category] : undefined;

// The main-site library: the older articles, surfaced here rather than left
// one click away.
const articles = allArticles();
const spotlight = articles.filter((a) => a.image).slice(0, 3);

// A dense second tier: 12 more titles in roughly the height three more cards
// would have cost.
const spotlightUrls = new Set(spotlight.map((a) => a.url));
const moreArticles = articles.filter((a) => !spotlightUrls.has(a.url)).slice(0, 12);
const topics = articleCategories(8).slice(0, 9);

// One row of four — the newest, and the whole row plays. Eight filled two rows
// of static cards, which read as a contact sheet of everything rather than an
// invitation to watch one; the count on the button is what says there are more.
const allShorts = getShorts();
const shorts = allShorts.slice(0, 4);
const shortCount = allShorts.length;


// No email is published; booking goes to the scheduler or the contact page.

const schema = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    name: SITE.title,
    description: SITE.description,
    url: SITE.url,
    author: { '@id': `${SITE.url}/#person` },
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.publishedAt.toISOString(),
      url: new URL(postUrl(p), SITE.url).href,
    })),
  },
  // No Review schema: self-serving testimonials reviewing the site's own author
  // aren't eligible for review rich results and fail validation (Person is not a
  // valid itemReviewed type). The quotes remain visible on the page.
];
---

<BaseLayout title={SITE.title} description={SITE.description} schema={schema} wide>
  <!-- An installed launch belongs on the app feed, not the marketing page. -->
  <AppLaunchRedirect />

  <!-- ══════════════ Hero ══════════════
       The home page sells the articles, not the author: the headline names the
       topics people search for, and every action leads into reading. The
       author lives on /about, /contributions and /speaking. -->
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-8 sm:px-6 lg:pt-10">
    <p class="eyebrow">{SITE.title} · Articles and short videos</p>
    <h1 class="display mt-2 max-w-3xl text-3xl sm:text-4xl text-balance">
      Azure, AI and GitHub Copilot, explained from production
    </h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted text-pretty">
      Hands-on articles on Azure, Microsoft Foundry, GitHub Copilot, Flutter and .NET, with real
      code, measured numbers and the trade-offs behind each decision.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="#latest" class="btn btn-primary">Read the latest</a>
      <a href="/series/" class="btn btn-outline">Start a series</a>
      <a href="/shorts/" class="btn btn-outline">Short videos</a>
    </div>
    <TopicLinks class="mt-6" />
  </section>

  <!-- ══════════════ Recently read ══════════════
       Hidden for first-time visitors; populated from local history so returning
       readers can pick up where they left off before anything else. -->
  <RecentlyRead limit={4} />

  <!-- ══════════════ Latest from the blog ══════════════
       The blog is what this site is for, so it sits above the stats, the
       badges and the syndicated article library: newest post large, the next
       five as rows beside it, then series entry points and the feed. -->
  {latestPost && (
    <section
      id="latest"
      class="border-y border-default bg-subtle scroll-mt-16"
      aria-labelledby="latest-heading"
    >
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="section-head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2 id="latest-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
              New on the blog
            </h2>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <a href="/blog/" class="btn btn-primary btn-sm">All posts</a>
            <!-- The feed is also the newsletter pipeline, so it gets a real
                 control here rather than only a footer link. -->
            <a
              href="/rss.xml"
              class="btn btn-outline btn-sm"
              title="Subscribe to the RSS feed — newest post first"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="6.18" cy="17.82" r="2.18" />
                <path d="M4 10.1v2.9a7 7 0 0 1 7 7h2.9A9.9 9.9 0 0 0 4 10.1Zm0-5.1v2.9A14.1 14.1 0 0 1 18.1 22H21A17 17 0 0 0 4 5Z" />
              </svg>
              RSS feed
            </a>
          </div>
        </div>

        <div class="mt-6 grid gap-8 lg:grid-cols-[1.05fr_1fr]">
          <!-- Newest post, full card. -->
          <article class="group relative flex flex-col overflow-hidden rounded-xl border border-default bg-[var(--bg)]">
            <div class="aspect-[1200/630] overflow-hidden bg-subtle">
              <CoverArt
                post={latestPost}
                large
                eager
                class="transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span
                  class="rounded-full px-2 py-0.5 font-medium"
                  style={`background: oklch(0.62 0.17 ${latestCategory!.hue} / 0.14); color: var(--accent-deep);`}
                >
                  {latestCategory!.label}
                </span>
                <span class="font-semibold text-accent">Latest post</span>
                <time datetime={latestPost.data.publishedAt.toISOString()} class="text-muted">
                  {formatDate(latestPost.data.publishedAt)}
                </time>
                <span class="text-muted">{readingTime(latestPost.body ?? '')} min read</span>
                <ViewCount slug={latestPost.id} class="text-muted" />
              </div>

              <h3 class="mt-2.5 text-xl leading-snug font-semibold tracking-tight text-balance sm:text-2xl">
                <a href={postUrl(latestPost)} class="after:absolute after:inset-0 group-hover:text-accent">
                  {latestPost.data.title}
                </a>
              </h3>

              <p class="mt-2 leading-relaxed text-muted text-pretty">
                {latestPost.data.description}
              </p>

              <span class="mt-4 text-sm font-semibold text-accent">Read the post →</span>
            </div>
          </article>

          <!-- The five behind it, dense rows so more titles fit the same height. -->
          <div>
            <h3 class="border-b border-default pb-2 text-xs font-semibold tracking-wider uppercase text-muted">
              More recent posts
            </h3>

            <ul class="divide-y divide-[var(--border)]">
              {nextPosts.map((post) => {
                const category = CATEGORIES[post.data.category];
                return (
                  <li class="group relative py-3.5">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                      <span class="font-medium" style={`color: var(--accent-deep);`}>
                        {category.label}
                      </span>
                      <time datetime={post.data.publishedAt.toISOString()} class="text-muted">
                        {formatDate(post.data.publishedAt)}
                      </time>
                      <span class="text-muted">{readingTime(post.body ?? '')} min</span>
                      {post.data.series && (
                        <span class="text-muted">Part {post.data.seriesOrder}</span>
                      )}
                      <ViewCount slug={post.id} class="text-muted" />
                    </div>
                    <h4 class="mt-1 leading-snug font-medium">
                      <a href={postUrl(post)} class="after:absolute after:inset-0 group-hover:text-accent">
                        {post.data.title}
                      </a>
                    </h4>
                    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">
                      {post.data.description}
                    </p>
                  </li>
                );
              })}
            </ul>

            <a href="/blog/" class="mt-4 inline-block text-sm font-semibold text-accent hover:underline">
              Every post on the blog →
            </a>
          </div>
        </div>

        <!-- Series entry points: the fastest way into a multi-part guide. -->
        <div class="mt-8 border-t border-default pt-5">
          <SeriesQuickNav label="Jump into a series" />
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════ Short videos ══════════════
       Directly after the blog, because it is the same material at a different
       speed: a visitor who is not ready to start a 12-minute read will still
       give 30 seconds to one idea, and that is a real entry point rather than
       a bounce. Portrait cards, because the shorts are drawn portrait. -->
  {shorts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 section sm:px-6" aria-labelledby="shorts-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">30-second learning</p>
          <h2 id="shorts-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
            A new way to learn — 30 seconds a day
          </h2>
        </div>
        <a href="/shorts/" class="btn btn-outline btn-sm">All {shortCount} short videos</a>
      </div>

      <!-- The promise, stated as a number rather than a mood: three or four of
           these, back to back, is the same half hour a real architecture
           question takes to actually think through — just spent watching the
           shape of the fix instead of staring at a blank diagram. The number
           gets its own stat treatment — the accent-left-border callout the
           short pages already use for "The takeaway" — so it reads at a
           glance before anyone reads the sentence. -->
      <div
        class="mt-5 flex flex-col gap-4 rounded-xl border-l-4 bg-subtle p-5 sm:flex-row sm:items-center sm:gap-6"
        style="border-left-color: var(--accent);"
      >
        <div class="flex shrink-0 items-baseline gap-2 sm:flex-col sm:items-center sm:gap-0.5 sm:border-r sm:border-default sm:pr-6">
          <span class="text-4xl leading-none font-extrabold tracking-tight text-accent">30</span>
          <span class="text-xs font-semibold tracking-wider uppercase text-muted">minutes</span>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-semibold tracking-wider uppercase text-accent">Not 3 hours</p>
          <p class="mt-1.5 leading-relaxed text-pretty">
            Most architecture problems don't need a redesign, they need the
            right idea at the right time. Three or four of these back to back
            is about 30 minutes — usually enough to get unstuck, instead of a
            week guessing at it on your own.
          </p>
        </div>
      </div>

      <!-- One short, full treatment; the rest as a list you can scan in a
           glance. The same asymmetric shape "New on the blog" uses above,
           on purpose — a visitor already knows how to read this page. -->
      <div class="mt-7 grid items-start gap-8 lg:grid-cols-[1.05fr_1fr]">
        {shorts[0] && (
          <!-- Same card language "New on the blog" uses above: badge row,
               title, description, CTA. The poster is 9:16, so media sits in
               its own left column at its own width instead of spanning the
               card top — that is what stopped the top strip being mostly
               empty background either side of a narrow centred image. -->
          <article class="group relative flex overflow-hidden rounded-xl border border-default bg-[var(--bg)]">
            <div class="w-32 shrink-0 overflow-hidden bg-subtle sm:w-40">
              <ShortPoster short={shorts[0]} preview class="transition-transform duration-500 group-hover:scale-[1.03]" />
            </div>

            <div class="flex flex-1 flex-col p-5 min-w-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span
                  class="rounded-full px-2 py-0.5 font-medium"
                  style={`background: oklch(0.62 0.17 ${CATEGORIES[shorts[0].category].hue} / 0.14); color: var(--accent-deep);`}
                >
                  {shorts[0].folderLabel}
                </span>
                <span class="font-semibold text-accent">Today's short</span>
                <span class="text-muted">{shorts[0].stages.length} steps · {shorts[0].seconds}s</span>
              </div>

              <h3 class="mt-2.5 text-xl leading-snug font-semibold tracking-tight text-balance sm:text-2xl">
                <a href={shortUrl(shorts[0])} class="after:absolute after:inset-0 group-hover:text-accent">
                  {shorts[0].title}
                </a>
              </h3>

              <!-- `sub` is the short's own punchy tagline (also on the
                   poster itself); `topic` is the full plain-language
                   description — the pair the blog card's title + description
                   already mirrors, so the short gets the same treatment. -->
              <p class="mt-2 leading-relaxed text-muted text-pretty">
                {shorts[0].topic}
              </p>

              <span class="mt-4 text-sm font-semibold text-accent">Watch it →</span>
            </div>
          </article>
        )}

        <div>
          <h3 class="border-b border-default pb-2 text-xs font-semibold tracking-wider uppercase text-muted">
            More shorts
          </h3>

          <ul class="divide-y divide-[var(--border)]">
            {shorts.slice(1).map((short) => {
              const category = CATEGORIES[short.category];
              return (
                <li class="group relative py-3.5">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                    <span class="font-medium" style={`color: var(--accent-deep);`}>
                      {short.folderLabel}
                    </span>
                    <span class="text-muted">{short.stages.length} steps · {short.seconds}s</span>
                  </div>
                  <h4 class="mt-1 leading-snug font-medium">
                    <a href={shortUrl(short)} class="after:absolute after:inset-0 group-hover:text-accent">
                      {short.title}
                    </a>
                  </h4>
                  <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">
                    {short.topic}
                  </p>
                </li>
              );
            })}
          </ul>

          <a href="/shorts/" class="mt-4 inline-block text-sm font-semibold text-accent hover:underline">
            Every short, {shortCount} and counting →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════ Articles ══════════════ -->
  <section class="mx-auto max-w-6xl px-4 section sm:px-6" aria-labelledby="articles-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Articles</p>
        <h2 id="articles-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
          Articles written from production
        </h2>
      </div>
      <a href="/articles/" class="btn btn-outline btn-sm">Browse all articles</a>
    </div>

    <!-- Topic chips double as an at-a-glance map of what the library covers.
         nofollow because these are faceted filter URLs: each one is a subset of
         /articles/, so crawling them spends budget on near-duplicate listings
         of pages already reachable from the unfiltered index. -->
    <ul class="mt-5 flex flex-wrap gap-2">
      {topics.map(({ label, count, slug }) => (
        <li>
          <a
            href={`/articles/?category=${slug}`}
            rel="nofollow"
            class="inline-flex items-center gap-1.5 rounded-full border border-default px-3 py-1 text-xs transition-colors hover:bg-subtle"
          >
            {label}
            <span class="text-muted">{count}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Featured three with artwork, then a dense list. More on screen, less scrolling. -->
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {spotlight.map((article) => (
        <article class="group relative flex gap-4 md:block">
          <div class="aspect-[4/3] w-28 shrink-0 overflow-hidden rounded-md border border-default md:aspect-[16/9] md:w-full">
            <img
              src={article.image!}
              alt={article.title}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            />
          </div>
          <div class="min-w-0 md:mt-3">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
              {article.categories.slice(0, 2).map((label) => (
                <span class="rounded-full border border-default px-2 py-0.5">{label}</span>
              ))}
            </div>
            <h3 class="mt-1 leading-snug font-semibold tracking-tight">
              <a
                href={article.url}
                rel="noopener"
                data-capture={capturePayload({ title: article.title, url: article.url, category: primaryCategory(article), image: article.image })}
                class="after:absolute after:inset-0 group-hover:text-accent"
              >
                {article.title}
              </a>
            </h3>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">{article.excerpt}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Second tier: 12 more titles in two dense columns. -->
    <div class="mt-8 border-t border-default pt-5">
      <ul class="grid grid-cols-1 gap-x-10 sm:grid-cols-2">
        {moreArticles.map((article) => (
          <li class="group relative flex items-baseline gap-3 border-b border-default py-2.5">
            <a
              href={article.url}
              rel="noopener"
              data-capture={capturePayload({ title: article.title, url: article.url, category: primaryCategory(article), image: article.image })}
              class="min-w-0 flex-1 truncate text-sm after:absolute after:inset-0 group-hover:text-accent"
            >
              {article.title}
            </a>
            <span class="shrink-0 text-xs text-muted">
              {article.categories[0] ?? ''}
            </span>
          </li>
        ))}
      </ul>
      <a href="/articles/" class="mt-4 inline-block text-sm font-semibold text-accent hover:underline">
        See all articles →
      </a>
    </div>

  </section>

  <!-- One display ad, after the article library. -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
  </div>

  <!-- ══════════════ Subscribe ══════════════ -->
  <section class="border-t border-default bg-subtle" aria-labelledby="subscribe-heading">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Subscribe</p>
        <h2 id="subscribe-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
          Get the next article first
        </h2>
        <p class="mt-3 max-w-lg leading-relaxed text-muted text-pretty">
          New articles and short videos on Azure, AI, GitHub Copilot and mobile, by email or RSS.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/rss.xml" class="btn btn-outline">RSS feed</a>
          <a href="/topics/" class="btn btn-outline">Browse topics</a>
        </div>

        <!-- Sharing the site itself. Only one ShareRow may render per page —
             its script wires up the first [data-share-row] it finds — so this
             stays on the home page and posts keep their own row. -->
        <div class="mt-8 border-t border-default pt-6">
          <ShareRow title={`${SITE.title} — ${SITE.tagline}`} path="/" />
        </div>
      </div>

      <div id="subscribe" class="scroll-mt-20 self-center">
        <Newsletter compact />
      </div>
    </div>
  </section>

  <!-- Home page only, once per visitor. -->
  <SubscribePopup />

  <!-- Site-wide find-an-article assistant (home only; posts have their own chat). -->
  <SiteChat />
</BaseLayout>
