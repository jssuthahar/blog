<mxfile host="app.diagrams.net"><diagram name="Before" id="Before"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="0" width="608" height="788" as="geometry"/></mxCell><mxCell id="before0" value="&lt;b&gt;One sentence from you&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&quot;Let customers give a reason when they cancel an order&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="560" height="62" as="geometry"/></mxCell><mxCell id="before1" value="&lt;b&gt;1. Architecture agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Warns: leave OrderStatus alone. Three features read it.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="118" width="560" height="62" as="geometry"/></mxCell><mxCell id="before2" value="&lt;b&gt;2. Developer agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Never sees the warning. Adds a new value to OrderStatus.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="212" width="560" height="62" as="geometry"/></mxCell><mxCell id="before3" value="&lt;b&gt;3. Tester agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;A test fails, so it widens canCancel in production code.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="306" width="560" height="62" as="geometry"/></mxCell><mxCell id="before4" value="&lt;b&gt;4. Security agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Asked to review. Rewrites firestore.rules instead.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="560" height="62" as="geometry"/></mxCell><mxCell id="before5" value="&lt;b&gt;5. Orchestrator agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Reports every phase complete and opens the pull request.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="494" width="560" height="62" as="geometry"/></mxCell><mxCell id="before6" value="&lt;b&gt;CI is green, because the tests never load firestore.rules&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The next day, on staging: cancel fails with permission denied&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="588" width="560" height="62" as="geometry"/></mxCell><mxCell id="before7" value="✗ Everything ran. Nobody owned the decision." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="682" width="560" height="48" as="geometry"/></mxCell><mxCell id="beforee0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before0" target="before1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before1" target="before2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before2" target="before3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before3" target="before4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before4" target="before5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee5" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before5" target="before6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforee6" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="before6" target="before7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="beforen" value="All five agents: no tools list, run as subagents, no person reads a step." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#A02C2C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="560" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>