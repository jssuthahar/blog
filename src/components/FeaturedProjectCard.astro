---
import type { FeaturedProject } from '../lib/featured-projects';

interface Props {
  project: FeaturedProject;
  /** Stagger index — drives the reveal delay so cards cascade in. */
  index?: number;
}

const { project, index = 0 } = Astro.props;
const delay = Math.min(index, 5) * 70;
---

<article
  class="reveal group relative flex flex-col overflow-hidden rounded-xl border border-default bg-[var(--bg)] transition-all duration-200 hover:-translate-y-1 hover:border-[var(--accent)] hover:shadow-xl"
  style={`--reveal-delay: ${delay}ms; --g-from: ${project.gradient[0]}; --g-to: ${project.gradient[1]};`}
>
  <!-- Gradient banner: a distinct look per project, with a soft dot pattern
       and a large emoji/monogram that drifts on hover. -->
  <div
    class="relative flex h-24 items-center overflow-hidden px-6"
    style="background: linear-gradient(120deg, var(--g-from), var(--g-to));"
  >
    <div
      class="absolute inset-0 opacity-30 transition-transform duration-500 group-hover:scale-110"
      style="background-image: radial-gradient(rgba(255,255,255,0.55) 1px, transparent 1.4px); background-size: 14px 14px;"
      aria-hidden="true"
    >
    </div>
    <span
      class="relative text-4xl font-black tracking-tight text-white/95 drop-shadow-sm transition-transform duration-300 group-hover:-translate-y-0.5"
      aria-hidden="true"
    >
      {project.emoji ?? project.monogram}
    </span>

    {project.live && (
      <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-black/25 px-2.5 py-0.5 text-xs font-semibold text-white backdrop-blur-sm">
        <span class="relative flex size-1.5">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-white opacity-75"></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-white"></span>
        </span>
        Live
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg leading-snug font-semibold tracking-tight">
      {project.name}
      {project.emoji && <span aria-hidden="true">{project.emoji}</span>}
    </h3>
    <p class="mt-1 text-sm font-medium text-accent">{project.tagline}</p>

  <p class="mt-3 text-sm leading-relaxed text-muted text-pretty">{project.summary}</p>

  <ul class="mt-4 grid gap-1.5 sm:grid-cols-2">
    {project.features.map((f) => (
      <li class="flex items-start gap-1.5 text-xs text-muted">
        <svg class="mt-0.5 size-3.5 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
        </svg>
        {f}
      </li>
    ))}
  </ul>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <span class="rounded border border-default px-1.5 py-0.5 text-[11px] font-medium text-muted">{t}</span>
    ))}
  </div>

  <!-- Actions pinned to the bottom so cards of different heights align. -->
  <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-default pt-4">
    {project.live && (
      <a href={project.live} rel="noopener" target="_blank" class="btn btn-accent btn-sm">
        Live demo
        <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.29a1 1 0 1 0 1.42 1.42L15 6.4V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z" />
          <path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z" />
        </svg>
      </a>
    )}
    {project.android && (
      <a
        href={project.android}
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-1.5 rounded-full border border-default px-4 py-2 text-sm font-semibold transition-colors hover:bg-subtle"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 9h12v9a1.5 1.5 0 0 1-1.5 1.5H15V22a1.25 1.25 0 1 1-2.5 0v-2.5h-1V22A1.25 1.25 0 1 1 9 22v-2.5H7.5A1.5 1.5 0 0 1 6 18V9Zm-2.25 0A1.25 1.25 0 0 1 5 10.25v5a1.25 1.25 0 1 1-2.5 0v-5A1.25 1.25 0 0 1 3.75 9Zm16.5 0a1.25 1.25 0 0 1 1.25 1.25v5a1.25 1.25 0 1 1-2.5 0v-5A1.25 1.25 0 0 1 20.25 9ZM15.9 3.2l1.06-1.6a.4.4 0 0 0-.67-.44L15.2 2.83A7.2 7.2 0 0 0 12 2.1c-1.16 0-2.25.26-3.2.73L7.71 1.16a.4.4 0 0 0-.67.44L8.1 3.2A6.1 6.1 0 0 0 5.25 8h13.5a6.1 6.1 0 0 0-2.85-4.8ZM9.5 5.6a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Zm5 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Z" />
        </svg>
        Android
      </a>
    )}
    <a
      href={project.source}
      rel="noopener"
      target="_blank"
      class="inline-flex items-center gap-1.5 rounded-full border border-default px-4 py-2 text-sm font-semibold transition-colors hover:bg-subtle"
    >
      <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      Source
    </a>
  </div>
  </div>
</article>
