<mxfile host="app.diagrams.net"><diagram name="RAG pipeline" id="RAGpipeline"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="116" y="-4" width="468" height="716" as="geometry"/></mxCell><mxCell id="t1" value="INGEST - once, ahead of time" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="400" height="20" as="geometry"/></mxCell><mxCell id="ing1" value="&lt;b&gt;1. Split on semantic boundaries&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;500-800 tokens, 15% overlap. This decides what can ever be retrieved together.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="50" width="420" height="62" as="geometry"/></mxCell><mxCell id="ing2" value="&lt;b&gt;2. Embed each chunk&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;One vector per chunk, from an embedding model, not the chat model&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="142" width="420" height="62" as="geometry"/></mxCell><mxCell id="ing3" value="&lt;b&gt;3. Store in Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Vector field plus the original text and its metadata&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="234" width="420" height="62" as="geometry"/></mxCell><mxCell id="inge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ing1" target="ing2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inge1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ing2" target="ing3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="RETRIEVE AND GENERATE - per question" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="342" width="400" height="20" as="geometry"/></mxCell><mxCell id="ret1" value="&lt;b&gt;1. Hybrid search&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Vector for meaning, keyword for product codes and error numbers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="376" width="420" height="62" as="geometry"/></mxCell><mxCell id="ret2" value="&lt;b&gt;2. Semantic reranking&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Reorders the top results by actual relevance to the question&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="468" width="420" height="62" as="geometry"/></mxCell><mxCell id="ret3" value="&lt;b&gt;3. Answer from this context only&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Grounded, and able to say it does not know&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="560" width="420" height="62" as="geometry"/></mxCell><mxCell id="rete0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ret1" target="ret2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rete1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ret2" target="ret3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bridge" value="the index" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ing3" target="ret1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Most bad RAG is bad here, not in the model." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150" y="666" width="400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>