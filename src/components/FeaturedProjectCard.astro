---
import type { FeaturedProject } from '../lib/featured-projects';

interface Props {
  project: FeaturedProject;
  /** Spans the whole row, for the project that leads the list. */
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
---

<article class:list={['tile reveal-in', wide && 'project--wide sm:col-span-2 lg:col-span-3']}>
  <!-- One azure banner for every project, with the deck's dot pattern. -->
  <div class="project-banner">
    <span class="tile-mark project-mark" aria-hidden="true">{project.monogram}</span>
    {project.live && (
      <span class="project-live">
        <span class="project-dot" aria-hidden="true"></span>
        Live
      </span>
    )}
  </div>

  <div class="tile-body">
    <h3 class="project-name">{project.name}</h3>
    <p class="project-tagline">{project.tagline}</p>
    <p class="tile-text text-pretty">{project.summary}</p>

    <ul class="project-features">
      {project.features.map((f) => (
        <li>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" /></svg>
          {f}
        </li>
      ))}
    </ul>

    <ul class="mt-3 flex flex-wrap gap-1.5">
      {project.tech.map((t) => <li class="tile-tag">{t}</li>)}
    </ul>

    <!-- Pinned to the bottom so tiles of different heights line up. -->
    <div class="project-actions">
      {project.live && (
        <a href={project.live} rel="noopener" target="_blank" class="btn btn-primary btn-sm">Live demo ↗</a>
      )}
      {project.android && (
        <a href={project.android} rel="noopener" target="_blank" class="btn btn-outline btn-sm">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 9h12v9a1.5 1.5 0 0 1-1.5 1.5H15V22a1.25 1.25 0 1 1-2.5 0v-2.5h-1V22A1.25 1.25 0 1 1 9 22v-2.5H7.5A1.5 1.5 0 0 1 6 18V9Zm-2.25 0A1.25 1.25 0 0 1 5 10.25v5a1.25 1.25 0 1 1-2.5 0v-5A1.25 1.25 0 0 1 3.75 9Zm16.5 0a1.25 1.25 0 0 1 1.25 1.25v5a1.25 1.25 0 1 1-2.5 0v-5A1.25 1.25 0 0 1 20.25 9ZM15.9 3.2l1.06-1.6a.4.4 0 0 0-.67-.44L15.2 2.83A7.2 7.2 0 0 0 12 2.1c-1.16 0-2.25.26-3.2.73L7.71 1.16a.4.4 0 0 0-.67.44L8.1 3.2A6.1 6.1 0 0 0 5.25 8h13.5a6.1 6.1 0 0 0-2.85-4.8ZM9.5 5.6a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Zm5 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Z" />
          </svg>
          Android
        </a>
      )}
      <a href={project.source} rel="noopener" target="_blank" class="btn btn-outline btn-sm">
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        Source
      </a>
    </div>
  </div>
</article>

<style>
  .project-banner {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    background:
      radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.4px) 0 0 / 14px 14px,
      radial-gradient(90% 120% at 100% 0%, rgb(255 255 255 / 0.2), transparent 70%),
      linear-gradient(135deg, #0068b8, #003e70);
    padding: 0.85rem 1.25rem;
  }
  .project-mark {
    border: 1px solid rgb(255 255 255 / 0.5);
    background: rgb(255 255 255 / 0.16);
    box-shadow: none;
  }
  .project-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    background: #fff;
    padding: 0.125rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 650;
    color: #005a9e;
  }
  .project-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: #0078d4;
    animation: project-pulse 2.2s ease-out infinite;
  }
  @keyframes project-pulse {
    from {
      box-shadow: 0 0 0 0 rgb(0 120 212 / 0.6);
    }
    to {
      box-shadow: 0 0 0 0.45rem transparent;
    }
  }
  .project-name {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .project-tagline {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--accent-deep);
  }
  .project-features {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }
  .project-features li {
    display: flex;
    gap: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .project-features svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
  }
  .tile-body > :nth-last-child(2) {
    margin-bottom: 0.9rem;
  }

  /* The lead project: banner down the side, features beside the summary. */
  @media (min-width: 1024px) {
    .project--wide {
      flex-direction: row;
    }
    .project--wide .project-banner {
      width: 11rem;
      flex-direction: column;
      align-items: flex-start;
    }
    .project--wide .project-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-dot {
      animation: none;
    }
  }
</style>
