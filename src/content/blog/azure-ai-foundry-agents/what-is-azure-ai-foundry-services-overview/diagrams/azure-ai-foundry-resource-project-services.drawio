<mxfile host="app.diagrams.net"><diagram name="Foundry map" id="Foundrymap"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="96" y="6" width="728" height="582" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;One project endpoint&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Everything below hangs off this single URL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="290" y="30" width="340" height="62" as="geometry"/></mxCell><mxCell id="br0" value="&lt;b&gt;Model catalogue&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;OpenAI and other vendors, deployed per project&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="280" y="146" width="320" height="70" as="geometry"/></mxCell><mxCell id="hb0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="181" as="sourcePoint"/><mxPoint x="280" y="181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="br1" value="&lt;b&gt;Foundry Agent Service&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Managed agent runtime, conversation state server-side&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=1