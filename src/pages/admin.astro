---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ADMIN, FIREBASE } from '../config';

/**
 * Admin console — moderation only.
 *
 * Everything here is convenience, not security: firestore.rules decides whether
 * the signed-in UID may read subscribers or moderate testimonials. An
 * unauthenticated visitor simply gets 403s. Post writing lives at /write and
 * needs no login, since it only produces a Markdown file.
 */
const configured = ADMIN.uid.length > 0 && FIREBASE.apiKey.length > 0;
---

<BaseLayout title="Admin" description="Site administration." noindex wide>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="eyebrow">Admin</p>
        <h1 class="display mt-1.5 text-2xl">Console</h1>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/write" class="btn btn-outline btn-sm">Write a post →</a>
        <a href="/preview" class="btn btn-outline btn-sm">Drafts →</a>
        <a href="/events/new" class="btn btn-outline btn-sm">New event →</a>
        <span id="who" class="text-sm text-muted"></span>
        <button id="sign-out" hidden class="btn btn-outline btn-sm">Sign out</button>
      </div>
    </header>

    <!-- Shown after sign-in: the exact UID to paste into firestore.rules. -->
    <div id="uid-banner" hidden class="mt-4 rounded-lg border border-default bg-subtle p-4 text-sm">
      <p>
        Signed in. Your Firebase UID is
        <code id="uid-value" class="rounded bg-[var(--bg)] px-1.5 py-0.5 font-mono"></code>
        <button id="uid-copy" class="ml-2 text-xs text-accent hover:underline">copy</button>
      </p>
      <p class="mt-1.5 text-xs text-muted">
        This exact value must be in <code>firestore.rules</code> (replace
        <code>ADMIN_UID_HERE</code>) and in <code>ADMIN.uid</code> in
        <code>src/config.ts</code>. After editing the rules, click <strong>Publish</strong>
        in the Firebase console — editing alone does not apply them.
      </p>
    </div>

    {!configured && (
      <div class="mt-8 rounded-lg border border-default bg-subtle p-6 text-sm leading-relaxed">
        <p class="font-semibold">Setup needed</p>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-muted">
          <li>Firebase Console → <strong>Authentication</strong> → enable <strong>Email/Password</strong>.</li>
          <li>Add a user (your admin email and a strong password).</li>
          <li>Copy that user's <strong>UID</strong> into <code>ADMIN.uid</code> in <code>src/config.ts</code>.</li>
          <li>Put the same UID in <code>firestore.rules</code> (replace <code>ADMIN_UID_HERE</code>) and publish the rules.</li>
        </ol>
        <p class="mt-3 text-muted">Writing posts needs none of this — go to <a href="/write" class="text-accent hover:underline">/write</a>.</p>
      </div>
    )}

    <section id="signin-panel" class="mt-8 max-w-sm" hidden>
      <form id="signin-form" class="space-y-3 rounded-lg border border-default p-6" novalidate>
        <h2 class="font-semibold">Sign in</h2>
        <div>
          <label for="admin-email" class="block text-sm font-medium">Email</label>
          <input id="admin-email" type="email" autocomplete="username" required
            class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="admin-password" class="block text-sm font-medium">Password</label>
          <input id="admin-password" type="password" autocomplete="current-password" required
            class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm" />
        </div>
        <button type="submit" class="btn btn-accent btn-sm w-full">Sign in</button>
        <p id="signin-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </section>

    <div id="console" hidden>
      <nav class="mt-8 flex gap-1 border-b border-default" role="tablist">
        {[['messages', 'Messages'], ['testimonials', 'Testimonials'], ['subscribers', 'Subscribers'], ['registrations', 'Registrations']].map(([id, label], i) => (
          <button type="button" role="tab" data-tab={id} aria-selected={i === 0 ? 'true' : 'false'}
            class="admin-tab -mb-px border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-muted">
            {label}
          </button>
        ))}
      </nav>

      <section data-panel="messages" class="pt-6">
        <div class="flex flex-wrap items-center gap-2">
          {['all', 'new', 'read', 'archived'].map((s) => (
            <button type="button" data-msg-filter={s} aria-pressed={s === 'all' ? 'true' : 'false'}
              class="msg-chip rounded-full border border-default px-3 py-1.5 text-sm capitalize">{s}</button>
          ))}
          <span id="m-count" class="ml-2 text-sm text-muted"></span>
          <button id="export-msg-csv" class="btn btn-outline btn-sm ml-auto">Export CSV</button>
        </div>
        <div id="m-list" class="mt-5 space-y-3"></div>
      </section>

      <section data-panel="testimonials" class="pt-6" hidden>
        <div class="flex flex-wrap items-center gap-2">
          {['all', 'pending', 'approved', 'rejected'].map((s) => (
            <button type="button" data-filter={s} aria-pressed={s === 'all' ? 'true' : 'false'}
              class="filter-chip rounded-full border border-default px-3 py-1.5 text-sm capitalize">{s}</button>
          ))}
          <span id="t-count" class="ml-2 text-sm text-muted"></span>
        </div>
        <div id="t-list" class="mt-5 space-y-3"></div>
      </section>

      <section data-panel="subscribers" class="pt-6" hidden>
        <div class="flex flex-wrap items-center gap-3">
          <span id="s-count" class="text-sm text-muted"></span>
          <button id="export-csv" class="btn btn-outline btn-sm">Export CSV</button>
        </div>
        <div id="s-list" class="mt-5 overflow-x-auto"></div>
      </section>

      <section data-panel="registrations" class="pt-6" hidden>
        <!-- How the events workflow fits together, for whoever runs the console. -->
        <div class="mb-5 rounded-lg border border-default bg-subtle p-4 text-sm leading-relaxed">
          <p class="font-semibold">Managing events</p>
          <ol class="mt-2 list-decimal space-y-1 pl-5 text-muted">
            <li>Create an event with the <a href="/events/new" class="text-accent hover:underline">event editor</a>, then commit the downloaded file to <code>src/content/events/</code>.</li>
            <li>It appears automatically on <a href="/events" class="text-accent hover:underline">/events</a> — upcoming until its date passes, then under “Past events”.</li>
            <li>Sign-ups land below. Filter by event, <strong>export a CSV</strong> for the attendee list, or remove an entry.</li>
          </ol>
          <p class="mt-2 text-xs text-muted">
            Registration data is private to this console — attendee emails are never shown on the public site.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <span id="r-count" class="text-sm text-muted"></span>
          <select id="r-filter" class="rounded-lg border border-default bg-[var(--bg)] px-3 py-1.5 text-sm">
            <option value="all">All events</option>
          </select>
          <button id="export-reg-csv" class="btn btn-outline btn-sm">Export CSV</button>
        </div>
        <div id="r-list" class="mt-5 overflow-x-auto"></div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .admin-tab[aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent); }
  .filter-chip[aria-pressed='true'],
  .msg-chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
</style>

<script>
  import {
    signIn, loadSession, clearSession,
    listTestimonials, moderateTestimonial, deleteTestimonial,
    listSubscribers, deleteSubscriber, toCsv,
    listRegistrations, deleteRegistration, registrationsToCsv,
    listContactMessages, updateContactMessage, deleteContactMessage, contactMessagesToCsv,
    type AdminTestimonial, type Registration, type ContactMessage,
  } from '../lib/admin';

  function initAdmin() {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const signinPanel = $('signin-panel');
    const consolePanel = $('console');
    if (!signinPanel || !consolePanel) return;

    const escape = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    // A permission error here almost always means the rules do not yet name
    // this UID, so say exactly that rather than a bare error string.
    function permissionHint(err: string): string {
      const uid = loadSession()?.uid ?? '(sign in first)';
      if (/permission|PERMISSION_DENIED|insufficient/i.test(err)) {
        return `<div class="rounded-lg border p-4 text-sm" style="border-color:oklch(0.6 0.16 60 / .4);background:oklch(0.6 0.16 60 / .06)">
          <p class="font-semibold">Firestore rejected the read — this UID is not the admin yet.</p>
          <p class="mt-2 text-muted">Put <code class="rounded bg-[var(--bg)] px-1 py-0.5 font-mono">${escape(uid)}</code>
          into <code>firestore.rules</code> in place of <code>ADMIN_UID_HERE</code>, then click
          <strong>Publish</strong> in the Firebase console. Editing the rules without publishing does nothing.</p>
        </div>`;
      }
      return `<p class="text-sm" style="color:var(--accent)">Could not load: ${escape(err)}</p>`;
    }

    function showSignedIn(email: string, uid: string) {
      signinPanel.hidden = true;
      consolePanel.hidden = false;
      $('who').textContent = email;
      $('sign-out').hidden = false;

      // Surface the UID so it can be pasted into the rules without guessing.
      $('uid-banner').hidden = false;
      $('uid-value').textContent = uid;

      void loadMessages();
      void loadTestimonials();
      void loadSubscribers();
      void loadRegistrations();
    }
    function showSignedOut() {
      signinPanel.hidden = false;
      consolePanel.hidden = true;
      $('who').textContent = '';
      $('sign-out').hidden = true;
      $('uid-banner').hidden = true;
    }

    const session = loadSession();
    session ? showSignedIn(session.email, session.uid) : showSignedOut();

    $('uid-copy')?.addEventListener('click', () => {
      navigator.clipboard.writeText($('uid-value').textContent ?? '');
      ($('uid-copy') as HTMLElement).textContent = 'copied';
    });

    $('signin-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = $('signin-status');
      status.textContent = 'Signing in…';
      status.style.color = 'var(--text-muted)';
      try {
        const s = await signIn(
          ($('admin-email') as HTMLInputElement).value.trim(),
          ($('admin-password') as HTMLInputElement).value,
        );
        showSignedIn(s.email, s.uid);
      } catch (err) {
        const code = err instanceof Error ? err.message : '';
        status.style.color = 'var(--accent)';
        status.textContent =
          code === 'CONFIGURATION_NOT_FOUND'
            ? 'Enable Email/Password sign-in in the Firebase console first.'
            : code.includes('INVALID') || code.includes('CREDENTIAL')
              ? 'Wrong email or password.'
              : `Sign-in failed: ${code}`;
      }
    });

    $('sign-out')?.addEventListener('click', () => { clearSession(); showSignedOut(); });

    document.querySelectorAll<HTMLButtonElement>('.admin-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.admin-tab').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          p.hidden = p.dataset.panel !== tab.dataset.tab;
        });
      });
    });

    let testimonials: AdminTestimonial[] = [];
    let filter = 'all';

    async function loadTestimonials() {
      try {
        testimonials = await listTestimonials();
        renderTestimonials();
      } catch (err) {
        $('t-list').innerHTML = permissionHint(String(err));
      }
    }

    function renderTestimonials() {
      const rows = testimonials.filter((t) => filter === 'all' || t.status === filter);
      $('t-count').textContent = `${rows.length} of ${testimonials.length}`;
      $('t-list').innerHTML = rows.length ? rows.map((t) => `
        <article class="rounded-lg border border-default p-4" data-id="${t.id}">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-full px-2 py-0.5 font-semibold" style="background:var(--accent-soft);color:var(--accent)">${t.status}</span>
            ${t.featured ? '<span class="rounded-full px-2 py-0.5 font-semibold" style="background:var(--accent);color:#fff">featured</span>' : ''}
            <span class="text-muted">${new Date(t.createdAt).toLocaleDateString()}</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed">${escape(t.message)}</p>
          <p class="mt-2 text-xs text-muted"><strong>${escape(t.name)}</strong>${t.role ? ' · ' + escape(t.role) : ''}${t.company ? ', ' + escape(t.company) : ''}${t.article ? ' · ' + escape(t.article) : ''}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button data-act="approved" class="btn btn-outline btn-sm">Approve</button>
            <button data-act="rejected" class="btn btn-outline btn-sm">Reject</button>
            <button data-act="feature" class="btn btn-outline btn-sm">${t.featured ? 'Unfeature' : 'Feature'}</button>
            <button data-act="delete" class="btn btn-outline btn-sm">Delete</button>
          </div>
        </article>`).join('') : '<p class="text-sm text-muted">Nothing here.</p>';
    }

    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => {
      chip.addEventListener('click', () => {
        filter = chip.dataset.filter!;
        document.querySelectorAll('[data-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        renderTestimonials();
      });
    });

    $('t-list')?.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      if (!button) return;
      const id = button.closest<HTMLElement>('[data-id]')!.dataset.id!;
      const item = testimonials.find((t) => t.id === id)!;
      const act = button.dataset.act!;
      if (act === 'delete' && !confirm('Delete this testimonial permanently?')) return;
      button.disabled = true;
      try {
        if (act === 'delete') await deleteTestimonial(id);
        else if (act === 'feature') await moderateTestimonial(id, { featured: !item.featured });
        else await moderateTestimonial(id, { status: act as AdminTestimonial['status'] });
        await loadTestimonials();
      } catch (err) {
        alert(`Failed: ${err}`);
        button.disabled = false;
      }
    });

    let subscribers: Awaited<ReturnType<typeof listSubscribers>> = [];

    async function loadSubscribers() {
      try {
        subscribers = await listSubscribers();
        $('s-count').textContent = `${subscribers.length} subscribers`;
        $('s-list').innerHTML = subscribers.length ? `<table class="w-full text-sm">
          <thead><tr class="border-b border-default text-left text-xs uppercase text-muted"><th class="py-2">Email</th><th>Source</th><th>Date</th><th></th></tr></thead>
          <tbody>${subscribers.map((s) => `<tr class="border-b border-default" data-sub="${escape(s.id)}"><td class="py-2 font-medium">${escape(s.email)}</td><td class="text-muted">${escape(s.source)}</td><td class="text-muted">${new Date(s.createdAt).toLocaleDateString()}</td><td class="text-right"><button data-del class="text-xs text-accent hover:underline">Remove</button></td></tr>`).join('')}</tbody></table>`
          : '<p class="text-sm text-muted">No subscribers yet.</p>';
      } catch (err) {
        $('s-list').innerHTML = permissionHint(String(err));
      }
    }

    $('s-list')?.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-del]');
      if (!button) return;
      const id = button.closest<HTMLElement>('[data-sub]')!.dataset.sub!;
      if (!confirm(`Remove ${id}?`)) return;
      try { await deleteSubscriber(id); await loadSubscribers(); }
      catch (err) { alert(`Failed: ${err}`); }
    });

    $('export-csv')?.addEventListener('click', () => {
      const blob = new Blob([toCsv(subscribers)], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `subscribers-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // ---- contact messages ----------------------------------------------
    let messages: ContactMessage[] = [];
    let msgFilter = 'all';

    async function loadMessages() {
      try {
        messages = await listContactMessages();
        renderMessages();
      } catch (err) {
        $('m-list').innerHTML = permissionHint(String(err));
      }
    }

    function filteredMessages() {
      return messages.filter((m) => msgFilter === 'all' || m.status === msgFilter);
    }

    function renderMessages() {
      const rows = filteredMessages();
      const unread = messages.filter((m) => m.status === 'new').length;
      $('m-count').textContent =
        `${rows.length} of ${messages.length}` + (unread ? ` · ${unread} new` : '');
      $('m-list').innerHTML = rows.length
        ? rows
            .map(
              (m) => `
        <article class="rounded-lg border border-default p-4" data-msg="${m.id}">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-full px-2 py-0.5 font-semibold" style="background:var(--accent-soft);color:var(--accent)">${m.status}</span>
            <span class="font-medium">${escape(m.subject)}</span>
            <span class="text-muted">${new Date(m.createdAt).toLocaleString()}</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed whitespace-pre-wrap">${escape(m.message)}</p>
          <p class="mt-2 text-xs text-muted"><strong>${escape(m.name)}</strong> · <a href="mailto:${escape(m.email)}?subject=Re: ${encodeURIComponent(m.subject)}" class="text-accent hover:underline">${escape(m.email)}</a>${m.phone ? ` · <a href="tel:${escape(m.phone)}" class="text-accent hover:underline">${escape(m.phone)}</a>` : ''}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="mailto:${escape(m.email)}?subject=Re: ${encodeURIComponent(m.subject)}" class="btn btn-outline btn-sm">Reply</a>
            ${m.status === 'new' ? '<button data-msg-act="read" class="btn btn-outline btn-sm">Mark read</button>' : ''}
            ${m.status !== 'archived' ? '<button data-msg-act="archived" class="btn btn-outline btn-sm">Archive</button>' : '<button data-msg-act="read" class="btn btn-outline btn-sm">Unarchive</button>'}
            <button data-msg-act="delete" class="btn btn-outline btn-sm">Delete</button>
          </div>
        </article>`,
            )
            .join('')
        : '<p class="text-sm text-muted">No messages here.</p>';
    }

    document.querySelectorAll<HTMLButtonElement>('[data-msg-filter]').forEach((chip) => {
      chip.addEventListener('click', () => {
        msgFilter = chip.dataset.msgFilter!;
        document.querySelectorAll('[data-msg-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        renderMessages();
      });
    });

    $('m-list')?.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-msg-act]');
      if (!button) return;
      const id = button.closest<HTMLElement>('[data-msg]')!.dataset.msg!;
      const act = button.dataset.msgAct!;
      if (act === 'delete' && !confirm('Delete this message permanently?')) return;
      button.disabled = true;
      try {
        if (act === 'delete') await deleteContactMessage(id);
        else await updateContactMessage(id, act as ContactMessage['status']);
        await loadMessages();
      } catch (err) {
        alert(`Failed: ${err}`);
        button.disabled = false;
      }
    });

    $('export-msg-csv')?.addEventListener('click', () => {
      const blob = new Blob([contactMessagesToCsv(filteredMessages())], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `messages-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // ---- event registrations -------------------------------------------
    let registrations: Registration[] = [];
    let regFilter = 'all';

    async function loadRegistrations() {
      try {
        registrations = await listRegistrations();
        // Rebuild the per-event filter, preserving the current selection.
        const select = $('r-filter') as HTMLSelectElement;
        const events = [...new Map(registrations.map((r) => [r.event, r.eventTitle])).entries()];
        select.innerHTML =
          '<option value="all">All events</option>' +
          events
            .map(([slug, title]) => `<option value="${escape(slug)}">${escape(title || slug)}</option>`)
            .join('');
        select.value = events.some(([s]) => s === regFilter) ? regFilter : 'all';
        renderRegistrations();
      } catch (err) {
        $('r-list').innerHTML = permissionHint(String(err));
      }
    }

    function filteredRegistrations() {
      return registrations.filter((r) => regFilter === 'all' || r.event === regFilter);
    }

    function renderRegistrations() {
      const rows = filteredRegistrations();
      $('r-count').textContent = `${rows.length} of ${registrations.length} registration${registrations.length === 1 ? '' : 's'}`;
      $('r-list').innerHTML = rows.length
        ? `<table class="w-full text-sm">
            <thead><tr class="border-b border-default text-left text-xs uppercase text-muted"><th class="py-2">Name</th><th>Email</th><th>Event</th><th>Company</th><th>Date</th><th></th></tr></thead>
            <tbody>${rows
              .map(
                (r) => `<tr class="border-b border-default" data-reg="${escape(r.id)}"><td class="py-2 font-medium">${escape(r.name)}</td><td class="text-muted">${escape(r.email)}</td><td class="text-muted">${escape(r.eventTitle || r.event)}</td><td class="text-muted">${escape(r.org)}</td><td class="text-muted">${new Date(r.createdAt).toLocaleDateString()}</td><td class="text-right"><button data-reg-del class="text-xs text-accent hover:underline">Remove</button></td></tr>`,
              )
              .join('')}</tbody></table>`
        : '<p class="text-sm text-muted">No registrations yet.</p>';
    }

    $('r-filter')?.addEventListener('change', (e) => {
      regFilter = (e.target as HTMLSelectElement).value;
      renderRegistrations();
    });

    $('r-list')?.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-reg-del]');
      if (!button) return;
      const id = button.closest<HTMLElement>('[data-reg]')!.dataset.reg!;
      if (!confirm('Remove this registration?')) return;
      try { await deleteRegistration(id); await loadRegistrations(); }
      catch (err) { alert(`Failed: ${err}`); }
    });

    $('export-reg-csv')?.addEventListener('click', () => {
      const blob = new Blob([registrationsToCsv(filteredRegistrations())], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `registrations-${regFilter === 'all' ? 'all' : regFilter}-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }

  initAdmin();
  document.addEventListener('astro:page-load', initAdmin);
</script>
