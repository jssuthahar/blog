<mxfile host="app.diagrams.net"><diagram name="Prompt to Skill" id="PrompttoSkill"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="96" y="16" width="988" height="314" as="geometry"/></mxCell><mxCell id="ev1" value="&lt;b&gt;1. A prompt&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;You type it once. Gone the next session.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="120" y="40" width="440" height="62" as="geometry"/></mxCell><mxCell id="ev2" value="&lt;b&gt;2. Instructions&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Read before every suggestion. Always on, always in the context window.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="120" y="132" width="440" height="62" as="geometry"/></mxCell><mxCell id="ev3" value="&lt;b&gt;3. A Skill&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;A named capability, loaded only when the task matches its description.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="120" y="224" width="440" height="62" as="geometry"/></mxCell><mxCell id="eve0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ev1" target="ev2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eve1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="ev2" target="ev3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="costs nothing, teaches nothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="78" width="260" height="34" as="geometry"/></mxCell><mxCell id="n2" value="teaches everything, every time,&lt;br&gt;whether the task needs it or not" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="260" height="44" as="geometry"/></mxCell><mxCell id="n3" value="teaches on demand -&lt;br&gt;the description is the trigger" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#82B366;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="262" width="260" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>