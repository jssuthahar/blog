---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { getAllTags } from '../lib/posts';

const tags = await getAllTags();
---

<BaseLayout title="All tags" description="Browse every topic covered on MSDEVBUILD by tag.">
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Tags</h1>
    <p class="mt-3 text-muted">{tags.length} topics covered so far.</p>
  </header>

  <ul class="mt-10 flex flex-wrap gap-2">
    {tags.map(({ slug, label, count }) => (
      <li>
        <a
          href={`/tag/${slug}/`}
          class="inline-block rounded-full border border-default px-4 py-2 text-sm transition-colors hover:text-accent hover:bg-subtle"
        >
          #{label} <span class="text-xs text-muted">{count}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-16">
    <Newsletter source="tags" compact />
  </div>
</BaseLayout>
