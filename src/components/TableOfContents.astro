---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Only h2/h3 — deeper levels make the rail noisy rather than useful.
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{headings.length >= 3 && (
  <nav class="toc" aria-labelledby="toc-heading">
    <h2 id="toc-heading" class="text-xs font-semibold tracking-wider uppercase text-muted">
      On this page
    </h2>
    <ul class="mt-3 space-y-1 border-l border-default text-sm">
      {headings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={[
              '-ml-px block border-l border-transparent py-1 leading-snug text-muted transition-colors hover:text-accent',
              h.depth === 2 ? 'pl-4' : 'pl-8',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc a[aria-current='true'] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 500;
  }
</style>

<script>
  function initScrollSpy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (links.length === 0) return;

    const headings = [...links]
      .map((link) => document.getElementById(link.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (slug: string) => {
      links.forEach((link) =>
        link.setAttribute('aria-current', String(link.dataset.tocLink === slug)),
      );
    };

    // Track which headings are above the fold line; the last one wins.
    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }

        const current = headings.find((h) => visible.has(h.id));
        if (current) setActive(current.id);
      },
      // Top band of the viewport, just below the sticky header.
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 },
    );

    headings.forEach((h) => observer.observe(h));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  initScrollSpy();
  document.addEventListener('astro:page-load', initScrollSpy);
</script>
