=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc2" target="fcr2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce2" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc1" target="fc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc3" value="Still in its lifetime?&lt;br&gt;exp and nbf, 30s clock skew" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="160" y="542" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr3" value="401 Unauthorized" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="566" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn3" value="no" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc3" target="fcr3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce3" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc2" target="fc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc4" value="Authorization policy on the route group" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="682" width="280" height="56" as="geometry"/></mxCell><mxCell id="fce4" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc3" target="fc4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc_end" value="200 - the endpoint runs" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="170" y="782" width="260" height="48" as="geometry"/></mxCell><mxCell id="fce_end" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc4" target="fc_end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Turn off any one of the four and the token stops being a security boundary.&lt;br&gt;ValidateAudience = false is the one people disable and the one that matters most." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="620" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>