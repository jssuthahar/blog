<mxfile host="app.diagrams.net"><diagram name="Cancel-order handoffs" id="Cancel-orderhandoffs"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="6" width="568" height="726" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;1. Business analyst&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;seven states, one BLOCKING question: who pays once cooking starts?&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="520" height="62" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;2. A person answers&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;cancel only while placed or confirmed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="118" width="520" height="62" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;3. Solution architect&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Order.canBeCancelled on the entity, an ADR, a line in AGENTS.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="206" width="520" height="62" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;4. Flutter agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the screen reads the entity, not its own condition&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="294" width="520" height="62" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b&gt;5. Testing agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;AC-3: cancelling a preparing order is refused&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="382" width="520" height="62" as="geometry"/></mxCell><mxCell id="h6" value="&lt;b&gt;6. Security agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the rules let a customer write any status on their own order&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="520" height="62" as="geometry"/></mxCell><mxCell id="h7" value="&lt;b&gt;7. Pen test agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;two attack tests, run on every push&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="558" width="520" height="62" as="geometry"/></mxCell><mxCell id="h8" value="&lt;b&gt;8. Release, l10n, a11y, analytics&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;notes, one message, a named button, order_cancelled&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="646" width="520" height="62" as="geometry"/></mxCell><mxCell id="he0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he5" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h6" target="h7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he6" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h7" target="h8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>