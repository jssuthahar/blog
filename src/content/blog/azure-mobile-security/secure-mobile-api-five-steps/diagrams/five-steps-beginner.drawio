<mxfile host="app.diagrams.net"><diagram name="Five steps in order" id="Fivestepsinorder"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="6" width="622" height="692" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. HTTPS only: lock the pipe&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Nothing travels in plain text, not even the&lt;br&gt;very first request.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="560" height="80" as="geometry"/></mxCell><mxCell id="s1ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="47" width="46" height="46" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Authentication: who are you?&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Entra ID gives the user a signed pass.&lt;br&gt;Your API checks it on every call.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="560" height="80" as="geometry"/></mxCell><mxCell id="s2ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="157" width="46" height="46" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Authorization: what may you see?&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Priya only gets Priya's orders. This check&lt;br&gt;lives in your own code.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="560" height="80" as="geometry"/></mxCell><mxCell id="s3ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="267" width="46" height="46" as="geometry"/></mxCell><mxCell id="s3ln" style="html=1;endArrow=none;strokeColor=#B85450;strokeWidth=2;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="359" as="sourcePoint"/><mxPoint x="630" y="359" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3lt" value="1-3: the doors an attacker must pass" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#A02C2C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="344" y="362" width="280" height="22" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Secrets: nothing in config&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Keys live in Key Vault, not in your code.&lt;br&gt;If something leaks, there is less to steal.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="388" width="560" height="80" as="geometry"/></mxCell><mxCell id="s4ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="405" width="46" height="46" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Monitoring: you find out first&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;An alert when failed logins spike, so you&lt;br&gt;hear about it before the bill does.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="498" width="560" height="80" as="geometry"/></mxCell><mxCell id="s5ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="515" width="46" height="46" as="geometry"/></mxCell><mxCell id="ssum" value="&lt;b&gt;Do them in this order.&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;You can add monitoring last. You can't add HTTPS last.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="608" width="560" height="66" as="geometry"/></mxCell><mxCell id="se0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s5" target="ssum"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>