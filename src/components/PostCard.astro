---
import CoverArt from './CoverArt.astro';
import ViewCount from './ViewCount.astro';
import { CATEGORIES, formatDate, postUrl, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { data } = post;
const minutes = readingTime(post.body ?? '');
const category = CATEGORIES[data.category];
---

<article class="tile reveal-in group">
  <!-- The share-card ratio, so a post's own OG art fills the panel with no crop. -->
  <div class="tile-media">
    <CoverArt post={post} eager={eager} />
  </div>

  <div class="tile-body">
    <div class="tile-meta">
      <span class="tile-topic">{category.label}</span>
      <span>{minutes} min read</span>
      {data.series && <span>Part {data.seriesOrder}</span>}
    </div>

    <h3 class="tile-title line-clamp-3">
      <a href={postUrl(post)} class="after:absolute after:inset-0">
        {data.title}
      </a>
    </h3>

    <p class="tile-text line-clamp-2">{data.description}</p>

    <div class="tile-foot">
      {data.updatedAt ? (
        <span>Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></span>
      ) : (
        <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      )}
      <ViewCount slug={post.id} />
      <span class="tile-cta" aria-hidden="true">Read <span>→</span></span>
    </div>
  </div>
</article>
