<mxfile host="app.diagrams.net"><diagram name="Model choice" id="Modelchoice"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="6" width="788" height="702" as="geometry"/></mxCell><mxCell id="fc_start" value="A task arrives" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="30" width="260" height="48" as="geometry"/></mxCell><mxCell id="fc0" value="Does it need multi-step planning?&lt;br&gt;A chain of dependent decisions" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="180" y="122" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr0" value="Reasoning model" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="590" y="146" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn0" value="no" style="html=1;rounded=0;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc0" target="fcr0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc_start" target="fc0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc1" value="Is it text in, text out?&lt;br&gt;Chat, drafting, summarising" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="180" y="262" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr1" value="Embedding model&lt;br&gt;for retrieval" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="590" y="286" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn1" value="no" style="html=1;rounded=0;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc1" target="fcr1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce1" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc0" target="fc1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc2" value="Is it narrow and high volume?&lt;br&gt;Classification, extraction, routing" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="180" y="402" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr2" value="SLM - Phi-4, Mistral Small" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="590" y="426" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn2" value="no" style="html=1;rounded=0;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc2" target="fcr2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce2" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc1" target="fc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc_end" value="LLM - GPT-5 for open-ended generation" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="542" width="260" height="48" as="geometry"/></mxCell><mxCell id="fce_end" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc2" target="fc_end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Start with the smallest model that clears your accuracy bar.&lt;br&gt;Moving a call up to an LLM later is a one-line config change; moving a bill back down is not." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="600" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>