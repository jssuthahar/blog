<mxfile host="app.diagrams.net"><diagram name="Blast radius" id="Blastradius"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="6" width="528" height="460" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;1. FIREBASE_SERVICE_ACCOUNT&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;acts on the project from CI: highest blast radius&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="480" height="64" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;2. ANDROID_KEYSTORE_* secrets&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;sign an update that installs over the real app&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="124" width="480" height="64" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;3. A test account password&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;one user's data, if the rules hold&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="218" width="480" height="64" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;4. The Firebase web API key&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;public by design; the rules are the boundary&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="312" width="480" height="64" as="geometry"/></mxCell><mxCell id="ke0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ke1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ke2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Ranked by what an attacker can do with it, not by how easy it is to see." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>