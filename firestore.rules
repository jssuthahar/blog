rules_version = '2';

// View counters only. No auth, no personal data — the rules themselves are
// the entire security boundary, so they must be strict about what a write
// is allowed to change.
service cloud.firestore {
  match /databases/{database}/documents {

    match /views/{slug} {
      // Counts are public.
      allow read: if true;

      // A write may only ever set `count`, and only to exactly one more than
      // its current value (or 1 if the document does not exist yet). That
      // makes the worst case "someone scripts extra page views", not
      // "someone writes arbitrary data or zeroes the counter".
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Newsletter subscribers.
    //
    // The document ID is the email address, which makes a repeat signup a
    // no-op instead of a duplicate row.
    match /subscribers/{email} {
      // Never readable. A public read here would publish the entire mailing
      // list to anyone who knows the collection name.
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    // Server-stamped, so a client cannot backdate a signup.
                    && request.resource.data.createdAt == request.time;
    }

    // Reader testimonials.
    //
    // Moderation lives entirely in these rules: anyone may submit, but only
    // as `pending`, and only `approved` documents are readable. A client
    // cannot approve its own submission, and a query that does not filter to
    // approved is rejected outright rather than returning a filtered set.
    match /testimonials/{id} {
      allow read: if resource.data.status == 'approved';

      allow create: if request.resource.data.keys().hasOnly(
                         ['message', 'name', 'company', 'role', 'article',
                          'status', 'featured', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.featured == false
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 1500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.company is string
                    && request.resource.data.company.size() <= 100
                    && request.resource.data.role is string
                    && request.resource.data.role.size() <= 100
                    && request.resource.data.article is string
                    && request.resource.data.article.size() <= 300
                    // Server-stamped, so a submission cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // Approving, editing, and deleting happen in the Firebase console only.
      allow update, delete: if false;
    }

    // The submitter's email, kept OUT of the testimonial document.
    //
    // Firestore rules cannot hide individual fields: reading an approved
    // testimonial returns every field it holds. Storing the address alongside
    // the quote would therefore publish it to anyone, and it would be baked
    // into the static HTML by the sync. It lives here instead, where nothing
    // can read it, keyed by the testimonial's own id.
    match /testimonialContacts/{id} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.createdAt == request.time;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
