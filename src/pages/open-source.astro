---
import BaseLayout from '../layouts/BaseLayout.astro';
import RepoCard from '../components/RepoCard.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import GlassCarousel from '../components/GlassCarousel.astro';
import type { GlassSlide } from '../lib/carousels';
import AdUnit from '../components/AdUnit.astro';
import { SITE, AUTHOR, ADSENSE_SLOT_DISPLAY } from '../config';
import Newsletter from '../components/Newsletter.astro';
import { allRepos, repoIndex } from '../lib/repos';
import { featuredProjects } from '../lib/featured-projects';

const liveCount = featuredProjects.filter((p) => p.live).length;

const slides: GlassSlide[] = [
  {
    tab: 'Open source',
    kicker: 'MSDEVBUILD · Open source',
    title: 'Open-source projects,',
    accent: 'code you can read',
    text: `Flagship apps you can open and try, plus ${repoIndex.count} public repositories, taking each idea end to end across AI and full-stack development, shipping to Android, iOS, and web.`,
    tiles: [
      { value: String(repoIndex.count), label: 'public repositories' },
      { value: String(repoIndex.totalStars), label: 'stars' },
      { value: String(repoIndex.totalForks), label: 'forks' },
    ],
    actions: [{ label: 'View on GitHub ↗', href: `https://github.com/${repoIndex.user}`, primary: true, external: true }],
    panel: {
      demo: { kind: 'flow', labels: ['Open', 'Run', 'Learn'], caption: 'Open a project, run it, and read how it was built.' },
      title: 'Flagship apps',
      steps: featuredProjects.slice(0, 3).map((p) => ({ title: p.name, note: p.tagline, href: p.live ?? p.source, external: true })),
    },
  },
  {
    tab: 'Live demos',
    kicker: 'MSDEVBUILD · Live demos',
    title: 'Try it right now,',
    accent: 'in your browser',
    text: 'Open the app in your browser, then read the source behind it.',
    tiles: [{ value: String(liveCount), label: 'live demos' }],
    actions: [{ label: 'See the projects', href: '#featured-heading' }],
    panel: {
      demo: { kind: 'flow', labels: ['Live demo', 'Source', 'Learn'], caption: 'See it working first, then read how it is built.' },
      title: 'Open a demo',
      steps: featuredProjects.filter((p) => p.live).slice(0, 3).map((p) => ({ title: p.name, note: p.tagline, href: p.live!, external: true })),
    },
  },
  {
    tab: 'Repositories',
    kicker: 'MSDEVBUILD · Repositories',
    title: `${repoIndex.count} repositories,`,
    accent: 'public on GitHub',
    text: 'Samples and tools across .NET, Xamarin, Azure and Visual Studio.',
    actions: [{ label: 'View on GitHub ↗', href: `https://github.com/${repoIndex.user}`, primary: true, external: true }],
    panel: {
      demo: { kind: 'flow', labels: ['Clone', 'Explore', 'Learn'], caption: 'Real repositories that show how the work is done.' },
      title: 'Most starred',
      steps: [...allRepos()].sort((a, b) => b.stars - a.stars).slice(0, 3).map((r) => ({ title: r.name, note: `${r.stars} stars · ${r.forks} forks`, href: r.url, external: true })),
    },
  },
];

const repos = allRepos();
const withDescription = repos.filter((r) => r.description.length > 0);
const rest = repos.filter((r) => r.description.length === 0);


const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/open-source#page`,
    name: `Open source — ${AUTHOR.name}`,
    description: `Public repositories maintained by ${AUTHOR.name}, covering .NET, Xamarin, Azure, and developer tooling.`,
    about: { '@id': `${SITE.url}/#person` },
  },
];
---

<BaseLayout
  title="Open-Source .NET & Flutter Projects"
  description={`${repoIndex.count} public repositories by ${AUTHOR.name} — .NET, Xamarin, Azure samples, Visual Studio extensions, and developer tools.`}
  schema={schema}
>
  <GlassCarousel slides={slides} label="Open source" />

  <section class="mt-14" aria-labelledby="tools-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">AI tools</p>
        <h2 id="tools-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">AI Token Calculator</h2>
      </div>
      <p class="text-sm text-muted">Runs on this site, in your browser</p>
    </div>

    <a href="/open-source/ai-token-calculator/" class="tool-card tile reveal-in mt-6">
      <div class="tool-copy">
        <span class="tile-topic self-start">New · Interactive</span>
        <h3 class="tool-title">See how Copilot turns text into tokens, and tokens into AI Credits</h3>
        <p class="tile-text text-pretty">
          Thirteen steps from beginner to expert: an animated lesson, a live tokenizer for your own text, AI Credit
          billing, agent and caching patterns, real before-and-after scenarios, and how to write instructions, skills
          and hooks that keep token use low.
        </p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          <li class="tile-tag">Animated lesson</li>
          <li class="tile-tag">Live tokenizer</li>
          <li class="tile-tag">AI Credits billing</li>
          <li class="tile-tag">Scenarios</li>
          <li class="tile-tag">Quiz</li>
        </ul>
        <span class="btn btn-accent btn-sm mt-4 self-start">Open the calculator <span aria-hidden="true">→</span></span>
      </div>

      <!-- A looping preview: the sentence splits into tokens, the counter
           climbs, and the credit meter fills. CSS only. -->
      <div class="tool-demo" aria-hidden="true">
        <div class="tool-sent">
          {['Copilot', ' counts', ' every', ' token', ' you', ' send', '.'].map((t, i) => (
            <span style={`--i:${i}`}>{t}</span>
          ))}
        </div>
        <div class="tool-meter">
          <div class="tool-count"><b>7</b><small>tokens</small></div>
          <div class="tool-bar"><span></span></div>
          <small class="tool-cr">× model price = AI Credits</small>
        </div>
      </div>
    </a>
  </section>

  <section class="mt-14" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Featured projects</p>
        <h2 id="featured-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
          Tools you can try right now
        </h2>
      </div>
      {liveCount > 0 && (
        <p class="text-sm text-muted">{liveCount} with a live demo you can open in the browser</p>
      )}
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project, i) => (
        <FeaturedProjectCard project={project} wide={i === 0} />
      ))}
    </div>
  </section>

  <section class="mt-16" aria-labelledby="projects-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">On GitHub</p>
        <h2 id="projects-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">More repositories</h2>
      </div>
    </div>
    <div class="repo-grid mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {withDescription.map((repo) => <RepoCard repo={repo} />)}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="mt-14" aria-labelledby="more-heading">
      <h2 id="more-heading" class="section-title">
        Also on GitHub
      </h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {rest.map((repo) => (
          <li>
            <a
              href={repo.url}
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-default px-3 py-1.5 text-sm transition-colors hover:bg-subtle"
            >
              {repo.name}
              {repo.stars > 0 && <span class="text-xs text-muted">{repo.stars}★</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-14">
    <Newsletter source="open-source" />
  </div>

  <!-- One display ad at the foot of the projects list. -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
</BaseLayout>

<style>
  .tool-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    color: inherit;
  }
  .tool-copy {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.5rem;
  }
  .tool-title {
    margin-top: 0.6rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .tool-demo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
    background:
      radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.4px) 0 0 / 14px 14px,
      radial-gradient(90% 120% at 100% 0%, rgb(255 255 255 / 0.2), transparent 70%),
      linear-gradient(135deg, #0068b8, #003e70);
    padding: 1.5rem;
    color: #fff;
  }
  .tool-sent {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font: 600 1.05rem/1.4 var(--font-mono);
  }
  .tool-sent span {
    border-radius: 0.45rem;
    background: rgb(255 255 255 / 0.18);
    padding: 0.2rem 0.5rem;
    white-space: pre;
  }
  .tool-meter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.4rem 0.9rem;
  }
  .tool-count b {
    display: block;
    font-size: 2rem;
    line-height: 1;
  }
  .tool-count small,
  .tool-cr {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.8);
  }
  .tool-cr {
    grid-column: 2;
  }
  .tool-bar {
    height: 0.6rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.2);
  }
  .tool-bar span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #8fcbf7, #fff);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tool-sent span {
      animation: tool-split 6s cubic-bezier(0.3, 1.4, 0.6, 1) calc(var(--i) * 0.25s) infinite both;
    }
    .tool-bar span {
      transform-origin: left;
      animation: tool-fill 6s ease-in-out infinite both;
    }
    .tool-count b {
      animation: tool-blink 6s ease infinite both;
    }
  }
  @keyframes tool-split {
    0%,
    6% {
      opacity: 0;
      transform: translateY(-12px) scale(0.8);
    }
    14%,
    82% {
      opacity: 1;
      transform: none;
    }
    92%,
    100% {
      opacity: 0;
    }
  }
  @keyframes tool-fill {
    0%,
    30% {
      transform: scaleX(0);
    }
    60%,
    85% {
      transform: scaleX(1);
    }
    95%,
    100% {
      transform: scaleX(0);
    }
  }
  @keyframes tool-blink {
    0%,
    25% {
      opacity: 0;
    }
    35%,
    85% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }
  @media (max-width: 767px) {
    .tool-card {
      grid-template-columns: 1fr;
    }
  }

  /* The last row always fills: a leftover tile stretches instead of leaving a hole. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .repo-grid > :global(:last-child:nth-child(odd)) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .repo-grid > :global(:last-child:nth-child(3n + 2)) {
      grid-column: span 2;
    }
    .repo-grid > :global(:last-child:nth-child(3n + 1)) {
      grid-column: span 3;
    }
  }
</style>
