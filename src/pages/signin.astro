---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMMUNITY, FIREBASE, SITE } from '../config';

// Optional feature: with no Firebase project (or COMMUNITY.enabled off) the
// page still builds, and says so, rather than offering buttons that cannot work.
const enabled = COMMUNITY.enabled && FIREBASE.projectId.length > 0;

// Brand marks are inlined rather than fetched — the site ships no external
// requests, and four small paths are cheaper than four image files.
const OAUTH = [
  {
    id: 'google.com',
    label: 'Google',
    path: 'M21.35 11.1H12v2.9h5.35c-.25 1.35-1.7 3.95-5.35 3.95a5.95 5.95 0 1 1 0-11.9c1.7 0 2.85.72 3.5 1.35l2.4-2.3C16.4 3.6 14.4 2.7 12 2.7a9.3 9.3 0 1 0 0 18.6c5.37 0 8.92-3.77 8.92-9.08 0-.6-.06-1.06-.15-1.52Z',
  },
  {
    id: 'microsoft.com',
    label: 'Microsoft',
    path: 'M3 3h8.5v8.5H3V3Zm9.5 0H21v8.5h-8.5V3ZM3 12.5h8.5V21H3v-8.5Zm9.5 0H21V21h-8.5v-8.5Z',
  },
  {
    id: 'github.com',
    label: 'GitHub',
    path: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/signin#page`,
    name: 'Sign in',
    description: 'Optional reader account for appreciations, badges and a public developer profile.',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
];
---

<BaseLayout
  title="Sign in"
  description="Optional reader account — keep your appreciations, earn badges, and claim a public developer profile. Reading never requires an account."
  schema={schema}
  noindex
>
  <div class="mx-auto max-w-md px-4 py-14 sm:px-6">
    <p class="eyebrow">Reader account</p>
    <h1 class="display mt-1.5 text-2xl">Sign in</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">
      Reading never needs an account — every article stays open, and you can react
      without one. Signing in only makes those appreciations, your badges and your
      developer profile follow you instead of living in one browser.
    </p>

    {!enabled && (
      <p class="mt-8 rounded-lg border border-default bg-subtle p-4 text-sm text-muted">
        Reader accounts are not switched on for this site yet.
      </p>
    )}

    {enabled && (
      <>
        <div class="mt-8 space-y-2.5">
          {OAUTH.map(({ id, label, path }) => (
            <button
              type="button"
              data-provider={id}
              class="flex w-full items-center justify-center gap-2.5 rounded-lg border border-default px-4 py-3 text-sm font-medium transition-colors hover:bg-subtle disabled:opacity-60"
            >
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={path} />
              </svg>
              Continue with {label}
            </button>
          ))}
        </div>

        <div class="my-6 flex items-center gap-3 text-xs text-muted">
          <span class="h-px flex-1 bg-[var(--border)]"></span>
          or use your email
          <span class="h-px flex-1 bg-[var(--border)]"></span>
        </div>

        <!-- Passwordless: a link, not a password. Nothing to store, nothing to
             reset, and nothing for this site to leak. -->
        <form data-email-form class="space-y-3" novalidate>
          <div>
            <label for="signin-email" class="block text-sm font-medium">Email</label>
            <input
              id="signin-email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder="you@example.com"
              class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm"
            />
          </div>
          <button type="submit" class="btn btn-accent btn-sm w-full">Email me a sign-in link</button>
        </form>

        <p data-status role="status" aria-live="polite" class="mt-4 text-sm"></p>

        <p class="mt-8 text-xs leading-relaxed text-muted">
          Your email address is stored privately and is never shown on your profile
          or shared. Your profile stays private until you choose to publish it, and
          you can delete your account and everything in it at any time from
          <a href="/profile/" class="text-accent hover:underline">your profile</a>.
          See the <a href="/privacy/" class="text-accent hover:underline">privacy notice</a>.
        </p>
      </>
    )}
  </div>
</BaseLayout>

<script>
  import {
    signInWithProvider,
    sendEmailLink,
    isEmailLink,
    completeEmailLink,
    loadSession,
    type ProviderId,
  } from '../lib/auth';
  import { saveContact } from '../lib/community';

  function initSignIn() {
    const status = document.querySelector<HTMLParagraphElement>('[data-status]');
    const form = document.querySelector<HTMLFormElement>('[data-email-form]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-provider]')];

    // Nothing to bind on other pages, and never bind twice when the view
    // transition router brings us back here.
    if (!buttons.length && !form) return;
    if (status?.dataset.bound === '') return;
    if (status) status.dataset.bound = '';

    const say = (message: string, tone: 'ok' | 'error' | 'muted' = 'muted') => {
      if (!status) return;
      status.textContent = message;
      status.className =
        'mt-4 text-sm ' +
        (tone === 'error'
          ? 'text-red-600 dark:text-red-400'
          : tone === 'ok'
            ? 'text-accent'
            : 'text-muted');
    };

    /** ?next= lets any page send someone here and get them back afterwards. */
    const next = () => new URLSearchParams(location.search).get('next') || '/profile/';

    async function afterSignIn() {
      const session = loadSession();
      if (!session) return;

      // The address goes to its own collection, never the public profile —
      // rules cannot hide a field, so it must not sit in a document anyone reads.
      if (session.email) {
        await saveContact(session.uid, session.email, session.provider).catch(() => {});
      }

      location.href = next();
    }

    function friendly(err: unknown): string {
      const code = String((err as Error)?.message ?? '');
      if (code.includes('popup-closed-by-user') || code.includes('cancelled-popup-request')) {
        return 'Sign-in window closed. Nothing was saved — try again when you are ready.';
      }
      if (code.includes('popup-blocked')) {
        return 'Your browser blocked the sign-in window. Allow popups for this site, then try again.';
      }
      if (code.includes('account-exists-with-different-credential')) {
        return 'That email already has an account through a different provider. Use that one instead.';
      }
      if (code.includes('operation-not-allowed') || code.includes('configuration-not-found')) {
        return 'That provider is not switched on yet. Try another one.';
      }
      if (code.includes('unauthorized-domain')) return 'This site is not authorised for sign-in yet.';
      if (code.includes('network')) return 'Network problem — check your connection and try again.';
      return 'That did not work. Please try again.';
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.provider as Exclude<ProviderId, 'email'>;

        buttons.forEach((b) => (b.disabled = true));
        say('Opening the sign-in window…');

        try {
          await signInWithProvider(id);
          say('Signed in. Taking you to your profile…', 'ok');
          await afterSignIn();
        } catch (err) {
          say(friendly(err), 'error');
          buttons.forEach((b) => (b.disabled = false));
        }
      });
    });

    const address = () => document.querySelector<HTMLInputElement>('#signin-email')?.value.trim() ?? '';

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = address();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        say('That email address does not look right.', 'error');
        return;
      }

      // Opened on a different device from the one that asked for the link, so
      // the address was never stored here: complete with what they just typed.
      if (form.dataset.awaitingEmail === '') {
        try {
          await completeEmailLink(email);
          await afterSignIn();
        } catch (err) {
          say(friendly(err), 'error');
        }
        return;
      }

      say('Sending your link…');
      try {
        await sendEmailLink(email, '/signin/');
        say(`Check ${email} for a sign-in link. You can close this tab.`, 'ok');
      } catch (err) {
        say(friendly(err), 'error');
      }
    });

    // Arriving back on an email link: finish the sign-in without asking again.
    (async () => {
      if (!(await isEmailLink().catch(() => false))) return;

      say('Finishing sign-in…');
      try {
        await completeEmailLink();
        say('Signed in. Taking you to your profile…', 'ok');
        await afterSignIn();
      } catch {
        if (form) form.dataset.awaitingEmail = '';
        say('Confirm the email address this link was sent to, then submit again.', 'error');
      }
    })();
  }

  initSignIn();
  document.addEventListener('astro:page-load', initSignIn);
</script>
