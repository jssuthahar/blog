---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import { SITE, AUTHOR, MAIN_SITE, FIREBASE, BOOKING, ADSENSE_SLOT_DISPLAY } from '../config';
import { SUBJECTS } from '../lib/contact';

// The form writes straight to Firestore (no external form service), so it is
// live wherever the Firestore project is configured.
const configured = FIREBASE.projectId.length > 0;

// Every route points at the form or LinkedIn. No address is published, so
// there is nothing on the page for a scraper to harvest.
const target = configured ? '#message-form' : AUTHOR.linkedin;

const routes = [
  {
    title: 'Speaking invitation',
    description:
      'Conference sessions, webinars, and community meetups on Azure, applied AI, and .NET.',
    cta: 'Send a speaking invitation',
    href: target,
  },
  {
    title: 'Article feedback',
    description:
      'Corrections, questions on a post, or a topic you would like covered next.',
    cta: 'Send feedback',
    href: target,
  },
  {
    title: 'Community & collaboration',
    description:
      'User groups, student communities, open-source projects, and podcast invitations.',
    cta: 'Start a conversation',
    href: target,
  },
];

const elsewhere = [
  { label: 'LinkedIn', value: 'in/jssuthahar', href: AUTHOR.linkedin },
  { label: 'GitHub', value: '@jssuthahar', href: 'https://github.com/jssuthahar' },
  { label: 'YouTube', value: '@MSDEVBUILD', href: 'https://www.youtube.com/@MSDEVBUILD' },
  { label: 'X', value: '@jssuthahar', href: AUTHOR.x },
  { label: 'Main site', value: MAIN_SITE.label, href: MAIN_SITE.url },
];

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact#page`,
    name: `Contact ${AUTHOR.name}`,
    description: `Get in touch with ${AUTHOR.name} about speaking invitations, community events, or the blog.`,
    about: { '@id': `${SITE.url}/#person` },
  },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${AUTHOR.name} about speaking invitations, community events, or feedback on an article.`}
  schema={schema}
>
  <header class="max-w-3xl">
    <p class="eyebrow">Contact</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Let's talk</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted text-pretty">
      Speaking invitations, community events, or a question about something I wrote —
      all welcome.
    </p>
    {BOOKING.available && (
      <p class="mt-4 inline-flex items-center gap-2 text-sm text-muted">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full opacity-60" style="background: var(--accent);"></span>
          <span class="relative inline-flex size-2 rounded-full" style="background: var(--accent);"></span>
        </span>
        {BOOKING.availabilityNote} · {BOOKING.responseTime}
      </p>
    )}
  </header>

  <section class="mt-12 grid gap-5 md:grid-cols-3" aria-label="What can I help with">
    {routes.map(({ title, description, cta, href }) => (
      <article class="group relative flex flex-col rounded-xl border border-default p-6 transition-all hover:-translate-y-1 hover:shadow-xl">
        <h2 class="font-semibold tracking-tight">{title}</h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{description}</p>
        <p class="mt-4 text-sm font-semibold text-accent">
          <a href={href} class="after:absolute after:inset-0">{cta} →</a>
        </p>
      </article>
    ))}
  </section>

  <div class="mt-16 grid gap-12 md:grid-cols-[1.4fr_1fr]">
    <section id="message-form" class="scroll-mt-24" aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-xl font-semibold tracking-tight">Send a message</h2>

      <form data-contact-form class="mt-6 space-y-4" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium">Name</label>
            <input
              id="name"
              data-field="name"
              type="text"
              required
              maxlength="80"
              autocomplete="name"
              disabled={!configured}
              class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium">Email</label>
            <input
              id="email"
              data-field="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              disabled={!configured}
              class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
            />
          </div>
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium">
            Phone <span class="font-normal text-muted">(optional)</span>
          </label>
          <input
            id="phone"
            data-field="phone"
            type="tel"
            maxlength="30"
            autocomplete="tel"
            inputmode="tel"
            placeholder="+60 12 345 6789"
            disabled={!configured}
            class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
          />
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium">Subject</label>
          <select
            id="subject"
            data-field="subject"
            disabled={!configured}
            class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
          >
            {SUBJECTS.map((s) => <option>{s}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium">Message</label>
          <textarea
            id="message"
            data-field="message"
            rows="6"
            required
            maxlength="3000"
            disabled={!configured}
            class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
          ></textarea>
          <p class="mt-1 text-xs text-muted"><span data-count>0</span>/3000 · minimum 10 characters</p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" disabled={!configured} class="btn btn-accent disabled:opacity-60">
            Send message
          </button>
          <p data-status role="status" aria-live="polite" class="text-sm"></p>
        </div>

        <p class="text-xs text-muted">
          Your email is used only to reply — never published or shared.
        </p>

        {!configured && (
          <p class="text-sm text-muted">
            This form is not live yet. Set <code>FIREBASE.projectId</code> in
            <code>src/config.ts</code> to switch it on. In the meantime,
            <a href={AUTHOR.linkedin} rel="noopener" class="text-accent hover:underline">
              message me on LinkedIn</a>.
          </p>
        )}
      </form>
    </section>

    <aside>
      <h2 class="text-xl font-semibold tracking-tight">Elsewhere</h2>
      <dl class="mt-6 space-y-3 text-sm">
        {elsewhere.map(({ label, value, href }) => (
          <div class="flex justify-between gap-4 border-b border-default pb-3">
            <dt class="text-muted">{label}</dt>
            <dd class="truncate font-medium">
              <a href={href} class="hover:text-accent" rel="noopener">{value}</a>
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-6 text-sm leading-relaxed text-muted">
        Based in {AUTHOR.location}, working with teams globally.
      </p>
    </aside>
  </div>

  <!-- Kept at the page foot, well clear of the form, so an ad is never adjacent
       to the inputs (avoids accidental clicks and AdSense placement flags). -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none mt-16" />
</BaseLayout>

<script>
  import { sendContactMessage, EMAIL_RE } from '../lib/contact';

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound === '') return;
    form.dataset.bound = '';

    const field = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-field="${name}"]`)!;

    const message = field('message') as HTMLTextAreaElement;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const counter = form.querySelector<HTMLElement>('[data-count]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    message.addEventListener('input', () => {
      counter.textContent = String(message.value.length);
    });

    const say = (text: string, tone: 'ok' | 'error' | 'muted') => {
      status.textContent = text;
      status.style.color = tone === 'muted' ? 'var(--text-muted)' : 'var(--accent)';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const values = {
        name: field('name').value.trim(),
        email: field('email').value.trim().toLowerCase(),
        phone: field('phone').value.trim(),
        subject: field('subject').value,
        message: message.value.trim(),
      };

      if (values.name.length < 2) { say('Please add your name.', 'error'); field('name').focus(); return; }
      if (!EMAIL_RE.test(values.email)) { say('Please enter a valid email address.', 'error'); field('email').focus(); return; }
      if (values.message.length < 10) { say('Please write at least 10 characters.', 'error'); message.focus(); return; }

      button.disabled = true;
      say('Sending…', 'muted');

      try {
        await sendContactMessage(values);
        form.querySelectorAll('input, textarea').forEach((el) => ((el as HTMLInputElement).value = ''));
        counter.textContent = '0';
        say('Thanks — your message has been sent. I’ll get back to you soon.', 'ok');
      } catch (err) {
        button.disabled = false;
        const code = err instanceof Error ? err.message : '';
        say(
          code === 'invalid-email' ? 'Please enter a valid email address.'
            : code === 'invalid-name' ? 'Please add your name.'
              : code === 'invalid-message' ? 'Please write at least 10 characters.'
                : 'Something went wrong. Please try again later.',
          'error',
        );
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
