---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/posts';
import { TAGS } from '../lib/taxonomy';

/**
 * Standalone post editor. No login — it only produces a Markdown file, which
 * you commit yourself. Fully client-side; nothing is sent anywhere.
 */
const today = new Date().toISOString().slice(0, 10);

// Existing series slugs, offered as suggestions so a new part joins cleanly.
const existingSeries = [
  ...new Set((await getCollection('blog')).map((p) => p.data.series).filter(Boolean)),
];

// The toolbar buttons. `wrap` surrounds the selection; `block` prefixes each
// line; `insert` drops a snippet at the cursor. `{sel}` is the selected text.
// `sep` renders a divider so related tools read as a group.
const TOOLBAR = [
  { key: 'b', label: 'B', title: 'Bold  ⌘B', kind: 'wrap', a: '**', b: '**', cls: 'font-bold' },
  { key: 'i', label: 'I', title: 'Italic  ⌘I', kind: 'wrap', a: '_', b: '_', cls: 'italic' },
  { key: 'code', label: '</>', title: 'Inline code', kind: 'wrap', a: '`', b: '`', cls: 'font-mono text-xs' },
  { sep: true },
  { key: 'h2', label: 'H2', title: 'Heading 2', kind: 'block', a: '## ' },
  { key: 'h3', label: 'H3', title: 'Heading 3', kind: 'block', a: '### ' },
  { sep: true },
  { key: 'ul', label: '• List', title: 'Bullet list', kind: 'block', a: '- ' },
  { key: 'ol', label: '1. List', title: 'Numbered list', kind: 'block', a: '1. ' },
  { key: 'quote', label: '❝', title: 'Quote', kind: 'block', a: '> ' },
  { key: 'link', label: '🔗', title: 'Link  ⌘K', kind: 'link' },
  { sep: true },
  { key: 'codeblock', label: 'Code block', title: 'Fenced code block', kind: 'insert',
    snippet: '\n```csharp\n{sel}\n```\n' },
  { key: 'table', label: 'Table', title: 'Table', kind: 'insert',
    snippet: '\n| Column | Column |\n| --- | --- |\n| Cell | Cell |\n' },
  { key: 'callout', label: 'Callout', title: 'Callout (needs .mdx)', kind: 'insert',
    snippet: '\n<Callout type="warning">\n{sel}\n</Callout>\n' },
  { key: 'video', label: 'Video', title: 'YouTube (needs .mdx)', kind: 'insert',
    snippet: '\n<YouTube id="VIDEO_ID" title="Title" />\n' },
  { key: 'image', label: 'Image', title: 'Image', kind: 'insert',
    snippet: '\n![alt text](./images/name.png)\n' },
  { key: 'hr', label: '―', title: 'Divider', kind: 'insert', snippet: '\n---\n' },
];
---

<BaseLayout title="Write a post" description="Post editor." noindex wide>
  <div id="composer" class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
    <!-- ── Action bar ─────────────────────────────────────────────────── -->
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-baseline gap-3">
        <h1 class="display text-xl">Write</h1>
        <span id="autosave" class="text-xs text-muted" aria-live="polite"></span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- View switcher: distraction-free vs. side-by-side preview. -->
        <div class="hidden items-center rounded-lg border border-default p-0.5 lg:inline-flex" role="group" aria-label="View">
          <button id="view-split" type="button" class="seg" aria-pressed="true">Split</button>
          <button id="view-focus" type="button" class="seg" aria-pressed="false">Focus</button>
        </div>
        <button id="btn-guide" type="button" class="btn btn-outline btn-sm" aria-expanded="false" aria-controls="guide">Guide</button>
        <button id="btn-mdx" type="button" class="btn btn-outline btn-sm" title="Toggle .md / .mdx">.md</button>
        <button id="btn-clear" type="button" class="btn btn-outline btn-sm">New</button>
        <button id="btn-copy" type="button" class="btn btn-outline btn-sm">Copy</button>
        <button id="btn-download" type="button" class="btn btn-accent btn-sm">Download</button>
      </div>
    </header>

    <!-- Reference, collapsed by default. Toggled by the Guide button. -->
    <section id="guide" hidden class="mt-4 rounded-lg border border-default bg-subtle p-5 text-sm">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">Markdown</h2>
          <table class="mt-2 w-full">
            <tbody class="[&_td]:py-0.5 [&_td:first-child]:pr-3 [&_code]:rounded [&_code]:bg-[var(--bg)] [&_code]:px-1 [&_code]:font-mono [&_code]:text-xs">
              <tr><td><code>## Heading</code></td><td class="text-muted">section (use questions)</td></tr>
              <tr><td><code>**bold**</code></td><td class="text-muted">bold</td></tr>
              <tr><td><code>_italic_</code></td><td class="text-muted">italic</td></tr>
              <tr><td><code>`code`</code></td><td class="text-muted">inline code</td></tr>
              <tr><td><code>[text](url)</code></td><td class="text-muted">link</td></tr>
              <tr><td><code>- item</code></td><td class="text-muted">bullet list</td></tr>
              <tr><td><code>&gt; quote</code></td><td class="text-muted">blockquote</td></tr>
              <tr><td><code>| a | b |</code></td><td class="text-muted">table</td></tr>
            </tbody>
          </table>
          <p class="mt-2 text-xs text-muted">Fenced code: <code class="rounded bg-[var(--bg)] px-1 font-mono">```csharp</code> … <code class="rounded bg-[var(--bg)] px-1 font-mono">```</code> — name the language for highlighting.</p>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">HTML in Markdown</h2>
          <p class="mt-2 leading-relaxed text-muted">
            Raw HTML works inside a <code class="rounded bg-[var(--bg)] px-1 font-mono">.md</code> file — drop in
            <code class="rounded bg-[var(--bg)] px-1 font-mono">&lt;div&gt;</code>,
            <code class="rounded bg-[var(--bg)] px-1 font-mono">&lt;kbd&gt;</code>,
            <code class="rounded bg-[var(--bg)] px-1 font-mono">&lt;table&gt;</code> wherever Markdown falls short.
          </p>
          <p class="mt-2 leading-relaxed text-muted">
            <strong>Gotcha:</strong> Markdown syntax is <em>not</em> parsed inside a raw HTML block — put finished
            HTML there, keep Markdown outside it.
          </p>
          <p class="mt-2 leading-relaxed text-muted">
            A standalone <code class="rounded bg-[var(--bg)] px-1 font-mono">.html</code> file is <strong>not</strong> a
            post. Put the HTML inside a <code class="rounded bg-[var(--bg)] px-1 font-mono">.md</code> instead.
          </p>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">Images, video, callouts</h2>
          <p class="mt-2 leading-relaxed text-muted">
            <strong>Image:</strong> file in <code class="rounded bg-[var(--bg)] px-1 font-mono">src/content/blog/images/</code>,
            then <code class="rounded bg-[var(--bg)] px-1 font-mono">![alt](./images/x.png)</code>. Always add alt text.
          </p>
          <p class="mt-2 leading-relaxed text-muted">
            <strong>Video / Callout</strong> use the toolbar buttons — they switch the file to
            <code class="rounded bg-[var(--bg)] px-1 font-mono">.mdx</code> and add the import on download.
          </p>
          <p class="mt-2 leading-relaxed text-muted">
            <strong>Cover</strong> is optional — posts without one get a generated gradient.
          </p>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">Structure that ranks</h2>
          <ol class="mt-2 list-decimal space-y-1 pl-4 leading-relaxed text-muted">
            <li>Open with the problem in one paragraph.</li>
            <li><code class="rounded bg-[var(--bg)] px-1 font-mono">##</code> headings as real questions.</li>
            <li>Answer in the first two sentences, then explain.</li>
            <li>Tables for comparisons.</li>
            <li>End with a <strong>Key takeaways</strong> list.</li>
          </ol>
          <p class="mt-2 text-xs text-muted">The <strong>Highlight</strong> field is your TL;DR — don't repeat it in the body.</p>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">Frontmatter limits</h2>
          <ul class="mt-2 space-y-1 leading-relaxed text-muted">
            <li><strong>Description:</strong> 50–200 characters (required).</li>
            <li><strong>Highlight:</strong> up to 400 characters.</li>
            <li><strong>Category:</strong> one of the six in the dropdown.</li>
            <li><strong>Slug:</strong> lowercase, hyphens — becomes the URL.</li>
            <li><strong>Cover alt</strong> is required if a cover is set.</li>
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider uppercase text-muted">Shortcuts &amp; publishing</h2>
          <ul class="mt-2 space-y-1 leading-relaxed text-muted">
            <li><kbd class="rounded border border-default bg-[var(--bg)] px-1 text-xs">⌘/Ctrl</kbd>+<kbd class="rounded border border-default bg-[var(--bg)] px-1 text-xs">B</kbd> bold, <kbd class="rounded border border-default bg-[var(--bg)] px-1 text-xs">I</kbd> italic, <kbd class="rounded border border-default bg-[var(--bg)] px-1 text-xs">K</kbd> link.</li>
            <li><strong>Tab</strong> indents inside the editor.</li>
            <li>Draft auto-saves to this browser.</li>
            <li><strong>Download</strong> → drop in <code class="rounded bg-[var(--bg)] px-1 font-mono">src/content/blog/</code> → commit → push.</li>
            <li>Uncheck <strong>Draft</strong> when it's ready to go live.</li>
          </ul>
          <p class="mt-2 text-xs">
            <a href="https://github.com/jssuthahar/blog/blob/main/WRITING.md" class="text-accent hover:underline">Full guide → WRITING.md</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ── Metadata (hidden in Focus mode) ────────────────────────────── -->
    <div id="meta-region" class="mt-5">
      <!-- Title + slug -->
      <input id="f-title" placeholder="Post title" maxlength="120"
        class="w-full border-0 bg-transparent px-0 text-3xl font-bold tracking-tight outline-none placeholder:text-muted/50" />
      <div class="mt-1 flex items-center text-sm text-muted">
        <span class="shrink-0 font-mono text-xs">blog.msdevbuild.com/blog/</span>
        <input id="f-slug" placeholder="slug" class="w-full bg-transparent py-1 font-mono text-xs outline-none" />
      </div>

      <!-- Compact meta strip: everything you set on every post, in one row. -->
      <div class="mt-4 flex flex-wrap items-center gap-2.5 border-y border-default py-2.5 text-sm">
        <select id="f-category" aria-label="Primary category"
          class="rounded-lg border border-default bg-[var(--bg)] px-2.5 py-1.5 text-sm">
          {Object.entries(CATEGORIES).map(([id, c]) => <option value={id}>{c.label}</option>)}
        </select>

        <input id="f-date" type="date" value={today} aria-label="Published date"
          class="rounded-lg border border-default bg-[var(--bg)] px-2.5 py-1.5 text-sm" />

        <label class="toggle">
          <input id="f-draft" type="checkbox" checked class="sr-only peer" />
          <span class="dot"></span> Draft
        </label>
        <label class="toggle">
          <input id="f-featured" type="checkbox" class="sr-only peer" />
          <span class="dot"></span> Featured
        </label>

        <span id="stats" class="ml-auto text-xs text-muted tabular-nums"></span>
      </div>

      <!-- SEO essentials: description (required) + highlight. -->
      <div class="mt-4 grid gap-3 lg:grid-cols-2">
        <div>
          <div class="flex items-center justify-between">
            <label for="f-description" class="text-xs font-medium text-muted">Description <span class="text-muted/70">· card, meta &amp; RSS</span></label>
            <span class="text-xs"><span id="desc-count" class="text-muted">0</span> / 200</span>
          </div>
          <textarea id="f-description" rows="2" maxlength="220" placeholder="50–200 characters. The one-line pitch that appears everywhere."
            class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm"></textarea>
        </div>
        <div>
          <label for="f-highlight" class="text-xs font-medium text-muted">Highlight <span class="text-muted/70">· TL;DR box, optional</span></label>
          <textarea id="f-highlight" rows="2" maxlength="400" placeholder="The answer in 2–3 sentences, shown in a box at the top of the post."
            class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm"></textarea>
        </div>
      </div>

      <!-- Tags -->
      <div class="mt-3">
        <label class="text-xs font-medium text-muted">Tags <span class="text-muted/70">— click a suggestion, or type and press ↵</span></label>
        <div id="tag-box" class="mt-1 flex flex-wrap items-center gap-1.5 rounded-lg border border-default bg-[var(--bg)] p-2">
          <span id="tag-chips" class="contents"></span>
          <input id="tag-entry" list="tag-suggestions" placeholder="add a tag…" class="min-w-[8rem] flex-1 bg-transparent px-1 py-0.5 text-sm outline-none" />
        </div>
        <datalist id="tag-suggestions">
          {TAGS.map((t) => <option value={t}></option>)}
        </datalist>
        <div class="mt-2 flex flex-wrap gap-1.5" id="tag-quick">
          {TAGS.slice(0, 18).map((t) => (
            <button type="button" data-quick-tag={t} class="rounded-full border border-default px-2.5 py-1 text-xs text-muted transition-colors hover:bg-subtle hover:text-accent">
              + {t}
            </button>
          ))}
        </div>
        <input id="f-tags" type="hidden" />
      </div>

      <!-- Advanced: everything optional, tucked away so the common path stays quick. -->
      <details class="mt-3 rounded-lg border border-default">
        <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium">
          More — extra categories, series, cover image &amp; FAQ
        </summary>

        <div class="space-y-6 border-t border-default p-4">
          <!-- Extra categories -->
          <fieldset>
            <legend class="text-xs font-bold tracking-wider uppercase text-muted">Also in <span class="font-normal normal-case">(cross-listed categories)</span></legend>
            <div id="f-categories" class="mt-2 flex flex-wrap gap-1.5">
              {Object.entries(CATEGORIES).map(([id, c]) => (
                <label class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-default px-2.5 py-1 text-xs has-[:checked]:border-accent">
                  <input type="checkbox" data-cat={id} class="peer sr-only" />
                  <span class="peer-checked:font-semibold peer-checked:text-accent">{c.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Series -->
          <fieldset>
            <legend class="text-xs font-bold tracking-wider uppercase text-muted">Part of a series</legend>
            <div class="mt-2 grid gap-3 sm:grid-cols-[1fr_8rem]">
              <div>
                <label for="f-series" class="block text-xs text-muted">Series name</label>
                <input id="f-series" list="series-suggestions" placeholder="e.g. minimal-api-production"
                  class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 font-mono text-xs" />
                <datalist id="series-suggestions">
                  {existingSeries.map((s) => <option value={s}></option>)}
                </datalist>
              </div>
              <div>
                <label for="f-seriesOrder" class="block text-xs text-muted">Part number</label>
                <input id="f-seriesOrder" type="number" min="1" step="1" placeholder="1"
                  class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm" />
              </div>
            </div>
            <p class="mt-1.5 text-xs text-muted">
              Give related posts the same series name and increasing part numbers — they'll cross-link automatically.
            </p>
          </fieldset>

          <!-- Cover -->
          <fieldset>
            <legend class="text-xs font-bold tracking-wider uppercase text-muted">Cover image</legend>
            <div class="mt-2 grid gap-3 sm:grid-cols-2">
              <div>
                <label for="f-cover" class="block text-xs text-muted">Path (optional)</label>
                <input id="f-cover" placeholder="./images/cover.png"
                  class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 font-mono text-xs" />
              </div>
              <div>
                <label for="f-coverAlt" class="block text-xs text-muted">Alt text (required if cover set)</label>
                <input id="f-coverAlt" placeholder="Describe the cover image"
                  class="mt-1 w-full rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-sm" />
              </div>
            </div>
          </fieldset>

          <!-- FAQ -->
          <fieldset>
            <div class="flex items-center justify-between">
              <legend class="text-xs font-bold tracking-wider uppercase text-muted">FAQ</legend>
              <button type="button" id="faq-add" class="btn btn-outline btn-sm">+ Add question</button>
            </div>
            <p class="mt-1.5 text-xs text-muted">
              Each pair renders on the page, emits rich-result schema, and answers the article chat.
            </p>
            <div id="faq-list" class="mt-3 space-y-3"></div>
          </fieldset>

          <!-- Updated -->
          <div>
            <label for="f-updated" class="text-xs font-bold tracking-wider uppercase text-muted">Updated date</label>
            <input id="f-updated" type="date" class="ml-3 rounded border border-default bg-[var(--bg)] px-2 py-1 text-sm" />
          </div>
        </div>
      </details>
    </div>

    <!-- ── Workspace: sticky toolbar + editor/preview ─────────────────── -->
    <div id="workspace" class="mt-5">
      <!-- Toolbar sticks below the site header while you scroll the editor. -->
      <div class="sticky top-16 z-10 flex flex-wrap items-center gap-0.5 rounded-t-lg border border-b-0 border-default bg-subtle/95 p-1.5 backdrop-blur">
        {TOOLBAR.map((t) => (
          t.sep
            ? <span class="mx-1 h-5 w-px self-center bg-[var(--border)]" aria-hidden="true"></span>
            : (
              <button
                type="button"
                class="rounded-md px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-[var(--bg)] hover:text-accent"
                data-tool={t.key}
                data-kind={t.kind}
                data-a={t.kind === 'wrap' || t.kind === 'block' ? t.a : undefined}
                data-b={t.kind === 'wrap' ? t.b : undefined}
                data-snippet={t.kind === 'insert' ? t.snippet : undefined}
                title={t.title}
              >
                <span class={t.cls}>{t.label}</span>
              </button>
            )
        ))}
      </div>

      <!-- Editor + preview -->
      <div id="split" class="grid rounded-b-lg border border-default lg:grid-cols-2">
        <div class="border-b border-default lg:border-b-0 lg:border-r">
          <textarea
            id="editor"
            spellcheck="true"
            placeholder="Write in Markdown. Open with the problem, use ## question headings, answer first, end with Key takeaways."
            class="editor-area block w-full resize-none bg-[var(--bg)] p-5 font-mono leading-relaxed focus:outline-none"
          ></textarea>
        </div>
        <div id="preview-pane" class="overflow-auto">
          <div class="sticky top-0 flex items-center justify-between border-b border-default bg-subtle px-4 py-1.5 text-xs text-muted">
            <span>Preview</span>
          </div>
          <article id="preview" class="prose-reading max-w-none p-5"></article>
        </div>
      </div>
    </div>

    <!-- Validation + generated file -->
    <div id="issues" class="mt-4"></div>

    <details class="mt-4 rounded-lg border border-default">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Generated file</summary>
      <pre id="filecode" class="overflow-auto border-t border-default bg-subtle p-4 font-mono text-xs whitespace-pre-wrap"></pre>
    </details>

    <p class="mt-6 text-sm leading-relaxed text-muted">
      <strong>To publish:</strong> Download the file, put it in
      <code>src/content/blog/</code> (images go in
      <code>src/content/blog/images/</code>), then commit and push. GitHub Actions
      deploys it. Set <strong>Draft</strong> off when it's ready. Full reference:
      <a href="https://github.com/jssuthahar/blog/blob/main/WRITING.md" class="text-accent hover:underline">WRITING.md</a>.
    </p>
  </div>
</BaseLayout>

<style>
  /* Segmented view switcher. */
  .seg {
    border-radius: 0.4rem;
    padding: 0.2rem 0.7rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: background 0.15s, color 0.15s;
  }
  .seg[aria-pressed='true'] {
    background: var(--bg);
    color: var(--accent);
    font-weight: 600;
    box-shadow: 0 1px 2px oklch(0 0 0 / 0.06);
  }

  /* Pill toggles for Draft / Featured — checkbox stays, chrome gets nicer. */
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.8rem;
    user-select: none;
  }
  .toggle .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--border);
    transition: background 0.15s;
  }
  .toggle:has(:checked) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .toggle:has(:checked) .dot {
    background: var(--accent);
  }
  .toggle:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Comfortable writing surface. */
  .editor-area {
    height: 62vh;
    font-size: 0.95rem;
  }

  /* Focus mode: hide everything but the words. */
  #composer.is-focus #meta-region,
  #composer.is-focus #preview-pane {
    display: none;
  }
  #composer.is-focus #split {
    grid-template-columns: 1fr;
  }
  #composer.is-focus .editor-area {
    height: 78vh;
    font-size: 1rem;
  }
  /* A calmer reading measure for the prose while drafting in Focus mode. */
  #composer.is-focus #editor {
    max-width: 52rem;
    margin: 0 auto;
  }
</style>

<script>
  import { marked } from 'marked';
  import {
    emptyDraft, slugify, toMarkdown, validate, readingStats, type PostDraft,
  } from '../lib/postdoc';

  function initWriter() {
    const editor = document.getElementById('editor') as HTMLTextAreaElement | null;
    if (!editor) return;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const field = (id: string) => $(id) as HTMLInputElement;
    const DRAFT_KEY = 'writer:draft';
    const GUIDE_KEY = 'writer:guide';
    const VIEW_KEY = 'writer:view';

    let mdx = false;

    // Guide panel — remembers whether it was left open.
    const guide = $('guide');
    const guideBtn = $('btn-guide');
    const setGuide = (open: boolean) => {
      guide.hidden = !open;
      guideBtn.setAttribute('aria-expanded', String(open));
      localStorage.setItem(GUIDE_KEY, open ? '1' : '0');
    };
    setGuide(localStorage.getItem(GUIDE_KEY) === '1');
    guideBtn.addEventListener('click', () => setGuide(guide.hidden));

    // View switcher — Split (editor + preview) vs Focus (editor only).
    const composer = $('composer');
    const splitBtn = $('view-split');
    const focusBtn = $('view-focus');
    const setView = (view: 'split' | 'focus') => {
      const focus = view === 'focus';
      composer.classList.toggle('is-focus', focus);
      splitBtn.setAttribute('aria-pressed', String(!focus));
      focusBtn.setAttribute('aria-pressed', String(focus));
      localStorage.setItem(VIEW_KEY, view);
    };
    splitBtn.addEventListener('click', () => setView('split'));
    focusBtn.addEventListener('click', () => setView('focus'));
    setView(localStorage.getItem(VIEW_KEY) === 'focus' ? 'focus' : 'split');

    // FAQ rows live in the DOM; read/write them alongside the flat fields.
    const faqList = $('faq-list');

    const readFaq = () =>
      [...faqList.querySelectorAll('[data-faq-row]')].map((row) => ({
        q: (row.querySelector('[data-faq-q]') as HTMLInputElement).value,
        a: (row.querySelector('[data-faq-a]') as HTMLTextAreaElement).value,
      }));

    function addFaqRow(q = '', a = '') {
      const row = document.createElement('div');
      row.dataset.faqRow = '';
      row.className = 'rounded-lg border border-default p-3';
      row.innerHTML = `
        <div class="flex items-start gap-2">
          <div class="flex-1 space-y-2">
            <input data-faq-q placeholder="Question" class="w-full rounded-md border border-default bg-[var(--bg)] px-3 py-1.5 text-sm" />
            <textarea data-faq-a rows="2" placeholder="Answer" class="w-full rounded-md border border-default bg-[var(--bg)] px-3 py-1.5 text-sm"></textarea>
          </div>
          <button type="button" data-faq-del aria-label="Remove" class="rounded-md p-1.5 text-muted hover:bg-subtle">✕</button>
        </div>`;
      (row.querySelector('[data-faq-q]') as HTMLInputElement).value = q;
      (row.querySelector('[data-faq-a]') as HTMLTextAreaElement).value = a;
      // Lazy arrow: `render` is declared later, so referencing it directly here
      // would hit the temporal dead zone during draft restore.
      row.querySelectorAll('input, textarea').forEach((el) => el.addEventListener('input', () => render()));
      row.querySelector('[data-faq-del]')!.addEventListener('click', () => { row.remove(); render(); });
      faqList.appendChild(row);
    }

    $('faq-add').addEventListener('click', () => { addFaqRow(); render(); });

    // ---- extra categories (checkboxes) ----------------------------------
    const catBoxes = () => [...document.querySelectorAll<HTMLInputElement>('#f-categories [data-cat]')];
    const readCategories = () => catBoxes().filter((b) => b.checked).map((b) => b.dataset.cat).join(', ');
    const writeCategories = (csv: string) => {
      const set = new Set(csv.split(',').map((s) => s.trim()));
      catBoxes().forEach((b) => (b.checked = set.has(b.dataset.cat!)));
    };
    catBoxes().forEach((b) => b.addEventListener('change', () => render()));

    // ---- tags (chip picker: existing + new) -----------------------------
    const tagChips = $('tag-chips');
    const tagEntry = $('tag-entry') as HTMLInputElement;
    let tags: string[] = [];

    const renderTags = () => {
      field('f-tags').value = tags.join(', ');
      tagChips.innerHTML = tags
        .map((t, i) =>
          `<span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs" style="background:var(--accent-soft);color:var(--accent)">${t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!))}<button type="button" data-tag-del="${i}" aria-label="Remove ${t}" class="hover:opacity-70">✕</button></span>`,
        )
        .join('');
    };
    const addTag = (raw: string) => {
      const t = raw.trim().replace(/,$/, '');
      if (t && !tags.some((x) => x.toLowerCase() === t.toLowerCase())) { tags.push(t); renderTags(); render(); }
    };
    tagChips.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest<HTMLElement>('[data-tag-del]');
      if (del) { tags.splice(Number(del.dataset.tagDel), 1); renderTags(); render(); }
    });
    tagEntry.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(tagEntry.value); tagEntry.value = ''; }
      else if (e.key === 'Backspace' && !tagEntry.value && tags.length) { tags.pop(); renderTags(); render(); }
    });
    tagEntry.addEventListener('change', () => { if (tagEntry.value) { addTag(tagEntry.value); tagEntry.value = ''; } });
    document.querySelectorAll<HTMLElement>('[data-quick-tag]').forEach((b) =>
      b.addEventListener('click', () => addTag(b.dataset.quickTag!)),
    );

    const readForm = (): PostDraft => ({
      slug: field('f-slug').value,
      title: field('f-title').value,
      description: field('f-description').value,
      highlight: field('f-highlight').value,
      category: field('f-category').value,
      categories: readCategories(),
      tags: field('f-tags').value,
      publishedAt: field('f-date').value,
      updatedAt: field('f-updated').value,
      draft: field('f-draft').checked,
      featured: field('f-featured').checked,
      cover: field('f-cover').value,
      coverAlt: field('f-coverAlt').value,
      series: field('f-series').value,
      seriesOrder: field('f-seriesOrder').value,
      faq: readFaq(),
      body: editor.value,
    });

    const writeForm = (d: PostDraft) => {
      field('f-slug').value = d.slug;
      field('f-title').value = d.title;
      field('f-description').value = d.description;
      field('f-highlight').value = d.highlight;
      field('f-category').value = d.category;
      writeCategories(d.categories ?? '');
      tags = (d.tags ?? '').split(',').map((t) => t.trim()).filter(Boolean);
      renderTags();
      field('f-date').value = d.publishedAt;
      field('f-updated').value = d.updatedAt;
      field('f-draft').checked = d.draft;
      field('f-featured').checked = d.featured;
      field('f-cover').value = d.cover;
      field('f-coverAlt').value = d.coverAlt;
      field('f-series').value = d.series ?? '';
      field('f-seriesOrder').value = d.seriesOrder ?? '';
      faqList.replaceChildren();
      (d.faq ?? []).forEach((f) => addFaqRow(f.q, f.a));
      editor.value = d.body;
    };

    // ---- restore last session -------------------------------------------
    try {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (saved) writeForm({ ...emptyDraft(), ...JSON.parse(saved) });
    } catch {}

    // ---- render loop ----------------------------------------------------
    let saveTimer: number | undefined;

    const render = () => {
      const d = readForm();

      // Preview: highlight box on top, then the rendered body.
      const hl = (d.highlight || d.description)
        ? `<aside style="border-left:3px solid var(--accent);background:var(--bg-subtle);padding:1rem 1.25rem;border-radius:.5rem;margin-bottom:1.5rem"><p style="font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)">Highlight</p><p style="margin-top:.4rem">${d.highlight || d.description}</p></aside>`
        : '';
      // Strip the two MDX component tags so the preview does not show raw JSX.
      const bodyForPreview = d.body
        .replace(/<(Callout|YouTube)[^>]*>/g, '')
        .replace(/<\/(Callout|YouTube)>/g, '');
      $('preview').innerHTML = hl + marked.parse(bodyForPreview, { async: false });

      const { words, minutes } = readingStats(d.body);
      $('stats').textContent = `${words} words · ${minutes} min read`;
      $('desc-count').textContent = String(d.description.trim().length);

      $('filecode').textContent = toMarkdown(d);

      const issues = validate(d);
      $('issues').innerHTML = issues.length
        ? `<div class="rounded-lg border p-4 text-sm" style="border-color:oklch(0.6 0.16 60 / .4);background:oklch(0.6 0.16 60 / .06)"><p class="font-semibold">Before publishing:</p><ul class="mt-2 list-disc space-y-1 pl-5 text-muted">${issues.map((i) => `<li>${i.message}</li>`).join('')}</ul></div>`
        : '<p class="text-sm" style="color:oklch(0.55 0.15 155)">✓ Ready to publish.</p>';

      clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
        $('autosave').textContent = 'Saved locally';
        setTimeout(() => ($('autosave').textContent = ''), 1500);
      }, 500);
    };

    document.querySelectorAll('#editor, #meta-region input, #meta-region textarea, #meta-region select')
      .forEach((el) => el.addEventListener('input', render));

    // Slug follows the title until edited by hand.
    field('f-title').addEventListener('input', () => {
      if (!field('f-slug').dataset.touched) field('f-slug').value = slugify(field('f-title').value);
      render();
    });
    field('f-slug').addEventListener('input', () => { field('f-slug').dataset.touched = ''; });

    // ---- toolbar --------------------------------------------------------
    const apply = (kind: string, a = '', b = '', snippet = '') => {
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      const value = editor.value;
      const sel = value.slice(start, end);

      let replacement = '';
      let caret = start;

      if (kind === 'wrap') {
        replacement = a + sel + b;
        caret = start + a.length + sel.length + (sel ? b.length : 0);
      } else if (kind === 'block') {
        const lines = (sel || value.slice(value.lastIndexOf('\n', start - 1) + 1, end) || '').split('\n');
        replacement = lines.map((l) => a + l).join('\n');
        caret = start + replacement.length;
      } else if (kind === 'link') {
        const url = prompt('Link URL:', 'https://');
        if (url === null) return;
        replacement = `[${sel || 'text'}](${url})`;
        caret = start + replacement.length;
      } else if (kind === 'insert') {
        replacement = snippet.replace('{sel}', sel);
        caret = start + replacement.length;
      }

      editor.setRangeText(replacement, start, end, 'end');
      editor.selectionStart = editor.selectionEnd = caret;
      editor.focus();

      // MDX-only snippets flip the file type so the imports are valid.
      if ((snippet.includes('<Callout') || snippet.includes('<YouTube')) && !mdx) toggleMdx(true);
      render();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-tool]').forEach((btn) => {
      btn.addEventListener('click', () =>
        apply(btn.dataset.kind!, btn.dataset.a ?? '', btn.dataset.b ?? '', btn.dataset.snippet ?? ''),
      );
    });

    // ---- keyboard shortcuts ---------------------------------------------
    editor.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (mod && e.key === 'b') { e.preventDefault(); apply('wrap', '**', '**'); }
      else if (mod && e.key === 'i') { e.preventDefault(); apply('wrap', '_', '_'); }
      else if (mod && e.key === 'k') { e.preventDefault(); apply('link'); }
      else if (e.key === 'Tab') {
        // Tab indents instead of leaving the textarea — expected in an editor.
        e.preventDefault();
        editor.setRangeText('  ', editor.selectionStart, editor.selectionEnd, 'end');
        render();
      }
    });

    // ---- file type ------------------------------------------------------
    function toggleMdx(on: boolean) {
      mdx = on;
      $('btn-mdx').textContent = mdx ? '.mdx' : '.md';
    }
    $('btn-mdx').addEventListener('click', () => toggleMdx(!mdx));

    const filename = () => `${field('f-slug').value || 'untitled'}.${mdx ? 'mdx' : 'md'}`;

    // The imports MDX needs, prepended only on download of an .mdx file.
    const withImports = (md: string) => {
      if (!mdx) return md;
      const needs = [
        md.includes('<Callout') && "import Callout from '../../components/mdx/Callout.astro';",
        md.includes('<YouTube') && "import YouTube from '../../components/mdx/YouTube.astro';",
      ].filter(Boolean);
      if (!needs.length) return md;
      // Insert imports right after the closing frontmatter fence.
      const end = md.indexOf('\n---', 3) + 4;
      return md.slice(0, end) + '\n' + needs.join('\n') + '\n' + md.slice(end);
    };

    // ---- actions --------------------------------------------------------
    $('btn-download').addEventListener('click', () => {
      const md = withImports(toMarkdown(readForm()));
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([md], { type: 'text/markdown' }));
      a.download = filename();
      a.click();
      URL.revokeObjectURL(a.href);
    });

    $('btn-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(withImports(toMarkdown(readForm())));
      $('autosave').textContent = 'Copied';
      setTimeout(() => ($('autosave').textContent = ''), 1500);
    });

    $('btn-clear').addEventListener('click', () => {
      if (!confirm('Start a new post? The current draft is saved locally but the fields will clear.')) return;
      localStorage.removeItem(DRAFT_KEY);
      writeForm(emptyDraft());
      field('f-slug').removeAttribute('data-touched');
      render();
    });

    render();
  }

  initWriter();
  document.addEventListener('astro:page-load', initWriter);
</script>
