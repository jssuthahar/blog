<mxfile host="app.diagrams.net"><diagram name="Conversation cost" id="Conversationcost"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="16" width="488" height="438" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;1. Turn 1&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Your question, plus the files you attached. Small.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="40" width="440" height="62" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. Turn 5&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Everything from turn 1, re-sent, plus four more exchanges.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="132" width="440" height="62" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. Turn 20&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The whole thread again. You are paying for turn 1 for the twentieth time.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="224" width="440" height="62" as="geometry"/></mxCell><mxCell id="te0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fix" value="Start a new chat at the natural boundary" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="155" y="342" width="350" height="48" as="geometry"/></mxCell><mxCell id="fx" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t3" target="fix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="The largest saving is not a shorter prompt. It is a shorter conversation." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="120" y="408" width="420" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>