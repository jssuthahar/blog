s="geometry"><mxPoint x="210" y="451" as="sourcePoint"/><mxPoint x="280" y="451" as="targetPoint"/></mxGeometry></mxCell><mxCell id="spine" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="92" as="sourcePoint"/><mxPoint x="210" y="451" as="targetPoint"/><Array as="points"><mxPoint x="210" y="92"/></Array></mxGeometry></mxCell><mxCell id="aside" value="And when none of that is needed: an Azure OpenAI resource on its own is still the right answer,&lt;br&gt;and costs you less to reason about." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="680" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>