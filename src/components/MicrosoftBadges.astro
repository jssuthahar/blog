---
import { MICROSOFT_ACHIEVEMENTS } from '../config';

interface Props {
  /** `full` = titled card grid (about); `compact` = dense band (home). */
  variant?: 'full' | 'compact';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;

/**
 * Metallic tier tokens. Deliberately hard-coded rather than theme variables:
 * a physical medal reads the same silver/bronze/blue in light and dark, so the
 * badge stays recognisable while the surrounding card follows the theme.
 */
const TIER = {
  Certified: { from: '#3f7bf0', to: '#1b3a8f', ring: '#1b3a8f', ink: '#1b3a8f' },
  Silver: { from: '#e2e6eb', to: '#9aa1ab', ring: '#828a95', ink: '#5b626c' },
  Bronze: { from: '#e6a86b', to: '#a5672a', ring: '#95591f', ink: '#8a5220' },
} as const;

/** 24×24 stroke glyphs, drawn on the white inner plate. */
const ICONS: Record<string, string> = {
  educator:
    '<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.4V15c0 1.1 2.7 2.4 6 2.4s6-1.3 6-2.4v-4.6"/><path d="M22 8v5"/>',
  gallery:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="9" r="1.6"/><path d="m21 15-5-5L5 21"/>',
  wiki: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="m8.5 12 2.4 2.4 4.6-5"/>',
  blog: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M8 8h5M8 12h4"/><path d="M18.6 3.4a1.7 1.7 0 0 1 2.4 2.4L16 11l-3 .8.8-3 4.8-5.2Z"/>',
};

const size = variant === 'compact' ? 46 : 60;
---

<section
  id="microsoft-recognition"
  class:list={['scroll-mt-20', className]}
  aria-labelledby="ms-recognition-heading"
>
  {
    variant === 'full' ? (
      <>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <p class="eyebrow">Recognition</p>
            <h2 id="ms-recognition-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
              Microsoft achievements
            </h2>
          </div>
          <p class="text-sm text-muted">Each badge links to its Microsoft Learn record.</p>
        </div>

        <ul class="mt-6 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-default bg-[var(--border)] sm:grid-cols-2">
          {MICROSOFT_ACHIEVEMENTS.map((a, i) => {
            const t = TIER[a.tier];
            return (
              <li>
                <a
                  href={a.url}
                  target="_blank"
                  rel="noopener"
                  class="group flex h-full items-center gap-4 bg-[var(--bg)] p-5 transition-colors hover:bg-subtle"
                >
                  <svg
                    class="shrink-0"
                    width={size}
                    height={size}
                    viewBox="0 0 100 100"
                    role="img"
                    aria-hidden="true"
                  >
                    <defs>
                      <linearGradient id={`ms-medal-${variant}-${i}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color={t.from} />
                        <stop offset="1" stop-color={t.to} />
                      </linearGradient>
                    </defs>
                    <path
                      d="M30 5h40l24 42-24 42H30L6 47Z"
                      fill={`url(#ms-medal-${variant}-${i})`}
                      stroke={t.ring}
                      stroke-width="3"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M33 20h34l19 30-19 30H33L14 50Z"
                      fill="#fff"
                      opacity="0.96"
                    />
                    <svg x="34" y="34" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke={t.ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[a.icon]} />
                  </svg>

                  <div class="min-w-0">
                    <p class="text-xs font-semibold tracking-wide uppercase" style={`color: ${t.ink};`}>
                      {a.tier} · Microsoft
                    </p>
                    <h3 class="mt-1 leading-snug font-semibold tracking-tight group-hover:text-accent">
                      {a.name}
                    </h3>
                    <span class="mt-1.5 inline-flex items-center gap-1 text-xs text-muted">
                      Verify on Microsoft Learn
                      <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </>
    ) : (
      <>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="ms-recognition-heading" class="text-sm font-semibold tracking-wider uppercase text-muted">
            Microsoft recognition
          </h2>
          <a href="/about#microsoft-recognition" class="text-sm font-semibold text-accent hover:underline">
            About the awards →
          </a>
        </div>

        <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {MICROSOFT_ACHIEVEMENTS.map((a, i) => {
            const t = TIER[a.tier];
            return (
              <li>
                <a
                  href={a.url}
                  target="_blank"
                  rel="noopener"
                  class="group flex h-full flex-col items-center gap-2 rounded-xl border border-default bg-[var(--bg)] p-4 text-center transition-colors hover:border-[var(--accent)]"
                  title={`${a.name} — verify on Microsoft Learn`}
                >
                  <svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-hidden="true">
                    <defs>
                      <linearGradient id={`ms-medal-${variant}-${i}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color={t.from} />
                        <stop offset="1" stop-color={t.to} />
                      </linearGradient>
                    </defs>
                    <path
                      d="M30 5h40l24 42-24 42H30L6 47Z"
                      fill={`url(#ms-medal-${variant}-${i})`}
                      stroke={t.ring}
                      stroke-width="3"
                      stroke-linejoin="round"
                    />
                    <path d="M33 20h34l19 30-19 30H33L14 50Z" fill="#fff" opacity="0.96" />
                    <svg x="34" y="34" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke={t.ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[a.icon]} />
                  </svg>

                  <span class="text-[0.7rem] font-semibold tracking-wide uppercase" style={`color: ${t.ink};`}>
                    {a.tier}
                  </span>
                  <span class="text-xs leading-snug font-medium group-hover:text-accent">
                    {a.short}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</section>
