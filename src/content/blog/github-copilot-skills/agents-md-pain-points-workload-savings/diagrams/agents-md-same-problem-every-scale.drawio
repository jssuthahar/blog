<mxfile host="app.diagrams.net"><diagram name="Every scale" id="Everyscale"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="41" y="6" width="778" height="364" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;An AI agent writes code without shared context&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The same problem, at every scale&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="260" y="30" width="340" height="62" as="geometry"/></mxCell><mxCell id="br0" value="&lt;b&gt;A solo developer&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Session two does not remember session one&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="65" y="152" width="230" height="70" as="geometry"/></mxCell><mxCell id="hb0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="hub" target="br0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="br1" value="&lt;b&gt;A small team&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Two people, two conventions, one repo&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="315" y="152" width="230" height="70" as="geometry"/></mxCell><mxCell id="hb1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="hub" target="br1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="br2" value="&lt;b&gt;An enterprise&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Every squad re-explains the same architecture&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="565" y="152" width="230" height="70" as="geometry"/></mxCell><mxCell id="hb2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="hub" target="br2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;AGENTS.md - written once, read by every agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Not a longer file. A more specific one.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="240" y="288" width="380" height="58" as="geometry"/></mxCell><mxCell id="jr0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="br0" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="jr1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="br1" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="jr2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="br2" target="res"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>