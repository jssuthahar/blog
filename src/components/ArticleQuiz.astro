---
/**
 * The "Test yourself" quiz at the end of an article.
 *
 * Five multiple-choice questions from the post's `quiz` frontmatter. The reader
 * answers, presses one Submit button and gets the score in a dialog; closing it
 * reveals the right answer and the explanation under every question. Each
 * question carries the certification exam whose skills outline covers it, so a
 * reader preparing for AZ-305 or GH-300 knows which questions are on topic.
 *
 * Everything is rendered server side; the script only toggles state, so the
 * questions are still readable (and indexable) without JavaScript.
 */
interface Question {
  q: string;
  options: string[];
  answer: 'A' | 'B' | 'C' | 'D';
  explain: string;
  exam: string;
  skill: string;
}

interface Props {
  quiz: Question[];
}

const { quiz } = Astro.props;
const LETTERS = ['A', 'B', 'C', 'D'] as const;
const exams = [...new Set(quiz.map((q) => q.exam))];
---

<section class="quiz mx-auto mt-14 max-w-[68ch]" aria-labelledby="quiz-heading" data-quiz>
  <p class="quiz-eyebrow">Test yourself · {quiz.length} questions</p>
  <h2 id="quiz-heading" class="text-2xl font-semibold tracking-tight">Check what you learned</h2>
  <p class="mt-2 text-sm text-muted">
    Answer the questions, then submit to see your score and the explanations. Each question is tagged with the
    certification exam that covers the skill:
    {exams.join(', ')}.
  </p>

  <ol class="mt-6 space-y-5">
    {quiz.map((item, i) => (
      <li class="quiz-card" data-question data-answer={item.answer}>
        <p class="quiz-exam">
          <span class="quiz-code">{item.exam}</span>
          <span>{item.skill}</span>
        </p>
        <fieldset>
          <legend class="font-semibold leading-snug">
            <span class="text-muted">{i + 1}.</span> {item.q}
          </legend>
          <div class="mt-3 space-y-2">
            {item.options.map((option, j) => (
              <label class="quiz-option" data-option={LETTERS[j]}>
                <input type="radio" name={`quiz-${i}`} value={LETTERS[j]} />
                <span class="quiz-letter">{LETTERS[j]}</span>
                <span>{option}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="quiz-feedback" data-feedback hidden>
          <p class="font-semibold" data-verdict></p>
          <p class="mt-1">{item.explain}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <button type="button" class="btn btn-primary" data-submit>Submit answers</button>
    <span class="text-sm text-muted" data-progress>0 of {quiz.length} answered</span>
  </div>
  <p class="quiz-score" data-score hidden></p>

  <dialog class="quiz-dialog" data-dialog aria-labelledby="quiz-dialog-title">
    <p class="quiz-eyebrow">Your result</p>
    <p id="quiz-dialog-title" class="quiz-dialog-score" data-dialog-score></p>
    <p class="mt-2 text-muted" data-dialog-message></p>
    <form method="dialog" class="mt-5">
      <button class="btn btn-primary">See answers and explanations</button>
    </form>
  </dialog>

  <p class="mt-3 text-xs text-muted">
    These are practice questions written from this article, not questions taken from a real exam. Exam tags follow
    the skills listed in each exam's official study guide on Microsoft Learn.
  </p>
</section>

<style>
  /* Clears the sticky header when the reveal scrolls back to the top. */
  .quiz {
    scroll-margin-top: 9rem;
  }

  .quiz-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .quiz-card {
    border-radius: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--glass-line);
    border-left: 3px solid var(--accent);
    background: var(--glass);
    box-shadow: var(--glass-shadow);
  }

  .quiz-exam {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .quiz-code {
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--glass-line);
    border-radius: 0.5rem;
    cursor: pointer;
    line-height: 1.45;
    transition: background-color 0.15s;
  }

  .quiz-option:hover {
    background: var(--accent-soft);
  }

  .quiz-option input {
    margin-top: 0.2rem;
    accent-color: var(--accent);
  }

  .quiz-letter {
    font-weight: 700;
    min-width: 1ch;
  }

  .quiz-option[data-state='correct'] {
    border-color: oklch(0.6 0.15 150);
    background: oklch(0.6 0.15 150 / 0.12);
  }

  .quiz-option[data-state='wrong'] {
    border-color: oklch(0.6 0.18 25);
    background: oklch(0.6 0.18 25 / 0.1);
  }

  .quiz-feedback {
    margin-top: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--accent-soft);
    line-height: 1.6;
  }

  .quiz-feedback[data-result='correct'] [data-verdict] {
    color: oklch(0.5 0.15 150);
  }

  .quiz-feedback[data-result='wrong'] [data-verdict] {
    color: oklch(0.52 0.18 25);
  }

  .quiz-score {
    margin-top: 1.25rem;
    font-weight: 600;
  }

  .quiz-dialog {
    width: min(26rem, calc(100vw - 2rem));
    margin: auto;
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid var(--glass-line);
    background: var(--bg);
    color: inherit;
    box-shadow: var(--glass-shadow);
    text-align: center;
  }

  .quiz-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .quiz-dialog-score {
    margin-top: 0.5rem;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
  }

  :global([data-theme='dark']) .quiz-feedback[data-result='correct'] [data-verdict] {
    color: oklch(0.78 0.14 150);
  }

  :global([data-theme='dark']) .quiz-feedback[data-result='wrong'] [data-verdict] {
    color: oklch(0.78 0.14 25);
  }
</style>

<script is:inline>
  (() => {
    function run() {
      const root = document.querySelector('[data-quiz]');
      if (!root || root.dataset.ready === '') return;
      root.dataset.ready = '';

      const cards = [...root.querySelectorAll('[data-question]')];
      const submit = root.querySelector('[data-submit]');
      const progress = root.querySelector('[data-progress]');
      const scoreEl = root.querySelector('[data-score]');
      const dialog = root.querySelector('[data-dialog]');
      const picked = (card) => card.querySelector('input[type="radio"]:checked');

      const updateProgress = () => {
        const n = cards.filter(picked).length;
        progress.textContent = `${n} of ${cards.length} answered`;
      };
      root.addEventListener('change', updateProgress);

      // Marks every question once the score dialog is closed.
      function reveal() {
        cards.forEach((card) => {
          const answer = card.dataset.answer;
          const choice = picked(card)?.value;
          const right = choice === answer;
          const answerText = card.querySelector(`[data-option="${answer}"] span:last-child`).textContent;

          card.querySelector(`[data-option="${answer}"]`).dataset.state = 'correct';
          if (choice && !right) card.querySelector(`[data-option="${choice}"]`).dataset.state = 'wrong';

          const feedback = card.querySelector('[data-feedback]');
          feedback.dataset.result = right ? 'correct' : 'wrong';
          feedback.querySelector('[data-verdict]').textContent = right
            ? `Correct: ${answer}. ${answerText}`
            : choice
              ? `Not quite. You picked ${choice}; the correct answer is ${answer}. ${answerText}`
              : `Not answered. The correct answer is ${answer}. ${answerText}`;
          feedback.hidden = false;
        });
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      submit.addEventListener('click', () => {
        const unanswered = cards.length - cards.filter(picked).length;
        if (unanswered && !confirm(`${unanswered} question${unanswered > 1 ? 's are' : ' is'} unanswered. Submit anyway?`)) return;

        const correct = cards.filter((c) => picked(c)?.value === c.dataset.answer).length;
        const message =
          correct === cards.length ? 'Every answer right. You could explain this article to someone else.'
          : correct >= cards.length - 1 ? 'Nearly all right. Check the one you missed below.'
          : correct >= Math.ceil(cards.length / 2) ? 'A good start. The explanations below cover the rest.'
          : 'Worth a second read. The explanations below show where each answer comes from.';

        root.querySelectorAll('input[type="radio"]').forEach((r) => (r.disabled = true));
        submit.hidden = true;
        progress.hidden = true;
        scoreEl.textContent = `You scored ${correct} out of ${cards.length}.`;
        scoreEl.hidden = false;

        dialog.querySelector('[data-dialog-score]').textContent = `${correct} / ${cards.length}`;
        dialog.querySelector('[data-dialog-message]').textContent = message;
        dialog.addEventListener('close', reveal, { once: true });
        dialog.showModal();
      });
    }

    run();
    document.addEventListener('astro:page-load', run);
  })();
</script>
