<mxfile host="app.diagrams.net"><diagram name="Hotel search in plain English" id="HotelsearchinplainEnglish"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="6" width="608" height="664" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;1. A traveller searches &quot;Goa, 14 to 16 October&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;One question, but three suppliers will answer it&lt;br&gt;in three different formats.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="560" height="80" as="geometry"/></mxCell><mxCell id="h1ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="47" width="46" height="46" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;2. Ask every supplier at the same time&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Wait 2.5 seconds at most. A slow supplier just&lt;br&gt;misses this search; nobody waits for it.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="560" height="80" as="geometry"/></mxCell><mxCell id="h2ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgLTk2MCA5NjAgOTYwIiB3aWR0aD0iMjQiPjxwYXRoIGQ9Im00MjItMjMyIDIwNy0yNDhINDY5bDI5LTIyNy0xODUgMjY3aDEzOWwtMzAgMjA4Wk0zMjAtODBsNDAtMjgwSDE2MGwzNjAtNTIwaDgwbC00MCAzMjBoMjQwTDQwMC04MGgtODBabTE1MS0zOTBaIi8+PC9zdmc+;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="157" width="46" height="46" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;3. Each answer goes through that supplier's own translator&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The adapter turns rupees, paise or dollars, per night or&lt;br&gt;per stay, into one shape: the whole stay, taxes in.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="560" height="80" as="geometry"/></mxCell><mxCell id="h3ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="267" width="46" height="46" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;4. Match every hotel to one master ID&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&quot;Sea Breeze Resort&quot; and &quot;Seabreeze Resort and Spa&quot;&lt;br&gt;are one building, so they become one card.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="560" height="80" as="geometry"/></mxCell><mxCell id="h4ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="377" width="46" height="46" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b&gt;5. Sort on one honest, all-in price&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Fees paid at the hotel are added on top, so a&lt;br&gt;cheap-looking price can't hide a big resort fee.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="560" height="80" as="geometry"/></mxCell><mxCell id="h5ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="487" width="46" height="46" as="geometry"/></mxCell><mxCell id="hsum" value="&lt;b&gt;One listing per hotel, prices you can compare.&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;And an answer in 2.5 seconds, even when a supplier is slow.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="560" height="66" as="geometry"/></mxCell><mxCell id="he0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="h5" target="hsum"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>