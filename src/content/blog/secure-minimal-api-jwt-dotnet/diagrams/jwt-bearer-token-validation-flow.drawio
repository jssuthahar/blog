<mxfile host="app.diagrams.net"><diagram name="Token validation" id="Tokenvalidation"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="6" width="738" height="962" as="geometry"/></mxCell><mxCell id="fc_start" value="Request arrives with a bearer token" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="170" y="30" width="260" height="48" as="geometry"/></mxCell><mxCell id="fc0" value="Signature valid?&lt;br&gt;Signed with the key we trust" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="160" y="122" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr0" value="401 Unauthorized" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="146" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn0" value="no" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc0" target="fcr0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc_start" target="fc0"><mxGeometry relative="1" as="geom