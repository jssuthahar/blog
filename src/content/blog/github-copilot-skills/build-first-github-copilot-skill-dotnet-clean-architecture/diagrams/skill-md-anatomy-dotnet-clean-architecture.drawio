<mxfile host="app.diagrams.net"><diagram name="SKILL.md anatomy" id="SKILL.mdanatomy"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="16" width="608" height="576" as="geometry"/></mxCell><mxCell id="sk1" value="&lt;b&gt;1. description: one line&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The activation trigger. Copilot reads this on every task and nothing else until it matches.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="40" width="460" height="62" as="geometry"/></mxCell><mxCell id="sk2" value="&lt;b&gt;2. Purpose, and when NOT to use it&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;A Skill that fires on everything is instructions with extra steps.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="132" width="460" height="62" as="geometry"/></mxCell><mxCell id="sk3" value="&lt;b&gt;3. Inputs the Skill needs&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Project name, layer, the entity being added&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="224" width="460" height="62" as="geometry"/></mxCell><mxCell id="sk4" value="&lt;b&gt;4. Rules - the non-negotiables&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Domain references nothing. No EF types above Infrastructure.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="316" width="460" height="62" as="geometry"/></mxCell><mxCell id="sk5" value="&lt;b&gt;5. The numbered workflow&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The order the files get created in&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="408" width="460" height="62" as="geometry"/></mxCell><mxCell id="ske0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="sk1" target="sk2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ske1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="sk2" target="sk3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ske2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="sk3" target="sk4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ske3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="sk4" target="sk5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Everything below the description only loads once the description has matched.&lt;br&gt;Get that one line wrong and the rest of the file never runs." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="524" width="560" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>