<mxfile host="app.diagrams.net"><diagram name="CDN decision" id="CDNdecision"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="126" y="6" width="728" height="624" as="geometry"/></mxCell><mxCell id="start" value="One response your app serves" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="30" width="300" height="48" as="geometry"/></mxCell><mxCell id="q1" value="Same bytes for every user?&lt;br&gt;no cart, no login, no wallet" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="118" width="300" height="100" as="geometry"/></mxCell><mxCell id="q1d" value="Never on the CDN.&lt;br&gt;private, no-store" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="270" height="56" as="geometry"/></mxCell><mxCell id="q1de" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="q1" target="q1d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1in" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="start" target="q1"><mxGeometry relative="1" as="geometry"/></mx