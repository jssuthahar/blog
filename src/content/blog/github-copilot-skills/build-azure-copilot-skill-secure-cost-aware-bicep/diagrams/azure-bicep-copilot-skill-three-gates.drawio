<mxfile host="app.diagrams.net"><diagram name="Three gates" id="Threegates"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="16" width="668" height="506" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;1. In the editor: the Copilot Skill&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the insecure default is never typed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="40" width="420" height="64" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;2. In CI: Bicep linter and PSRule&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;template rules checked on every build&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="138" width="420" height="64" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;3. At deploy: Azure Policy&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;deny or audit anything that reaches Azure&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="236" width="420" height="64" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;4. After deploy: Resource Graph queries&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;find what slipped through, weekly&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="334" width="420" height="64" as="geometry"/></mxCell><mxCell id="ge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gl" value="earliest, cheapest" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="530" y="60" width="160" height="24" as="geometry"/></mxCell><mxCell id="gr" value="latest, most expensive" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="530" y="352" width="180" height="24" as="geometry"/></mxCell><mxCell id="gok" value="✓ Each gate rarely fires, because the one above it held" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="420" height="48" as="geometry"/></mxCell><mxCell id="ge" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=