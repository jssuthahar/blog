---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../config';
import { getAllTags, getPublishedPosts, postUrl, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags();

  return tags.map(({ slug, label }) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)),
    },
  }));
}

const { posts, label } = Astro.props;
const path = `/tag/${Astro.params.tag}/`;
const description = `All articles tagged ${label} — ${posts.length} in total.`;

// Same CollectionPage + ItemList + BreadcrumbList pattern as `/category`.
// Every tag page was crawlable and in the sitemap already with nothing
// telling a search engine (or an answer engine) what kind of page it is.
const schema: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}${path}#page`,
    name: `Posts tagged ${label}`,
    description,
    about: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: new URL(postUrl(post), SITE.url).href,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Tags', item: `${SITE.url}/tags` },
      { '@type': 'ListItem', position: 3, name: `#${label}`, item: `${SITE.url}${path}` },
    ],
  },
];
---

<BaseLayout
  title={`Posts tagged ${label}`}
  description={description}
  canonical={path}
  schema={schema}
>
  <header class="max-w-2xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/tags/" class="hover:text-accent">Tags</a>
    </nav>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">#{label}</h1>
    <p class="mt-3 text-muted">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
  </header>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <div class="mt-16">
    <Newsletter source="tag" compact />
  </div>
</BaseLayout>
