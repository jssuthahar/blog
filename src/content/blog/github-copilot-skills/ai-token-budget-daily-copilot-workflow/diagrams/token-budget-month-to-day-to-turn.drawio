<mxfile host="app.diagrams.net"><diagram name="Token budget" id="Tokenbudget"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="16" width="548" height="394" as="geometry"/></mxCell><mxCell id="bd1" value="&lt;b&gt;1. 400,000 tokens a month&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The allowance, before you have done anything with it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="40" width="440" height="62" as="geometry"/></mxCell><mxCell id="bd2" value="&lt;b&gt;2. About 19,000 tokens a working day&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Twenty-one days, no weekends, no rollover&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="132" width="440" height="62" as="geometry"/></mxCell><mxCell id="bd3" value="&lt;b&gt;3. Four file-heavy chat turns&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Or roughly one third of a single agent-mode run&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="224" width="440" height="62" as="geometry"/></mxCell><mxCell id="bde0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="bd1" target="bd2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bde1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="bd2" target="bd3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Agent mode is where the month actually goes.&lt;br&gt;Knowing the daily number is what makes the choice between chat and agent a real one." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="342" width="500" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>