---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import TestimonialForm from '../../components/TestimonialForm.astro';
import { SITE } from '../../config';
import { getPublishedPosts } from '../../lib/posts';
import { featuredTestimonials, reviewSchema, testimonialIndex } from '../../lib/testimonials';

const posts = await getPublishedPosts();

// Ten by default; the sync puts featured entries first, so the highlighted
// ones are always the ones that make the cut.
const testimonials = featuredTestimonials(10);
const highlighted = testimonials.filter((t) => t.featured);
const standard = testimonials.filter((t) => !t.featured);

const schema =
  testimonials.length > 0 ? reviewSchema(testimonials, `${SITE.url}/#person`) : [];
---

<BaseLayout
  title="All posts"
  description={`Every article on ${SITE.title} — .NET, C#, Azure, and AI engineering guides.`}
  schema={schema}
>
  <header class="max-w-2xl">
    <h1 class="display text-3xl sm:text-4xl">All posts</h1>
    <p class="mt-3 text-muted">
      {posts.length} {posts.length === 1 ? 'article' : 'articles'} on .NET, Azure, and AI engineering.
    </p>
  </header>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  {testimonials.length > 0 && (
    <section class="mt-20" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 id="testimonials-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
            How these articles helped
          </h2>
        </div>
        <a href="/testimonials" class="btn btn-outline btn-sm">
          {testimonialIndex.count > 10 ? `All ${testimonialIndex.count}` : 'All testimonials'}
        </a>
      </div>

      {highlighted.length > 0 && (
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {highlighted.map((t) => <TestimonialCard testimonial={t} highlight />)}
        </div>
      )}

      {standard.length > 0 && (
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {standard.map((t) => <TestimonialCard testimonial={t} />)}
        </div>
      )}
    </section>
  )}

  <div class="mt-16">
    <TestimonialForm compact />
  </div>
</BaseLayout>
