rules_version = '2';

// View counters only. No auth, no personal data — the rules themselves are
// the entire security boundary, so they must be strict about what a write
// is allowed to change.
service cloud.firestore {
  match /databases/{database}/documents {

    // The admin console signs in with Firebase Auth and moderates through
    // these rules. Replace ADMIN_UID_HERE with the UID from
    // Authentication → Users, and keep ADMIN.uid in src/config.ts in step.
    // Until it is set, no account matches and every admin path stays closed.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'BVDLfgqNvJSZORv2zRitolBU3Cn2';
    }

    match /views/{slug} {
      // Counts are public.
      allow read: if true;

      // A write may only ever set `count`, and only to exactly one more than
      // its current value (or 1 if the document does not exist yet). That
      // makes the worst case "someone scripts extra page views", not
      // "someone writes arbitrary data or zeroes the counter".
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Per-article reactions (like / love / celebrate / insightful).
    //
    // One document per article holds a count per reaction, incremented with a
    // field transform. The rules pin down exactly what a write may do: touch a
    // single reaction from the fixed set, and only by +1. So the worst case is
    // "someone scripts extra reactions", never arbitrary data or a wiped count.
    match /reactions/{slug} {
      function keys() { return ['like', 'love', 'celebrate', 'insightful']; }
      function bumped(k) {
        return (k in request.resource.data)
            && request.resource.data[k] == ((k in resource.data) ? resource.data[k] + 1 : 1);
      }

      allow read: if true;

      // First reaction creates the doc with exactly one key set to 1.
      allow create: if request.resource.data.keys().hasOnly(keys())
                    && request.resource.data.keys().size() == 1
                    && request.resource.data.values().hasOnly([1]);

      // Later reactions increment exactly one allowed key by exactly one.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys())
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && (bumped('like') || bumped('love') || bumped('celebrate') || bumped('insightful'));

      allow delete: if false;
    }

    // Newsletter subscribers.
    //
    // The document ID is the email address, which makes a repeat signup a
    // no-op instead of a duplicate row.
    match /subscribers/{email} {
      // Never publicly readable — a public read here would publish the entire
      // mailing list to anyone who knows the collection name. The signed-in
      // admin may read the list and remove entries.
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    // Server-stamped, so a client cannot backdate a signup.
                    && request.resource.data.createdAt == request.time;
    }

    // Reader testimonials.
    //
    // Moderation lives entirely in these rules: anyone may submit, but only
    // as `pending`, and only `approved` documents are readable. A client
    // cannot approve its own submission, and a query that does not filter to
    // approved is rejected outright rather than returning a filtered set.
    match /testimonials/{id} {
      // Public sees approved only; the admin sees pending and rejected too.
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                         ['message', 'name', 'company', 'role', 'article',
                          'status', 'featured', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.featured == false
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 1500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.company is string
                    && request.resource.data.company.size() <= 100
                    && request.resource.data.role is string
                    && request.resource.data.role.size() <= 100
                    && request.resource.data.article is string
                    && request.resource.data.article.size() <= 300
                    // Server-stamped, so a submission cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // Moderation: the admin may change status and featured, nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'featured'])
                    && request.resource.data.status in ['pending', 'approved', 'rejected'];

      allow delete: if isAdmin();
    }

    // The submitter's email, kept OUT of the testimonial document.
    //
    // Firestore rules cannot hide individual fields: reading an approved
    // testimonial returns every field it holds. Storing the address alongside
    // the quote would therefore publish it to anyone, and it would be baked
    // into the static HTML by the sync. It lives here instead, where nothing
    // can read it, keyed by the testimonial's own id.
    match /testimonialContacts/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.createdAt == request.time;
    }

    // Event registrations.
    //
    // The document ID is `{eventSlug}__{email}`, which makes a repeat sign-up a
    // no-op instead of a duplicate row. The list holds attendee emails, so it
    // is NEVER publicly readable — only the signed-in admin may read or remove
    // entries (and export them). Anyone may create their own registration, but
    // the rules pin down exactly what a registration document may contain.
    match /eventRegistrations/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;

      allow create: if request.resource.data.keys().hasAll(['event', 'eventTitle', 'name', 'email', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['event', 'eventTitle', 'name', 'email', 'org', 'createdAt'])
                    && request.resource.data.event is string
                    && request.resource.data.event.size() >= 1
                    && request.resource.data.event.size() <= 120
                    && request.resource.data.eventTitle is string
                    && request.resource.data.eventTitle.size() <= 200
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && (!('org' in request.resource.data)
                        || (request.resource.data.org is string && request.resource.data.org.size() <= 100))
                    // Server-stamped, so a registration cannot be backdated.
                    && request.resource.data.createdAt == request.time;
    }

    // Contact-form messages.
    //
    // A static site cannot process a POST, so messages are written straight
    // here. They hold the sender's email and message, so the collection is
    // NEVER publicly readable — only the signed-in admin may read, update the
    // status, or delete. Anyone may create a message, but only as `new`, and
    // the rules pin down exactly what it may contain.
    match /contactMessages/{id} {
      allow read, delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 6
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    // Phone is optional; when supplied it must be a short string.
                    && (!('phone' in request.resource.data) ||
                        (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 3000
                    // Server-stamped, so a message cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // The admin may only move the status through the fixed set, nothing else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'read', 'archived'];
    }

    // Public registration tally — a single count per event, no personal data.
    //
    // Mirrors `views`: the count is public so a page can show "N registered"
    // without ever reading the private list above. A write may only ever bump
    // `count` by one, so the worst case is an inflated tally, never PII or a
    // wiped counter.
    match /eventRegistrationCounts/{slug} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // PWA install tally — a single public counter, no personal data.
    //
    // Mirrors `views`: incremented once per device the first time the app is
    // opened as an installed PWA (the only cross-platform install signal, since
    // iOS never fires `appinstalled`). Public so /admin can show the number; a
    // write may only ever bump `count` by one, so the worst case is an inflated
    // tally, never PII or a wiped counter.
    match /appInstalls/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Web Push subscriptions (PWA notifications).
    //
    // The document ID is a SHA-256 of the push endpoint, so re-subscribing from
    // the same browser updates one row instead of piling up duplicates. A
    // subscription is an encryption target, not a secret, but the endpoint can
    // be used to send to that browser — so the list is NEVER publicly readable.
    // Only the signed-in admin (and the sender script, using the admin token)
    // may read it; the sender also prunes dead subscriptions, hence admin
    // delete. Anyone may register their own, but the shape is pinned down.
    match /pushSubscriptions/{id} {
      allow read, delete: if isAdmin();

      allow create, update: if request.resource.data.keys().hasOnly(
                                 ['endpoint', 'p256dh', 'auth', 'ua', 'createdAt'])
                            && request.resource.data.endpoint is string
                            && request.resource.data.endpoint.matches('^https://.*')
                            && request.resource.data.endpoint.size() <= 1000
                            && request.resource.data.p256dh is string
                            && request.resource.data.p256dh.size() <= 200
                            && request.resource.data.auth is string
                            && request.resource.data.auth.size() <= 100
                            && request.resource.data.ua is string
                            && request.resource.data.ua.size() <= 300
                            // Server-stamped, so a subscription cannot be backdated.
                            && request.resource.data.createdAt == request.time;
    }

    // Push notification outbox.
    //
    // The admin composes a notification in /admin, which lands here as
    // `pending`. A scheduled GitHub Action signs in as the admin, reads the
    // pending rows, fans each out to every push subscription with the VAPID
    // private key (which lives only in GitHub Secrets, never in the browser),
    // and marks the row `sent` with delivery counts. Only the admin can touch
    // this collection at all — a visitor cannot queue or read notifications.
    match /pushOutbox/{id} {
      allow read, delete: if isAdmin();

      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['title', 'body', 'url', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 1
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 300
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 300
                    // Server-stamped, so a queued notification cannot be backdated.
                    && request.resource.data.createdAt == request.time;

      // The sender (as admin) records the outcome — status plus counts, nothing
      // that would change what gets sent.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'sentAt', 'delivered', 'pruned', 'failed'])
                    && request.resource.data.status in ['pending', 'sending', 'sent', 'failed'];
    }

    // ---------------------------------------------------------------------
    // Community: reader accounts, appreciations, profiles, badges.
    //
    // Everything below requires a signed-in reader. The article reading
    // experience does not depend on any of it: a signed-out visitor still
    // reads, still reacts through `reactions` above, and touches nothing here.
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A banned reader keeps their account and can still read, but cannot write
    // anything the site would publish. Checked on writes only, so a normal page
    // view never pays for it.
    function notBanned() {
      return !exists(/databases/$(database)/documents/moderation/$(request.auth.uid))
          || get(/databases/$(database)/documents/moderation/$(request.auth.uid)).data.banned != true;
    }

    // Appreciations — the signed-in half of a reaction.
    //
    // The public counters in `reactions` are unchanged and still anonymous.
    // This collection records WHO appreciated WHAT, and only for readers who
    // asked for that by signing in. The document ID is `{uid}__{slug}`, so a
    // second appreciation for the same article is the same document — a
    // duplicate is impossible by construction rather than by convention.
    //
    // `source` separates the two ways a record can appear: 'live' is written at
    // the moment of the click and is trustworthy; 'claimed' is backfilled from
    // localStorage when a returning reader first signs in, and is therefore
    // self-asserted. Badges weigh them differently.
    match /appreciations/{id} {
      // Never public. The profile shows a total, published through `stats`,
      // not this collection — so nobody can enumerate what a reader read.
      allow read: if isSelf(resource.data.uid) || isAdmin();

      allow create: if isSelf(request.resource.data.uid)
                    && notBanned()
                    && id == request.auth.uid + '__' + request.resource.data.slug
                    && request.resource.data.keys().hasOnly(['uid', 'slug', 'type', 'source', 'createdAt'])
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() >= 1
                    && request.resource.data.slug.size() <= 200
                    // The same fixed set the public counters use.
                    && request.resource.data.type in ['like', 'love', 'celebrate', 'insightful']
                    && request.resource.data.source in ['live', 'claimed']
                    // Server-stamped, so an appreciation cannot be backdated to
                    // fake a long history for a badge.
                    && request.resource.data.createdAt == request.time;

      // Nothing about a recorded appreciation is editable — a reader who wants
      // a different reaction deletes and writes again, which keeps `createdAt`
      // honest.
      allow update: if false;
      allow delete: if isSelf(resource.data.uid) || isAdmin();
    }

    // Handle registry — the public username → uid map.
    //
    // The handle IS the document ID, so uniqueness is enforced by Firestore
    // itself: a create against a taken handle fails, and the first claimant
    // wins with no race and no lookup.
    match /handles/{handle} {
      // Public, because /u/?h=<handle> resolves through it for profiles that
      // are newer than the last build.
      allow read: if true;

      allow create: if isSelf(request.resource.data.uid)
                    && notBanned()
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && handle.matches('^[a-z0-9][a-z0-9-]{2,29}$')
                    // Keep the namespace clear of routes and impersonation.
                    && !(handle in ['admin', 'about', 'blog', 'search', 'profile',
                                    'signin', 'settings', 'suthahar', 'msdevbuild', 'support'])
                    && request.resource.data.createdAt == request.time;

      // A handle is never edited in place; releasing it is a delete, which lets
      // someone else claim it afterwards.
      allow update: if false;
      allow delete: if isSelf(resource.data.uid) || isAdmin();
    }

    // Public developer profiles.
    //
    // Only the owner writes this, and only fields that are safe to publish —
    // the email address deliberately lives in `profileContacts` instead,
    // because rules cannot hide a field: a public read returns the whole
    // document, and the nightly sync bakes it into static HTML.
    //
    // `skills` is a comma-separated STRING rather than a list. Rules have no
    // loop, so the elements of a list cannot be length-checked individually —
    // a capped string is the only shape that is fully validatable here. The UI
    // splits it into chips and the sync splits it into JSON-LD `knowsAbout`.
    match /profiles/{uid} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['handle', 'name', 'photo', 'bio', 'skills', 'linkedin',
                  'github', 'visibility', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(
                 ['handle', 'name', 'visibility', 'createdAt', 'updatedAt'])
            && request.resource.data.handle is string
            && request.resource.data.handle.matches('^[a-z0-9][a-z0-9-]{2,29}$')
            // The handle must actually be registered to this uid, so a profile
            // can never advertise a name someone else owns.
            && get(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 80
            && request.resource.data.visibility in ['public', 'private']
            && (!('bio' in request.resource.data)
                || (request.resource.data.bio is string && request.resource.data.bio.size() <= 400))
            && (!('skills' in request.resource.data)
                || (request.resource.data.skills is string && request.resource.data.skills.size() <= 200))
            && (!('photo' in request.resource.data)
                || (request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 500
                    && (request.resource.data.photo == '' || request.resource.data.photo.matches('^https://.*'))))
            && (!('linkedin' in request.resource.data)
                || (request.resource.data.linkedin is string
                    && request.resource.data.linkedin.size() <= 200
                    && (request.resource.data.linkedin == ''
                        || request.resource.data.linkedin.matches('^https://[a-z]*[.]?linkedin[.]com/.*'))))
            && (!('github' in request.resource.data)
                || (request.resource.data.github is string
                    && request.resource.data.github.size() <= 200
                    && (request.resource.data.github == ''
                        || request.resource.data.github.matches('^https://github[.]com/.*'))))
            && request.resource.data.updatedAt == request.time;
      }

      // A profile is published only when its owner asks for it to be. The admin
      // hides an abusive one by setting `hidden` in `moderation`, which the
      // sync honours before anything reaches a built page.
      allow read: if resource.data.visibility == 'public'
                  || isSelf(uid)
                  || isAdmin();

      allow create: if isSelf(uid) && notBanned() && validProfile()
                    && request.resource.data.createdAt == request.time;

      allow update: if isSelf(uid) && notBanned() && validProfile()
                    // Immutable, so an account cannot claim to be older than it is.
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSelf(uid) || isAdmin();
    }

    // The reader's email, kept OUT of the public profile — same split, and for
    // the same reason, as testimonials/testimonialContacts above.
    match /profileContacts/{uid} {
      allow read, delete: if isSelf(uid) || isAdmin();

      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(['email', 'provider', 'updatedAt'])
                            && request.resource.data.email is string
                            && request.resource.data.email.size() <= 254
                            && request.resource.data.provider is string
                            && request.resource.data.provider.size() <= 40
                            && request.resource.data.updatedAt == request.time;
    }

    // Private reading progress, mirrored up from localStorage by /profile.
    //
    // Owner-written, so the numbers here are self-reported — there is no
    // trusted client on a static site. It drives the "articles read" figure and
    // the per-series rings, never a badge that is meant to be defensible.
    match /progress/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create, update: if isSelf(uid)
                            && notBanned()
                            && request.resource.data.keys().hasOnly(['read', 'updatedAt'])
                            && request.resource.data.updatedAt == request.time;

      allow delete: if isSelf(uid) || isAdmin();
    }

    // Published reader stats and badges.
    //
    // Public, because the profile page and the nightly sync both read it — and
    // ADMIN-WRITE-ONLY, because it is the score. The nightly GitHub Action signs
    // in as the admin, recomputes each reader's totals from `appreciations` and
    // `progress`, and writes the result here. A reader cannot award themselves
    // a badge or edit their own count.
    match /stats/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Moderation flags. Nothing client-side ever needs to read these; the rules
    // above check them server-side through exists()/get().
    match /moderation/{uid} {
      allow read, write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
