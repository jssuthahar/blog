ure OpenAI" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="148" y="560" width="54" height="54" as="geometry"/></mxCell><mxCell id="blob" value="Blob Storage" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="263" y="560" width="54" height="54" as="geometry"/></mxCell><mxCell id="srch" value="Azure AI Search" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="378" y="560" width="54" height="54" as="geometry"/></mxCell><mxCell id="datanote" value="✕ The app never calls any of these directly. The crossed&lt;br&gt;path on the left is the one this design deletes." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="117" y="642" width="340" height="32" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS, Authorization: Bearer user token" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="dev" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Managed identity - no key travels on this call" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="api" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gone" value="direct call" style="html=1;rounded=0;strokeColor=#B85450;