---
/**
 * Primary navigation on phones — installed or not.
 *
 * A burger hides every destination behind a tap. The floating bar puts four of
 * them permanently in thumb reach with a "More" sheet of icon tiles behind the
 * fifth, so it replaces the burger outright at phone widths rather than sitting
 * alongside it. Two navigation systems on one screen is the worse outcome.
 *
 * It floats rather than spanning the bottom edge: detached from the edge it
 * reads as a control layered over the page, and the strip of page visible
 * underneath tells the reader there is more to scroll.
 *
 * Visibility is CSS-only at `max-width: 767px`. The one thing that still varies
 * by mode is where Home points — see the two Home tabs below.
 */

interface Item {
  label: string;
  href: string;
  icon: string;
  /** Extra path prefixes that should light this tab up. */
  also?: string[];
}

// Inline paths rather than an icon dependency: five tabs and nine tiles is not
// worth a package, and these ship with the HTML instead of a second request.
const ICONS: Record<string, string> = {
  home: '<path d="M4 10.5 12 3.5l8 7"/><path d="M6.5 9.5V20h11V9.5"/>',
  blog: '<rect x="4.5" y="3.5" width="15" height="17" rx="2.5"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/>',
  series: '<path d="m12 3 8 4.2-8 4.2-8-4.2L12 3Z"/><path d="m4 12 8 4.2 8-4.2"/><path d="m4 16.3 8 4.2 8-4.2"/>',
  articles: '<path d="M5 4.5h5a2 2 0 0 1 2 2V20a2 2 0 0 0-2-2H5Z"/><path d="M19 4.5h-5a2 2 0 0 0-2 2V20a2 2 0 0 1 2-2h5Z"/>',
  more: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.8"/>',
  library: '<path d="M5 4.5h5a2 2 0 0 1 2 2V20a2 2 0 0 0-2-2H5Z"/><path d="M19 4.5h-5a2 2 0 0 0-2 2V20a2 2 0 0 1 2-2h5Z"/><path d="M12 6.5V18"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  events: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  speaking: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11.5a7 7 0 0 0 14 0"/><path d="M12 18.5V21"/>',
  code: '<path d="m9 8-5 4 5 4"/><path d="m15 8 5 4-5 4"/>',
  topics: '<path d="M11.5 3.5H4v7.5l9.5 9.5 7.5-7.5-9.5-9.5Z"/><circle cx="7.6" cy="7.6" r="1.3"/>',
  quote: '<path d="M20 14.5a3.5 3.5 0 0 1-3.5 3.5H8.5L4 21V6.5A3.5 3.5 0 0 1 7.5 3h9A3.5 3.5 0 0 1 20 6.5Z"/>',
  history: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.2 2"/>',
  about: '<circle cx="12" cy="8" r="3.6"/><path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"/>',
  contact: '<rect x="3.5" y="5" width="17" height="14" rx="2.5"/><path d="m4.5 7.5 7.5 5.5 7.5-5.5"/>',
};

// Five tabs is the practical ceiling before targets get too narrow to hit.
// The four destinations a reader uses on a phone: home, finding something,
// what they saved, and who wrote it. Browsing by blog/series/article listing is
// a lean-back activity that belongs in the sheet.
const TABS: Item[] = [
  { label: 'Search', href: '/search/', icon: 'search' },
  { label: 'Library', href: '/history/', icon: 'library' },
  { label: 'Profile', href: '/about/', icon: 'about' },
];

/**
 * Home means two different pages depending on how the site was opened, and a
 * static build cannot know which. So both are rendered and CSS shows one:
 * `/app/` is the installed app's start_url and the reading feed, while `/` is
 * the site's actual home — sending a browser visitor to a noindex app shell
 * because they tapped Home would be wrong.
 */
const HOME: (Item & { mode: 'browser' | 'app' })[] = [
  { label: 'Home', href: '/', icon: 'home', mode: 'browser' },
  { label: 'Home', href: '/app/', icon: 'home', also: ['/'], mode: 'app' },
];

const MORE: Item[] = [
  { label: 'Blog', href: '/blog/', icon: 'blog' },
  { label: 'Series', href: '/series/', icon: 'series' },
  { label: 'Articles', href: '/articles/', icon: 'articles' },
  { label: 'Events', href: '/events/', icon: 'events' },
  { label: 'Speaking', href: '/speaking/', icon: 'speaking' },
  { label: 'Open source', href: '/open-source/', icon: 'code' },
  { label: 'Topics', href: '/topics/', icon: 'topics' },
  { label: 'Testimonials', href: '/testimonials/', icon: 'quote' },
  { label: 'Contact', href: '/contact/', icon: 'contact' },
];

const path = Astro.url.pathname;
const matches = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isActive = (item: Item) => matches(item.href) || (item.also ?? []).some(matches);

// "More" carries the active state when the open page lives inside the sheet,
// so the bar never looks like it has lost the reader's position.
const moreActive = MORE.some(isActive);
---

<nav class="app-tabs" aria-label="Primary">
  {
    HOME.map((item) => (
      <a
        href={item.href}
        class={`app-tab app-tab--${item.mode}`}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        <span class="app-tab__mark">
          <svg
            class="app-tab__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS[item.icon]}
          />
        </span>
        <span class="app-tab__label">{item.label}</span>
      </a>
    ))
  }
  {
    TABS.map((item) => (
      <a href={item.href} class="app-tab" aria-current={isActive(item) ? 'page' : undefined}>
        <span class="app-tab__mark">
          <svg
            class="app-tab__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS[item.icon]}
          />
        </span>
        <span class="app-tab__label">{item.label}</span>
      </a>
    ))
  }

  <button
    type="button"
    id="app-more-toggle"
    class="app-tab"
    aria-expanded="false"
    aria-controls="app-more"
    aria-current={moreActive ? 'page' : undefined}
  >
    <span class="app-tab__mark">
      <svg
        class="app-tab__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={ICONS.more}
      />
    </span>
    <span class="app-tab__label">More</span>
  </button>
</nav>

<!-- Everything the five tabs do not cover, as icon tiles rather than a list. -->
<div id="app-more" class="app-sheet" hidden>
  <div class="app-sheet__scrim" data-close></div>
  <div class="app-sheet__panel" role="dialog" aria-modal="true" aria-label="More">
    <div class="app-sheet__grip" aria-hidden="true"></div>
    <div class="app-sheet__grid">
      {
        MORE.map(({ label, href, icon }) => (
          <a href={href} class="app-tile" aria-current={matches(href) ? 'page' : undefined}>
            <span class="app-tile__badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONS[icon]}
              />
            </span>
            {label}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Desktop keeps the header nav; a bar pinned across a wide viewport reads as
     a broken page rather than an app. Shown at phone widths in the media query
     at the bottom of this block. */
  .app-tabs,
  .app-sheet {
    display: none;
  }

  .app-tabs {
    position: fixed;
    z-index: 55;
    /* Detached on all four sides — the floating part. The bottom offset stacks
       on top of the safe-area inset so the bar clears the iOS home indicator
       instead of sitting under it. */
    left: 0.7rem;
    right: 0.7rem;
    bottom: calc(0.7rem + env(safe-area-inset-bottom));
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: stretch;
    /* Opaque, not blurred. A backdrop-filter over scrolling content is
       recomputed every frame and janks on Chrome — the same reason
       Header.astro stays solid. */
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 1.15rem;
    box-shadow:
      0 12px 28px -10px rgb(0 0 0 / 0.3),
      0 3px 10px -4px rgb(0 0 0 / 0.14);
    /* Keeps the pressed state inside the rounded corners. */
    overflow: hidden;
  }
  /* The shadow that reads as "lifted" on white disappears on a dark page, so
     depth is carried by a brighter rim there instead. */
  :global([data-theme='dark']) .app-tabs {
    border-color: color-mix(in oklch, var(--border) 70%, var(--text) 30%);
    box-shadow: 0 14px 34px -12px rgb(0 0 0 / 0.75);
  }

  .app-tab {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.12rem;
    /* Comfortably over the 44px touch target minimum. */
    min-height: 3.4rem;
    padding: 0.4rem 0.2rem;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* The pill behind the icon. A rounded bar has no top edge to rule, so the
     current tab is still marked twice — colour plus a shape that appears — and
     reads for anyone who cannot separate the accent from the muted grey. */
  .app-tab__mark {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 1.7rem;
    border-radius: 9999px;
    background: transparent;
  }
  .app-tab__icon {
    width: 1.4rem;
    height: 1.4rem;
  }
  .app-tab__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .app-tab[aria-current='page'] {
    color: var(--accent);
  }
  .app-tab[aria-current='page'] .app-tab__mark {
    background: var(--accent-soft);
  }
  .app-tab:active {
    background: var(--bg-subtle);
  }

  /* Only one Home tab is ever shown; see the HOME comment above. Browser is the
     default so the app variant is the one that has to be switched on. */
  .app-tab--app {
    display: none;
  }
  @media (display-mode: standalone), (display-mode: minimal-ui), (display-mode: fullscreen) {
    .app-tab--app {
      display: grid;
    }
    .app-tab--browser {
      display: none;
    }
  }
  :global(html[data-standalone]) .app-tab--app {
    display: grid;
  }
  :global(html[data-standalone]) .app-tab--browser {
    display: none;
  }

  .app-sheet {
    position: fixed;
    inset: 0;
    /* Above the chat launcher and its panel (60/61), below the install
       modal (70) — the sheet's scrim should cover the floating buttons. */
    z-index: 65;
  }
  .app-sheet__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
  }
  .app-sheet__panel {
    position: absolute;
    inset: auto 0 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-radius: 1.1rem 1.1rem 0 0;
    padding: 0.6rem 1rem 1rem;
    /* Clears the bar it opens above, so the last row of tiles is never sitting
       behind it. Derived from the same token rather than a second guess. */
    padding-bottom: calc(0.6rem + var(--app-nav-h));
    box-shadow: 0 -18px 50px -20px rgb(0 0 0 / 0.5);
  }
  .app-sheet__grip {
    width: 2.4rem;
    height: 0.25rem;
    margin: 0 auto 0.9rem;
    border-radius: 9999px;
    background: var(--border);
  }
  .app-sheet__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .app-tile {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 0.85rem 0.35rem;
    border-radius: 0.85rem;
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }
  .app-tile__badge {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.8rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--accent);
  }
  .app-tile__badge svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .app-tile[aria-current='page'] .app-tile__badge {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .app-tile:active {
    background: var(--bg-subtle);
  }

  /* Every phone-width page, installed or not. One rule now: the bar is the
     phone's primary navigation rather than app-mode chrome, so it no longer
     needs to ask how the page was opened. */
  @media (max-width: 767px) {
    .app-tabs {
      display: grid;
    }
    .app-sheet:not([hidden]) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-tab__mark {
      transition: background-color 0.16s ease;
    }
  }
</style>

<style is:global>
  /*
   * Total vertical space the floating bar claims, and the single source of
   * truth for getting out of its way: the bar itself (3.4rem), its gap from the
   * bottom edge (0.7rem), the same gap again above it so content does not stop
   * flush against it, and the safe-area inset.
   *
   * Zero above phone widths, which makes every rule below inert on desktop — so
   * each bottom-fixed element is adjusted once rather than once per mode.
   */
  :root {
    --app-nav-h: 0px;
  }

  @media (max-width: 767px) {
    :root {
      --app-nav-h: calc(4.8rem + env(safe-area-inset-bottom));
    }

    /* The bar carries every destination the burger did — four tabs plus the
       More sheet — so keeping the burger would leave two navigation systems
       competing on one screen. */
    #menu-toggle,
    #mobile-nav {
      display: none !important;
    }
  }

  /* The bar must not cover the end of the page. */
  body {
    padding-bottom: var(--app-nav-h);
  }

  /*
   * Everything else anchored to the bottom of the viewport — the chat launchers
   * and their panels, the reactions rail, the resume prompt, the notifications
   * pill — would otherwise sit on top of the tabs, the chat button landing
   * squarely on "More". Margin rather than `bottom` so each keeps whatever
   * offset and transform it already had.
   */
  .site-fab,
  .site-panel,
  .chat-fab,
  .chat-panel,
  .engagement-rail,
  .pwa-bar,
  [data-resume-prompt] {
    margin-bottom: var(--app-nav-h);
  }

  /* The panels are sized against the viewport, so shortening them by the same
     amount keeps a lifted panel from running off the top of the screen. */
  .site-panel,
  .chat-panel {
    max-height: calc(100dvh - 2rem - var(--app-nav-h));
  }
</style>

<script>
  function initAppTabs() {
    const sheet = document.getElementById('app-more');
    const toggle = document.getElementById('app-more-toggle');
    if (!sheet || !toggle) return;

    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(sheet.hidden));
    sheet.querySelector('[data-close]')?.addEventListener('click', () => setOpen(false));
    // Tapping a tile navigates; close first so a same-page link still dismisses.
    sheet.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sheet.hidden) setOpen(false);
    });
  }

  initAppTabs();
  // View Transitions replace the body, so re-bind against the new elements.
  document.addEventListener('astro:page-load', initAppTabs);
</script>
