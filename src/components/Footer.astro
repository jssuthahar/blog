---
import { SITE, AUTHOR, MAIN_SITE, SOCIAL } from '../config';
import { TOPIC_GROUPS } from '../lib/taxonomy';
import FollowCTA from './FollowCTA.astro';

const year = new Date().getFullYear();

// Follow targets come from SOCIAL so the verbs stay consistent with the CTA.
const elsewhere = [
  ...SOCIAL.map(({ label, action, href }) => ({ label: `${action} on ${label}`, href })),
  { label: 'Testimonials', href: '/testimonials' },
  { label: `Main site — ${MAIN_SITE.label}`, href: MAIN_SITE.url },
  { label: 'Profile', href: 'https://suthahar.msdevbuild.com' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="mt-24 border-t border-default bg-subtle">
  <!-- Site-wide follow ask: present on every page without each page adding it. -->
  <div class="mx-auto max-w-6xl border-b border-default px-4 py-10 sm:px-6">
    <FollowCTA />
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <p class="font-semibold tracking-tight">
        <span class="text-accent">MS</span>DEVBUILD
        <span class="font-normal text-muted">/ blog</span>
      </p>
      <p class="mt-1 text-sm text-muted">{SITE.byline} Jegatheesan</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">{SITE.description}</p>
      <p class="mt-3 text-sm text-muted">
        The main site lives at <a href={MAIN_SITE.url} class="hover:text-accent">{MAIN_SITE.label}</a>.
      </p>
    </div>

    <nav aria-labelledby="footer-topics">
      <h2 id="footer-topics" class="text-sm font-semibold">
        <a href="/topics" class="hover:text-accent">Topics</a>
      </h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {TOPIC_GROUPS.map((g) => (
          <li>
            <a href={`/category/${g.slug}`} class="hover:text-accent">
              <span aria-hidden="true">{g.emoji}</span> {g.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="text-sm font-semibold">Elsewhere</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {elsewhere.map(({ label, href }) => (
          <li><a href={href} class="hover:text-accent" rel="me noopener">{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-default">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>&copy; {year} {AUTHOR.name}. All rights reserved.</p>
      <p class="flex gap-4">
        <a href="/privacy" class="hover:text-accent">Privacy</a>
        <a href="/llms.txt" class="hover:text-accent">llms.txt</a>
        <a href="/rss.xml" class="hover:text-accent">RSS</a>
        <a href="/sitemap-index.xml" class="hover:text-accent">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
