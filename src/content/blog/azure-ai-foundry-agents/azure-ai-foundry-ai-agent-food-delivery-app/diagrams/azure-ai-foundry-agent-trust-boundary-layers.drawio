<mxfile host="app.diagrams.net"><diagram name="Trust boundary" id="Trustboundary"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="-4" y="6" width="688" height="594" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Flutter app - customer, partner, rider&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;HTTPS, carrying a Firebase ID token&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="30" width="380" height="58" as="geometry"/></mxCell><mxCell id="L1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="640" height="104" as="geometry"/></mxCell><mxCell id="L1n" value="TRUST BOUNDARY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="122" width="616" height="18" as="geometry"/></mxCell><mxCell id="L1r" value="ASP.NET Core Web API - everything below happens under your rules" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="139" width="616" height="16" as="geometry"/></mxCell><mxCell id="L1i0" value="&lt;b&gt;Token validation&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Verifies the Firebase token, resolves the role&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="198" height="58" as="geometry"/></mxCell><mxCell id="L1i1" value="&lt;b&gt;Agent loop&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Sends the turn to Foundry over managed identity, no keys&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="198" height="58" as="geometry"/></mxCell><mxCell id="L1i2" value="&lt;b&gt;Tool executor&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Maps a tool name to a C# method after validating arguments&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="448" y="160" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="256" width="640" height="104" as="geometry"/></mxCell><mxCell id="L2n" value="REASONING" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="260" width="616" height="18" as="geometry"/></mxCell><mxCell id="L2r" value="Foundry Agent Service - consulted by the loop, holds no data of yours" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="277" width="616" height="16" as="geometry"/></mxCell><mxCell id="L2i0" value="&lt;b&gt;Model deployment&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Chosen from the Foundry catalogue&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="32" y="298" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2i1" value="&lt;b&gt;Agent definition&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Instructions and tool schemas, versioned&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="240" y="298" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2i2" value="&lt;b&gt;Conversation state&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Turn history, server-side&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="448" y="298" width="198" height="58" as="geometry"/></mxCell><mxCell id="L3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="394" width="640" height="104" as="geometry"/></mxCell><mxCell id="L3n" value="YOUR EXISTING PLATFORM" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="398" width="616" height="18" as="geometry"/></mxCell><mxCell id="L3r" value="Reached only by the tool executor, unchanged by any of this" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="415" width="616" height="16" as="geometry"/></mxCell><mxCell id="L3i0" value="&lt;b&gt;Business APIs and repositories&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The endpoints you already shipped&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="32" y="436" width="616" height="58" as="geometry"/></mxCell><mxCell id="le0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Firestore / SQL&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Never learns that an agent was involved&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190" y="520" width="300" height="56" as="geometry"/></mxCell><mxCell id="er" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L3" target="res"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>