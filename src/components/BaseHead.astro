---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { SITE, AUTHOR, GA_ID, ADSENSE_CLIENT } from '../config';
import { BUILD_ID } from '../lib/build-id';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative. Defaults to the current page. */
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Any JSON-LD graph nodes this page wants to emit. */
  schema?: Record<string, unknown>[];
  /** Path to the raw Markdown twin of this page, for AI crawlers. */
  markdownUrl?: string;
  noindex?: boolean;
  /**
   * Load AdSense on a page that is otherwise excluded by `noindex`.
   *
   * Ads follow indexing by default, which correctly keeps them out of /admin and
   * the editor. The app feed is the one page where those two things come apart:
   * it is deliberately unindexed and still a reader-facing screen, so it opts in
   * explicitly rather than by inference.
   */
  ads?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/og/default.png',
  type = 'website',
  publishedAt,
  updatedAt,
  schema = [],
  markdownUrl,
  noindex = false,
  ads,
} = Astro.props;

const showAds = ads ?? !noindex;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.url);
const imageUrl = new URL(image, SITE.url);
// Every page is attributed, so a search result or a shared link names the
// author without the reader having to click through. The home page title
// carries the positioning line instead of the plain brand, so the site's
// <title> reads as a multi-stack platform rather than a .NET blog.
const brand = `${SITE.title} ${SITE.byline}`;
const fullTitle = title === SITE.title ? `${SITE.title} — ${SITE.tagline}` : `${title} | ${brand}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Which build served this page. The installed app compares it with
     /version.json to know when it is running stale code. -->
<meta name="build-id" content={BUILD_ID} />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Point AI crawlers at the clean Markdown twin of this page. -->
{markdownUrl && (
  <link rel="alternate" type="text/markdown" href={new URL(markdownUrl, SITE.url)} title={`${title} (Markdown)`} />
)}

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS Feed`} href={new URL('/rss.xml', SITE.url)} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- PWA: installable app + theme integration. The manifest makes the site
     installable on Android/desktop; the apple-* meta let iOS launch it
     standalone (full native-like chrome) when added to the home screen. -->
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#1e5fd1" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="MSDEVBUILD" />

<!-- Open Graph -->
<meta property="og:site_name" content={brand} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE.locale} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<!-- Twitter/X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={AUTHOR.xHandle} />
<meta name="twitter:creator" content={AUTHOR.xHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{schema.length > 0 && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })}
  />
)}

<!-- Google AdSense Auto ads. One snippet site-wide; Google places the units.
     Skipped on private tooling pages so ads never render in the admin/editor. -->
{ADSENSE_CLIENT && showAds && (
  <>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>
    <script is:inline>
      // View Transitions swap the DOM without a reload, so the usual per-unit
      // `push({})` never re-runs on client navigation and units go blank. This
      // requests a fill for every not-yet-processed <ins> on each page-load,
      // including the first. Bound once so navigations don't stack listeners.
      (() => {
        const fill = () => {
          document
            .querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])')
            .forEach(() => {
              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              } catch {}
            });
        };
        if (!window.__adsBound) {
          window.__adsBound = true;
          document.addEventListener('astro:page-load', fill);
        }
      })();
    </script>
  </>
)}

<!-- Theme applied before first paint: no flash of the wrong theme. -->
<script is:inline>
  (() => {
    const stored = localStorage.getItem('theme');
    const theme =
      stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;

    // Installed-app mode drives a different navigation (icon tab bar instead of
    // the burger menu). CSS handles this on its own via `display-mode:
    // standalone`; the attribute exists for iOS, where Safari reports the mode
    // through a non-standard flag rather than the media query. Set here so the
    // app never paints the browser navigation first.
    if (navigator.standalone === true) document.documentElement.dataset.standalone = '';

    // A reader who entered through /app keeps the app's tab bar for the rest of
    // the session, so tapping a card in a browser tab does not drop them back
    // into the website's navigation. /app itself renders the attribute
    // server-side; this carries it to every page after that. Session-scoped, so
    // closing the tab returns to the normal site.
    try {
      if (sessionStorage.getItem('app-shell') !== null) {
        document.documentElement.dataset.appShell = '';
      }
    } catch {
      /* Private mode blocks sessionStorage — the browser navigation is fine. */
    }
  })();
</script>

{GA_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      // The private tools are not part of the audience, so keep the owner's
      // own admin/editor usage out of the numbers entirely.
      window.__gaPrivate = (p) => p.startsWith('/admin') || p.startsWith('/write');

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());

      // View Transitions navigate without a full reload, so the automatic
      // page_view is suppressed and one is sent on every astro:page-load
      // instead — which fires on the first load AND each client navigation.
      // Guarded so the listener is only ever attached once.
      gtag('config', GA_ID, { send_page_view: false });

      if (!window.__gaBound) {
        window.__gaBound = true;
        document.addEventListener('astro:page-load', () => {
          if (window.__gaPrivate(location.pathname)) return;
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        });
      }
    </script>
  </>
)}
