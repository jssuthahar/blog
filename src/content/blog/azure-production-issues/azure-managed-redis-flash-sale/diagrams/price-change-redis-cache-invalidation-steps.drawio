<mxfile host="app.diagrams.net"><diagram name="Price change" id="Pricechange"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="16" width="448" height="504" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1. Partner changes the price&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;PUT /api/partner/items/biryani-99/price&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="400" height="64" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2. Write Azure SQL first&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;UPDATE dbo.MenuItems: the source of truth&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="138" width="400" height="64" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3. Delete the Redis key&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Delete, do not update. The next read rebuilds it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="236" width="400" height="64" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4. Other instances drop their L1 copy&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Within 10 seconds, the L1 lifetime&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="334" width="400" height="64" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;5. Checkout re-reads the price&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The order uses the database price, never the cached one&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="432" width="400" height="64" as="geometry"/></mxCell><mxCell id="pe0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>