<mxfile host="app.diagrams.net"><diagram name="AGENTS.md anatomy" id="AGENTS.mdanatomy"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="1" width="668" height="667" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;An agent opens the repo&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;It knows the language. It knows nothing about this codebase.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="160" y="25" width="420" height="58" as="geometry"/></mxCell><mxCell id="L1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="620" height="104" as="geometry"/></mxCell><mxCell id="L1n" value="STACK AND LAYOUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="122" width="596" height="18" as="geometry"/></mxCell><mxCell id="L1r" value="What this is, in one screen" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="139" width="596" height="16" as="geometry"/></mxCell><mxCell id="L1i0" value="&lt;b&gt;Stack&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Framework, versions, package manager&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="72" y="160" width="293" height="58" as="geometry"/></mxCell><mxCell id="L1i1" value="&lt;b&gt;Layout&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Where the layers live, and why&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="375" y="160" width="293" height="58" as="geometry"/></mxCell><mxCell id="L2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="60" y="256" width="620" height="104" as="geometry"/></mxCell><mxCell id="L2n" value="CONVENTIONS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="260" width="596" height="18" as="geometry"/></mxCell><mxCell id="L2r" value="The choices already made, so it stops re-deciding" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="277" width="596" height="16" as="geometry"/></mxCell><mxCell id="L2i0" value="&lt;b&gt;Patterns&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;State, errors, naming&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="72" y="298" width="293" height="58" as="geometry"/></mxCell><mxCell id="L2i1" value="&lt;b&gt;Testing&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;What a test looks like here&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="375" y="298" width="293" height="58" as="geometry"/></mxCell><mxCell id="L3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="620" height="104" as="geometry"/></mxCell><mxCell id="L3n" value="HARD RULES" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="398" width="596" height="18" as="geometry"/></mxCell><mxCell id="L3r" value="Constraints an agent can check itself against" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="415" width="596" height="16" as="geometry"/></mxCell><mxCell id="L3i0" value="&lt;b&gt;Never do this&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The specific thing, not 'follow best practices'&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="72" y="436" width="293" height="58" as="geometry"/></mxCell><mxCell id="L3i1" value="&lt;b&gt;Verify with&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The exact command that proves it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="375" y="436" width="293" height="58" as="geometry"/></mxCell><mxCell id="le0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="res" value="Code that reads like the rest of the repo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="562" width="300" height="48" as="geometry"/></mxCell><mxCell id="er" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L3" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="The difference is specificity, not length." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="622" width="300" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>