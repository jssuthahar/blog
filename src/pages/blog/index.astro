---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import TestimonialForm from '../../components/TestimonialForm.astro';
import AdUnit from '../../components/AdUnit.astro';
import SeriesQuickNav from '../../components/SeriesQuickNav.astro';
import GlassCarousel from '../../components/GlassCarousel.astro';
import type { GlassSlide } from '../../lib/carousels';
import { SITE, ADSENSE_SLOT_DISPLAY } from '../../config';
import { getPublishedPosts, getSeriesIndex, postUrl, seriesUrl } from '../../lib/posts';
import { featuredTestimonials, testimonialIndex } from '../../lib/testimonials';

const posts = await getPublishedPosts();
const seriesIndex = await getSeriesIndex();

const slides: GlassSlide[] = [
  {
    tab: 'All posts',
    kicker: 'MSDEVBUILD · The blog',
    title: 'All posts,',
    accent: 'newest first',
    text: `${posts.length} articles on .NET, Azure, and AI engineering.`,
    tiles: [
      { value: String(posts.length), label: 'articles' },
      { value: String(seriesIndex.length), label: 'series' },
      { value: String(new Set(posts.map((p) => p.data.category)).size), label: 'topics' },
    ],
    actions: posts[0] ? [{ label: 'Read the newest →', href: postUrl(posts[0]), primary: true }, { label: 'RSS feed', href: '/rss.xml' }] : [{ label: 'RSS feed', href: '/rss.xml' }],
    panel: {
      demo: { kind: 'flow', labels: ['Scenario', 'Code', 'Trade-offs'], caption: 'Each post starts from a scenario, then shows the code and the trade-offs.' },
      title: 'Newest posts',
      steps: posts.slice(0, 3).map((p) => ({ title: p.data.title, href: postUrl(p) })),
    },
  },
  {
    tab: 'Series',
    kicker: 'MSDEVBUILD · Series',
    title: 'Read a whole guide,',
    accent: 'part by part',
    text: 'Multi-part guides meant to be read in order, each building on the last.',
    tiles: [
      { value: String(seriesIndex.length), label: 'series' },
      { value: String(seriesIndex.reduce((sum, s) => sum + s.parts.length, 0)), label: 'parts in total' },
      { value: 'In order', label: 'each builds on the last' },
    ],
    actions: [{ label: 'All series →', href: '/series/', primary: true }],
    panel: {
      demo: { kind: 'flow', labels: ['Part 1', 'Part 2', 'Whole system'], caption: 'Start at part 1 and finish with a complete system.' },
      title: 'Largest series',
      steps: [...seriesIndex].sort((a, b) => b.parts.length - a.parts.length).slice(0, 3).map((s) => ({ title: s.title, note: `${s.parts.length} parts`, href: seriesUrl(s.id) })),
    },
  },
  {
    tab: 'Follow',
    kicker: 'MSDEVBUILD · Follow',
    title: 'New posts,',
    accent: 'straight to you',
    text: 'Subscribe by RSS, or follow on the channel you already use.',
    follow: true,
    panel: { demoOnlyOnPhone: true, demo: { kind: 'social', caption: 'One new post reaches every channel, so follow the one you already use.' } },
  },
];

// Ten by default; the sync puts featured entries first, so the highlighted
// ones are always the ones that make the cut.
const testimonials = featuredTestimonials(10);
const highlighted = testimonials.filter((t) => t.featured);
const standard = testimonials.filter((t) => !t.featured);

// The one hub page on the site that had no schema at all — every other
// listing (category, series, shorts) already says what it is and lists its
// items structurally. Same CollectionPage + ItemList + BreadcrumbList
// pattern as `/category/[category]`, capped at 20 like the homepage's own
// `blogPost` slice: naming every one of 50+ posts here would bloat the
// graph for no benefit, since each post already carries its own full
// BlogPosting node on its own page.
// No Review schema — self-serving testimonials on your own site aren't eligible
// for review rich results, and a Person is an invalid itemReviewed type.
const schema: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/blog#page`,
    name: 'All posts',
    description: `Every article on ${SITE.title} — Cloud, Azure, AI, GitHub Copilot, Mobile, and Web development guides.`,
    about: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 20).map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: new URL(postUrl(post), SITE.url).href,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    ],
  },
];
---

<BaseLayout
  title="All posts"
  description={`Every article on ${SITE.title} — Cloud, Azure, AI, GitHub Copilot, Mobile, and Web development guides.`}
  schema={schema}
>
  <GlassCarousel slides={slides} label="The blog" />

  <!-- Series first: a reader who wants the whole guide should not have to spot
       the parts among the individual posts. -->
  <SeriesQuickNav class="mt-6" />

  <div class="section-head mt-10">
    <div>
      <p class="eyebrow">Newest first</p>
      <h2 class="display mt-1.5 text-2xl sm:text-[1.75rem]">Every post</h2>
    </div>
    <p class="text-sm text-muted">{posts.length} articles</p>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <!-- Straight after the post grid, while the titles are still on screen —
       ahead of both the ad and the testimonials, which are not asks. -->
  <div class="mt-16">
    <Newsletter source="blog-index" />
  </div>

  <!-- One display ad below the post grid, before the testimonials section. -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none mt-16" />

  {testimonials.length > 0 && (
    <section class="mt-20" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 id="testimonials-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
            How these articles helped
          </h2>
        </div>
        <a href="/testimonials/" class="btn btn-outline btn-sm">
          {testimonialIndex.count > 10 ? `All ${testimonialIndex.count}` : 'All testimonials'}
        </a>
      </div>

      {highlighted.length > 0 && (
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {highlighted.map((t) => <TestimonialCard testimonial={t} highlight />)}
        </div>
      )}

      {standard.length > 0 && (
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {standard.map((t) => <TestimonialCard testimonial={t} />)}
        </div>
      )}
    </section>
  )}

  <div class="mt-16">
    <TestimonialForm compact />
  </div>
</BaseLayout>
