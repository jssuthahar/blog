---
/**
 * Short-video strip for the installed app.
 *
 * Portrait tiles in a horizontal scroller, because that is the shape the shorts
 * are drawn at and the gesture a phone user already has for this kind of row.
 * It sits above the article feed rather than inside it: a 30-second watch and a
 * 12-minute read are different intentions, and mixing them into one column
 * makes the reader judge every card twice.
 *
 * Order is the hub's own — dated shorts newest first — capped to what fits a
 * couple of swipes. The last tile links on to the full hub, so a rail that has
 * run out of tiles never dead-ends.
 */
import { getShorts, shortUrl } from '../lib/shorts';
import ShortPoster from './ShortPoster.astro';

/** Two comfortable swipes on a phone. More than this belongs on /shorts. */
const MAX_TILES = 8;

const shorts = getShorts().slice(0, MAX_TILES);
const total = getShorts().length;
---

{shorts.length > 0 && (
  <section class="pt-4" aria-labelledby="app-shorts-heading">
    <div class="flex items-baseline justify-between px-4">
      <div>
        <p class="eyebrow">30-second learning</p>
        <h2 id="app-shorts-heading" class="mt-0.5 text-lg font-semibold tracking-tight">
          Short videos
        </h2>
      </div>
      <a href="/shorts/" class="text-sm font-medium text-accent">See all {total}</a>
    </div>

    <div class="app-rail mt-3">
      <ul class="flex gap-3 overflow-x-auto px-4 pb-1">
        {shorts.map((short) => (
          <li class="shrink-0">
            <a href={shortUrl(short)} class="app-short">
              <ShortPoster short={short} compact />
              <span class="app-short__title">{short.title}</span>
            </a>
          </li>
        ))}

        <li class="shrink-0">
          <a href="/shorts/" class="app-short">
            <span class="app-short__more-art">
              <span class="app-short__more" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </span>
            <span class="app-short__title">All short videos</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
)}

<style>
  .app-rail ul {
    scrollbar-width: none;
  }
  .app-rail ul::-webkit-scrollbar {
    display: none;
  }

  .app-short {
    display: grid;
    width: 6.75rem;
    gap: 0.4rem;
  }

  /* The poster itself is drawn by ShortPoster; the rail owns only the press
     feedback and the tile that links on to the hub. */
  .app-short:active :global(.poster) {
    transform: scale(0.96);
  }

  .app-short__more-art {
    display: grid;
    place-items: center;
    aspect-ratio: 9 / 16;
    border-radius: 0.85rem;
    background: var(--bg-subtle);
    border: 1px dashed var(--border);
  }
  .app-short__more svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--text-muted);
  }

  .app-short__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.68rem;
    line-height: 1.3;
    color: var(--text-muted);
  }
</style>
