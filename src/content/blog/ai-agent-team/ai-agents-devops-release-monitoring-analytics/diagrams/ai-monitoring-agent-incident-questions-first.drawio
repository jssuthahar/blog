<mxfile host="app.diagrams.net"><diagram name="Incident questions first" id="Incidentquestionsfirst"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="6" width="508" height="488" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;1. A bad night, in one sentence&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;orders are placed but restaurants never see them&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="460" height="64" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;2. The questions you will ask at 2am&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;which build, which backend, which screen, since when?&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="460" height="64" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;3. The signal that answers each one&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;crash reports, logs, a placed-vs-seen count&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="218" width="460" height="64" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;4. Alerts with a first step&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;a threshold, who it wakes, what they do first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="312" width="460" height="64" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;5. What you cannot answer today&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;written down before the incident, not during it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="406" width="460" height="64" as="geometry"/></mxCell><mxCell id="me0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>