<mxfile host="app.diagrams.net"><diagram name="The straight line" id="Thestraightline"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="6" width="528" height="780" as="geometry"/></mxCell><mxCell id="dev" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="480" height="176" as="geometry"/></mxCell><mxCell id="devn" value="ON THE DEVICE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="38" width="456" height="18" as="geometry"/></mxCell><mxCell id="devr" value="Whoever holds the phone holds everything in here" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="55" width="456" height="16" as="geometry"/></mxCell><mxCell id="app" value="Your Flutter app" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="283" y="78" width="54" height="54" as="geometry"/></mxCell><mxCell id="appt" value="Server name, database, user, password - compiled into the build" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2933;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="158" width="456" height="18" as="geometry"/></mxCell><mxCell id="appr" value="✕ Unzip the package and all four read back as plain text" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="178" width="456" height="18" as="geometry"/></mxCell><mxCell id="db" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="316" width="480" height="176" as="geometry"/></mxCell><mxCell id="dbn" value="AZURE SQL DATABASE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="324" width="456" height="18" as="geometry"/></mxCell><mxCell id="dbr" value="Public endpoint, reachable from anywhere on the internet" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="341" width="456" height="16" as="geometry"/></mxCell><mxCell id="sql" value="Azure SQL Database" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="283" y="364" width="54" height="54" as="geometry"/></mxCell><mxCell id="dbt" value="Firewall opened to every address, because a phone has no fixed IP" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2933;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="444" width="456" height="18" as="geometry"/></mxCell><mxCell id="dbr2" value="✕ Nothing between the two boxes asks a single question" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="82" y="464" width="456" height="18" as="geometry"/></mxCell><mxCell id="line" value="One straight line&lt;br&gt;TCP 1433, from a device you do not control" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=3;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dev" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;What that one line hands over&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Every row the app's login can read, to anyone who installs the app. No ruleset, no ownership check, no private network.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="552" width="480" height="80" as="geometry"/></mxCell><mxCell id="ec" value="" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="db" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Replace the line with five layers&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Each answers one question the others do not cover.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="480" height="62" as="geometry"/></mxCell><mxCell id="ef" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="cost" target="fix"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>