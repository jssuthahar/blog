---
// Theme toggle. The initial theme is set in BaseHead before paint;
// this only handles user-driven changes.
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-md p-2 transition-colors hover:bg-subtle"
  aria-label="Toggle dark mode"
>
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script>
  function initThemeToggle() {
    const button = document.getElementById('theme-toggle');
    button?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  }

  initThemeToggle();
  // Re-bind after client-side view transitions.
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
