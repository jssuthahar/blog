---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import SeriesQuickNav from '../components/SeriesQuickNav.astro';
import GlassCarousel from '../components/GlassCarousel.astro';
import { flagshipSeriesSlides, seriesMinutes, type GlassSlide } from '../lib/carousels';
import { getSeriesIndex, formatDate, postUrl, seriesUrl } from '../lib/posts';

const series = await getSeriesIndex();

const slides: GlassSlide[] = [
  {
    tab: 'All series',
    kicker: 'MSDEVBUILD · Series',
    title: 'Series,',
    accent: 'built to read in order',
    text: 'Multi-part guides meant to be read in order, each building on the last.',
    tiles: [
      { value: String(series.length), label: 'series' },
      { value: String(series.reduce((sum, s) => sum + s.parts.length, 0)), label: 'parts' },
      { value: `${Math.round(series.reduce((sum, s) => sum + seriesMinutes(s), 0) / 60)} hours`, label: 'of reading' },
    ],
    panel: {
      demo: { kind: 'flow', labels: ['Part 1', 'Part 2', 'Whole system'], caption: 'Start at part 1 and finish with a complete system.' },
      title: 'Recently updated',
      steps: [...series]
        .sort((a, b) => b.latest.data.publishedAt.getTime() - a.latest.data.publishedAt.getTime())
        .slice(0, 3)
        .map((s) => ({ title: s.title, note: `${s.parts.length} parts`, href: seriesUrl(s.id) })),
    },
  },
  ...(await flagshipSeriesSlides()),
];
---

<BaseLayout
  title="Series"
  description="Multi-part guides that build a complete system step by step, on .NET, Azure, and AI."
>
  <GlassCarousel slides={slides} label="Series" />

  <!-- Same chips as the home page, so a link from anywhere lands on a page that
       still offers the other series. -->
  <SeriesQuickNav label="" class="mt-6" />

  <div class="mt-10 space-y-8">
    {series.map(({ id, title, description, parts, latest }) => (
      <!-- id + scroll-mt kept: older links and shares still arrive at /series/#slug. -->
      <section id={id} class="scroll-mt-20 rounded-xl border border-default p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-xl font-semibold tracking-tight capitalize">
            <a href={seriesUrl(id)} class="hover:text-accent">{title}</a>
          </h2>
          <p class="text-xs text-muted">
            {parts.length} parts · updated {formatDate(latest.data.publishedAt)}
          </p>
        </div>
        {description && <p class="mt-2 text-muted">{description}</p>}
        <ol class="mt-5 space-y-3">
          {parts.map((post) => (
            <li class="flex gap-3">
              <span class="text-muted tabular-nums">{post.data.seriesOrder}.</span>
              <div>
                <a href={postUrl(post)} class="font-medium hover:text-accent">{post.data.title}</a>
                <p class="mt-0.5 text-sm text-muted">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <!-- Someone browsing series wants the next part when it lands, which is
       exactly what the list delivers. -->
  <div class="mt-16">
    <Newsletter source="series" />
  </div>
</BaseLayout>
