---
/**
 * A promotion between two feed items.
 *
 * The feed earns these. One lands after every fifth piece of content and never
 * before the sixth item, so by the time a reader meets the first ask they have
 * already watched or read five things — which is the only thing that makes
 * "follow this" a fair question rather than a toll.
 *
 * Three kinds share the slot: a follow target from SOCIAL, the newsletter form,
 * and the AdSense unit. They rotate rather than repeat, because a reader who
 * sees the same card four times has learned to scroll past that shape, and the
 * fifth one — the one that mattered — goes with it.
 *
 * Every promotion is visibly a promotion. It sits on the page background as a
 * bordered panel with its own eyebrow, never in the chrome of an article card,
 * and the ad keeps its "Advertisement" label. A feed that dresses its asks up
 * as content buys one tap and loses the reader.
 */
import AdUnit from './AdUnit.astro';
import AppPromo from './AppPromo.astro';
import Newsletter from './Newsletter.astro';
import type { PromoItem } from '../lib/app-feed';

interface Props {
  item: PromoItem;
}

const { promo, shownIn } = Astro.props.item as PromoItem;

// The same glyphs FollowCTA draws, so a follow button looks the same wherever
// the reader meets it. Single filled paths — no stroke pass, no icon package.
const ICONS: Record<string, string> = {
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.75-2.05C21.6 8.65 22 11.1 22 14.3V21h-4v-6c0-1.4-.03-3.2-2-3.2s-2.3 1.5-2.3 3.1V21h-4V9Z',
  github:
    'M12 .5C5.73.5.9 5.33.9 11.6c0 4.9 3.17 9.05 7.57 10.52.55.1.76-.24.76-.53 0-.26-.01-1.13-.01-2.05-2.78.51-3.5-.68-3.72-1.3-.12-.32-.66-1.3-1.13-1.56-.39-.21-.94-.72-.02-.74.87-.01 1.49.8 1.7 1.13.99 1.67 2.57 1.2 3.2.91.1-.71.39-1.2.7-1.47-2.46-.28-5.03-1.23-5.03-5.47 0-1.2.43-2.2 1.13-2.97-.11-.28-.49-1.41.11-2.94 0 0 .93-.29 3.05 1.13a10.3 10.3 0 0 1 5.55 0c2.12-1.44 3.05-1.13 3.05-1.13.6 1.53.22 2.66.11 2.94.7.77 1.13 1.75 1.13 2.97 0 4.26-2.58 5.19-5.04 5.47.4.35.75 1.02.75 2.06 0 1.49-.01 2.69-.01 3.06 0 .29.2.64.76.53a11.12 11.12 0 0 0 7.55-10.52C23.1 5.33 18.27.5 12 .5Z',
  youtube:
    'M23.5 6.9a3 3 0 0 0-2.11-2.13C19.5 4.25 12 4.25 12 4.25s-7.5 0-9.39.52A3 3 0 0 0 .5 6.9C0 8.8 0 12 0 12s0 3.2.5 5.1a3 3 0 0 0 2.11 2.13c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.13C24 15.2 24 12 24 12s0-3.2-.5-5.1ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z',
  x: 'M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.6 6.6L18.9 2Z',
  instagram:
    'M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4A5.8 5.8 0 0 1 16.2 22H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm4.2 2.9a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 2a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.35-3.4a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
  whatsapp:
    'M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a13 13 0 0 1-6.3-5.5C6.9 10.6 6.6 9.6 6.6 9c0-.6.3-1.5.8-1.9.2-.2.4-.2.6-.2h.5c.2 0 .4 0 .6.4l.8 2c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.5.9 1.5 2 2.6 2.5.3.2.5.1.6 0l.7-.8c.2-.2.3-.2.6-.1l1.9.9c.3.1.4.2.4.4.1.2.1.7-.1 1.3Z',
};

// Brand hue per platform, used only for the glyph badge. Everything else on the
// card stays in the site's own palette so a promotion never out-shouts an
// article sitting next to it.
const HUES: Record<string, number> = {
  linkedin: 250,
  'linkedin-page': 250,
  instagram: 340,
  whatsapp: 145,
  youtube: 25,
  github: 280,
  x: 260,
};
---

<!-- `data-for` lists the filter tabs this promotion was positioned for; the
     filter rules in app.astro show it in those and hide it in the rest. -->
<article class="feed-item feed-promo" data-feed-item data-kind="promo" data-for={shownIn.join(' ')}>
  {promo.type === 'social' && (
    <div class="feed-promo__card" style={`--promo-hue: ${HUES[promo.id] ?? 250};`}>
      <p class="feed-promo__eyebrow">Keep up with the work</p>

      <span class="feed-promo__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICONS[promo.icon]} /></svg>
      </span>

      <h2 class="feed-promo__title">{promo.action} on {promo.label}</h2>
      <p class="feed-promo__handle">{promo.handle}</p>
      <p class="feed-promo__blurb">{promo.blurb}</p>

      <a href={promo.href} target="_blank" rel="noopener" class="feed-promo__cta">
        {promo.action}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
      </a>

      <p class="feed-promo__skip">Keep scrolling — there is more below.</p>
    </div>
  )}

  {promo.type === 'newsletter' && (
    <div class="feed-promo__wide">
      <Newsletter compact source="app-feed" />
    </div>
  )}

  {promo.type === 'install' && (
    <div class="feed-promo__wide">
      <AppPromo />
    </div>
  )}

  {promo.type === 'ad' && (
    <div class="feed-promo__wide">
      <AdUnit
        slot={promo.slot}
        format={promo.format}
        layoutKey={promo.layoutKey}
        class="!my-0 !max-w-none"
      />
    </div>
  )}
</article>

<style>
  .feed-promo {
    display: grid;
    place-items: center;
    padding: 1rem;
    background: var(--bg-subtle);
  }

  .feed-promo__card,
  .feed-promo__wide {
    width: 100%;
    max-width: 30rem;
    max-height: 100%;
    overflow-y: auto;
  }

  .feed-promo__card {
    border-radius: 1.1rem;
    border: 1px solid var(--border);
    background: var(--bg);
    padding: 1.75rem 1.5rem;
    text-align: center;
  }

  .feed-promo__eyebrow {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .feed-promo__badge {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    margin: 1rem auto 0;
    border-radius: 1rem;
    background: oklch(0.62 0.17 var(--promo-hue) / 0.14);
    color: oklch(0.55 0.17 var(--promo-hue));
  }
  :global([data-theme='dark']) .feed-promo__badge {
    color: oklch(0.78 0.15 var(--promo-hue));
  }
  .feed-promo__badge svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .feed-promo__title {
    margin-top: 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .feed-promo__handle {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: oklch(0.55 0.17 var(--promo-hue));
  }
  :global([data-theme='dark']) .feed-promo__handle {
    color: oklch(0.78 0.15 var(--promo-hue));
  }

  .feed-promo__blurb {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .feed-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.15rem;
    border-radius: 999px;
    background: var(--accent);
    padding: 0.6rem 1.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #fff;
  }
  .feed-promo__cta svg {
    width: 1rem;
    height: 1rem;
  }

  .feed-promo__skip {
    margin-top: 1rem;
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
