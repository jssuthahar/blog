<mxfile host="app.diagrams.net"><diagram name="Decision" id="Decision"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="126" y="6" width="718" height="768" as="geometry"/></mxCell><mxCell id="start" value="One piece of data on the dish page" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="30" width="300" height="48" as="geometry"/></mxCell><mxCell id="d1" value="Is it a file?&lt;br&gt;image, CSS, JS, font" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="118" width="300" height="100" as="geometry"/></mxCell><mxCell id="d1y" value="CDN: Front Door&lt;br&gt;long TTL, versioned URL" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="260" height="56" as="geometry"/></mxCell><mxCell id="d1ye" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d1" target="d1y"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1in" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2" value="Different for each user?&lt;br&gt;cart, address, wallet" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="262" width="300" height="100" as="geometry"/></mxCell><mxCell id="d2y" value="Do not share-cache it.&lt;br&gt;Read it from the database" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="284" width="260" height="56" as="geometry"/></mxCell><mxCell id="d2ye" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d2" target="d2y"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2in" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="Must be exact when money moves?&lt;br&gt;stock left, final price" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="406" width="300" height="100" as="geometry"/></mxCell><mxCell id="d3y" value="Database is the truth.&lt;br&gt;Redis counter only as the gate" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="428" width="260" height="56" as="geometry"/></mxCell><mxCell id="d3ye" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d3" target="d3y"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3in" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d4" value="Read far more than written,&lt;br&gt;fine if 30 seconds old?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="550" width="300" height="100" as="geometry"/></mxCell><mxCell id="d4y" value="Redis: cache-aside&lt;br&gt;TTL of 1 to 5 minutes" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="572" width="260" height="56" as="geometry"/></mxCell><mxCell id="d4ye" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d4" target="d4y"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d4in" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="end" value="Leave it in the database.&lt;br&gt;Measure before caching it." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="694" width="300" height="56" as="geometry"/></mxCell><mxCell id="endin" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="d4" target="end"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>