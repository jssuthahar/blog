<mxfile host="app.diagrams.net"><diagram name="Two channels" id="Twochannels"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="6" width="748" height="700" as="geometry"/></mxCell><mxCell id="grp" value="Saturday 21:14, two travellers, the same last room" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="150" as="geometry"/></mxCell><mxCell id="you" value="Traveller on your app&lt;br&gt;pays at 21:14:05" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="54" height="54" as="geometry"/></mxCell><mxCell id="oth" value="Traveller on another site&lt;br&gt;books at 21:13:56" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="54" height="54" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Your supplier&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;still shows 1 room left&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="110" y="290" width="240" height="60" as="geometry"/></mxCell><mxCell id="ota" value="&lt;b&gt;Another booking site&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;also shows 1 room left&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="240" height="60" as="geometry"/></mxCell><mxCell id="cm" value="&lt;b&gt;The hotel's channel manager and PMS&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;1 Deluxe Sea View left for 2 to 4 October&lt;br&gt;Pushes availability to every channel, seconds to minutes late&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="130" y="450" width="520" height="80" as="geometry"/></mxCell><mxCell id="bad" value="✗ The hotel takes the first booking to arrive.&lt;br&gt;The second gets SOLD_OUT, after its traveller has paid" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="170" y="620" width="440" height="62" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="grp" target="sup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="grp" target="ota"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="book, 9 s too late" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArro