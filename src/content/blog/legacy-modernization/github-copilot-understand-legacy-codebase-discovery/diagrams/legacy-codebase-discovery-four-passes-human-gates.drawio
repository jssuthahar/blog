<mxfile host="app.diagrams.net"><diagram name="Discovery" id="Discovery"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="-4" y="6" width="834" height="1044" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Legacy repo + git history + people&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Everything the knowledge is scattered across&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="30" width="330" height="58" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Pass 1 - Structural map&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Projects, versions, entry points, data stores, integrations&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="118" width="330" height="62" as="geometry"/></mxCell><mxCell id="g2" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HUMAN GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Are the module boundaries real?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="214" width="330" height="48" as="geometry"/></mxCell><mxCell id="g2bk" value="Missing integration or wrong boundary -&gt; re-run the inventory" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="226" width="250" height="34" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Pass 2 - Business-rule extraction&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Candidate rules, quoted code, inferred outcomes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="296" width="330" height="62" as="geometry"/></mxCell><mxCell id="g4" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HUMAN GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Is the rule real, load-bearing, correctly explained?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="392" width="330" height="48" as="geometry"/></mxCell><mxCell id="g4bk" value="Unconfirmed -&gt; mark 'appears unused, verify before removing'" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="404" width="250" height="34" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Pass 3 - Risk and dependency mapping&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;High fan-in files, hidden coupling, dependency debt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="474" width="330" height="62" as="geometry"/></mxCell><mxCell id="g6" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HUMAN GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Does the blast radius match reality?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="570" width="330" height="48" as="geometry"/></mxCell><mxCell id="g6bk" value="Coupling through a queue, trigger or cron -&gt; add it by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="582" width="250" height="34" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;Pass 4 - Knowledge from history&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;git log and git blame on the load-bearing modules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="652" width="330" height="62" as="geometry"/></mxCell><mxCell id="g8" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HUMAN GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Does the history actually explain the why?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="748" width="330" height="48" as="geometry"/></mxCell><mxCell id="g8bk" value="No rationale -&gt; ask the people, do not invent one" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="760" width="250" height="34" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;Verified knowledge&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Findings a person has confirmed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="830" width="330" height="62" as="geometry"/></mxCell><mxCell id="ge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" s