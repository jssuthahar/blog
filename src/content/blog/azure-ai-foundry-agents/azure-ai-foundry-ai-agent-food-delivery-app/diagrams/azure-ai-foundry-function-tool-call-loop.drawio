<mxfile host="app.diagrams.net"><diagram name="Tool loop" id="Toolloop"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="96" y="6" width="659" height="664" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Customer types &quot;Find spicy food under RM20&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Flutter posts it to your API with the Firebase ID token&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="120" y="30" width="360" height="58" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Your API opens the turn&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Sends the text to Foundry against the agent name and conversation id&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="118" width="330" height="62" as="geometry"/></mxCell><mxCell id="g2" value="&lt;font color='#6B7280'&gt;&lt;b&gt;MODEL DECISION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Does this answer need data the model does not have?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="214" width="330" height="48" as="geometry"/></mxCell><mxCell id="g2bk" value="No -&gt; it answers from the conversation alone, turn ends here" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="226" width="250" height="34" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Foundry returns a function_call&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;name = search_menu, call_id = call_9fA2..., arguments = spicy true, maxPriceMyr 20&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="296" width="330" height="62" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Your API validates, then dispatches&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Argument validation and role check first, then the real endpoint&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="392" width="330" height="62" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Your API sends a function_call_output&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;That JSON, carrying the same call_id - the second model invocation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="488" width="330" height="62" as="geometry"/></mxCell><mxCell id="g5bk" value="Model asks for another tool -&gt; back to function_call, one more round trip" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="507" width="250" height="34" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;Model turns the JSON into a sentence&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Final text travels back down the same path to the Flutter chat&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="584" width="330" height="62" as="geometry"/></mxCell><mxCell id="ge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>