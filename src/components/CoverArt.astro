---
import { Image } from 'astro:assets';
import { type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Hero-sized panel — loads the larger source first. */
  large?: boolean;
  class?: string;
  eager?: boolean;
}

const { post, large = false, class: className = '', eager = false } = Astro.props;
const { data } = post;

/**
 * Posts without a cover image fall back to their own share card — the same
 * drawing that represents the post on LinkedIn and in search, downsampled to
 * WebP by /og/w<width>/<id>.webp.
 *
 * This replaced a slug-seeded gradient. The gradient was free and never
 * repeated, but a grid of them told the reader nothing: identical shapes in
 * different colours, with the category as the only word on the panel. The
 * share card carries the title, the category chip in its own hue, and the
 * MSDEVBUILD wordmark, so a card in a grid looks like the thing people will
 * later see in their feed. It costs nothing extra to produce — the card is
 * already rendered for the meta tag.
 *
 * Kept at the card's native 1200×630 ratio wherever it is used, so the
 * container crops nothing off the title.
 */
const thumb = (w: number) => `/og/w${w}/${post.id}.webp`;
---

{data.cover ? (
  <Image
    src={data.cover}
    alt={data.coverAlt ?? ''}
    widths={large ? [480, 800, 1200] : [320, 480, 800]}
    sizes={large ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 640px) 100vw, 33vw'}
    loading={eager ? 'eager' : 'lazy'}
    class:list={['size-full object-cover', className]}
  />
) : (
  <img
    src={thumb(large ? 1200 : 800)}
    srcset={`${thumb(800)} 800w, ${thumb(1200)} 1200w`}
    sizes={large ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 640px) 100vw, 33vw'}
    width={large ? 1200 : 800}
    height={large ? 630 : 420}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    alt=""
    aria-hidden="true"
    class:list={['size-full object-cover', className]}
  />
)}
