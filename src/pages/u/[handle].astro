---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { allProfiles, profileTitle, type PublicProfile } from '../../lib/profiles';
import { BADGES } from '../../lib/badges.js';
import { getSeriesIndex } from '../../lib/posts';

/**
 * A public developer profile.
 *
 * Prerendered from the committed cache, so it is real HTML: indexable, instant,
 * and free of Firestore reads. A profile published since the last sync is served
 * by the client-rendered fallback at /u/?h=<handle> until the next build.
 */
export async function getStaticPaths() {
  return allProfiles().map((profile) => ({
    params: { handle: profile.handle },
    props: { profile },
  }));
}

interface Props {
  profile: PublicProfile;
}

const { profile } = Astro.props;

const seriesTitles = Object.fromEntries((await getSeriesIndex()).map((s) => [s.id, s.title]));

const earned = BADGES.filter((badge) => profile.badges.includes(badge.id));

const progress = Object.entries(profile.series)
  .map(([id, pct]) => ({ id, pct, title: seriesTitles[id] ?? id.replace(/-/g, ' ') }))
  .sort((a, b) => b.pct - a.pct);

const links = [
  profile.linkedin && { label: 'LinkedIn', href: profile.linkedin },
  profile.github && { label: 'GitHub', href: profile.github },
].filter(Boolean) as { label: string; href: string }[];

const url = `${SITE.url}/u/${profile.handle}/`;

const description =
  profile.bio.length > 20
    ? profile.bio
    : `${profile.name} reads and appreciates Cloud, AI and mobile engineering articles on ${SITE.title}.`;

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${url}#page`,
    name: profileTitle(profile),
    url,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: { '@id': `${url}#person` },
  },
  {
    '@type': 'Person',
    '@id': `${url}#person`,
    name: profile.name,
    alternateName: `@${profile.handle}`,
    url,
    ...(profile.photo ? { image: profile.photo } : {}),
    ...(profile.bio ? { description: profile.bio } : {}),
    ...(profile.skills.length ? { knowsAbout: profile.skills } : {}),
    ...(links.length ? { sameAs: links.map((l) => l.href) } : {}),
  },
];
---

<BaseLayout title={profileTitle(profile)} description={description} schema={schema}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="eyebrow">Reader profile</p>

    <header class="mt-3 flex flex-wrap items-start gap-5">
      {profile.photo ? (
        <img
          src={profile.photo}
          alt=""
          width="72"
          height="72"
          loading="lazy"
          referrerpolicy="no-referrer"
          class="size-18 shrink-0 rounded-full object-cover ring-1 ring-[var(--border)]"
        />
      ) : (
        <span
          aria-hidden="true"
          class="grid size-18 shrink-0 place-items-center rounded-full bg-[var(--accent-soft)] text-xl font-semibold text-accent ring-1 ring-[var(--border)]"
        >
          {profile.name.slice(0, 1).toUpperCase()}
        </span>
      )}

      <div class="min-w-0 flex-1">
        <h1 class="display text-2xl">{profile.name}</h1>
        <p class="mt-0.5 text-sm text-muted">@{profile.handle}</p>
        {links.length > 0 && (
          <p class="mt-2 flex flex-wrap gap-3 text-sm">
            {links.map(({ label, href }) => (
              <a href={href} rel="nofollow noopener" target="_blank" class="text-accent hover:underline">
                {label}
              </a>
            ))}
          </p>
        )}
      </div>
    </header>

    {profile.bio && <p class="mt-6 leading-relaxed">{profile.bio}</p>}

    {profile.skills.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Skills">
        {profile.skills.map((skill) => (
          <li class="rounded-full border border-default px-3 py-1 text-xs text-muted">{skill}</li>
        ))}
      </ul>
    )}

    <section class="mt-8 grid gap-3 sm:grid-cols-3" aria-label="Activity">
      {[
        [profile.appreciations, 'Appreciations'],
        [profile.articlesRead, 'Articles read'],
        [earned.length, 'Badges'],
      ].map(([value, label]) => (
        <div class="rounded-lg border border-default p-4">
          <p class="text-2xl font-semibold tabular-nums">{value}</p>
          <p class="mt-0.5 text-xs text-muted">{label}</p>
        </div>
      ))}
    </section>

    {earned.length > 0 && (
      <section class="mt-10" aria-labelledby="badges">
        <h2 id="badges" class="text-lg font-semibold tracking-tight">Badges</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {earned.map((badge) => (
            <li class="flex items-start gap-3 rounded-lg border border-[var(--accent)] p-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[var(--accent-soft)] text-xs font-semibold text-accent">
                {badge.glyph}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-medium">{badge.label}</span>
                <span class="block text-xs text-muted">{badge.description}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {progress.length > 0 && (
      <section class="mt-10" aria-labelledby="progress">
        <h2 id="progress" class="text-lg font-semibold tracking-tight">Learning progress</h2>
        <ul class="mt-4 space-y-3">
          {progress.map(({ id, title, pct }) => (
            <li class="rounded-lg border border-default p-3">
              <div class="flex items-baseline justify-between gap-3">
                <a href={`/series/#${id}`} class="text-sm font-medium hover:text-accent">{title}</a>
                <span class="shrink-0 text-xs tabular-nums text-muted">{pct}%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-subtle">
                <div class="h-full rounded-full bg-[var(--accent)]" style={`width:${pct}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12 border-t border-default pt-6 text-sm text-muted">
      Counts are updated once a day. Reading articles here never requires an account —
      <a href="/signin/" class="text-accent hover:underline">one is optional</a>, and only
      keeps your appreciations and badges with you.
    </p>
  </div>
</BaseLayout>
