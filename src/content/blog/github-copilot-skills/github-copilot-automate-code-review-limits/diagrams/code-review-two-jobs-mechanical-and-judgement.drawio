try"/></mxCell><mxCell id="L1i1" value="&lt;b&gt;Missing tests&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The path with no coverage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="260" y="152" width="198" height="58" as="geometry"/></mxCell><mxCell id="L1i2" value="&lt;b&gt;Obvious security smells&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Hardcoded secrets, unparameterised SQL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="468" y="152" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="640" height="104" as="geometry"/></mxCell><mxCell id="L2n" value="THE JUDGEMENT LAYER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="252" width="616" height="18" as="geometry"/></mxCell><mxCell id="L2r" value="A human owns this, and always will" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="52" y="269" width="616" height="16" as="geometry"/></mxCell><mxCell id="L2i0" value="&lt;b&gt;Is this the right change?&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Does it belong in this service at all&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="52" y="290" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2i1" value="&lt;b&gt;Blast radius&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;What breaks that the diff does not show&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="260" y="290" width="198" height="58" as="geometry"/></mxCell><mxCell id="L2i2" value="&lt;b&gt;Who signs their name&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Accountability is not delegable&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="468" y="290" width="198" height="58" as="geometry"/></mxCell><mxCell id="le0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="res" value="A review that is faster AND still owned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="414" width="340" height="48" as="geometry"/></mxCell><mxCell id="er" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L2" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Copilot cannot automate code review 100%. It can take the whole first layer off your plate." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="120" y="476" width="480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>