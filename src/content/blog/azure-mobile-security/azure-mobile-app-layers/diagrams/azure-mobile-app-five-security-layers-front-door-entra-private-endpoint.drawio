<mxfile host="app.diagrams.net"><diagram name="Five layers" id="Fivelayers"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="-4" y="6" width="668" height="920" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Your Flutter app&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;HTTPS request carrying a short-lived user token, and nothing else&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="30" width="380" height="58" as="geometry"/></mxCell><mxCell id="L1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="620" height="104" as="geometry"/></mxCell><mxCell id="L1n" value="LAYER 1 - AZURE FRONT DOOR + WAF" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="122" width="596" height="18" as="geometry"/></mxCell><mxCell id="L1r" value="Is this traffic garbage?" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="139" width="596" height="16" as="geometry"/></mxCell><mxCell id="L1i0" value="&lt;b&gt;Azure Front Door&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Global entry point - the only address the app knows&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="293" height="58" as="geometry"/></mxCell><mxCell id="L1c0" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="44" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="L1i1" value="&lt;b&gt;Azure WAF&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;OWASP ruleset and rate limiting. Blocked here, nothing spins up.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="335" y="160" width="293" height="58" as="geometry"/></mxCell><mxCell id="L1c1" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="347" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="L2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="620" height="104" as="geometry"/></mxCell><mxCell id="L2n" value="LAYER 2 - YOUR API" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="274" width="596" height="18" as="geometry"/></mxCell><mxCell id="L2r" value="The only public address you own" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="291" width="596" height="16" as="geometry"/></mxCell><mxCell id="L2i0" value="&lt;b&gt;Azure App Service&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;ASP.NET Core Web API - and the only thing in the picture holding credentials for anything downstream&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="32" y="312" width="596" height="58" as="geometry"/></mxCell><mxCell id="L2c0" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="44" y="322" width="38" height="38" as="geometry"/></mxCell><mxCell id="L3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="620" height="104" as="geometry"/></mxCell><mxCell id="L3n" value="LAYER 3 - MICROSOFT ENTRA ID" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="426" width="596" height="18" as="geometry"/></mxCell><mxCell id="L3r" value="Who are you?" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="443" width="596" height="16" as="geometry"/></mxCell><mxCell id="L3i0" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Signature, issuer and audience, checked locally against cached keys - microseconds, not a round trip&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="32" y="464" width="596" height="58" as="geometry"/></mxCell><mxCell id="L3c0" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="44" y="474" width="38" height="38" as="geometry"/></mxCell><mxCell id="L4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="574" width="620" height="104" as="geometry"/></mxCell><mxCell id="L4n" value="LAYER 4 - AUTHORIZATION IN YOUR API" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="578" width="596" height="18" as="geometry"/></mxCell><mxCell id="L4r" value="What may you see?" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="595" width="596" height="16" as="geometry"/></mxCell><mxCell id="L4i0" value="&lt;b&gt;Your own code, never middleware&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;A WHERE clause on the validated token's user id. Never an id the client supplied. OWASP API #1.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="32" y="616" width="596" height="58" as="geometry"/></mxCell><mxCell id="L4c0" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="44" y="626" width="38" height="38" as="geometry"/></mxCell><mxCell id="L5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="726" width="620" height="104" as="geometry"/></mxCell><mxCell id="L5n" value="LAYER 5 - AZURE SQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="730" width="596" height="18" as="geometry"/></mxCell><mxCell id="L5r" value="Can you even reach me?" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="32" y="747" width="596" height="16" as="geometry"/></mxCell><mxCell id="L5i0" value="&lt;b&gt;Private endpoint&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Private IP in your VNet, public access off&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="32" y="768" width="293" height="58" as="geometry"/></mxCell><mxCell id="L5c0" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="44" y="778" width="38" height="38" as="geometry"/></mxCell><mxCell id="L5i1" value="&lt;b&gt;Azure SQL Database&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;No internet-facing address left to scan or guess&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=62;" vertex="1" parent="1"><mxGeometry x="335" y="768" width="293" height="58" as="geometry"/></mxCell><mxCell id="L5c1" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="347" y="778" width="38" height="38" as="geometry"/></mxCell><mxCell id="le0" value="the requests that survived the ruleset" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le1" value="the bearer token, on a call your code owns" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le2" value="a validated identity - and only an identity" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le3" value="one query, filtered to that identity" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0" value="the only call the app ever makes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="miss" value="✕ Skip layer 4 and a valid token from a real, signed-in user reads someone else's order." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="620" height="20" as="geometry"/></mxCell><mxCell id="miss2" value="Layer 1 is the only address the app knows. Nothing below it has a public one." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="882" width="620" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>