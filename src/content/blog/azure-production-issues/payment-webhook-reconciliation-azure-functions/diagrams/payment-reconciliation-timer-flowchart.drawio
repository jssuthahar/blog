<mxfile host="app.diagrams.net"><diagram name="Reconcile" id="Reconcile"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="6" width="778" height="632" as="geometry"/></mxCell><mxCell id="start" value="Every 5 minutes: each order&lt;br&gt;PendingPayment for 3+ minutes" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="140" y="30" width="320" height="56" as="geometry"/></mxCell><mxCell id="q1" value="Ask the gateway by the&lt;br&gt;order reference: captured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="126" width="300" height="100" as="geometry"/></mxCell><mxCell id="q1d" value="✓ Enqueue the payment event.&lt;br&gt;The same processor places the order" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="148" width="300" height="56" as="geometry"/></mxCell><mxCell id="q2" value="Failed or&lt;br&gt;abandoned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="300" height="100" as="geometry"/></mxCell><mxCell id="q2d" value="Mark PaymentFailed.&lt;br&gt;The gateway said so" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="292" width="300" height="56" as="geometry"/></mxCell><mxCell id="q3" value="Pending for&lt;br&gt;15 minutes or more?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="150" y="414" width="300" height="100" as="geometry"/></mxCell><mxCell id="q3d" value="Still pending. Ask again&lt;br&gt;on the next run" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="436" width="300" height="56" as="geometry"/></mxCell><mxCell id="end" value="Cancel the payment at the gateway first,&lt;br&gt;then expire the order" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="130" y="558" width="340" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="start" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="q1" target="q1d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=bloc