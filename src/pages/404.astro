---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <div class="mx-auto max-w-xl py-20 text-center">
    <p class="text-6xl font-bold tracking-tight text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">This page doesn't exist</h1>
    <p class="mt-3 text-muted">
      The link may be outdated, or the post may have moved during the migration from Blogger.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-md px-5 py-2.5 text-sm font-medium text-white"
        style="background: var(--accent);"
      >
        Go home
      </a>
      <a href="/search" class="rounded-md border border-default px-5 py-2.5 text-sm font-medium hover:bg-subtle">
        Search articles
      </a>
    </div>
  </div>
</BaseLayout>
