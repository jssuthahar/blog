<mxfile host="app.diagrams.net"><diagram name="Before" id="Before"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="116" y="16" width="368" height="570" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1. Developer request&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;A small change, on paper&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="40" width="320" height="62" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2. Search stale docs&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Written for a version that no longer exists&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="132" width="320" height="62" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3. Read unfamiliar code&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Hours, sometimes days&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="224" width="320" height="62" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4. Ask the one senior&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;If they are still at the company&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="316" width="320" height="62" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;5. Implement carefully&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Blast radius unknown&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="408" width="320" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;6. Test manually and hope&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;No regression suite to catch the miss&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="500" width="320" height="62" as="geometry"/></mxCell><mxCell id="ce0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative