---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppLaunchRedirect from '../components/AppLaunchRedirect.astro';
import Avatar from '../components/Avatar.astro';
import EventCard from '../components/EventCard.astro';
import Newsletter from '../components/Newsletter.astro';
import SubscribePopup from '../components/SubscribePopup.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ShareRow from '../components/ShareRow.astro';
import SiteChat from '../components/SiteChat.astro';
import TestimonialForm from '../components/TestimonialForm.astro';
import { homeTestimonials } from '../lib/testimonials';
import { SITE, AUTHOR, BOOKING, SPEAKING_TOPICS, ADSENSE_SLOT_DISPLAY } from '../config';
import { CATEGORIES, getPublishedPosts, postUrl, formatDate, readingTime } from '../lib/posts';
import { allArticles, articleCategories, primaryCategory, capturePayload } from '../lib/articles';
import { featuredRepos, repoIndex, languageColor } from '../lib/repos';
import { getUpcomingEvents, eventSchema } from '../lib/speaking';
import { contributionPillars, publishingSpan } from '../lib/evidence';
import ContributionTimeline from '../components/ContributionTimeline.astro';
import AdUnit from '../components/AdUnit.astro';
import HeroCarousel, { type Slide } from '../components/HeroCarousel.astro';
import MicrosoftBadges from '../components/MicrosoftBadges.astro';
import RecentlyRead from '../components/RecentlyRead.astro';
import SeriesQuickNav from '../components/SeriesQuickNav.astro';
import CoverArt from '../components/CoverArt.astro';
import { formatEventDate, FORMAT_LABELS } from '../lib/speaking';

const posts = await getPublishedPosts();

// The blog leads the page: the newest post gets the large card, the next five
// sit beside it as rows. Everything else on the home page is supporting proof.
const [latestPost, ...olderPosts] = posts;
const nextPosts = olderPosts.slice(0, 5);
const latestCategory = latestPost ? CATEGORIES[latestPost.data.category] : undefined;

// The main-site library is the deepest proof of expertise — lead with it
// rather than leaving 236 articles one click away.
const articles = allArticles();
const spotlight = articles.filter((a) => a.image).slice(0, 3);

// A dense second tier: showing 12 more titles proves the depth of the library
// in roughly the height three more cards would have cost.
const spotlightUrls = new Set(spotlight.map((a) => a.url));
const moreArticles = articles.filter((a) => !spotlightUrls.has(a.url)).slice(0, 12);
const topics = articleCategories(8).slice(0, 9);
const repos = featuredRepos(4);
const upcoming = await getUpcomingEvents();

const pillars = contributionPillars();
const span = publishingSpan();

const testimonials = homeTestimonials(5);
const leadQuote = testimonials.filter((t) => t.featured).slice(0, 2);
const restQuotes = testimonials.filter((t) => !t.featured);

/**
 * Banner slides, interleaved so the first three cover all three kinds — a
 * visitor sees a post, an article, and an event without waiting through a
 * run of the same type. Blog posts go first in each round: they are the
 * writing this site is actually for.
 */
const articleSlides: Slide[] = articles.slice(0, 3).map((a) => ({
  kind: 'Latest article',
  title: a.title,
  href: a.url,
  external: true,
  image: a.image,
  meta: a.categories[0],
  cta: 'Read the article',
}));

// Every post already has a share card drawn for it, so the banner shows that
// rather than an empty panel — the same title card people meet in a feed.
const blogSlides: Slide[] = posts.slice(0, 3).map((p) => ({
  kind: 'From the blog',
  title: p.data.title,
  href: postUrl(p),
  image: `/og/w1200/${p.id}.webp`,
  meta: CATEGORIES[p.data.category].label,
  cta: 'Read the post',
}));

const eventSlides: Slide[] = upcoming.slice(0, 2).map((e) => ({
  kind: 'Upcoming event',
  title: e.data.talk ?? e.data.title,
  href: e.data.registrationUrl ?? e.data.url ?? '/speaking/',
  external: Boolean(e.data.registrationUrl ?? e.data.url),
  // The event name rides along in the meta line when the title is the talk,
  // so dropping the slide summary costs the reader nothing.
  meta: [FORMAT_LABELS[e.data.format], formatEventDate(e), e.data.talk ? e.data.title : e.data.location]
    .filter(Boolean)
    .join(' · '),
  cta: 'Event details',
}));

const slides: Slide[] = [];
for (let i = 0; i < 3; i++) {
  for (const group of [blogSlides, articleSlides, eventSlides]) {
    if (group[i]) slides.push(group[i]);
  }
}

// No email is published; booking goes to the scheduler or the contact page.
const bookingHref = BOOKING.scheduler || '/contact/';

const schema = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    name: SITE.title,
    description: SITE.description,
    url: SITE.url,
    author: { '@id': `${SITE.url}/#person` },
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.publishedAt.toISOString(),
      url: new URL(postUrl(p), SITE.url).href,
    })),
  },
  ...eventSchema(upcoming, SITE.url, `${SITE.url}/#person`),
  // No Review schema: self-serving testimonials reviewing the site's own author
  // aren't eligible for review rich results and fail validation (Person is not a
  // valid itemReviewed type). The quotes remain visible on the page.
];
---

<BaseLayout title={SITE.title} description={SITE.description} schema={schema} wide>
  <!-- An installed launch belongs on the app feed, not the marketing page. -->
  <AppLaunchRedirect />

  <!-- ══════════════ Hero: claim, proof, and action on one screen ══════════════ -->
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:px-6 lg:pt-16 lg:pb-12">
    <div class="grid items-center gap-10 lg:grid-cols-[1.3fr_0.9fr]">
      <div>
        <p class="eyebrow">
          <span class="text-accent">MS</span>DEVBUILD — {SITE.alternateName}
        </p>
        <div class="mt-3 flex items-center gap-3">
          <Avatar size={40} />
          <div class="text-sm">
            <p class="font-semibold">{AUTHOR.name}</p>
            <p class="text-muted">{AUTHOR.jobTitle} · {AUTHOR.location}</p>
          </div>
        </div>

        <h1 class="display mt-6 text-[2.25rem] sm:text-[2.75rem] lg:text-[3rem]">
          {span.activeYears} years contributing to the
          <span style="color: var(--accent);">developer community</span>
        </h1>

        <!-- The lead deliberately repeats the H1 wording ("contributing to the
             developer community") — auditors flag an H1 whose terms never
             appear in the body copy. -->
        <p class="mt-4 max-w-xl leading-relaxed text-muted text-pretty">
          {AUTHOR.yearsExperience}+ years as a solutions architect across Cloud, AI, Mobile and Web —
          Azure, .NET, Flutter and modern web. {span.activeYears} of those years went into
          contributing to the developer community: {articles.length} articles, 50+ conference
          sessions, {repoIndex.count} open-source projects, 15,000+ developers reached.
        </p>

        <!-- Recognition moved inline so the panel slot can carry the banner. -->
        <ul class="mt-6 flex flex-wrap gap-2">
          {[...AUTHOR.awards, 'Microsoft Certified Trainer'].map((award) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-default px-3 py-1.5 text-xs font-medium">
              <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" style="color: var(--accent);" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.47a.75.75 0 0 0-1.22-.86l-3.24 4.53-1.62-1.62a.75.75 0 0 0-1.06 1.06l2.24 2.24a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
              </svg>
              {award}
            </li>
          ))}
        </ul>

        <!-- Prominent power search: opens the ⌘K palette over all content. -->
        <button
          type="button"
          data-open-search
          class="mt-6 flex w-full max-w-md items-center gap-3 rounded-full border border-default bg-[var(--bg)] px-5 py-3 text-left text-sm text-muted transition-colors hover:border-[var(--accent)]"
        >
          <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          <span class="flex-1">Search {articles.length}+ articles, posts and pages…</span>
          <kbd class="hidden rounded border border-default px-1.5 py-0.5 text-xs sm:inline">⌘K</kbd>
        </button>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={bookingHref} class="btn btn-primary">Book me to speak</a>
          <a href="/about/" class="btn btn-outline">Full profile</a>
          {BOOKING.available && (
            <span class="inline-flex items-center gap-2 text-sm text-muted">
              <span class="size-2 rounded-full" style="background: var(--accent);"></span>
              {BOOKING.availabilityNote}
            </span>
          )}
        </div>
      </div>

      <HeroCarousel slides={slides} label="Latest articles, blog posts and events" />

    </div>
  </section>

  <!-- ══════════════ Recently read ══════════════
       Hidden for first-time visitors; populated from local history so returning
       readers can pick up where they left off before anything else. -->
  <RecentlyRead limit={4} />

  <!-- ══════════════ Latest from the blog ══════════════
       The blog is what this site is for, so it sits above the stats, the
       badges and the syndicated article library: newest post large, the next
       five as rows beside it, then series entry points and the feed. -->
  {latestPost && (
    <section
      id="latest"
      class="border-y border-default bg-subtle scroll-mt-16"
      aria-labelledby="latest-heading"
    >
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="section-head">
          <div>
            <p class="eyebrow">Latest</p>
            <h2 id="latest-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
              New on the blog
            </h2>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <a href="/blog/" class="btn btn-primary btn-sm">All {posts.length} posts</a>
            <!-- The feed is also the newsletter pipeline, so it gets a real
                 control here rather than only a footer link. -->
            <a
              href="/rss.xml"
              class="btn btn-outline btn-sm"
              title="Subscribe to the RSS feed — newest post first"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="6.18" cy="17.82" r="2.18" />
                <path d="M4 10.1v2.9a7 7 0 0 1 7 7h2.9A9.9 9.9 0 0 0 4 10.1Zm0-5.1v2.9A14.1 14.1 0 0 1 18.1 22H21A17 17 0 0 0 4 5Z" />
              </svg>
              RSS feed
            </a>
          </div>
        </div>

        <div class="mt-6 grid gap-8 lg:grid-cols-[1.05fr_1fr]">
          <!-- Newest post, full card. -->
          <article class="group relative flex flex-col overflow-hidden rounded-xl border border-default bg-[var(--bg)]">
            <div class="aspect-[1200/630] overflow-hidden bg-subtle">
              <CoverArt
                post={latestPost}
                large
                eager
                class="transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span
                  class="rounded-full px-2 py-0.5 font-medium"
                  style={`background: oklch(0.62 0.17 ${latestCategory!.hue} / 0.14); color: oklch(0.62 0.17 ${latestCategory!.hue});`}
                >
                  {latestCategory!.label}
                </span>
                <span class="font-semibold text-accent">Latest post</span>
                <time datetime={latestPost.data.publishedAt.toISOString()} class="text-muted">
                  {formatDate(latestPost.data.publishedAt)}
                </time>
                <span class="text-muted">{readingTime(latestPost.body ?? '')} min read</span>
              </div>

              <h3 class="mt-2.5 text-xl leading-snug font-semibold tracking-tight text-balance sm:text-2xl">
                <a href={postUrl(latestPost)} class="after:absolute after:inset-0 group-hover:text-accent">
                  {latestPost.data.title}
                </a>
              </h3>

              <p class="mt-2 leading-relaxed text-muted text-pretty">
                {latestPost.data.description}
              </p>

              <span class="mt-4 text-sm font-semibold text-accent">Read the post →</span>
            </div>
          </article>

          <!-- The five behind it, dense rows so more titles fit the same height. -->
          <div>
            <h3 class="border-b border-default pb-2 text-xs font-semibold tracking-wider uppercase text-muted">
              More recent posts
            </h3>

            <ul class="divide-y divide-[var(--border)]">
              {nextPosts.map((post) => {
                const category = CATEGORIES[post.data.category];
                return (
                  <li class="group relative py-3.5">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                      <span class="font-medium" style={`color: oklch(0.62 0.17 ${category.hue});`}>
                        {category.label}
                      </span>
                      <time datetime={post.data.publishedAt.toISOString()} class="text-muted">
                        {formatDate(post.data.publishedAt)}
                      </time>
                      <span class="text-muted">{readingTime(post.body ?? '')} min</span>
                      {post.data.series && (
                        <span class="text-muted">Part {post.data.seriesOrder}</span>
                      )}
                    </div>
                    <h4 class="mt-1 leading-snug font-medium">
                      <a href={postUrl(post)} class="after:absolute after:inset-0 group-hover:text-accent">
                        {post.data.title}
                      </a>
                    </h4>
                    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">
                      {post.data.description}
                    </p>
                  </li>
                );
              })}
            </ul>

            <a href="/blog/" class="mt-4 inline-block text-sm font-semibold text-accent hover:underline">
              Every post on the blog →
            </a>
          </div>
        </div>

        <!-- Series entry points: the fastest way into a multi-part guide. -->
        <div class="mt-8 border-t border-default pt-5">
          <SeriesQuickNav label="Jump into a series" />
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════ Contribution at a glance ══════════════
       Each number links to the evidence behind it, so the claim and the proof
       are never more than one click apart. -->
  <section class="border-y border-default bg-subtle" aria-labelledby="impact-heading">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="impact-heading" class="text-sm font-semibold tracking-wider uppercase text-muted">
          Contribution to the developer community
        </h2>
        <a href="/contributions/" class="text-sm font-semibold text-accent hover:underline">
          Full contribution record →
        </a>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-7 md:grid-cols-3 lg:grid-cols-6">
        {pillars.map(({ value, label, detail, href }) => (
          <a href={href} class="group">
            <div class="text-[1.75rem] leading-none font-bold tracking-tight text-accent">
              {value}
            </div>
            <div class="mt-1.5 text-sm font-medium group-hover:text-accent">{label}</div>
            <div class="mt-0.5 text-xs leading-snug text-muted">{detail}</div>
          </a>
        ))}
      </div>

      <div class="mt-10 border-t border-default pt-6">
        <ContributionTimeline />
      </div>
    </div>
  </section>

  <!-- ══════════════ Microsoft recognition ══════════════
       Verifiable Microsoft achievements as visual badges, each linking to its
       Microsoft Learn record — proof placed high on the page. -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-label="Microsoft recognition">
    <MicrosoftBadges variant="compact" />
  </section>

  <!-- ══════════════ Articles ══════════════ -->
  <section class="mx-auto max-w-6xl px-4 section sm:px-6" aria-labelledby="articles-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Articles</p>
        <h2 id="articles-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
          500+ articles, written from production
        </h2>
      </div>
      <a href="/articles/" class="btn btn-outline btn-sm">Browse all {articles.length}</a>
    </div>

    <!-- Topic chips double as an at-a-glance map of what the library covers.
         nofollow because these are faceted filter URLs: each one is a subset of
         /articles/, so crawling them spends budget on near-duplicate listings
         of pages already reachable from the unfiltered index. -->
    <ul class="mt-5 flex flex-wrap gap-2">
      {topics.map(({ label, count, slug }) => (
        <li>
          <a
            href={`/articles/?category=${slug}`}
            rel="nofollow"
            class="inline-flex items-center gap-1.5 rounded-full border border-default px-3 py-1 text-xs transition-colors hover:bg-subtle"
          >
            {label}
            <span class="text-muted">{count}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Featured three with artwork, then a dense list. More on screen, less scrolling. -->
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {spotlight.map((article) => (
        <article class="group relative flex gap-4 md:block">
          <div class="aspect-[4/3] w-28 shrink-0 overflow-hidden rounded-md border border-default md:aspect-[16/9] md:w-full">
            <img
              src={article.image!}
              alt={article.title}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            />
          </div>
          <div class="min-w-0 md:mt-3">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
              {article.categories.slice(0, 2).map((label) => (
                <span class="rounded-full border border-default px-2 py-0.5">{label}</span>
              ))}
            </div>
            <h3 class="mt-1 leading-snug font-semibold tracking-tight">
              <a
                href={article.url}
                rel="noopener"
                data-capture={capturePayload({ title: article.title, url: article.url, category: primaryCategory(article), image: article.image })}
                class="after:absolute after:inset-0 group-hover:text-accent"
              >
                {article.title}
              </a>
            </h3>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted">{article.excerpt}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Second tier: 12 more titles in two dense columns. -->
    <div class="mt-8 border-t border-default pt-5">
      <ul class="grid grid-cols-1 gap-x-10 sm:grid-cols-2">
        {moreArticles.map((article) => (
          <li class="group relative flex items-baseline gap-3 border-b border-default py-2.5">
            <a
              href={article.url}
              rel="noopener"
              data-capture={capturePayload({ title: article.title, url: article.url, category: primaryCategory(article), image: article.image })}
              class="min-w-0 flex-1 truncate text-sm after:absolute after:inset-0 group-hover:text-accent"
            >
              {article.title}
            </a>
            <span class="shrink-0 text-xs text-muted">
              {article.categories[0] ?? ''}
            </span>
          </li>
        ))}
      </ul>
      <a href="/articles/" class="mt-4 inline-block text-sm font-semibold text-accent hover:underline">
        See all {articles.length} articles →
      </a>
    </div>

  </section>

  <!-- ══════════════ Speaker ══════════════
       A deep neutral band rather than a saturated gradient: it separates the
       section without introducing a second brand colour. -->
  <section
    id="speaking"
    class="scroll-mt-16"
    style="background: var(--navy); color: oklch(0.96 0.004 265);"
    aria-labelledby="speaking-heading"
  >
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <span class="badge-chip" style="opacity: 0.7;">Speaker</span>
          <h2 id="speaking-heading" class="display mt-4 text-2xl sm:text-[2rem]">
            50+ sessions. 15,000+ developers reached.
          </h2>
          <p class="mt-3 max-w-md leading-relaxed" style="opacity: 0.72;">
            Conference sessions, webinars, and community meetups on Azure, applied AI,
            and .NET — in English or Tamil, on site or online.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href={bookingHref} class="btn" style="background: #fff; color: var(--navy);">
              Book an appointment
            </a>
            <a
              href="/speaking/"
              class="btn"
              style="background: transparent; color: #fff; border: 1.5px solid rgb(255 255 255 / 0.35);"
            >
              Talks &amp; topics
            </a>
          </div>

          <p class="mt-3 text-sm" style="opacity: 0.6;">{BOOKING.responseTime}</p>
        </div>

        <div>
          <h3 class="text-xs font-semibold tracking-wider uppercase" style="opacity: 0.6;">
            {upcoming.length > 0 ? 'Upcoming' : 'Talks I give'}
          </h3>

          {upcoming.length > 0 ? (
            <div class="mt-3 space-y-2">
              {upcoming.slice(0, 3).map((event) => (
                <div class="rounded-lg bg-white/95 p-1" style="color: var(--navy);">
                  <EventCard event={event} />
                </div>
              ))}
            </div>
          ) : (
            <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
              {SPEAKING_TOPICS.map(({ title, description }) => (
                <li class="border-t py-3.5" style="border-color: rgb(255 255 255 / 0.16);">
                  <h4 class="text-sm font-semibold">{title}</h4>
                  <p class="mt-1 text-sm leading-relaxed" style="opacity: 0.66;">{description}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ Open source ══════════════ -->
  <section class="mx-auto max-w-6xl px-4 section sm:px-6" aria-labelledby="oss-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Open source</p>
        <h2 id="oss-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">Code you can read</h2>
      </div>
      <p class="text-sm text-muted">
        {repoIndex.count} repos · {repoIndex.totalStars} stars · {repoIndex.totalForks} forks
        <a href="/open-source/" class="ml-3 font-semibold text-accent hover:underline">All projects →</a>
      </p>
    </div>

    <ul class="mt-2 divide-y divide-[var(--border)]">
      {repos.map((repo) => (
        <li class="group relative flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3.5">
          <a href={repo.url} rel="noopener" class="font-semibold after:absolute after:inset-0 group-hover:text-accent">
            {repo.name}
          </a>
          <p class="min-w-0 flex-1 truncate text-sm text-muted">{repo.description}</p>
          {repo.language && (
            <span class="inline-flex items-center gap-1.5 text-xs text-muted">
              <span class="size-2.5 rounded-full" style={`background: ${languageColor(repo.language)};`}></span>
              {repo.language}
            </span>
          )}
          <span class="w-16 text-right text-xs text-muted">{repo.stars}★ {repo.forks}⑂</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- One display ad between the open-source and testimonials sections. -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
  </div>

  <!-- ══════════════ Testimonials ══════════════ -->
  {testimonials.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 section sm:px-6" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 id="testimonials-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
            How these articles helped
          </h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <!-- The form is on this page already, so the button jumps to it rather
               than opening the popup — a second copy of the form would repeat
               its heading and help text in the page source. -->
          <a href="#write-testimonial" class="btn btn-accent btn-sm">Add your feedback</a>
          <a href="/testimonials/" class="btn btn-outline btn-sm">All testimonials</a>
        </div>
      </div>

      {leadQuote.length > 0 && (
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {leadQuote.map((t) => <TestimonialCard testimonial={t} highlight />)}
        </div>
      )}

      {restQuotes.length > 0 && (
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {restQuotes.map((t) => <TestimonialCard testimonial={t} />)}
        </div>
      )}

      <!-- The one form on this page: a reader who scrolls this far should not
           have to open a dialog to answer. -->
      <div class="mt-8">
        <TestimonialForm compact formId="home" />
      </div>
    </section>
  )}

  <!-- ══════════════ Contact + Subscribe ══════════════ -->
  <section class="border-t border-default bg-subtle" aria-labelledby="contact-heading">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
          Invite me to your event
        </h2>
        <p class="mt-3 max-w-lg leading-relaxed text-muted text-pretty">
          Based in {AUTHOR.location}, speaking globally. Conference sessions, webinars,
          and community meetups — or just feedback on something I wrote.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact/" class="btn btn-primary">Get in touch</a>
          <a href={bookingHref} class="btn btn-outline">Book an appointment</a>
        </div>

        <dl class="mt-8 grid max-w-md grid-cols-2 gap-x-6 gap-y-3 text-sm">
          {[
            { label: 'LinkedIn', value: 'in/jssuthahar', href: AUTHOR.linkedin },
            { label: 'GitHub', value: '@jssuthahar', href: 'https://github.com/jssuthahar' },
            { label: 'YouTube', value: '@MSDEVBUILD', href: 'https://www.youtube.com/@MSDEVBUILD' },
            { label: 'X', value: '@jssuthahar', href: AUTHOR.x },
            { label: 'Contact', value: 'Send a message', href: '/contact/' },
          ].map(({ label, value, href }) => (
            <div class="min-w-0">
              <dt class="text-xs text-muted">{label}</dt>
              <dd class="truncate font-medium">
                <a href={href} rel="noopener" class="hover:text-accent">{value}</a>
              </dd>
            </div>
          ))}
        </dl>

        <!-- Sharing the site itself. Only one ShareRow may render per page —
             its script wires up the first [data-share-row] it finds — so this
             stays on the home page and posts keep their own row. -->
        <div class="mt-8 border-t border-default pt-6">
          <ShareRow title={`${SITE.title} — ${SITE.tagline}`} path="/" />
        </div>
      </div>

      <div id="subscribe" class="scroll-mt-20 self-center">
        <Newsletter compact />
      </div>
    </div>
  </section>

  <!-- Home page only, once per visitor. -->
  <SubscribePopup />

  <!-- Site-wide find-an-article assistant (home only; posts have their own chat). -->
  <SiteChat />
</BaseLayout>
