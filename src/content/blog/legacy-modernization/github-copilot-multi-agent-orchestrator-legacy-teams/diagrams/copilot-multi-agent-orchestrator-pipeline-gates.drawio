<mxfile host="app.diagrams.net"><diagram name="Pipeline" id="Pipeline"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="111" y="6" width="644" height="992" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Developer request&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Stated through a reusable prompt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="30" width="330" height="58" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Orchestrator agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Interprets the request and sequences the work&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="118" width="330" height="62" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Discovery agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Read-only map of what the change touches&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="214" width="330" height="62" as="geometry"/></mxCell><mxCell id="g3" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HUMAN GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Approve the plan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="310" width="330" height="48" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Developer agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Implements behind a seam&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="392" width="330" height="62" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;Tester agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Characterization tests around the change&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="488" width="330" height="62" as="geometry"/></mxCell><mxCell id="g6" value="&lt;font color='#6B7280'&gt;&lt;b&gt;CI GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Tests must pass" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="135" y="584" width="330" height="48" as="geometry"/></mxCell><mxCell id="g6bk" value="Red -&gt; back to the developer agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="481" y="596" width="250" height="34" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;Security agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Read-only review of the diff&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="666" width="330" height="62" as="geometry"/></mxCell><mxCell id="g8" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HOOK + CI GATE&lt;