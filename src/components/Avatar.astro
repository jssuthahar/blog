---
import { Image } from 'astro:assets';
import photo from '../assets/author.jpg';
import { AUTHOR } from '../config';

interface Props {
  size?: number;
  class?: string;
  eager?: boolean;
}

const { size = 56, class: className = '', eager = false } = Astro.props;

// Imported rather than referenced from public/, so Astro emits AVIF/WebP at the
// size actually rendered — the source is 640px and most slots are under 64px.
// The public/ copy stays for the absolute URL in JSON-LD.
---

<Image
  src={photo}
  alt={AUTHOR.name}
  width={size}
  height={size}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  class:list={['rounded-full object-cover', className]}
  style={`width:${size}px;height:${size}px;`}
/>
