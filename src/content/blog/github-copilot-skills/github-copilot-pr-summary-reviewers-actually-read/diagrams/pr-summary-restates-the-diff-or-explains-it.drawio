<mxfile host="app.diagrams.net"><diagram name="PR summary" id="PRsummary"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="6" width="818" height="700" as="geometry"/></mxCell><mxCell id="fc_start" value="Copilot drafts a PR description from the diff" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="210" y="30" width="260" height="48" as="geometry"/></mxCell><mxCell id="fc0" value="Does it say anything the diff does not?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="200" y="122" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr0" value="It restated the diff.&lt;br&gt;The reviewer already&lt;br&gt;has the diff." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="620" y="146" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn0" value="no" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc0" target="fcr0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc_start" target="fc0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc1" value="Does it say WHY, not just what?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="200" y="262" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr1" value="Reviewer reads all&lt;br&gt;eleven files to find out" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="620" y="286" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn1" value="no" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc1" target="fcr1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce1" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc0" target="fc1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc2" value="Does it flag the risky part?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="200" y="402" width="280" height="96" as="geometry"/></mxCell><mxCell id="fcr2" value="The migration in the&lt;br&gt;middle goes unnoticed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="620" y="426" width="190" height="48" as="geometry"/></mxCell><mxCell id="fcn2" value="no" style="html=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="fc2" target="fcr2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fce2" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc1" target="fc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fc_end" value="A description a reviewer actually reads" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="210" y="542" width="260" height="48" as="geometry"/></mxCell><mxCell id="fce_end" value="yes" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="fc2" target="fc_end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="The default failure mode is restating the diff, which is the one thing the reviewer does not need." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="640" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>