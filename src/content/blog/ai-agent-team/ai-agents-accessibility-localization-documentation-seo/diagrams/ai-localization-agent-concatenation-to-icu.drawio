<mxfile host="app.diagrams.net"><diagram name="Concatenation to ICU" id="ConcatenationtoICU"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="6" width="528" height="488" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;1. 'Order ${order.id} → ${order.status.label}'&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;partner_bloc.dart:125, English word order&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="480" height="64" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. The localization agent flags it&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;a sentence built from fragments cannot be translated&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="124" width="480" height="64" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. One ICU message with placeholders&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;orderStatusChanged(id, status)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="218" width="480" height="64" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;4. A description for the translator&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;a toast after a status change, a noun phrase&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="312" width="480" height="64" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;5. Width checked at +35%&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the snackbar still fits in a longer language&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="90" y="406" width="480" height="64" as="geometry"/></mxCell><mxCell id="te0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>