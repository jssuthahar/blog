---
/**
 * A series hub — one URL that owns a whole topic.
 *
 * The parts already rank individually for their own long-tail queries. What
 * nothing on the site covered was the head term: "azure ai foundry agents",
 * "legacy modernization with copilot". A hub gives that query a page whose
 * whole subject is the topic, concentrates internal links on one URL instead of
 * spreading them across twelve, and gives an answer engine something to cite as
 * the source for the subject rather than for one instalment of it.
 *
 * The prose from the series definition file is rendered here, not just its
 * one-line description — a hub with only a list of links is a sitemap, and
 * search engines treat it as one.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE } from '../../config';
import { getSeriesIndex, formatDate, postUrl, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const [index, definitions] = await Promise.all([getSeriesIndex(), getCollection('series')]);

  // Drive the routes off the index, not the definition files: a series exists
  // as soon as posts reference it, and a hub for a series with no published
  // parts would be an empty page.
  return index.map((series) => ({
    params: { id: series.id },
    props: { series, definition: definitions.find((d) => d.id === series.id) ?? null },
  }));
}

const { series, definition } = Astro.props;
const { id, title, description, parts, latest } = series;

const Body = definition ? (await render(definition)).Content : null;

const path = `/series/${id}`;
const url = new URL(path, SITE.url).href;

const totalWords = parts.reduce((n, p) => n + (p.body ?? '').split(/\s+/).filter(Boolean).length, 0);

const schema: Record<string, unknown>[] = [
  {
    '@type': 'CreativeWorkSeries',
    '@id': `${url}#series`,
    name: title,
    description,
    url,
    author: { '@id': `${SITE.url}/#person` },
    numberOfItems: parts.length,
    inLanguage: SITE.lang,
  },
  {
    // The reading order, stated explicitly. A series is only useful in order,
    // and ItemList is the one way to say so that a machine reads.
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: parts.length,
    itemListElement: parts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: new URL(postUrl(post), SITE.url).href,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Series', item: `${SITE.url}/series` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={path} schema={schema}>
  <header class="max-w-2xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/series/" class="hover:text-accent">Series</a>
    </nav>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mt-3 text-muted">{description}</p>
    <p class="mt-4 text-xs text-muted">
      {parts.length} parts · about {Math.round(totalWords / 200)} minutes end to end · updated {formatDate(latest.data.publishedAt)}
    </p>
  </header>

  {Body && (
    <!-- The site's own reading styles, not Tailwind's `prose` — typography's
         default decorates inline code with literal backticks. -->
    <div class="prose-reading mt-8">
      <Body />
    </div>
  )}

  <h2 class="mt-12 text-xl font-semibold tracking-tight">Read it in order</h2>

  <ol class="mt-6 space-y-4">
    {parts.map((post, i) => (
      <li class="flex gap-4 rounded-xl border border-default p-5">
        <span class="text-sm font-semibold tabular-nums text-muted">{i + 1}</span>
        <div class="min-w-0">
          <a href={postUrl(post)} class="font-semibold hover:text-accent">{post.data.title}</a>
          <p class="mt-1 text-sm text-muted">{post.data.description}</p>
          <p class="mt-2 text-xs text-muted">
            {formatDate(post.data.publishedAt)} · {readingTime(post.body ?? '')} min read
          </p>
        </div>
      </li>
    ))}
  </ol>

  <div class="mt-16">
    <Newsletter source={`series-${id}`} />
  </div>
</BaseLayout>
