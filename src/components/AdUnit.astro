---
import { ADSENSE_CLIENT } from '../config';

interface Props {
  /** AdSense ad-unit slot ID. When empty the unit renders nothing. */
  slot?: string;
  /**
   * 'in-article' — fluid unit for the end of a reading page (default).
   * 'display'    — responsive unit for listing pages.
   * 'multiplex'  — autorelaxed grid of recommendations for the foot of a post.
   * 'in-feed'    — native unit sized to sit between items in the app feed.
   */
  format?: 'in-article' | 'display' | 'multiplex' | 'in-feed';
  /** Required by 'in-feed': the data-ad-layout-key AdSense generates. */
  layoutKey?: string;
  /** Extra classes for the wrapping <aside>. */
  class?: string;
}

const { slot, format = 'in-article', layoutKey, class: className } = Astro.props;

// Render only when both the account client and a real slot exist, so no empty
// ad frame ever ships to readers before the unit is configured. An in-feed unit
// additionally needs its layout key — without it Google renders nothing.
const show = Boolean(ADSENSE_CLIENT && slot && (format !== 'in-feed' || layoutKey));
---

{show && (
  <!-- `w-full` is load-bearing, not cosmetic: as a grid child (the /app feed)
       the `mx-auto` here would cancel `justify-self: stretch` and shrink this to
       max-content — a slot about as wide as the word "Advertisement", which
       AdSense will not fill. The explicit width keeps the margins at 0 and the
       slot the full width of the column. -->
  <aside
    class:list={['ad-unit mx-auto my-12 w-full max-w-[68ch] text-center', className]}
    aria-label="Advertisement"
  >
    <span class="mb-2 block text-[11px] font-medium tracking-wider text-muted uppercase">
      Advertisement
    </span>

    {format === 'in-article' && (
      <ins
        class="adsbygoogle"
        style="display:block; text-align:center;"
        data-ad-layout="in-article"
        data-ad-format="fluid"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
      ></ins>
    )}

    {format === 'display' && (
      <ins
        class="adsbygoogle"
        style="display:block;"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    )}

    {format === 'in-feed' && (
      <ins
        class="adsbygoogle"
        style="display:block;"
        data-ad-format="fluid"
        data-ad-layout-key={layoutKey}
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
      ></ins>
    )}

    {format === 'multiplex' && (
      <ins
        class="adsbygoogle"
        style="display:block;"
        data-ad-format="autorelaxed"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
      ></ins>
    )}
  </aside>
)}

<style>
  /* Google has no ad for this slot: remove the whole frame — label, rules and
     reserved height — so no empty box is left behind. This has to key off
     `unfilled` rather than hiding by default and revealing on `filled`: an <ins>
     inside a `display:none` parent measures 0px wide, and AdSense refuses to
     fill a zero-width slot, so hiding first would guarantee the empty state it
     is meant to clean up. */
  .ad-unit:has(ins[data-ad-status='unfilled']) {
    display: none;
  }

  /* Until the fill lands there is nothing to label, so hold the word back and
     keep its line box — revealing it must not shove the feed downward. */
  .ad-label {
    visibility: hidden;
  }

  .ad-unit:has(ins[data-ad-status='filled']) .ad-label {
    visibility: visible;
  }
</style>
