<mxfile host="app.diagrams.net"><diagram name="Leak response order" id="Leakresponseorder"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="16" width="714" height="466" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Check whether the key is being used&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Azure Monitor logs, grouped by caller IP&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="400" height="62" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Ship a version that no longer needs it&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;or put your API in front of it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="136" width="400" height="62" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Move traffic to the secondary key&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;most Azure services give you two for this&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="400" height="62" as="geometry"/></mxCell><mxCell id="g4" value="&lt;font color='#6B7280'&gt;&lt;b&gt;CHECK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Is anything still using the primary?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="60" y="328" width="400" height="48" as="geometry"/></mxCell><mxCell id="g4bk" value="yes: keep moving traffic first" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="476" y="340" width="250" height="34" as="geometry"/></mxCell><mxCell id="g5" value="Now regenerate the primary, then the secondary" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="400" height="48" as="geometry"/></mxCell><mxCell id="ge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>