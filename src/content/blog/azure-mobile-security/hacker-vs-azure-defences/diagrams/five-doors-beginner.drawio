<mxfile host="app.diagrams.net"><diagram name="Five doors" id="Fivedoors"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="6" width="608" height="774" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. The attacker&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Has your app, a laptop and plenty of time.&lt;br&gt;Tries five different ways in.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="560" height="80" as="geometry"/></mxCell><mxCell id="s1ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="47" width="46" height="46" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Door 1, Front Door WAF: &quot;Is this junk?&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Blocks floods and injection attacks at the edge.&lt;br&gt;Must be in Prevention mode, not Detection.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="560" height="80" as="geometry"/></mxCell><mxCell id="s2ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="157" width="46" height="46" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Door 2, Entra ID: &quot;Who are you?&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;No valid signed pass, no entry.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="560" height="80" as="geometry"/></mxCell><mxCell id="s3ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="267" width="46" height="46" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Door 3, your API: &quot;Is this yours?&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Logged in is not enough. You only get&lt;br&gt;your own orders, never someone else's.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="560" height="80" as="geometry"/></mxCell><mxCell id="s4ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="377" width="46" height="46" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Door 4, Key Vault: &quot;Nothing to steal&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;No keys in the code or the repo for&lt;br&gt;the attacker to find.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="560" height="80" as="geometry"/></mxCell><mxCell id="s5ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="487" width="46" height="46" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Door 5, private endpoint: &quot;Can you reach me?&quot;&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The database has no internet address,&lt;br&gt;so there's nothing to dial.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="560" height="80" as="geometry"/></mxCell><mxCell id="s6ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="597" width="46" height="46" as="geometry"/></mxCell><mxCell id="ssum" value="&lt;b&gt;Customer data: reachable only through all five doors.&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Each door guards a different thing. Miss one and the others can't cover for it.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="560" height="66" as="geometry"/></mxCell><mxCell id="se0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="se5" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s6" target="ssum"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>