---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags();

  return tags.map(({ slug, label }) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)),
    },
  }));
}

const { posts, label } = Astro.props;
---

<BaseLayout
  title={`Posts tagged ${label}`}
  description={`All articles tagged ${label} — ${posts.length} in total.`}
>
  <header class="max-w-2xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/tags/" class="hover:text-accent">Tags</a>
    </nav>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">#{label}</h1>
    <p class="mt-3 text-muted">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
  </header>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
