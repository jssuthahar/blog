<mxfile host="app.diagrams.net"><diagram name="Weekly learning loop" id="Weeklylearningloop"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="-14" width="808" height="572" as="geometry"/></mxCell><mxCell id="t" value="One concept a week, all eight steps" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="760" height="28" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. Learn&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;read the official docs, one-sentence summary&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="340" height="66" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Experiment&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;ask AI, compare with a real codebase&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="340" height="66" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Build&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;your own version, without copying&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="66" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Test&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;one test that passes, one that must fail&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="340" height="66" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Break&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;sign in as someone else, attack it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="340" height="66" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Fix&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;fix it and add a test so it stays fixed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="340" height="66" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7. Deploy&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;a rule on your laptop protects nobody&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="340" height="66" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8. Explain&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;300 words or 2 minutes, no AI open&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="340" height="66" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="next week: next concept" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="100" as="sourcePoint"/><mxPoint x="230" y="100" as="targetPoint"/><Array as="points"><mxPoint x="630" y="66"/><mxPoint x="230" y="66"/></Array></mxGeometry></mxCell><mxCell id="note" value="Most students stop after step 3. Interviews test step 8." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="760" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>