---
import BaseLayout from '../layouts/BaseLayout.astro';
import RepoCard from '../components/RepoCard.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import AdUnit from '../components/AdUnit.astro';
import { SITE, AUTHOR, ADSENSE_SLOT_DISPLAY } from '../config';
import Newsletter from '../components/Newsletter.astro';
import { allRepos, repoIndex } from '../lib/repos';
import { featuredProjects } from '../lib/featured-projects';

const liveCount = featuredProjects.filter((p) => p.live).length;

const repos = allRepos();
const withDescription = repos.filter((r) => r.description.length > 0);
const rest = repos.filter((r) => r.description.length === 0);


const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/open-source#page`,
    name: `Open source — ${AUTHOR.name}`,
    description: `Public repositories maintained by ${AUTHOR.name}, covering .NET, Xamarin, Azure, and developer tooling.`,
    about: { '@id': `${SITE.url}/#person` },
  },
];
---

<BaseLayout
  title="Open source"
  description={`${repoIndex.count} public repositories by ${AUTHOR.name} — .NET, Xamarin, Azure samples, Visual Studio extensions, and developer tools.`}
  schema={schema}
>
  <header class="max-w-3xl">
    <p class="eyebrow">Open source</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Code you can read</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted text-pretty">
      Flagship apps you can open and try, plus {repoIndex.count} public repositories. In my
      free time I explore new topics and get hands-on with different technologies — taking
      each idea end to end, from first commit to delivery — across AI and full-stack
      development with Dart, C#, React, and React Native, shipping to Android, iOS, and web.
    </p>
  </header>

  <section class="mt-10 flex flex-wrap gap-3" aria-label="Totals">
    {[
      { value: repoIndex.count, label: 'public repositories' },
      { value: repoIndex.totalStars, label: 'stars' },
      { value: repoIndex.totalForks, label: 'forks' },
    ].map(({ value, label }) => (
      <div class="rounded-xl border border-default px-5 py-4">
        <div class="text-2xl font-bold tracking-tight text-accent">{value}</div>
        <div class="mt-0.5 text-xs text-muted">{label}</div>
      </div>
    ))}

    <a href={`https://github.com/${repoIndex.user}`} rel="noopener" class="btn btn-outline self-center">
      View on GitHub ↗
    </a>
  </section>

  <section class="mt-14" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Featured projects</p>
        <h2 id="featured-heading" class="mt-2 text-xl font-semibold tracking-tight">
          Tools you can try right now
        </h2>
      </div>
      {liveCount > 0 && (
        <p class="text-sm text-muted">{liveCount} with a live demo you can open in the browser</p>
      )}
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project, i) => (
        <FeaturedProjectCard project={project} index={i} />
      ))}
    </div>
  </section>

  <section class="mt-16" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="border-b-2 border-default pb-3 text-xl font-semibold tracking-tight">
      More repositories
    </h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {withDescription.map((repo) => <RepoCard repo={repo} />)}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="mt-14" aria-labelledby="more-heading">
      <h2 id="more-heading" class="border-b-2 border-default pb-3 text-xl font-semibold tracking-tight">
        Also on GitHub
      </h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {rest.map((repo) => (
          <li>
            <a
              href={repo.url}
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-default px-3 py-1.5 text-sm transition-colors hover:bg-subtle"
            >
              {repo.name}
              {repo.stars > 0 && <span class="text-xs text-muted">{repo.stars}★</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-14">
    <Newsletter source="open-source" />
  </div>

  <!-- One display ad at the foot of the projects list. -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
</BaseLayout>

<style>
  /* Scroll-reveal for the featured cards: a gentle fade-up, staggered by the
     per-card `--reveal-delay`. `.is-in` is toggled by the observer below. */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
  }
  .reveal.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* Motion-sensitive readers see the cards immediately, never a transform. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Reveal cards as they scroll into view. Runs on every view-transition
  // navigation, not just first paint. If the API is missing, cards are shown.
  function armReveal() {
    const cards = document.querySelectorAll<HTMLElement>('.reveal');
    if (!cards.length) return;

    if (!('IntersectionObserver' in window)) {
      cards.forEach((c) => c.classList.add('is-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );

    cards.forEach((c) => io.observe(c));
  }

  document.addEventListener('astro:page-load', armReveal);
</script>
