<mxfile host="app.diagrams.net"><diagram name="Inside the APK" id="InsidetheAPK"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="136" y="6" width="538" height="735" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;msdevbuild-eats-release.apk  (or .ipa)&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;The same file the store hands to every device&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="400" height="58" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Rename to .zip and extract&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;unzip, then apktool or jadx - about a minute of work&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="200" y="136" width="400" height="62" as="geometry"/></mxCell><mxCell id="eh" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="entry" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="it0" value="&lt;b&gt;res/values/strings.xml&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;String constants, exactly as you typed them&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="230" y="250" width="420" height="66" as="geometry"/></mxCell><mxCell id="it1" value="&lt;b&gt;AndroidManifest.xml&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Endpoints, permissions, meta-data values&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="230" y="336" width="420" height="66" as="geometry"/></mxCell><mxCell id="it2" value="&lt;b&gt;assets/ and flutter_assets/&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Config JSON, .env files, bundled models&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="230" y="422" width="420" height="66" as="geometry"/></mxCell><mxCell id="it3" value="&lt;b&gt;classes.dex, MAUI assemblies&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;jadx reads them back as Java, Kotlin or Dart&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="230" y="508" width="420" height="66" as="geometry"/></mxCell><mxCell id="it4" value="&lt;b&gt;AZURE_OPENAI_KEY, in the clear&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Nine seconds, if you know which file to open first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="230" y="618" width="420" height="66" as="geometry"/></mxCell><mxCell id="leadin" value="And in that same strings.xml, a few lines below the app name:" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="230" 