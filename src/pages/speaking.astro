---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import GlassCarousel from '../components/GlassCarousel.astro';
import type { GlassSlide } from '../lib/carousels';
import AdUnit from '../components/AdUnit.astro';
import { SITE, AUTHOR, BOOKING, IMPACT, SPEAKING_TOPICS, SESSION_FORMATS, ADSENSE_SLOT_DISPLAY } from '../config';
import { getUpcomingEvents, getPastEvents, eventSchema } from '../lib/speaking';

const upcoming = await getUpcomingEvents();
const past = await getPastEvents();

// No email is published, so booking is the scheduler when one is configured and
// the contact page otherwise.
const bookingHref = BOOKING.scheduler || '/contact/';
const bookingLabel = BOOKING.scheduler ? 'Check availability →' : 'Send a speaking invitation →';

const slides: GlassSlide[] = [
  {
    tab: 'Invite',
    kicker: 'MSDEVBUILD · Speaking',
    title: 'Sessions for your',
    accent: 'conference or community',
    text: `${IMPACT[4].value} sessions delivered to ${IMPACT[3].value} developers across Microsoft Azure, applied AI, and .NET. Available in English or Tamil, on site or online.`,
    tiles: [
      { value: IMPACT[4].value, label: 'sessions delivered' },
      { value: IMPACT[3].value, label: 'developers reached' },
      { value: '2', label: 'English and Tamil' },
    ],
    actions: [{ label: bookingLabel, href: bookingHref, primary: true }],
    note: BOOKING.available ? BOOKING.availabilityNote : undefined,
    panel: {
      demo: { kind: 'flow', labels: ['Invite', 'Pick a topic', 'Session'], caption: BOOKING.responseTime },
      title: 'Talks I give',
      steps: SPEAKING_TOPICS.slice(0, 3).map((t) => ({ title: t.title, href: '#topics-heading' })),
    },
  },
  {
    tab: 'Talks',
    kicker: 'MSDEVBUILD · Talks',
    title: 'Azure, applied AI,',
    accent: 'and .NET in production',
    text: 'Demo-led sessions, tailored to the audience in the room.',
    pills: SPEAKING_TOPICS.map((t) => t.title),
    actions: [{ label: 'See all talks', href: '#topics-heading' }],
    panel: {
      demo: { kind: 'ai', caption: 'For example: how an agent calls search and your own functions, then answers.' },
      title: 'A few of the talks',
      steps: SPEAKING_TOPICS.slice(0, 3).map((t) => ({ title: t.title, href: '#topics-heading' })),
    },
  },
  {
    tab: 'Formats',
    kicker: 'MSDEVBUILD · Formats',
    title: 'On site or online,',
    accent: 'in English or Tamil',
    text: 'Conference stage, online session or community meetup. The content fits the format.',
    actions: [{ label: bookingLabel, href: bookingHref, primary: true }],
    panel: {
      demo: { kind: 'flow', labels: ['Conference', 'Online', 'Meetup'], caption: 'Three formats, one demo-led approach.' },
      title: 'Formats',
      steps: SESSION_FORMATS.map((f) => ({ title: f.title, note: f.description, href: '#formats-heading' })),
    },
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/speaking#page`,
    name: `Speaking — ${AUTHOR.name}`,
    description: `Conference sessions, webinars, and community meetups delivered by ${AUTHOR.name} on Azure, applied AI, and .NET.`,
    about: { '@id': `${SITE.url}/#person` },
  },
  ...eventSchema(upcoming, SITE.url, `${SITE.url}/#person`),
];
---

<BaseLayout
  title="Conference Speaker on Azure, AI & .NET"
  description={`Invite ${AUTHOR.name} to speak — conference sessions, webinars, and community meetups on Microsoft Azure, applied AI, and .NET, in English or Tamil.`}
  schema={schema}
>
  <GlassCarousel slides={slides} label="Speaking" />

  {upcoming.length > 0 && (
    <section class="mt-16" aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="section-title">
        Upcoming
      </h2>
      <div class="mt-6 space-y-3">
        {upcoming.map((event) => <EventCard event={event} />)}
      </div>
    </section>
  )}

  <section class="mt-16" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="section-title">
      Talks I give
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {SPEAKING_TOPICS.map(({ title, description }) => (
        <article class="rounded-xl border border-default p-5">
          <h3 class="font-semibold tracking-tight">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
        </article>
      ))}
    </div>
    <p class="mt-4 text-sm text-muted">
      Sessions are tailored to the audience — happy to build something specific to your event.
    </p>
  </section>

  <section class="mt-16" aria-labelledby="formats-heading">
    <h2 id="formats-heading" class="section-title">
      Formats
    </h2>
    <dl class="mt-6 grid gap-5 sm:grid-cols-3">
      {SESSION_FORMATS.map(({ title, description }) => (
        <div>
          <dt class="font-semibold">{title}</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-muted">{description}</dd>
        </div>
      ))}
    </dl>
  </section>

  {past.length > 0 && (
    <section class="mt-16" aria-labelledby="past-heading">
      <h2 id="past-heading" class="section-title">
        Past events
      </h2>
      <div class="mt-6 space-y-3">
        {past.map((event) => <EventCard event={event} past />)}
      </div>
    </section>
  )}

  <p class="mt-10 text-sm text-muted">
    The full dated record of talks, articles, and community work lives on the
    <a href="/contributions/" class="text-accent hover:underline">contributions page</a>.
  </p>

  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
</BaseLayout>
