---
import { BOOKING } from '../config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

// No email is published, so the booking path is the scheduler when one is
// configured and the contact page otherwise — never a dead end.
const href = BOOKING.scheduler || '/contact';
const isScheduler = BOOKING.scheduler.length > 0;
---

<div
  class:list={[
    'relative overflow-hidden rounded-2xl border border-default',
    compact ? 'p-6' : 'p-8 md:p-10',
  ]}
>
  <!-- Soft accent wash: enough presence to read as a primary action without
       resorting to a saturated block of colour. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(120% 100% at 0% 0%, color-mix(in oklch, var(--accent) 14%, transparent), transparent 60%),
      radial-gradient(90% 80% at 100% 100%, color-mix(in oklch, var(--accent) 10%, transparent), transparent 55%);"
    aria-hidden="true"
  >
  </div>

  {BOOKING.available && (
    <p class="inline-flex items-center gap-2 rounded-full border border-default bg-[var(--bg)] px-3 py-1 text-xs font-medium">
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full opacity-60" style="background: var(--accent);"></span>
        <span class="relative inline-flex size-2 rounded-full" style="background: var(--accent);"></span>
      </span>
      {BOOKING.availabilityNote}
    </p>
  )}

  <h2 class:list={['mt-4 font-bold tracking-tight text-balance', compact ? 'text-xl' : 'text-3xl']}>
    Invite Suthahar to speak
  </h2>

  <p class="mt-3 max-w-lg leading-relaxed text-muted text-pretty">
    Conference sessions, webinars, and community meetups on Azure, applied AI, and
    .NET — delivered in English or Tamil, on site or online.
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href={href}
      class="rounded-lg px-5 py-3 text-sm font-semibold text-white shadow-lg transition-transform hover:-translate-y-0.5"
      style="background: var(--accent);"
    >
      {isScheduler ? 'Check availability →' : 'Send a speaking invitation →'}
    </a>
    <a
      href="/speaking"
      class="rounded-lg border border-default bg-[var(--bg)] px-5 py-3 text-sm font-medium transition-colors hover:bg-subtle"
    >
      See talks &amp; topics
    </a>
  </div>

  <p class="mt-4 text-xs text-muted">{BOOKING.responseTime}</p>
</div>
