---
import { FIREBASE } from '../config';

interface Props {
  compact?: boolean;
  /** Chrome is dropped when the form is already inside a titled dialog. */
  bare?: boolean;
  /** Must be unique per page — a page may hold both an inline and a popup form. */
  formId?: string;
}

const { compact = false, bare = false, formId = 'testimonial' } = Astro.props;
const enabled = FIREBASE.projectId.length > 0;

const id = (field: string) => `${formId}-${field}`;
---

<div
  id={bare ? undefined : 'write-testimonial'}
  class:list={[
    !bare && 'scroll-mt-24 rounded-xl border border-default',
    !bare && (compact ? 'p-6' : 'p-8'),
  ]}
>
  {!bare && (
    <>
      <p class="eyebrow">Your turn</p>
      <h2 class="display mt-2 text-2xl">How did Suthahar's articles help you?</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
        If something here saved you time or unblocked a real project, I'd love to hear
        about it. Submissions are reviewed before they appear on the site.
      </p>
    </>
  )}

  <form data-testimonial-form class:list={[!bare && 'mt-6', 'space-y-4']} novalidate>
    <div>
      <label for={id('message')} class="block text-sm font-medium">
        Your feedback <span style="color: var(--accent);">*</span>
      </label>
      <textarea
        id={id('message')}
        data-field="message"
        rows={compact ? 4 : 5}
        required
        maxlength="1500"
        disabled={!enabled}
        placeholder="Suthahar's article helped me complete my work faster. The explanation was clear, practical, and easy to apply in a real project."
        class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
      ></textarea>
      <p class="mt-1 text-xs text-muted">
        <span data-count>0</span>/1500 · minimum 10 characters
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for={id('name')} class="block text-sm font-medium">
          Name <span style="color: var(--accent);">*</span>
        </label>
        <input
          id={id('name')}
          data-field="name"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          disabled={!enabled}
          class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
        />
      </div>
      <div>
        <label for={id('email')} class="block text-sm font-medium">
          Email <span style="color: var(--accent);">*</span>
        </label>
        <input
          id={id('email')}
          data-field="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          disabled={!enabled}
          class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
        />
        <p class="mt-1 text-xs text-muted">Never published — used only to verify your feedback.</p>
      </div>
      <div>
        <label for={id('company')} class="block text-sm font-medium">
          Company <span class="font-normal text-muted">(optional)</span>
        </label>
        <input
          id={id('company')}
          data-field="company"
          type="text"
          maxlength="100"
          autocomplete="organization"
          disabled={!enabled}
          class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
        />
      </div>
      <div>
        <label for={id('role')} class="block text-sm font-medium">
          Role <span class="font-normal text-muted">(optional)</span>
        </label>
        <input
          id={id('role')}
          data-field="role"
          type="text"
          maxlength="100"
          autocomplete="organization-title"
          disabled={!enabled}
          class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
        />
      </div>
      <div>
        <label for={id('article')} class="block text-sm font-medium">
          Article name or link <span class="font-normal text-muted">(optional)</span>
        </label>
        <input
          id={id('article')}
          data-field="article"
          type="text"
          maxlength="300"
          disabled={!enabled}
          class="mt-1.5 w-full rounded-lg border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
        />
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" disabled={!enabled} class="btn btn-accent disabled:opacity-60">
        Submit feedback
      </button>
      <p data-status role="status" aria-live="polite" class="text-sm"></p>
    </div>

    <p class="text-xs text-muted">
      Your name, company, and role appear publicly if published. Nothing else is collected.
    </p>

    {!enabled && (
      <p class="text-sm text-muted">
        Set <code>FIREBASE.projectId</code> in <code>src/config.ts</code> to enable this form.
      </p>
    )}
  </form>
</div>

<script>
  import { FIREBASE } from '../config';

  function initTestimonialForms() {
    // Bound per form, not per page: the home page carries both an inline form
    // and one inside the feedback dialog.
    document.querySelectorAll<HTMLFormElement>('[data-testimonial-form]').forEach((form) => {
      if (form.dataset.bound === '') return;
      form.dataset.bound = '';

      const field = (name: string) =>
        form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${name}"]`)!;

      const message = field('message');
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const counter = form.querySelector<HTMLElement>('[data-count]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

      message.addEventListener('input', () => {
        counter.textContent = String(message.value.length);
      });

      const say = (text: string, tone: 'ok' | 'error' | 'muted') => {
        status.textContent = text;
        status.style.color = tone === 'muted' ? 'var(--text-muted)' : 'var(--accent)';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const values = {
          message: message.value.trim(),
          name: field('name').value.trim(),
          email: field('email').value.trim().toLowerCase(),
          company: field('company').value.trim(),
          role: field('role').value.trim(),
          article: field('article').value.trim(),
        };

        if (values.message.length < 10) {
          say('Please write at least 10 characters.', 'error');
          message.focus();
          return;
        }
        if (values.name.length < 2) {
          say('Please add your name.', 'error');
          field('name').focus();
          return;
        }
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(values.email)) {
          say('Please enter a valid email address.', 'error');
          field('email').focus();
          return;
        }

        button.disabled = true;
        say('Sending…', 'muted');

        // A client-generated ID lets this use commit(), which supports the
        // server-timestamp transform the rules require.
        const docId = crypto.randomUUID();
        const base = `https://firestore.googleapis.com/v1/projects/${FIREBASE.projectId}/databases/(default)/documents`;

        try {
          const res = await fetch(`${base}:commit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              writes: [
                {
                  update: {
                    name: `projects/${FIREBASE.projectId}/databases/(default)/documents/testimonials/${docId}`,
                    fields: {
                      message: { stringValue: values.message },
                      name: { stringValue: values.name },
                      company: { stringValue: values.company },
                      role: { stringValue: values.role },
                      article: { stringValue: values.article },
                      // Fixed here and enforced by the rules: a submission can
                      // never arrive pre-approved or pre-featured.
                      status: { stringValue: 'pending' },
                      featured: { booleanValue: false },
                    },
                  },
                  updateMask: {
                    fieldPaths: ['message', 'name', 'company', 'role', 'article', 'status', 'featured'],
                  },
                  updateTransforms: [
                    { fieldPath: 'createdAt', setToServerValue: 'REQUEST_TIME' },
                  ],
                  currentDocument: { exists: false },
                },
                // The email goes to a separate, unreadable collection under the
                // same id. Both writes are in one commit, so a testimonial can
                // never be stored without its contact record or vice versa.
                {
                  update: {
                    name: `projects/${FIREBASE.projectId}/databases/(default)/documents/testimonialContacts/${docId}`,
                    fields: { email: { stringValue: values.email } },
                  },
                  updateMask: { fieldPaths: ['email'] },
                  updateTransforms: [
                    { fieldPath: 'createdAt', setToServerValue: 'REQUEST_TIME' },
                  ],
                  currentDocument: { exists: false },
                },
              ],
            }),
          });

          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            throw new Error(body?.error?.message || `HTTP ${res.status}`);
          }

          form.querySelectorAll('input, textarea').forEach((el) => {
            (el as HTMLInputElement).value = '';
          });
          counter.textContent = '0';
          say('Thank you — your feedback has been sent for review.', 'ok');
          form.dispatchEvent(new CustomEvent('testimonial:sent', { bubbles: true }));
        } catch (error) {
          button.disabled = false;
          say('Something went wrong. Please try again later.', 'error');
        }
      });
    });
  }

  initTestimonialForms();
  document.addEventListener('astro:page-load', initTestimonialForms);
</script>
