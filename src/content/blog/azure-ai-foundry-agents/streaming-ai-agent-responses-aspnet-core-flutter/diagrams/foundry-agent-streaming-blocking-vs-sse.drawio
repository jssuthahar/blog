<mxfile host="app.diagrams.net"><diagram name="Blocking vs streaming" id="Blockingvsstreaming"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="-4" width="888" height="550" as="geometry"/></mxCell><mxCell id="lh" value="Blocking response" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="380" height="28" as="geometry"/></mxCell><mxCell id="lu" value="wait for the whole answer" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="48" width="380" height="22" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;1. Tap send&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;nothing on screen&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="380" height="64" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;2. Tool round, about four seconds&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;still nothing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="186" width="380" height="64" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;3. Second model call&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;still nothing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="380" height="64" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;4. The full answer appears&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;about six seconds in&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="380" height="64" as="geometry"/></mxCell><mxCell id="le0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lsum" value="✗ Six seconds of a frozen spinner" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="380" height="48" as="geometry"/></mxCell><mxCell id="le" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="l4" target="lsum"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rh" value="Server-sent events" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="380" height="28" as="geometry"/></mxCell><mxCell id="ru" value="render as it arrives" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="48" width="380" height="22" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;1. Tap send&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&quot;Thinking…&quot; at once&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="380" height="64" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;2. Tool round&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;&quot;Searching the menu…&quot; status line&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="520" y="186" width="380" height="64" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;3. First token&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;under a second after the tool round&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="520" y="282" width="380" height="64" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;4. Text streams in&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;same total time, legible wait&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="520" y="378" width="380" height="64" as="geometry"/></mxCell><mxCell id="re0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rok" value="✓ Same agent, the wait reads as progress" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="474" width="380" height="48" as="geometry"/></mxCell><mxCell id="re" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="r4" target="rok"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>