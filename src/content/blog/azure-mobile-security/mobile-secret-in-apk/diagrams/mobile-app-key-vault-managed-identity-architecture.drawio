<mxfile host="app.diagrams.net"><diagram name="What to ship instead" id="Whattoshipinstead"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="6" width="758" height="820" as="geometry"/></mxCell><mxCell id="dev" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4D9FDB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="460" height="200" as="geometry"/></mxCell><mxCell id="devn" value="ON THE DEVICE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="38" width="430" height="18" as="geometry"/></mxCell><mxCell id="devr" value="Readable by whoever holds the phone" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="55" width="430" height="16" as="geometry"/></mxCell><mxCell id="app" value="Your Flutter or .NET MAUI app" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="263" y="84" width="54" height="54" as="geometry"/></mxCell><mxCell id="appt" value="Short-lived user token, issued at sign-in" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2933;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="172" width="436" height="18" as="geometry"/></mxCell><mxCell id="appr" value="✕ No service key. Nothing in strings.xml, Info.plist or assets/.