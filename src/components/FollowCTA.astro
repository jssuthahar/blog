---
import { SOCIAL } from '../config';

interface Props {
  /**
   * `panel` — a bordered block with a heading, for end-of-page placement.
   * `row`   — a bare row of buttons, for tucking under existing content.
   */
  variant?: 'panel' | 'row';
  heading?: string;
  class?: string;
}

const {
  variant = 'panel',
  heading = 'Follow the work',
  class: className = '',
} = Astro.props;

/**
 * The footer renders one of these on every page, so any page placing a second
 * one had two elements sharing `id="follow-heading"` — which silently points
 * both `aria-labelledby` references at whichever came first. Deriving the id
 * from the heading keeps them distinct without a caller having to pass one.
 */
const headingId = `follow-heading-${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;

const ICONS: Record<string, string> = {
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.75-2.05C21.6 8.65 22 11.1 22 14.3V21h-4v-6c0-1.4-.03-3.2-2-3.2s-2.3 1.5-2.3 3.1V21h-4V9Z',
  github:
    'M12 .5C5.73.5.9 5.33.9 11.6c0 4.9 3.17 9.05 7.57 10.52.55.1.76-.24.76-.53 0-.26-.01-1.13-.01-2.05-2.78.51-3.5-.68-3.72-1.3-.12-.32-.66-1.3-1.13-1.56-.39-.21-.94-.72-.02-.74.87-.01 1.49.8 1.7 1.13.99 1.67 2.57 1.2 3.2.91.1-.71.39-1.2.7-1.47-2.46-.28-5.03-1.23-5.03-5.47 0-1.2.43-2.2 1.13-2.97-.11-.28-.49-1.41.11-2.94 0 0 .93-.29 3.05 1.13a10.3 10.3 0 0 1 5.55 0c2.12-1.44 3.05-1.13 3.05-1.13.6 1.53.22 2.66.11 2.94.7.77 1.13 1.75 1.13 2.97 0 4.26-2.58 5.19-5.04 5.47.4.35.75 1.02.75 2.06 0 1.49-.01 2.69-.01 3.06 0 .29.2.64.76.53a11.12 11.12 0 0 0 7.55-10.52C23.1 5.33 18.27.5 12 .5Z',
  youtube:
    'M23.5 6.9a3 3 0 0 0-2.11-2.13C19.5 4.25 12 4.25 12 4.25s-7.5 0-9.39.52A3 3 0 0 0 .5 6.9C0 8.8 0 12 0 12s0 3.2.5 5.1a3 3 0 0 0 2.11 2.13c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.13C24 15.2 24 12 24 12s0-3.2-.5-5.1ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z',
  // Same path ShareRow and EngagementRail use for the share button, so the
  // X mark is one shape whether the ask is "share" or "follow".
  x: 'M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.6 6.6L18.9 2Z',
  // Rounded square, lens, and the flash dot — the glyph drawn as one filled
  // path with even-odd holes, so it needs no separate stroke pass.
  instagram:
    'M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4A5.8 5.8 0 0 1 16.2 22H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm4.2 2.9a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 2a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.35-3.4a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
  // Same path ShareRow and EngagementRail use, so the WhatsApp mark is one
  // shape across the site whether the ask is "share" or "follow".
  whatsapp:
    'M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a13 13 0 0 1-6.3-5.5C6.9 10.6 6.6 9.6 6.6 9c0-.6.3-1.5.8-1.9.2-.2.4-.2.6-.2h.5c.2 0 .4 0 .6.4l.8 2c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.5.9 1.5 2 2.6 2.5.3.2.5.1.6 0l.7-.8c.2-.2.3-.2.6-.1l1.9.9c.3.1.4.2.4.4.1.2.1.7-.1 1.3Z',
};
---

{variant === 'panel' ? (
  <section
    class:list={['rounded-lg border border-default p-6', className]}
    aria-labelledby={headingId}
  >
    <h2 id={headingId} class="text-lg font-semibold tracking-tight">{heading}</h2>
    <p class="mt-1.5 text-sm text-muted">
      New articles, sample code, and video walkthroughs as they land.
    </p>

    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {SOCIAL.map(({ icon, label, handle, action, href, blurb }) => (
        <li>
          <a
            href={href}
            rel="noopener"
            class="group flex h-full flex-col rounded-lg border border-default p-4 transition-all hover:-translate-y-0.5 hover:shadow-md"
          >
            <span class="flex items-center gap-2">
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICONS[icon]} />
              </svg>
              <span class="text-sm font-semibold">{label}</span>
            </span>
            <span class="mt-1 flex-1 text-xs leading-snug text-muted">{blurb}</span>
            <!-- Template literal: adjacent expressions lose the space between them. -->
            <span class="mt-3 text-xs font-semibold text-accent">
              {`${action} ${handle} →`}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
) : (
  <div class:list={['flex flex-wrap items-center gap-2', className]}>
    <span class="mr-1 text-sm text-muted">{heading}</span>
    {SOCIAL.map(({ icon, cta, href }) => (
      <a
        href={href}
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full border border-default px-3 py-1.5 text-sm font-medium transition-colors hover:bg-subtle hover:text-accent"
      >
        <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={ICONS[icon]} />
        </svg>
        {cta}
      </a>
    ))}
  </div>
)}
