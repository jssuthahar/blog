---
import { SITE, NAV } from '../config';
import ThemeToggle from './ThemeToggle.astro';
import SiteBell from '@msdevbuild/config/components/SiteBell.astro';
import AccountMenu from '@msdevbuild/config/components/AccountMenu.astro';
import Avatar from './Avatar.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- The glass header, menu and dropdown styles are shared with azure.msdevbuild.com
     through @msdevbuild/config (.hdr-glass, .glass-pill-nav). Only the layout and
     the blog's own controls live here. -->
<header class="site-header hdr-glass sticky top-0 z-50">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4 sm:gap-4 sm:px-6">
    <a
      href="/"
      class="flex min-w-0 items-center gap-2.5"
      aria-label={`${SITE.title} blog ${SITE.byline} — home`}
    >
      <Avatar size={32} eager class="shrink-0 ring-2 ring-[var(--accent)]/30" />
      <span class="min-w-0 leading-tight">
        <span class="block truncate font-semibold tracking-tight">
          <span class="header-ms">MS</span>DEVBUILD
          <span class="font-normal text-muted">/ blog</span>
        </span>
        <span class="block truncate text-[0.7rem] text-muted">{SITE.alternateName} · {SITE.byline}</span>
      </span>
    </a>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <!-- A returning reader's own streak, reflected back at them. Hidden until
           the script below finds one — most visits are still a stranger's
           first, and a "0 day streak" badge would read as an accusation
           rather than a reward. Links to /history, which carries the full stat. -->
      <a
        id="streak-chip"
        href="/history/"
        hidden
        class="glass-field inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors hover:border-[var(--accent)]"
        title="Your reading streak"
      >
        <span aria-hidden="true">🔥</span>
        <span id="streak-chip-count"></span>
      </a>
      <!-- Opens the ⌘K palette; falls back to /search if JS is unavailable. -->
      <a
        href="/search/"
        data-open-search
        class="rounded-md p-2 transition-colors hover:bg-subtle"
        aria-label="Search (⌘K)"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <!-- Anchor text for crawlers, which read markup and do not credit
             aria-label. The aria-label still wins for assistive tech. -->
        <span class="sr-only">Search</span>
      </a>
      <!-- Install as an app (PWA). Hidden until the browser reports the site is
           installable, or on iOS where it opens Add-to-Home-Screen steps.
           Icon only on phones, so the header never overflows a 390px screen. -->
      <button
        id="pwa-install"
        type="button"
        hidden
        class="btn btn-accent btn-sm max-sm:size-9 max-sm:gap-0 max-sm:px-0"
        aria-label="Install app"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v11" /><path d="m8 11 4 4 4-4" /><path d="M5 20h14" />
        </svg>
        <span class="max-sm:hidden">Install app</span>
      </button>
      <!-- Announcements + who is online (admin.msdevbuild.com → Notifications). -->
      <SiteBell site="blog" />
      <ThemeToggle />
      <!-- Optional Google sign-in and profile, shared with azure.msdevbuild.com. -->
      <AccountMenu />
    </div>
  </div>

  <!-- The pill menu, as on azure.msdevbuild.com: every link visible at every
       width, scrolling sideways on a phone with a "more" hint at the edge. -->
  <div class="topbar-wrap relative">
    <nav class="topbar h-[3.25rem] overflow-x-auto px-2" aria-label="Main">
      <ul class="glass-pill-nav text-sm">
        {NAV.map(({ label, href }) => (
          <li class="flex">
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <span class="topbar-more" aria-hidden="true">›</span>
  </div>
</header>

<style>
  .topbar {
    scrollbar-width: none;
  }
  .topbar::-webkit-scrollbar {
    display: none;
  }
  /* Fade + arrow when more links sit off to the right (phones). */
  .topbar-more {
    display: none;
    position: absolute;
    inset-block: 0 0.25rem;
    right: 0;
    width: 2.6rem;
    align-items: center;
    justify-content: flex-end;
    padding-right: 0.5rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--bg) 65%);
  }
  .topbar-wrap.more-right .topbar-more {
    display: flex;
  }
  @media (max-width: 479px) {
    .glass-pill-nav > li > a {
      padding-inline: 0.75rem;
    }
  }
</style>

<script>
  // Glass header: a deeper shadow once the page scrolls under it, and the
  // "more" hint on the pill menu. Re-run on every soft navigation, because
  // ClientRouter swaps the header in with the rest of the page.
  const onScroll = () => document.querySelector('.site-header')?.classList.toggle('is-scrolled', scrollY > 4);
  addEventListener('scroll', onScroll, { passive: true });

  function initPillNav() {
    onScroll();
    const bar = document.querySelector<HTMLElement>('.site-header .topbar');
    const wrap = bar?.parentElement;
    if (!bar || !wrap) return;
    const more = () => wrap.classList.toggle('more-right', bar.scrollLeft + bar.clientWidth < bar.scrollWidth - 6);
    bar.addEventListener('scroll', more, { passive: true });
    more();
    // Keep the current page's pill in view on phones.
    bar.querySelector<HTMLElement>('[aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
  }
  initPillNav();
  document.addEventListener('astro:page-load', initPillNav);
  addEventListener('resize', () => {
    const bar = document.querySelector<HTMLElement>('.site-header .topbar');
    bar?.dispatchEvent(new Event('scroll'));
  });

  // Any [data-open-search] element opens the command palette instead of
  // navigating; the href stays as a no-JS fallback.
  function initSearchTriggers() {
    document.querySelectorAll('[data-open-search]').forEach((el) => {
      if ((el as HTMLElement).dataset.searchBound === '') return;
      (el as HTMLElement).dataset.searchBound = '';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new Event('open-search'));
      });
    });
  }
  initSearchTriggers();
  document.addEventListener('astro:page-load', initSearchTriggers);

  // Streak chip: reflects lib/reading-history's own streak calculation, so
  // this can never disagree with what /history reports for the same reader.
  async function initStreakChip() {
    const chip = document.getElementById('streak-chip');
    const count = document.getElementById('streak-chip-count');
    if (!chip || !count) return;

    const { getStreak } = await import('../lib/reading-history');
    const paint = () => {
      const streak = getStreak();
      count.textContent = String(streak);
      chip.hidden = streak < 2; // a "streak" of one day is just today — not yet a habit worth flaunting back.
      chip.title = `${streak} day reading streak — keep it going`;
    };

    paint();
    window.addEventListener('reading-history-change', paint);
  }
  initStreakChip();
  document.addEventListener('astro:page-load', initStreakChip);
</script>
