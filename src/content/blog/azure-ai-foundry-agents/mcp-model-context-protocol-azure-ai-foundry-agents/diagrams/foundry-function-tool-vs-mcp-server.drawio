<mxfile host="app.diagrams.net"><diagram name="Function tool vs MCP" id="FunctiontoolvsMCP"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="126" y="6" width="668" height="364" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Your tool logic&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;search the menu, check an order&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="290" y="30" width="340" height="62" as="geometry"/></mxCell><mxCell id="br0" value="&lt;b&gt;Function tool&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;declared on one agent, executed inside your API&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="152" width="300" height="70" as="geometry"/></mxCell><mxCell id="hb0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="hub" target="br0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="br1" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;any client can call it, from a reachable server&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="470" y="152" width="300" height="70" a