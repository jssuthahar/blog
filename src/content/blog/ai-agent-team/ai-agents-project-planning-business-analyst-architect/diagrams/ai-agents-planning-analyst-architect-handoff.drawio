<mxfile host="app.diagrams.net"><diagram name="Plan, analyse, decide" id="Plan,analyse,decide"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="6" width="508" height="582" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1. Kickoff notes, as they are&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;four bullets and the real constraints&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="460" height="64" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2. Planning agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;docs/delivery-plan.md: order of work, dependencies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="460" height="64" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3. Business analyst agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;docs/requirements/cancel-order.md: states, open questions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="218" width="460" height="64" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4. A person answers the BLOCKING questions&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the agent never invents a business rule&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="312" width="460" height="64" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;5. Solution architect agent&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;an ADR, and checkable rules for AGENTS.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="406" width="460" height="64" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;6. A hook enforces the rule&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;every later agent and developer inherits it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="460" height="64" as="geometry"/></mxCell><mxCell id="pe0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pe4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>