---
import { Image } from 'astro:assets';
import { CATEGORIES, coverArt, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Larger monogram and blur for hero-sized panels. */
  large?: boolean;
  class?: string;
  eager?: boolean;
}

const { post, large = false, class: className = '', eager = false } = Astro.props;
const { data } = post;
const art = coverArt(post.id, data.category);
const label = CATEGORIES[data.category].label;
---

{data.cover ? (
  <Image
    src={data.cover}
    alt={data.coverAlt ?? ''}
    widths={large ? [480, 800, 1200] : [320, 480, 800]}
    sizes={large ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 640px) 100vw, 33vw'}
    loading={eager ? 'eager' : 'lazy'}
    class:list={['size-full object-cover', className]}
  />
) : (
  <div
    class:list={['relative size-full overflow-hidden', className]}
    style={`background: linear-gradient(${art.angle}deg, ${art.from}, ${art.to});`}
    aria-hidden="true"
  >
    <!-- Soft shapes, seeded from the slug, so no two posts look alike. -->
    <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" preserveAspectRatio="none">
      {art.blobs.map((b) => (
        <circle cx={b.x} cy={b.y} r={b.r} fill="#fff" opacity="0.09" />
      ))}
    </svg>

    <!-- Fine diagonal hatching adds texture without reading as noise. -->
    <div
      class="absolute inset-0 opacity-[0.14]"
      style="background-image: repeating-linear-gradient(45deg, #fff 0 1px, transparent 1px 9px);"
    >
    </div>

    <span
      class:list={[
        'absolute left-0 bottom-0 p-4 font-semibold tracking-tight text-white/85',
        large ? 'text-2xl' : 'text-sm',
      ]}
    >
      {label}
    </span>
  </div>
)}
