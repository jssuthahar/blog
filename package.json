{
  "name": "msdvbuild-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync:articles": "node scripts/sync-blogger.mjs",
    "sync:repos": "node scripts/sync-github.mjs",
    "sync": "npm run sync:articles && npm run sync:repos && npm run sync:testimonials",
    "sync:testimonials": "node scripts/sync-testimonials.mjs",
    "check:humanizer": "node scripts/check-humanizer.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:seo:dist": "npm run build && node scripts/check-seo.mjs --dist",
    "check:aeo": "node scripts/check-aeo.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:covers": "node scripts/check-covers.mjs",
    "check:all": "npm run check:humanizer && npm run check:seo && npm run check:aeo && npm run check:covers",
    "seed:testimonials": "node scripts/seed-testimonials.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "push:send": "node --env-file=.env scripts/send-push.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.7",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^5.16.2",
    "canvaskit-wasm": "^0.41.1",
    "marked": "^18.0.7",
    "rehype-autolink-headings": "^7.1.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7"
  }
}
