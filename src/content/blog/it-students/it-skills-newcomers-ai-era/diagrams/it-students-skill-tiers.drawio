<mxfile host="app.diagrams.net"><diagram name="Skill tiers" id="Skilltiers"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="-29" y="6" width="858" height="400" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;Specialisations: go deep later&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;architecture, data engineering, cloud-native depth, UX&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#6B7280;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="600" height="76" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Emerging: new in the last three years&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;context engineering, AI-assisted development, agents, AI evaluation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="65" y="122" width="670" height="76" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Foundations: AI makes these matter more&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;AI literacy, APIs, databases, secure development, cloud and CI/CD basics, communication, problem-solving&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="214" width="740" height="76" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;The floor: not optional&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;programming, data structures and algorithms, operating systems, networking&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="-5" y="306" width="810" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>