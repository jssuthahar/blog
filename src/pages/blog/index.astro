---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import TestimonialForm from '../../components/TestimonialForm.astro';
import AdUnit from '../../components/AdUnit.astro';
import SeriesQuickNav from '../../components/SeriesQuickNav.astro';
import { SITE, ADSENSE_SLOT_DISPLAY } from '../../config';
import { getPublishedPosts } from '../../lib/posts';
import { featuredTestimonials, testimonialIndex } from '../../lib/testimonials';

const posts = await getPublishedPosts();

// Ten by default; the sync puts featured entries first, so the highlighted
// ones are always the ones that make the cut.
const testimonials = featuredTestimonials(10);
const highlighted = testimonials.filter((t) => t.featured);
const standard = testimonials.filter((t) => !t.featured);

// No Review schema — self-serving testimonials on your own site aren't eligible
// for review rich results, and a Person is an invalid itemReviewed type.
const schema: Record<string, unknown>[] = [];
---

<BaseLayout
  title="All posts"
  description={`Every article on ${SITE.title} — Cloud, Azure, AI, GitHub Copilot, Mobile, and Web development guides.`}
  schema={schema}
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <header class="max-w-2xl">
      <h1 class="display text-3xl sm:text-4xl">All posts</h1>
      <p class="mt-3 text-muted">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} on .NET, Azure, and AI engineering,
        newest first.
      </p>
    </header>

    <a href="/rss.xml" class="btn btn-outline btn-sm" title="Subscribe to the RSS feed — newest post first">
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="6.18" cy="17.82" r="2.18" />
        <path d="M4 10.1v2.9a7 7 0 0 1 7 7h2.9A9.9 9.9 0 0 0 4 10.1Zm0-5.1v2.9A14.1 14.1 0 0 1 18.1 22H21A17 17 0 0 0 4 5Z" />
      </svg>
      RSS feed
    </a>
  </div>

  <!-- Series first: a reader who wants the whole guide should not have to spot
       the parts among the individual posts. -->
  <SeriesQuickNav class="mt-6" />

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <!-- Straight after the post grid, while the titles are still on screen —
       ahead of both the ad and the testimonials, which are not asks. -->
  <div class="mt-16">
    <Newsletter source="blog-index" />
  </div>

  <!-- One display ad below the post grid, before the testimonials section. -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none mt-16" />

  {testimonials.length > 0 && (
    <section class="mt-20" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <p class="eyebrow">Testimonials</p>
          <h2 id="testimonials-heading" class="display mt-1.5 text-2xl sm:text-[1.75rem]">
            How these articles helped
          </h2>
        </div>
        <a href="/testimonials/" class="btn btn-outline btn-sm">
          {testimonialIndex.count > 10 ? `All ${testimonialIndex.count}` : 'All testimonials'}
        </a>
      </div>

      {highlighted.length > 0 && (
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {highlighted.map((t) => <TestimonialCard testimonial={t} highlight />)}
        </div>
      )}

      {standard.length > 0 && (
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {standard.map((t) => <TestimonialCard testimonial={t} />)}
        </div>
      )}
    </section>
  )}

  <div class="mt-16">
    <TestimonialForm compact />
  </div>
</BaseLayout>
