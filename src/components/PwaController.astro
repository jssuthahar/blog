---
/**
 * PWA runtime: registers the service worker, drives the header "Install app"
 * icon (Android / desktop via beforeinstallprompt, iOS via an Add-to-Home-Screen
 * sheet), and a notifications toggle backed by Web Push (src/lib/push.ts).
 *
 * Rendered once from BaseLayout. Install lives as a quiet icon in the header
 * (see Header.astro #pwa-install); this only supplies the notifications bar,
 * which appears when there is something to offer and remembers a dismissal.
 */
import { PUSH } from '../config';

const pushConfigured = PUSH.publicKey.length > 0;
---

{pushConfigured && (
  <div id="pwa-bar" class="pwa-bar" hidden aria-live="polite">
    <span class="pwa-msg" id="pwa-msg">Get notified about new articles</span>
    <div class="pwa-actions">
      <button type="button" id="pwa-notify" class="pwa-btn" hidden>
        Enable notifications
      </button>
      <button type="button" id="pwa-close" class="pwa-x" aria-label="Dismiss">&times;</button>
    </div>
  </div>
)}

<!-- Shown when a newer build is on the server than the one running. Not gated on
     push being configured: an installed app needs this regardless. -->
<div id="pwa-update" class="pwa-bar" hidden aria-live="polite">
  <span class="pwa-msg">A new version is ready</span>
  <div class="pwa-actions">
    <button type="button" id="pwa-update-go" class="pwa-btn">Reload</button>
    <button type="button" id="pwa-update-close" class="pwa-x" aria-label="Not now">&times;</button>
  </div>
</div>

<!-- One-time nudge for iOS Safari (no install prompt exists there). Points to
     the guided Add-to-Home-Screen sheet; shown once, then remembered. -->
<div id="pwa-ios-banner" class="pwa-bar" hidden aria-live="polite">
  <span class="pwa-msg">Install MSDEVBUILD on your Home Screen</span>
  <div class="pwa-actions">
    <button type="button" id="pwa-ios-banner-show" class="pwa-btn">Show how</button>
    <button type="button" id="pwa-ios-banner-close" class="pwa-x" aria-label="Dismiss">&times;</button>
  </div>
</div>

<!-- iOS install instructions (Safari has no install prompt API). -->
<div id="pwa-ios" class="pwa-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pwa-ios-title">
  <div class="pwa-modal__card">
    <button type="button" id="pwa-ios-close" class="pwa-x pwa-x--modal" aria-label="Close">&times;</button>
    <h2 id="pwa-ios-title">Install on iPhone or iPad</h2>
    <p class="pwa-modal__note">Apple only allows adding an app from <strong>Safari</strong>. Three quick taps:</p>
    <ol>
      <li>
        <span>Tap the <strong>Share</strong> button
        <svg class="pwa-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4"/><path d="m8 8 4-4 4 4"/><path d="M6 12H5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2h-1"/></svg>
        — bottom bar on iPhone, top-right on iPad.</span>
      </li>
      <li>Scroll down and tap <strong>Add to Home&nbsp;Screen</strong>.</li>
      <li>Tap <strong>Add</strong>, then open MSDEVBUILD from the new icon — it launches like an app, and only then can you turn on notifications.</li>
    </ol>
    <p class="pwa-modal__hint" id="pwa-ios-safari-hint" hidden>
      You're not in Safari right now. Open <strong>blog.msdevbuild.com</strong> in Safari, then follow these steps.
    </p>
  </div>
</div>

<style>
  .pwa-bar {
    position: fixed;
    z-index: 60;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.6rem 0.75rem 0.6rem 1rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 9999px;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.45);
    font: inherit;
    font-size: 0.9rem;
  }
  .pwa-msg {
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pwa-actions { display: flex; align-items: center; gap: 0.4rem; }
  .pwa-btn {
    appearance: none;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    white-space: nowrap;
  }
  .pwa-btn:hover { border-color: var(--accent); color: var(--accent); }
  .pwa-btn:disabled { opacity: 0.6; cursor: default; }
  .pwa-x {
    appearance: none;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 1.35rem;
    line-height: 1;
    padding: 0 0.35rem;
    border-radius: 9999px;
  }
  .pwa-x:hover { color: var(--text); }

  .pwa-modal {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: end center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.45);
  }
  .pwa-modal__card {
    position: relative;
    width: 100%;
    max-width: 26rem;
    margin-bottom: env(safe-area-inset-bottom);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.5);
  }
  .pwa-modal__card h2 { margin: 0 0 0.4rem; font-size: 1.1rem; }
  .pwa-modal__note { margin: 0 0 0.9rem; color: var(--text-muted); font-size: 0.9rem; }
  .pwa-modal__card ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.6rem; }
  .pwa-modal__card li { color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; }
  .pwa-modal__card strong { color: var(--text); }
  .pwa-share {
    display: inline-block; width: 1.05em; height: 1.05em; vertical-align: -0.2em;
    margin: 0 0.1em; color: var(--accent);
  }
  .pwa-modal__hint {
    margin: 1rem 0 0; padding: 0.7rem 0.85rem; border-radius: 0.6rem;
    background: var(--accent-soft); color: var(--text); font-size: 0.86rem; line-height: 1.45;
  }
  .pwa-x--modal { position: absolute; top: 0.6rem; right: 0.75rem; font-size: 1.6rem; }

  @media (min-width: 640px) {
    .pwa-modal { place-items: center; }
    .pwa-modal__card { margin-bottom: 0; }
  }
</style>

<script>
  import { enablePush, isPushSupported, isSubscribed, isIos, isStandalone, recordInstallOnce } from '../lib/push';
  import {
    captureInstallPrompt,
    clearInstallPrompt,
    getInstallPrompt,
    isIosSafari,
    onInstallStateChange,
    promptInstall,
    type InstallPromptEvent,
  } from '../lib/install';

  const DISMISS_KEY = 'pwa:bar-dismissed';
  const UPDATE_SNOOZE_KEY = 'pwa:update-snoozed';

  /** The registration, kept so the update check can ask it to look again. */
  let registration: ServiceWorkerRegistration | null = null;

  async function registerServiceWorker() {
    if (!('serviceWorker' in navigator)) return;
    try {
      const reg = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
      registration = reg;
      // Activate a freshly-installed worker without forcing a jarring reload;
      // network-first HTML already keeps content current.
      reg.addEventListener('updatefound', () => {
        const sw = reg.installing;
        sw?.addEventListener('statechange', () => {
          if (sw.state === 'installed' && navigator.serviceWorker.controller) {
            reg.waiting?.postMessage('SKIP_WAITING');
          }
        });
      });
    } catch {
      /* SW registration failing must never break the page. */
    }
  }

  /* ---------------------------------------------------------- Updates -- */
  /*
   * Why this exists: an installed app is opened by tapping an icon, and can be
   * resumed from the app switcher for days without a single navigation. Nothing
   * in that flow re-checks the server, so the reader can sit on a build from
   * last week and never know. Two checks cover it — the service worker is asked
   * to look for a new copy of itself, and the build stamp in this page's head is
   * compared with /version.json, which catches a content-only deploy where sw.js
   * did not change at all.
   */

  const CHECK_EVERY = 5 * 60 * 1000;
  let lastCheck = 0;

  const loadedBuild = (): string =>
    document.querySelector<HTMLMetaElement>('meta[name="build-id"]')?.content ?? '';

  const updateBarVisible = (): boolean => {
    const bar = document.getElementById('pwa-update') as HTMLElement | null;
    return Boolean(bar && !bar.hidden);
  };

  function showUpdateBar() {
    const bar = document.getElementById('pwa-update') as HTMLElement | null;
    if (!bar || sessionStorage.getItem(UPDATE_SNOOZE_KEY) === '1') return;
    bar.hidden = false;

    // These share the same fixed slot, so stand them down while this is up.
    for (const id of ['pwa-bar', 'pwa-ios-banner']) {
      const other = document.getElementById(id);
      if (other) other.hidden = true;
    }

    const go = document.getElementById('pwa-update-go') as HTMLButtonElement | null;
    const close = document.getElementById('pwa-update-close') as HTMLButtonElement | null;
    if (go) {
      go.onclick = () => {
        go.disabled = true;
        // A plain reload is enough: HTML is network-first, so this pulls the new
        // document, and its hashed assets come with it.
        location.reload();
      };
    }
    if (close) {
      close.onclick = () => {
        bar.hidden = true;
        // Session-scoped: an update prompt should come back next launch, not be
        // silenced for good like the notifications nudge.
        sessionStorage.setItem(UPDATE_SNOOZE_KEY, '1');
      };
    }
  }

  async function checkForUpdate(force = false) {
    const now = Date.now();
    if (!force && now - lastCheck < CHECK_EVERY) return;
    lastCheck = now;

    // Picks up changes to the worker itself (caching logic, push handling).
    void registration?.update().catch(() => {});

    const running = loadedBuild();
    if (!running) return;
    try {
      const res = await fetch('/version.json', { cache: 'no-store' });
      if (!res.ok) return;
      const { build } = (await res.json()) as { build?: string };
      if (build && build !== running) showUpdateBar();
    } catch {
      /* Offline, or the endpoint is missing — nothing to tell the reader. */
    }
  }

  // View Transitions swap the <body> on navigation, so the header icon / bar /
  // modal are new elements each page. render() re-attaches to the current ones
  // and reflects the current install/notification state. Window-level listeners
  // are bound once (below) and just call render() when state changes.
  function render() {
    renderInstallIcon();
    wireIosModal();
    renderIosBanner();
    void renderBar();
    // Count this device once, when the app is opened as an installed PWA.
    void recordInstallOnce();
  }

  // A single, dismissible "Add to Home Screen" nudge for iOS Safari, where no
  // install button is ever offered by the OS. Opens the guided sheet. Never
  // shown once dismissed, once installed (standalone), or outside iOS Safari.
  const IOS_BANNER_KEY = 'pwa:ios-banner-dismissed';
  function renderIosBanner() {
    const banner = document.getElementById('pwa-ios-banner') as HTMLElement | null;
    if (!banner) return;

    if (
      !isIosSafari() ||
      isStandalone() ||
      localStorage.getItem(IOS_BANNER_KEY) === '1' ||
      updateBarVisible()
    ) {
      banner.hidden = true;
      return;
    }

    banner.hidden = false;
    const show = document.getElementById('pwa-ios-banner-show') as HTMLButtonElement;
    const close = document.getElementById('pwa-ios-banner-close') as HTMLButtonElement;
    show.onclick = () => {
      const modal = document.getElementById('pwa-ios') as HTMLElement | null;
      if (modal) modal.hidden = false;
    };
    close.onclick = () => {
      banner.hidden = true;
      localStorage.setItem(IOS_BANNER_KEY, '1');
    };
  }

  // The install control is a quiet icon in the header, shown only when the site
  // is actually installable. Not tied to the notifications bar, so dismissing
  // the bar never hides it.
  function renderInstallIcon() {
    const btn = document.getElementById('pwa-install') as HTMLButtonElement | null;
    if (!btn) return;
    const iosModal = document.getElementById('pwa-ios') as HTMLElement | null;
    const iosNeedsManual = isIos() && !isStandalone();

    if (!getInstallPrompt() && !iosNeedsManual) {
      btn.hidden = true;
      return;
    }

    btn.hidden = false;
    btn.onclick = async () => {
      if (getInstallPrompt()) {
        await promptInstall();
        btn.hidden = true;
      } else if (iosModal) {
        iosModal.hidden = false; // iOS: manual Add-to-Home-Screen steps.
      }
    };
  }

  async function renderBar() {
    const bar = document.getElementById('pwa-bar') as HTMLElement | null;
    if (!bar || localStorage.getItem(DISMISS_KEY) === '1') return;
    // One bar at a time, and an update outranks a notifications nudge: it is
    // actionable now, and the nudge will still be there next launch.
    if (updateBarVisible()) return;

    const msg = document.getElementById('pwa-msg') as HTMLElement;
    const notifyBtn = document.getElementById('pwa-notify') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('pwa-close') as HTMLButtonElement;

    const hideBar = () => { bar.hidden = !notifyBtn || notifyBtn.hidden; };

    closeBtn.onclick = () => {
      bar.hidden = true;
      localStorage.setItem(DISMISS_KEY, '1');
    };

    if (notifyBtn) await renderNotify(notifyBtn, msg, hideBar);
    hideBar();
  }

  async function renderNotify(
    btn: HTMLButtonElement,
    msg: HTMLElement,
    hideBar: () => void,
  ) {
    // Only offer when it can work and hasn't already been dealt with. On iOS,
    // push only works once installed, so don't offer it before then — the
    // install banner handles that case instead.
    if (
      !isPushSupported() ||
      (isIos() && !isStandalone()) ||
      Notification.permission === 'denied' ||
      (await isSubscribed())
    ) {
      btn.hidden = true;
      return;
    }

    btn.hidden = false;

    btn.onclick = async () => {
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Enabling…';
      try {
        await enablePush();
        btn.textContent = 'Notifications on';
        setTimeout(() => { btn.hidden = true; hideBar(); }, 1400);
      } catch (err: any) {
        btn.disabled = false;
        btn.textContent = original;
        const reason = err?.message;
        if (reason === 'not-installed') {
          msg.textContent = 'Install from the header first, then enable notifications';
        } else if (reason === 'denied') {
          msg.textContent = 'Notifications are blocked in your browser settings';
          btn.hidden = true;
          hideBar();
        } else {
          msg.textContent = "Couldn't enable notifications — try again";
        }
      }
    };
  }

  // The iOS Add-to-Home-Screen sheet, opened from the header install icon.
  function wireIosModal() {
    const modal = document.getElementById('pwa-ios') as HTMLElement | null;
    const close = document.getElementById('pwa-ios-close') as HTMLButtonElement | null;
    if (!modal || !close) return;
    close.onclick = () => { modal.hidden = true; };
    modal.onclick = (e) => { if (e.target === modal) modal.hidden = true; };

    const hint = document.getElementById('pwa-ios-safari-hint') as HTMLElement | null;
    if (hint) hint.hidden = isIosSafari();
  }

  // One-time setup: SW registration and window-level listeners.
  if (!(window as any).__pwaBound) {
    (window as any).__pwaBound = true;

    registerServiceWorker();

    window.addEventListener('beforeinstallprompt', (e: Event) => {
      e.preventDefault(); // Suppress the mini-infobar; we show our own button.
      captureInstallPrompt(e as InstallPromptEvent);
    });
    window.addEventListener('appinstalled', () => {
      clearInstallPrompt();
      // Funnel signal for GA (Android/desktop only — iOS never fires this).
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'pwa_install', { method: 'browser_prompt' });
      }
    });

    // Both capture and clear announce themselves, so the header icon also
    // follows an install started from the /install page.
    onInstallStateChange(render);

    // Coming back to the app is the moment that matters: the reader has been
    // away, and the server may have moved on.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void checkForUpdate();
    });

    // A worker taking over after this page loaded means the code on screen is no
    // longer the code in charge — offer the same Reload rather than yanking the
    // page out from under someone mid-article. Ignored for the very first
    // controller, which is only the initial install claiming this page.
    const hadController = Boolean(navigator.serviceWorker?.controller);
    navigator.serviceWorker?.addEventListener('controllerchange', () => {
      if (hadController) showUpdateBar();
    });
  }

  // Re-render on first load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => {
    render();
    // A navigation already fetched fresh HTML, so this is cheap insurance for
    // the launch case: opening the app icon straight onto a cached document.
    void checkForUpdate();
  });
</script>
