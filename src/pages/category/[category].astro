---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, getPublishedPosts, postCategories, type CategoryId } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return (Object.keys(CATEGORIES) as CategoryId[]).map((category) => ({
    params: { category },
    // Include posts cross-listed under this category, not just its primary.
    props: { posts: posts.filter((p) => postCategories(p).includes(category)), category },
  }));
}

const { posts, category } = Astro.props;
const { label, description } = CATEGORIES[category as CategoryId];
---

<BaseLayout title={`${label} articles`} description={`${description} — ${posts.length} articles.`}>
  <header class="max-w-2xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/blog/" class="hover:text-accent">Blog</a>
    </nav>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{label}</h1>
    <p class="mt-3 text-muted">{description}</p>
  </header>

  {posts.length > 0 ? (
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="mt-10 text-muted">No posts in this category yet.</p>
  )}

  <!-- Category pages are a common search landing point: the reader arrived
       already interested in one subject, which is the easiest case to ask in. -->
  <div class="mt-16">
    <Newsletter source="category" compact />
  </div>
</BaseLayout>
