---
/**
 * The installed app's home screen, and the manifest's start_url.
 *
 * A phone launched from the home screen has no address bar and no patience for
 * a marketing page: it wants the reading queue. So the installed entry point is
 * its own route rather than a standalone-only branch of `/` — that keeps the
 * feed's markup out of every browser visitor's HTML, and keeps this page out of
 * the index (noindex) since it is a shell around content that lives elsewhere.
 *
 * All behaviour for the feed lives in the one script at the bottom: ten cards
 * share a single set of listeners and a single IntersectionObserver.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import AppPostCard from '../components/AppPostCard.astro';
import AppSeriesRail from '../components/AppSeriesRail.astro';
import { getPublishedPosts, getSeriesIndex } from '../lib/posts';
import {
  ADSENSE_LAYOUT_KEY_IN_FEED,
  ADSENSE_SLOT_DISPLAY,
  ADSENSE_SLOT_IN_FEED,
} from '../config';

const [posts, series] = await Promise.all([getPublishedPosts(), getSeriesIndex()]);

// Enough to scroll through on a phone without shipping the whole archive.
const feed = posts.slice(0, 12);
const seriesTitle = new Map(series.map((s) => [s.id, s.title]));

/*
 * One ad, and only one, placed after the fourth card.
 *
 * Deliberately mid-scroll: the reader has passed real content to reach it, and
 * it is nowhere near the tab bar or a card's own reaction row, where a stray
 * thumb would land on an ad instead of the control it aimed for. It also never
 * takes the last slot, so the feed does not end on an advert.
 *
 * Native in-feed when that unit exists, otherwise the responsive display unit —
 * a correct placement either way, just not native until the unit is created.
 */
const AD_AFTER = 4;
const adNative = Boolean(ADSENSE_SLOT_IN_FEED && ADSENSE_LAYOUT_KEY_IN_FEED);
const adSlot = adNative ? ADSENSE_SLOT_IN_FEED : ADSENSE_SLOT_DISPLAY;
// Only worth showing when enough cards follow it to keep the feed reading as a
// feed rather than ending on an advert.
const showAd = feed.length > AD_AFTER + 1;
const feedBefore = showAd ? feed.slice(0, AD_AFTER) : feed;
const feedAfter = showAd ? feed.slice(AD_AFTER) : [];
---

<BaseLayout
  title="Your feed"
  description="The latest engineering articles from MSDEVBUILD, plus the article you were last reading."
  noindex
  ads
  wide
  appShell
>
  <!-- Carries the app chrome to every page opened from the feed, for this tab. -->
  <script is:inline>
    try {
      sessionStorage.setItem('app-shell', '1');
    } catch {
      /* Private mode: the feed still works, later pages just use site nav. */
    }
  </script>

  <div class="mx-auto max-w-2xl pb-10">
    <AppSeriesRail />

    <!-- Filled from this browser's reading history; stays collapsed when empty. -->
    <div data-app-resume class="px-4 pt-3 empty:hidden"></div>

    <div class="px-4 pt-6">
      <div class="section-head">
        <div>
          <p class="eyebrow">Latest</p>
          <h1 class="display mt-1 text-2xl">From the blog</h1>
        </div>
        <a href="/articles/" class="btn btn-outline btn-sm">All articles</a>
      </div>
    </div>

    <div class="mt-4 grid gap-4 px-4">
      {feedBefore.map((post, i) => (
        <AppPostCard
          post={post}
          seriesTitle={post.data.series ? seriesTitle.get(post.data.series) : undefined}
          eager={i === 0}
        />
      ))}

      <!-- Hairlines on the page background, never card chrome: an ad must not be
           mistakable for an article. min-h reserves a 320x100 banner so the cards
           below it do not jump when the unit fills. -->
      {showAd && (
        <AdUnit
          slot={adSlot}
          format={adNative ? 'in-feed' : 'display'}
          layoutKey={ADSENSE_LAYOUT_KEY_IN_FEED}
          class="!my-0 !max-w-none min-h-[100px] border-y border-default py-4"
        />
      )}

      {feedAfter.map((post) => (
        <AppPostCard
          post={post}
          seriesTitle={post.data.series ? seriesTitle.get(post.data.series) : undefined}
        />
      ))}
    </div>

    <p class="px-4 pt-8 text-center text-sm text-muted">
      That is the {feed.length} most recent.
      <a href="/articles/" class="text-accent">Browse everything</a> to go further back.
    </p>
  </div>
</BaseLayout>

<script>
  import {
    createResumeCard,
    getEntry,
    getHistory,
    getResume,
    isBookmarked,
    toggleBookmark,
    type ArticleMeta,
  } from '../lib/reading-history';
  import { FIREBASE } from '../config';

  const BASE = `https://firestore.googleapis.com/v1/projects/${FIREBASE.projectId}/databases/(default)/documents`;
  const counters = FIREBASE.projectId.length > 0;

  // Baselines match ViewCounter.astro and Reactions.astro so the same article
  // never shows one number in the feed and a different one on its own page.
  const VIEW_BASE = 422;
  const REACT_BASE = 2;

  const format = (n: number): string =>
    n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);

  const metaOf = (card: HTMLElement): ArticleMeta | null => {
    const block = card.querySelector('[data-app-meta]');
    try {
      return block ? (JSON.parse(block.textContent ?? '') as ArticleMeta) : null;
    } catch {
      return null;
    }
  };

  function paintSave(card: HTMLElement, on: boolean): void {
    const btn = card.querySelector<HTMLButtonElement>('[data-app-save]');
    if (!btn) return;
    btn.setAttribute('aria-pressed', String(on));
    btn.setAttribute('aria-label', on ? 'Remove from your library' : 'Save to your library');
  }

  /** Views and reaction counts, read once per card when it first appears. */
  async function loadCounts(card: HTMLElement): Promise<void> {
    if (!counters || card.dataset.counted === '') return;
    card.dataset.counted = '';
    const slug = card.dataset.slug;
    if (!slug) return;

    const views = card.querySelector('[data-app-views]');
    if (views) {
      try {
        const doc = await fetch(`${BASE}/views/${encodeURIComponent(slug)}`).then((r) =>
          r.ok ? r.json() : null,
        );
        views.textContent = format(VIEW_BASE + Number(doc?.fields?.count?.integerValue ?? 0));
      } catch {
        views.textContent = format(VIEW_BASE);
      }
    }

    try {
      const doc = await fetch(`${BASE}/reactions/${encodeURIComponent(slug)}`).then((r) =>
        r.ok ? r.json() : null,
      );
      const fields = doc?.fields ?? {};
      card.querySelectorAll<HTMLButtonElement>('[data-react]').forEach((btn) => {
        const key = btn.dataset.react!;
        const out = btn.querySelector(`[data-count="${key}"]`);
        if (out) out.textContent = format(REACT_BASE + Number(fields[key]?.integerValue ?? 0));
        if (localStorage.getItem(`reacted:${slug}:${key}`) !== null) btn.dataset.reacted = '';
      });
    } catch {
      // Counts are decoration: leave the em dash rather than break the feed.
    }
  }

  async function react(card: HTMLElement, btn: HTMLButtonElement): Promise<void> {
    const slug = card.dataset.slug;
    const key = btn.dataset.react;
    if (!counters || !slug || !key) return;

    // One of each reaction per browser, matching Reactions.astro.
    const guard = `reacted:${slug}:${key}`;
    if (localStorage.getItem(guard) !== null) return;
    localStorage.setItem(guard, '1');
    btn.dataset.reacted = '';

    const out = btn.querySelector(`[data-count="${key}"]`);
    const shown = Number(String(out?.textContent).replace(/k$/, '000')) || REACT_BASE;
    if (out) out.textContent = format(shown + 1);

    try {
      const res = await fetch(`${BASE}:commit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          writes: [
            {
              update: {
                name: `projects/${FIREBASE.projectId}/databases/(default)/documents/reactions/${slug}`,
                fields: {},
              },
              updateMask: { fieldPaths: [] },
              updateTransforms: [{ fieldPath: key, increment: { integerValue: '1' } }],
            },
          ],
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
    } catch {
      // Roll the guard back so a genuine failure can be retried.
      localStorage.removeItem(guard);
      delete btn.dataset.reacted;
      if (out) out.textContent = format(shown);
    }
  }

  async function share(card: HTMLElement): Promise<void> {
    const meta = metaOf(card);
    if (!meta) return;
    const url = new URL(meta.url, location.origin).href;

    if (navigator.share) {
      try {
        await navigator.share({ title: meta.title, text: meta.description, url });
        return;
      } catch {
        // Cancelled, or unavailable in this context — fall through to copy.
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      const btn = card.querySelector<HTMLButtonElement>('[data-app-share]');
      if (btn) {
        const original = btn.lastChild;
        const was = original?.textContent ?? 'Share';
        if (original) original.textContent = 'Copied';
        setTimeout(() => {
          if (original) original.textContent = was;
        }, 1600);
      }
    } catch {
      // Nothing sensible left to try; the card's title link still works.
    }
  }

  /** How much of each series this browser has opened. */
  function paintSeries(): void {
    const opened = new Set(getHistory().map((e) => e.slug));
    document.querySelectorAll<HTMLElement>('[data-series-slugs]').forEach((link) => {
      const slugs = link.dataset.seriesSlugs!.split(',').filter(Boolean);
      const total = Number(link.dataset.seriesTotal) || slugs.length || 1;
      const read = slugs.filter((s) => opened.has(s)).length;

      const ring = link.querySelector<HTMLElement>('.app-ring');
      if (ring) ring.style.setProperty('--p', String(Math.round((read / total) * 100)));

      const count = link.querySelector('[data-series-count]');
      if (count) count.textContent = `${read}/${total}`;
    });
  }

  function paintResume(): void {
    const slot = document.querySelector<HTMLElement>('[data-app-resume]');
    if (!slot) return;
    const resume = getResume();
    slot.replaceChildren(...(resume ? [createResumeCard(resume)] : []));
  }

  let observer: IntersectionObserver | undefined;

  function initAppFeed(): void {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-app-card]')];
    if (cards.length === 0) return;

    paintResume();
    paintSeries();
    cards.forEach((card) => {
      const meta = metaOf(card);
      if (meta) paintSave(card, isBookmarked(meta.slug));
      // A card already read shows its progress the way the resume card does.
      const entry = meta ? getEntry(meta.slug) : undefined;
      if (entry && entry.progress > 0 && !entry.completed) {
        card.dataset.progress = String(Math.round(entry.progress * 100));
      }
    });

    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const card = e.target as HTMLElement;
          card.dataset.in = '';
          void loadCounts(card);
          observer?.unobserve(card);
        }
      },
      { rootMargin: '120px 0px', threshold: 0.01 },
    );
    cards.forEach((card) => observer!.observe(card));

    // One delegated listener for the whole feed rather than one per card.
    if (document.body.dataset.appFeedBound === undefined) {
      document.body.dataset.appFeedBound = '';
      document.body.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const card = target.closest<HTMLElement>('[data-app-card]');
        if (!card) return;

        const reactBtn = target.closest<HTMLButtonElement>('[data-react]');
        if (reactBtn) {
          void react(card, reactBtn);
          return;
        }
        if (target.closest('[data-app-share]')) {
          void share(card);
          return;
        }
        if (target.closest('[data-app-save]')) {
          const meta = metaOf(card);
          if (meta) paintSave(card, toggleBookmark(meta));
        }
      });
    }
  }

  initAppFeed();
  // View Transitions swap the body, so re-bind against the new nodes.
  document.addEventListener('astro:page-load', initAppFeed);
  // Reading elsewhere (or clearing history) should be reflected on return.
  window.addEventListener('reading-history-change', () => {
    paintResume();
    paintSeries();
  });
</script>
