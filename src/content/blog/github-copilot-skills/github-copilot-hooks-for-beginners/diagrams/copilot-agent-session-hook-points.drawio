<mxfile host="app.diagrams.net"><diagram name="Hook points" id="Hookpoints"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="6" width="759" height="782" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;You give the agent a task&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Plain language, in agent mode&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="155" y="30" width="330" height="62" as="geometry"/></mxCell><mxCell id="g2" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HOOK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Before the session starts&lt;br&gt;&lt;font color='#6B7280'&gt;Load context, check the branch is clean&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="155" y="126" width="330" height="62" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;Agent proposes a command&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Probabilistic. Usually right. Not always.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="155" y="222" width="330" height="62" as="geometry"/></mxCell><mxCell id="g4" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HOOK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Before the tool runs&lt;br&gt;&lt;font color='#6B7280'&gt;Deterministic. Same input, same answer, every time.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="155" y="318" width="330" height="62" as="geometry"/></mxCell><mxCell id="g4bk" value="Blocked -&gt; the command never executes" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#A02C2C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="501" y="337" width="250" height="34" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;The command runs&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Only what survived the gate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="155" y="414" width="330" height="62" as="geometry"/></mxCell><mxCell id="g6" value="&lt;font color='#6B7280'&gt;&lt;b&gt;HOOK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;After the session ends&lt;br&gt;&lt;font color='#6B7280'&gt;Format, lint, run the tests, write the log&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 6;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="155" y="510" width="330" height="62" as="geometry"/></mxCell><mxCell id="g7" value="&lt;b&gt;A change you can review&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Nothing surprising happened on the way here&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="155" y="606" width="330" height="62" as="geometry"/></mxCell><mxCell id="ge0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge5" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="A hook runs outside the model. That is the whole point:&lt;br&gt;the agent can be talked out of a rule, a shell script cannot." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="560" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>