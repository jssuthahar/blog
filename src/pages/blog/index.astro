---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../config';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="All posts"
  description={`Every article on ${SITE.title} — .NET, C#, Azure, and AI engineering guides.`}
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">All posts</h1>
    <p class="mt-3 text-muted">
      {posts.length} {posts.length === 1 ? 'article' : 'articles'} on .NET, Azure, and AI engineering.
    </p>
  </header>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
