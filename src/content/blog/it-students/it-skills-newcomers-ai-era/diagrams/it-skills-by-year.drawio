<mxfile host="app.diagrams.net"><diagram name="IT skills by year" id="ITskillsbyyear"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="6" width="608" height="402" as="geometry"/></mxCell><mxCell id="y1" value="&lt;b&gt;1. First year&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;the floor, plus AI literacy, databases, problem-solving&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="560" height="66" as="geometry"/></mxCell><mxCell id="y2" value="&lt;b&gt;2. Second year&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;APIs, security, cloud basics, documentation; one feature built with AI&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="560" height="66" as="geometry"/></mxCell><mxCell id="y3" value="&lt;b&gt;3. Final year&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;CI/CD, two finished projects, one emerging AI skill&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="560" height="66" as="geometry"/></mxCell><mxCell id="y4" value="&lt;b&gt;4. Graduate or career changer&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;fill gaps in the floor, then show one emerging skill&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wr