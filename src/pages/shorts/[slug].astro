---
/**
 * One short video, understood one stage at a time.
 *
 * The short runs in the sandboxed player; every step it plays is also written
 * out beside it as ordinary, indexable prose. That duplication is the point of
 * the page. Nothing that only plays is visible to a search engine or an answer
 * engine — the step list is the version that gets crawled, quoted and ranked,
 * and it is also the version a reader can go back over at their own speed,
 * which a thirty-second player does not allow.
 *
 * Clicking a step drives the player to that stage. When the player advances on
 * its own, the matching step lights up. Neither direction is required for the
 * page to work: with no JavaScript at all, this is still the full explanation
 * in order.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShortPlayer from '../../components/ShortPlayer.astro';
import AppPromo from '../../components/AppPromo.astro';
import AdUnit from '../../components/AdUnit.astro';
import Newsletter from '../../components/Newsletter.astro';
import ShareRow from '../../components/ShareRow.astro';
import Reactions from '../../components/Reactions.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import PresentationMode from '../../components/PresentationMode.astro';
import { AUTHOR } from '../../config';
import { SITE, ADSENSE_SLOT_IN_ARTICLE, ADSENSE_SLOT_MULTIPLEX } from '../../config';
import { shortUrl, getShorts, type Short } from '../../lib/shorts';
import { CATEGORIES, formatDate, getPublishedPosts, postUrl } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = () =>
  getShorts().map((short) => ({
    params: { slug: short.slug },
    props: { short },
  }));

const { short } = Astro.props as { short: Short };

const category = CATEGORIES[short.category];
const url = new URL(shortUrl(short), SITE.url).href;

// Articles that go deeper on the same subject. A short is the doorway; these
// are the rooms — and they are the internal links this page contributes.
//
// The spec's own `article` link (when set) is the author naming the room this
// short leads to, so it goes first and never gets bumped by a same-category
// post that merely published more recently. Same confidence order as
// `learnMoreFor` in lib/app-feed.ts, which drives the same link on /app.
const posts = await getPublishedPosts();
const linkedPost = short.articleSlug ? posts.find((p) => p.id === short.articleSlug) : undefined;
const relatedPosts = [
  ...(linkedPost ? [linkedPost] : []),
  ...posts.filter((p) => p.data.category === short.category && p.id !== linkedPost?.id),
].slice(0, 3);

const relatedShorts = getShorts()
  .filter((a) => a.slug !== short.slug)
  .sort((a, b) => Number(b.category === short.category) - Number(a.category === short.category))
  .slice(0, 3);

/**
 * HowTo, because that is what this genuinely is: an ordered set of steps that
 * take a reader from not understanding something to understanding it. Every
 * `name` and `text` below is the short's own authored copy — nothing is
 * generated to fill a schema slot, which is the line between structured data
 * that earns a rich result and structured data that earns a penalty.
 */
const schema: Record<string, unknown>[] = [
  {
    '@type': 'HowTo',
    '@id': `${url}#howto`,
    name: short.topic,
    description: short.sub,
    totalTime: `PT${short.seconds}S`,
    inLanguage: SITE.lang,
    // Only emitted when the short is dated. An undated short still publishes
    // (see `Short.publishedAt`), and a guessed date in structured data is worse
    // than none — it is the field Google trusts to say how fresh this is.
    ...(short.publishedAt && {
      datePublished: short.publishedAt.toISOString(),
      dateModified: (short.updatedAt ?? short.publishedAt).toISOString(),
    }),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: category.label },
    keywords: short.tags.join(', '),
    step: short.stages.map((stage, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: stage.title,
      text: stage.desc,
      url: `${url}#step-${index + 1}`,
    })),
  },
  // The page's whole content is a video, and nothing on the page said so
  // structurally until this — HowTo describes the steps, not the medium.
  // No contentUrl/embedUrl: the player has no public file to point at on
  // purpose (see ShortPlayer.astro — nothing to hotlink, nothing to save),
  // so this stays a description of the video rather than a claim of one
  // Google can fetch. It is still valid, useful VideoObject data for an
  // answer engine deciding whether "short video" is the right thing to cite.
  {
    '@type': 'VideoObject',
    '@id': `${url}#video`,
    name: short.title,
    description: short.description,
    thumbnailUrl: [new URL(`/og/short-${short.slug}.png`, SITE.url).href],
    duration: `PT${short.seconds}S`,
    inLanguage: SITE.lang,
    // Same rule as HowTo below: only emitted when the short is actually
    // dated, because a guessed uploadDate is worse than none.
    ...(short.publishedAt && {
      uploadDate: short.publishedAt.toISOString(),
      ...(short.updatedAt && { dateModified: short.updatedAt.toISOString() }),
    }),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: category.label },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Short videos', item: `${SITE.url}/shorts/` },
      { '@type': 'ListItem', position: 3, name: short.title, item: url },
    ],
  },
];

// Same rule as the blog post: FAQ schema is what earns rich results and gets
// quoted by AI answer engines. Only emitted when the spec actually carries one.
if (short.faq.length > 0) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: short.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}
---

<BaseLayout
  title={short.seoTitle}
  description={short.description}
  image={`/og/short-${short.slug}.png`}
  markdownUrl={`/shorts/${short.slug}.md`}
  schema={schema}
  wide
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
    <!-- ══════════════ Breadcrumb ══════════════ -->
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/shorts/" class="hover:text-accent">Short videos</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/shorts/?category=${short.category}`} class="hover:text-accent">
            {category.label}
          </a>
        </li>
      </ol>
    </nav>

    <!-- ══════════════ Header ══════════════ -->
    <!-- The bottom margin is the gap above the sticky reader bar below. It
         cannot live on that bar: a margin on a sticky element adds to where it
         comes to rest, leaving a gap under the site header. -->
    <header class="mt-6 mb-6 max-w-3xl">
      <!-- The category chip stays above the title, where it sets up what is
           coming. The rest of the meta moved into the sticky bar below, so the
           tools cost no row of their own. -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span
          class="rounded-full px-2.5 py-1 font-semibold"
          style="background: var(--accent-soft); color: var(--accent);"
        >
          {category.label}
        </span>
      </div>

      <h1 class="display mt-3 text-[1.9rem] leading-tight text-balance sm:text-4xl">
        {short.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted text-pretty">{short.sub}</p>

      <!-- What you take away, before you press play.
           A short opens on a hook, and a hook withholds on purpose — which is
           exactly wrong for somebody deciding whether to spend thirty seconds
           here. This states the scope in plain prose instead, which is also the
           passage an answer engine can lift when asked what the short covers. -->
      {short.learn.length > 0 && (
        <section class="mt-5 rounded-xl border border-default bg-subtle p-5" aria-labelledby="learn-heading">
          <h2 id="learn-heading" class="text-sm font-semibold tracking-wider uppercase" style="color: var(--accent);">
            What you'll learn
          </h2>
          <ul class="mt-3 space-y-2">
            {short.learn.map((point) => (
              <li class="flex gap-2.5 leading-relaxed">
                <svg
                  class="mt-1 size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                  stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                  style="color: var(--accent);" aria-hidden="true"
                >
                  <path d="m4 10.5 4 4 8-9" />
                </svg>
                <span class="text-pretty">{point}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </header>

    <!--
      The steps are the readable half of a short, so they get the same reader
      tools an article does — and the deck turns them straight back into the
      slides they were drawn as.

      A direct child of the page container, with no wrapper: a sticky element is
      constrained by its parent, so a `<div class="mt-6">` around it would be a
      box exactly its own height and it would come unstuck the moment it moved.
      The spacing above it lives on the header instead.
    -->
    <ReaderTools
      slug={`short-${short.slug}`}
      title={short.title}
      path={shortUrl(short)}
      category={category.label}
      hue={category.hue}
      present
      align="start"
    >
      <Fragment slot="meta">
        <span>{short.folderLabel}</span>
        <span>{short.stages.length} steps</span>
        <span>{short.seconds} seconds</span>
        {short.publishedAt && <time datetime={short.publishedAt.toISOString()}>{formatDate(short.publishedAt)}</time>}
        {short.updatedAt && (
          <span class="text-accent">Updated {formatDate(short.updatedAt)}</span>
        )}
        <!--
          The same counter an article carries, on the same Firestore document
          the app feed already writes for this short — hence the `short-`
          prefix, which is also the key Reactions and ReaderTools use here.
          Get that prefix wrong and a short would count views twice, under two
          names, and agree with nothing.
        -->
        <ViewCounter slug={`short-${short.slug}`} />
      </Fragment>
    </ReaderTools>

    <!-- Reactions and share sit above the player rather than after the steps.
         A short is thirty seconds long: by the time someone has watched it they
         have already decided what they think, and a control they have to scroll
         back up — or all the way down — to reach is a control they do not use.
         One instance only; the Reactions script binds a single root per page. -->
    <div class="mt-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-y border-default py-4">
      <Reactions slug={`short-${short.slug}`} />
      <ShareRow title={`${short.title} — a ${short.seconds}-second short video`} path={shortUrl(short)} />
    </div>

    <!-- ══════════════ Player + steps ══════════════ -->
    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <ShortPlayer short={short} />
      </div>

      <div>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="display text-2xl">Understand it one step at a time</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              The short runs these in order in about {short.seconds} seconds. Here they
              are written out — pick any step to jump the short straight to it.
            </p>
          </div>

          <!-- Two ways to read the same steps. "All steps" is the no-JS baseline
               (plain, crawlable, always visible); "One at a time" is a pure
               enhancement that mirrors whichever stage the player is on, so it
               never drifts out of sync with the short. -->
          <div
            class="steps-view-toggle"
            role="tablist"
            aria-label="Steps view"
            data-steps-view-toggle
          >
            <button type="button" role="tab" aria-selected="true" data-steps-view-btn="list" class="steps-view-btn">
              All steps
            </button>
            <button type="button" role="tab" aria-selected="false" data-steps-view-btn="focus" class="steps-view-btn">
              One at a time
            </button>
          </div>
        </div>

        <div class="mt-6" data-steps-views data-active-view="list">
          <ol class="space-y-3" data-short-steps data-reader-root data-steps-panel="list">
            {short.stages.map((stage, index) => (
              <li id={`step-${index + 1}`} class="scroll-mt-24">
                <button
                  type="button"
                  data-short-step={index}
                  data-step-title={stage.title}
                  data-step-desc={stage.desc}
                  aria-current="false"
                  class="short-step w-full rounded-xl border border-default bg-[var(--bg)] p-4 text-left transition-colors hover:border-[var(--accent)]"
                >
                  <div class="flex gap-3.5">
                    <span
                      class="short-step__num mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-default text-xs font-semibold tabular-nums"
                    >
                      {index + 1}
                    </span>
                    <div class="min-w-0">
                      <h3 class="font-semibold leading-snug tracking-tight">{stage.title}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-muted">{stage.desc}</p>
                    </div>
                  </div>
                </button>
              </li>
            ))}
          </ol>

          <!-- Auto-advancing focus card: same data as the list above (copied
               from its data-step-* attributes at runtime), just one stage tall.
               It updates from the same `short:stage` event the list uses to
               highlight the active row, so both views always agree with the
               player and with each other. -->
          <div class="steps-focus rounded-xl border border-default bg-[var(--bg)] p-5" data-steps-panel="focus">
            <div class="flex items-center justify-between gap-3">
              <span
                class="short-step__num grid size-7 shrink-0 place-items-center rounded-full border border-default text-xs font-semibold tabular-nums"
                data-steps-focus-num
              >
                1
              </span>
              <span class="text-xs font-medium text-muted" data-steps-focus-progress>
                Step 1 of {short.stages.length}
              </span>
            </div>
            <h3 class="mt-3 text-lg font-semibold leading-snug tracking-tight" data-steps-focus-title>
              {short.stages[0]?.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted" data-steps-focus-desc>
              {short.stages[0]?.desc}
            </p>
          </div>
        </div>

        <!-- The closing card, kept as text. This is the sentence the whole short
             exists to land, so it is also the passage most worth quoting. -->
        <aside
          class="mt-8 rounded-xl border-l-4 bg-subtle p-5"
          style="border-left-color: var(--accent);"
        >
          <p class="text-sm font-semibold tracking-wider uppercase" style="color: var(--accent);">
            The takeaway
          </p>
          <p class="mt-2 text-lg font-semibold leading-snug text-balance">{short.end.title}</p>
          <p class="mt-2 leading-relaxed text-muted text-pretty">{short.end.sub}</p>
        </aside>

      </div>
    </div>

    {short.faq.length > 0 && (
      <section class="mt-14 border-t border-default pt-8" aria-labelledby="short-faq-heading">
        <h2 id="short-faq-heading" class="display text-2xl">Frequently asked questions</h2>
        <dl class="mt-6 space-y-4">
          {short.faq.map(({ q, a }) => (
            <div class="rounded-xl border border-default p-5">
              <dt class="font-semibold">{q}</dt>
              <dd class="mt-2 leading-relaxed text-muted">{a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- In-article unit at the end of the read, matching how a blog post places
         it: nothing sits between the player and the steps, so the explanation
         is never interrupted by an advert. -->
    <AdUnit slot={ADSENSE_SLOT_IN_ARTICLE} />

    <div class="mt-12">
      <AppPromo />
    </div>

    {relatedPosts.length > 0 && (
      <section class="mt-14 border-t border-default pt-8">
        <h2 class="display text-2xl">Read deeper on {category.label}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
          Twenty seconds gets the shape of an idea across. These go into how it
          behaves in production.
        </p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {relatedPosts.map((post) => (
            <li class="group rounded-xl border border-default p-4 transition-colors hover:border-[var(--accent)]">
              <h3 class="font-semibold leading-snug tracking-tight">
                <a href={postUrl(post)} class="group-hover:text-accent">{post.data.title}</a>
              </h3>
              <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-muted">
                {post.data.description}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedShorts.length > 0 && (
      <section class="mt-12">
        <h2 class="display text-2xl">More shorts</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {relatedShorts.map((other) => (
            <li class="group rounded-xl border border-default p-4 transition-colors hover:border-[var(--accent)]">
              <p class="text-xs font-semibold" style="color: var(--accent);">
                {CATEGORIES[other.category].label}
              </p>
              <h3 class="mt-1 font-semibold leading-snug tracking-tight">
                <a href={shortUrl(other)} class="group-hover:text-accent">{other.title}</a>
              </h3>
              <p class="mt-1.5 text-xs text-muted">
                {other.stages.length} steps · {other.seconds}s
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-12">
      <Newsletter source="shorts" />
    </div>

    <!-- Multiplex grid last, below our own recommendations — the reader always
         meets the site's shorts and articles before the ad network's. -->
    <AdUnit slot={ADSENSE_SLOT_MULTIPLEX} format="multiplex" class="!max-w-none" />
  </div>

  <!-- One slide per step — which is the shape the short was written in before
       it was ever a video. -->
  <PresentationMode
    title={short.title}
    description={short.sub}
    category={category.label}
    hue={category.hue}
    author={AUTHOR.name}
    url={url}
    mode="items"
  />
</BaseLayout>

<style>
  .short-step[aria-current='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .short-step[aria-current='true'] .short-step__num {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Steps view toggle: "All steps" is the plain, no-JS baseline (visible by
     default via [data-active-view="list"] below), "One at a time" is a pure
     enhancement — both panels exist in the DOM, only one is shown at once. */
  .steps-view-toggle {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem;
  }
  .steps-view-btn {
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .steps-view-btn[aria-selected='true'] {
    background: var(--accent);
    color: #fff;
  }

  [data-steps-views] > [data-steps-panel] {
    display: none;
  }
  [data-steps-views][data-active-view='list'] > [data-steps-panel='list'] {
    display: block;
  }
  [data-steps-views][data-active-view='focus'] > [data-steps-panel='focus'] {
    display: block;
  }
</style>

<script>
  /**
   * Two-way sync with the player.
   *
   * Both directions go through DOM events on `document` rather than a direct
   * reference to the iframe: the player owns the postMessage channel, this owns
   * the list, and neither imports the other.
   */
  function initShortSteps() {
    const list = document.querySelector('[data-short-steps]');
    if (!list) return;

    const steps = [...list.querySelectorAll<HTMLButtonElement>('[data-short-step]')];
    if (steps.length === 0) return;

    // The focus card's fields, populated from whichever step is active —
    // read straight off that step's own data-step-* attributes, so the card
    // never carries a second copy of the copy to drift out of sync with.
    const focusNum = document.querySelector('[data-steps-focus-num]');
    const focusProgress = document.querySelector('[data-steps-focus-progress]');
    const focusTitle = document.querySelector('[data-steps-focus-title]');
    const focusDesc = document.querySelector('[data-steps-focus-desc]');

    const showStage = (index: number) => {
      steps.forEach((step, i) => step.setAttribute('aria-current', String(i === index)));

      const step = steps[index];
      if (!step) return;
      if (focusNum) focusNum.textContent = String(index + 1);
      if (focusProgress) focusProgress.textContent = `Step ${index + 1} of ${steps.length}`;
      if (focusTitle) focusTitle.textContent = step.dataset.stepTitle ?? '';
      if (focusDesc) focusDesc.textContent = step.dataset.stepDesc ?? '';
    };

    for (const step of steps) {
      step.addEventListener('click', () => {
        const index = Number(step.dataset.shortStep);
        showStage(index);
        document.dispatchEvent(new CustomEvent('short:jump', { detail: { index } }));

        // On a phone the player sits above the list and is off-screen by the
        // time you reach step six — a jump you cannot see has not happened.
        if (window.matchMedia('(max-width: 1023px)').matches) {
          document
            .querySelector('[data-short-player]')
            ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    document.addEventListener('short:stage', (event) => {
      const index = (event as CustomEvent<{ index: number }>).detail?.index;
      if (typeof index === 'number') showStage(index);
    });
  }

  /**
   * Which of the two panels is visible. Purely a display toggle — both panels
   * stay populated by `initShortSteps` above regardless of which one shows, so
   * switching views never has to fetch or recompute anything.
   */
  function initStepsViewToggle() {
    const wrapper = document.querySelector<HTMLElement>('[data-steps-views]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-steps-view-btn]')];
    if (!wrapper || buttons.length === 0) return;

    const setView = (view: string) => {
      wrapper.dataset.activeView = view;
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.stepsViewBtn === view)));
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        if (button.dataset.stepsViewBtn) setView(button.dataset.stepsViewBtn);
      });
    }

    // The player fires this when its own "Full screen" goes active — land the
    // reader on one focused step instead of the full list for when they exit.
    document.addEventListener('short:fullscreen', (event) => {
      const active = (event as CustomEvent<{ active: boolean }>).detail?.active;
      if (active) setView('focus');
    });
  }

  initShortSteps();
  initStepsViewToggle();
  document.addEventListener('astro:page-load', initShortSteps);
  document.addEventListener('astro:page-load', initStepsViewToggle);
</script>
