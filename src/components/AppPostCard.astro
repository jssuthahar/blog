---
/**
 * A feed card for the installed app (/app).
 *
 * Same information as PostCard, restacked for a phone and given the engagement
 * row the web card does not need: reactions, save, share and a view count. It
 * is markup only — every behaviour is delegated to the one script on /app, so
 * ten cards cost one listener set rather than ten.
 *
 * Server data the client script needs (title, cover, hue…) rides along in a
 * JSON block, the same pattern ReadingTracker uses, because bundled modules
 * cannot take define:vars.
 */
import Avatar from './Avatar.astro';
import CoverArt from './CoverArt.astro';
import { CATEGORIES, formatDate, postUrl, readingTime, type Post } from '../lib/posts';
import type { ArticleMeta } from '../lib/reading-history';
import { AUTHOR } from '../config';

interface Props {
  post: Post;
  seriesTitle?: string;
  /** First card in the feed loads its cover eagerly. */
  eager?: boolean;
}

const { post, seriesTitle, eager = false } = Astro.props;
const { data } = post;
const category = CATEGORIES[data.category];
const minutes = readingTime(post.body ?? '');
const url = postUrl(post);

// Keys must match the fixed set in firestore.rules and Reactions.astro exactly.
const REACTIONS = [
  { key: 'like', emoji: '👍', label: 'Like' },
  { key: 'love', emoji: '❤️', label: 'Love' },
  { key: 'celebrate', emoji: '🎉', label: 'Celebrate' },
  { key: 'insightful', emoji: '💡', label: 'Insightful' },
] as const;

const meta: ArticleMeta = {
  slug: post.id,
  title: data.title,
  url,
  description: data.description,
  cover: data.cover?.src ?? '',
  coverAlt: data.coverAlt ?? '',
  category: data.category,
  categoryLabel: category.label,
  hue: category.hue,
  minutes,
};

// Escape `<` so a value containing `</script>` cannot close the block early.
const metaJson = JSON.stringify(meta).replace(/</g, '\\u003c');
---

<article
  class="app-card overflow-hidden rounded-xl border border-default"
  data-app-card
  data-slug={post.id}
>
  <a href={url} class="block aspect-[1200/630] overflow-hidden bg-subtle" tabindex="-1" aria-hidden="true">
    <CoverArt post={post} eager={eager} />
  </a>

  <div class="flex flex-wrap items-center gap-2 px-3.5 pt-3 text-xs">
    <span
      class="rounded-full px-2 py-0.5 font-medium"
      style={`background: oklch(0.62 0.17 ${category.hue} / 0.14); color: oklch(0.62 0.17 ${category.hue});`}
    >
      {category.label}
    </span>
    <span class="text-muted">{minutes} min</span>
    {seriesTitle && data.seriesOrder && (
      <span class="text-muted">· {seriesTitle}, part {data.seriesOrder}</span>
    )}
  </div>

  <div class="px-3.5 pt-2.5">
    <h3 class="text-lg leading-snug font-semibold tracking-tight">
      <a href={url} class="hover:text-accent">{data.title}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{data.description}</p>
  </div>

  <div class="mx-3.5 mt-3 flex items-center gap-2 border-t border-default pt-2.5 text-xs text-muted">
    <Avatar size={20} />
    <span>{AUTHOR.name}</span>
    <span aria-hidden="true">·</span>
    <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
  </div>

  <!-- Counts load when the card scrolls into view, so a long feed stays cheap. -->
  <div class="flex flex-wrap gap-1.5 px-3.5 pt-3" role="group" aria-label="React to this article">
    {REACTIONS.map((r) => (
      <button
        type="button"
        data-react={r.key}
        aria-label={r.label}
        title={r.label}
        class="app-react inline-flex items-center gap-1.5 rounded-full border border-default px-2.5 py-1 leading-none transition-colors hover:bg-subtle"
      >
        <span class="text-[0.95rem] leading-none">{r.emoji}</span>
        <span data-count={r.key} class="text-xs tabular-nums text-muted">—</span>
      </button>
    ))}
  </div>

  <div class="flex items-center gap-1 px-2 py-1.5 text-muted">
    <a
      href={`${url}#comments-heading`}
      class="inline-flex h-10 items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium transition-colors hover:bg-subtle"
    >
      <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A3.5 3.5 0 0 1 16.5 18H8.5L4 21V6.5A3.5 3.5 0 0 1 7.5 3h9A3.5 3.5 0 0 1 20 6.5Z" />
      </svg>
      Comment
    </a>

    <button
      type="button"
      data-app-share
      class="inline-flex h-10 items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium transition-colors hover:bg-subtle"
    >
      <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 16.5V4" /><path d="m7.5 8.5 4.5-4.5 4.5 4.5" />
        <path d="M5 14v5.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V14" />
      </svg>
      Share
    </button>

    <span class="inline-flex h-10 items-center gap-1.5 px-2.5 text-xs tabular-nums">
      <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12Z" />
        <circle cx="12" cy="12" r="2.6" />
      </svg>
      <span data-app-views>—</span>
      <span class="sr-only">views</span>
    </span>

    <span class="flex-1"></span>

    <button
      type="button"
      data-app-save
      aria-pressed="false"
      aria-label="Save to your library"
      class="app-save inline-flex size-10 items-center justify-center rounded-lg transition-colors hover:bg-subtle"
    >
      <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6.5 3.8h11a1 1 0 0 1 1 1v15.4L12 16.6l-6.5 3.6V4.8a1 1 0 0 1 1-1Z" />
      </svg>
    </button>
  </div>

  <script is:inline type="application/json" data-app-meta set:html={metaJson}></script>
</article>

<style>
  /* Matches the reacted state used by Reactions.astro and EngagementRail. */
  .app-react[data-reacted] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .app-react[data-reacted] [data-count] {
    color: var(--accent);
    font-weight: 600;
  }
  .app-react[data-reacted] span:first-child {
    animation: app-pop 0.44s cubic-bezier(0.2, 1.5, 0.4, 1);
  }
  @keyframes app-pop {
    0% { transform: scale(1); }
    35% { transform: scale(1.4); }
    70% { transform: scale(0.93); }
    100% { transform: scale(1); }
  }

  .app-save[aria-pressed='true'] {
    color: var(--accent);
  }
  .app-save[aria-pressed='true'] svg {
    fill: var(--accent);
  }

  /* Cards fade up as they enter the feed; the observer adds the class. */
  .app-card {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .app-card[data-in] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card {
      opacity: 1;
      transform: none;
    }
    .app-react[data-reacted] span:first-child {
      animation: none;
    }
  }
</style>
