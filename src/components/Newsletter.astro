---
import { FIREBASE, NEWSLETTER } from '../config';

interface Props {
  compact?: boolean;
  /** Recorded against the subscriber so signup sources can be compared. */
  source?: string;
}

const { compact = false, source = 'inline-form' } = Astro.props;

// Enabled as soon as there is somewhere to put the address — Firestore alone
// is enough; the email provider is an additional destination, not a gate.
const enabled = FIREBASE.projectId.length > 0 || NEWSLETTER.action.length > 0;
---

<section
  class:list={['rounded-xl border border-default bg-subtle', compact ? 'p-6' : 'p-8 md:p-12']}
  aria-labelledby="newsletter-heading"
>
  <div class="mx-auto max-w-xl text-center">
    <h2
      id="newsletter-heading"
      class:list={['font-semibold tracking-tight', compact ? 'text-lg' : 'text-2xl']}
    >
      Get new posts by email
    </h2>
    <p class="mt-2 text-sm text-muted">
      New technical articles, Azure AI and GitHub Copilot updates, and upcoming events.
      No spam, unsubscribe anytime.
    </p>

    <form
      data-newsletter-form
      data-source={source}
      class="mt-5 flex flex-col gap-2 sm:flex-row"
      novalidate
    >
      <label for={`newsletter-email-${source}`} class="sr-only">Email address</label>
      <input
        id={`newsletter-email-${source}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        disabled={!enabled}
        class="flex-1 rounded-md border border-default bg-[var(--bg)] px-4 py-2.5 text-sm disabled:opacity-60"
      />
      <button type="submit" disabled={!enabled} class="btn btn-accent btn-sm disabled:opacity-60">
        Subscribe
      </button>
    </form>

    <p data-newsletter-status role="status" aria-live="polite" class="mt-3 min-h-5 text-sm"></p>

    {!enabled && (
      <p class="mt-1 text-xs text-muted">
        Set <code>FIREBASE.projectId</code> or <code>NEWSLETTER.action</code> in
        <code>src/config.ts</code> to enable this form.
      </p>
    )}
  </div>
</section>

<script>
  import { subscribe } from '../lib/subscribe';

  function initNewsletterForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]');

    forms.forEach((form) => {
      if (form.dataset.bound === '') return;
      form.dataset.bound = '';

      const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');

      const say = (message: string, tone: 'ok' | 'error' | 'muted') => {
        if (!status) return;
        status.textContent = message;
        status.style.color = tone === 'muted' ? 'var(--text-muted)' : 'var(--accent)';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        button.disabled = true;
        say('Subscribing…', 'muted');

        try {
          await subscribe(input.value, form.dataset.source ?? 'inline-form');
          say("Thanks — you're subscribed. Check your inbox.", 'ok');
          form.hidden = true;
        } catch (error) {
          button.disabled = false;
          say(
            error instanceof Error && error.message === 'invalid-email'
              ? 'Please enter a valid email address.'
              : 'Something went wrong. Please try again later.',
            'error',
          );
          input.focus();
        }
      });
    });
  }

  initNewsletterForms();
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
