---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareRow from '../../components/ShareRow.astro';
import Reactions from '../../components/Reactions.astro';
import EngagementRail from '../../components/EngagementRail.astro';
import FeedbackDialog from '../../components/FeedbackDialog.astro';
import ArticleChat from '../../components/ArticleChat.astro';
import CodeCopyButton from '../../components/CodeCopyButton.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import Comments from '../../components/Comments.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import ReadingTracker from '../../components/ReadingTracker.astro';
import PostHighlight from '../../components/PostHighlight.astro';
import FollowCTA from '../../components/FollowCTA.astro';
import AdUnit from '../../components/AdUnit.astro';
import { SITE, AUTHOR, ADSENSE_SLOT_IN_ARTICLE, ADSENSE_SLOT_MULTIPLEX } from '../../config';
import {
  CATEGORIES,
  formatDate,
  getAdjacentPosts,
  getPostsInSeries,
  getPublishedPosts,
  getRelatedPosts,
  postUrl,
  readingTime,
  slugifyTag,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const minutes = readingTime(post.body ?? '');
const related = await getRelatedPosts(post);
const { newer, older } = await getAdjacentPosts(post);
const seriesPosts = data.series ? await getPostsInSeries(data.series) : [];
const path = postUrl(post);
const category = CATEGORIES[data.category];

// --- Structured data -------------------------------------------------------
const schema: Record<string, unknown>[] = [
  {
    '@type': 'BlogPosting',
    '@id': new URL(path, SITE.url).href + '#article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedAt.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(path, SITE.url).href },
    articleSection: category.label,
    keywords: data.tags.join(', '),
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    inLanguage: SITE.lang,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: category.label, item: `${SITE.url}/category/${data.category}` },
      { '@type': 'ListItem', position: 4, name: data.title },
    ],
  },
];

// FAQ schema is what earns rich results and gets quoted by AI answer engines.
if (data.faq.length > 0) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  canonical={data.canonical ?? path}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  markdownUrl={`${path}.md`}
  image={`/og/${post.id}.png`}
  schema={schema}
  wide
>
  <ReadingProgress />

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <!-- Header spans the full column; the body below is narrower for reading. -->
    <header class="mx-auto max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a href="/blog" class="hover:text-accent">Blog</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <a href={`/category/${data.category}`} class="hover:text-accent">{category.label}</a>
      </nav>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl md:text-[2.75rem] md:leading-[1.15]">
        {data.title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-muted text-pretty">{data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
        <span>By <a href="/about" class="hover:text-accent">{AUTHOR.name}</a></span>
        <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
        {data.updatedAt && (
          <span class="text-accent">Updated {formatDate(data.updatedAt)}</span>
        )}
        <span>{minutes} min read</span>
        <ViewCounter slug={post.id} />
        <ReadingTracker post={post} />
      </div>
    </header>

    {data.cover && (
      <figure class="mx-auto mt-10 max-w-4xl">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 896px) 100vw, 896px"
          quality={90}
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-xl border border-default"
        />
      </figure>
    )}

    <div class="mt-12 gap-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem]">
      <div class="mx-auto min-w-0 max-w-3xl">
        {seriesPosts.length > 1 && (
          <aside class="mb-10 rounded-xl border border-default bg-subtle p-5" aria-label="Series navigation">
            <p class="text-xs font-semibold tracking-wider uppercase text-muted">Part of a series</p>
            <ol class="mt-3 space-y-2 text-sm">
              {seriesPosts.map((p) => (
                <li class="flex gap-3">
                  <span class="text-muted tabular-nums">{p.data.seriesOrder}.</span>
                  {p.id === post.id ? (
                    <span class="font-medium" aria-current="true">{p.data.title}</span>
                  ) : (
                    <a href={postUrl(p)} class="text-muted hover:text-accent">{p.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </aside>
        )}

        <!-- Highlight sits above the body, outside .prose-reading, so it keeps
             the sans stack and does not inherit article paragraph spacing. -->
        <div class="mb-9 max-w-[68ch]">
          <PostHighlight text={data.highlight ?? data.description} />
        </div>

        <article class="prose-reading">
          <Content />
        </article>

        <div class="mx-auto mt-12 max-w-[68ch] border-t border-default pt-8" data-engagement-end>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <Reactions slug={post.id} />
            <ShareRow title={data.title} path={path} />
          </div>
        </div>

        {data.faq.length > 0 && (
          <section class="mx-auto mt-16 max-w-[68ch]" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">
              Frequently asked questions
            </h2>
            <dl class="mt-6 space-y-6">
              {data.faq.map(({ q, a }) => (
                <div class="rounded-lg border border-default p-5">
                  <dt class="font-semibold">{q}</dt>
                  <dd class="mt-2 leading-relaxed text-muted">{a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <!-- One in-article ad at the end of the read, before the engagement
             bar. No sticky/mid-content units, so it never interrupts reading. -->
        <AdUnit slot={ADSENSE_SLOT_IN_ARTICLE} />

        <div class="mx-auto mt-14 max-w-[68ch] border-t border-default pt-8">
          {data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tag/${slugifyTag(tag)}`}
                    class="inline-block rounded-full border border-default px-3 py-1 text-sm text-muted transition-colors hover:text-accent hover:bg-subtle"
                  >
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <nav class="mx-auto mt-10 grid max-w-[68ch] gap-4 sm:grid-cols-2" aria-label="Adjacent posts">
          {older && (
            <a href={postUrl(older)} class="rounded-lg border border-default p-4 transition-colors hover:bg-subtle">
              <span class="text-xs text-muted">← Previous</span>
              <span class="mt-1 block font-medium">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a href={postUrl(newer)} class="rounded-lg border border-default p-4 text-right transition-colors hover:bg-subtle sm:col-start-2">
              <span class="text-xs text-muted">Next →</span>
              <span class="mt-1 block font-medium">{newer.data.title}</span>
            </a>
          )}
        </nav>

        <div class="mx-auto mt-14 max-w-[68ch]">
          <FollowCTA heading="Found this useful?" />
        </div>

        <div class="mx-auto mt-8 max-w-[68ch]">
          <Newsletter compact />
        </div>

        <div class="mx-auto mt-14 max-w-[68ch]">
          <Comments />
        </div>
      </div>

      <!-- Sticky rail: hidden below lg, where the TOC would crowd the text. -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-20 border-t border-default pt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-xl font-semibold tracking-tight">Keep reading</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}

    <!-- Multiplex grid sits below "Keep reading" so the reader always meets our
         own posts first, then the ad recommendations. -->
    <AdUnit slot={ADSENSE_SLOT_MULTIPLEX} format="multiplex" class="!max-w-none" />
  </div>

  <CodeCopyButton />

  <!-- Floating engagement rail (share + reactions + testimonial) shown while
       scrolling, plus the dialog its testimonial button opens. -->
  <EngagementRail slug={post.id} title={data.title} path={path} />
  <FeedbackDialog />

  <!-- Floating chat launcher; fixed-position, so it lives at the page root. -->
  <ArticleChat faq={data.faq} body={post.body ?? ''} title={data.title} intro={data.highlight} />
</BaseLayout>
