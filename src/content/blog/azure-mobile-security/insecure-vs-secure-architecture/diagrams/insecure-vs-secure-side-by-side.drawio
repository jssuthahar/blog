<mxfile host="app.diagrams.net"><diagram name="Before and after" id="Beforeandafter"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="-4" y="-24" width="948" height="515" as="geometry"/></mxCell><mxCell id="hb" value="BEFORE: simple, but wide open" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#A02C2C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="420" height="24" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Your app&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Carries the database password&lt;br&gt;inside it. Anyone can unzip it.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="420" height="80" as="geometry"/></mxCell><mxCell id="b1ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="57" width="46" height="46" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Azure SQL&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;On the internet. Anyone with&lt;br&gt;that password can log straight in.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="420" height="80" as="geometry"/></mxCell><mxCell id="b2ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="167" width="46" height="46" as="geometry"/></mxCell><mxCell id="be0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ha" value="AFTER: one extra hop, far safer" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3D7A35;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="0" width="420" height="24" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Your app&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Carries only a 1-hour pass&lt;br&gt;for one signed-in person.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="420" height="80" as="geometry"/></mxCell><mxCell id="a1ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="57" width="46" height="46" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Front Door + WAF&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Throws away junk and attack&lt;br&gt;traffic before it reaches you.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="420" height="80" as="geometry"/></mxCell><mxCell id="a2ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="167" width="46" height="46" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Your API&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Checks who you are, and only&lt;br&gt;returns your own orders.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="420" height="80" as="geometry"/></mxCell><mxCell id="a3ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="277" width="46" height="46" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Azure SQL&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Private. It has no internet&lt;br&gt;address at all.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=78;" vertex="1" parent="1"><mxGeometry x="500" y="370" width="420" height="80" as="geometry"/></mxCell><mxCell id="a4ic" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="387" width="46" height="46" as="geometry"/></mxCell><mxCell id="ae0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ae2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>