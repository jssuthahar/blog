<mxfile host="app.diagrams.net"><diagram name="Figure 2" id="Figure2"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="126" y="16" width="448" height="694" as="geometry"/></mxCell><mxCell id="term" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontSize=13;fontColor=#1F2933;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="326" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="hdr" value="No tooling. Four minutes in a browser that was already open." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7280;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150" y="104" width="400" height="22" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. Open the web app&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Developer tools, Network tab&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="150" width="320" height="62" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Search for anything&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Find the /api/catalog/search request&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="242" width="320" height="62" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Right-click, Copy as cURL&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Every header comes along, X-Client-App too&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="334" width="320" height="62" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Paste into a terminal&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;200 OK and a JSON body. No session, no cookie&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="426" width="320" height="62" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Loop over the alphabet&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Walk the entire catalogue, page by page&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="190" y="518" width="320" height="62" as="geometry"/></mxCell><mxCell id="out" value="The app was never opened.&lt;br&gt;Nothing the server checked required it." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="170" y="626" width="360" height="60" as="geometry"/></mxCell><mxCell id="a0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=6;" edge="1" parent="1" source="s5" target="out"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>