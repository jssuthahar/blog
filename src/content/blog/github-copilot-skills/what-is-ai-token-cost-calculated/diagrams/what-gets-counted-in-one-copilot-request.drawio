<mxfile host="app.diagrams.net"><diagram name="What is counted" id="Whatiscounted"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="186" y="6" width="498" height="628" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;One Copilot request&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;You typed one line. This is what gets billed.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="290" y="30" width="340" height="62" as="geometry"/></mxCell><mxCell id="br0" value="&lt;b&gt;The system prompt&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Sent every time, you never see it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="280" y="146" width="320" height="70" as="geometry"/></mxCell><mxCell id="hb0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="181" as="sourcePoint"/><mxPoint x="280" y="181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="br1" value="&lt;b&gt;Every attached file&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;In full, not the part you meant&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="280" y="236" width="320" height="70" as="geometry"/></mxCell><mxCell id="hb1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="271" as="sourcePoint"/><mxPoint x="280" y="271" as="targetPoint"/></mxGeometry></mxCell><mxCell id="br2" value="&lt;b&gt;The whole conversation so far&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Resent from turn one, every turn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="280" y="326" width="320" height="70" as="geometry"/></mxCell><mxCell id="hb2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="361" as="sourcePoint"/><mxPoint x="280" y="361" as="targetPoint"/></mxGeometry></mxCell><mxCell id="br3" value="&lt;b&gt;Your actual message&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Usually the smallest piece of the four&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="280" y="416" width="320" height="70" as="geometry"/></mxCell><mxCell id="hb3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="451" as="sourcePoint"/><mxPoint x="280" y="451" as="targetPoint"/></mxGeometry></mxCell><mxCell id="spine" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="92" as="sourcePoint"/><mxPoint x="210" y="451" as="targetPoint"/><Array as="points"><mxPoint x="210" y="92"/></Array></mxGeometry></mxCell><mxCell id="res" value="&lt;b&gt;Input tokens + the reply's output tokens&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Output is billed at several times the input rate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2933;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="270" y="552" width="380" height="58" as="geometry"/></mxCell><mxCell id="jr0" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="181" as="sourcePoint"/><mxPoint x="660" y="181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="jr1" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="271" as="sourcePoint"/><mxPoint x="660" y="271" as="targetPoint"/></mxGeometry></mxCell><mxCell id="jr2" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="361" as="sourcePoint"/><mxPoint x="660" y="361" as="targetPoint"/></mxGeometry></mxCell><mxCell id="jr3" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="451" as="sourcePoint"/><mxPoint x="660" y="451" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rres" value="" style="html=1;rounded=0;strokeColor=#2E5C8A;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=6;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="181" as="sourcePoint"/><mxPoint x="460" y="552" as="targetPoint"/><Array as="points"><mxPoint x="660" y="522"/><mxPoint x="460" y="522"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>