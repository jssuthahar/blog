---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../config';
import { CATEGORIES, getPublishedPosts, postCategories, type CategoryId } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return (Object.keys(CATEGORIES) as CategoryId[]).map((category) => ({
    params: { category },
    // Include posts cross-listed under this category, not just its primary.
    props: { posts: posts.filter((p) => postCategories(p).includes(category)), category },
  }));
}

const { posts, category } = Astro.props;
const { label, description } = CATEGORIES[category as CategoryId];
const path = `/category/${category}/`;

// Same pattern as /topics and a blog post: a CollectionPage plus its
// breadcrumb, so a category listing is a resolvable entity rather than just
// a filtered list of PostCard components with no schema of its own.
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}${path}#page`,
    name: `${label} articles`,
    description: `${description} — ${posts.length} articles.`,
    about: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: label },
    ],
  },
];
---

<BaseLayout
  title={`${label} articles`}
  description={`${description} — ${posts.length} articles.`}
  canonical={path}
  schema={schema}
>
  <header class="max-w-2xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href="/blog/" class="hover:text-accent">Blog</a>
    </nav>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{label}</h1>
    <p class="mt-3 text-muted">{description}</p>
  </header>

  {posts.length > 0 ? (
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="mt-10 text-muted">No posts in this category yet.</p>
  )}

  <!-- Category pages are a common search landing point: the reader arrived
       already interested in one subject, which is the easiest case to ask in. -->
  <div class="mt-16">
    <Newsletter source="category" compact />
  </div>
</BaseLayout>
