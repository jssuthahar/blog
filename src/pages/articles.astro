---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import GlassCarousel from '../components/GlassCarousel.astro';
import type { GlassSlide } from '../lib/carousels';
import { SITE, AUTHOR, ADSENSE_SLOT_DISPLAY } from '../config';
import Newsletter from '../components/Newsletter.astro';
import { allArticles, normaliseCategory, slugifyCategory, capturePayload } from '../lib/articles';
import {
  CATEGORIES,
  formatDate,
  getPublishedPosts,
  postCategories,
  postUrl,
  readingTime,
} from '../lib/posts';

/**
 * One continuous knowledge base. The blog posts and the main-site article
 * library are merged into a single, date-sorted set — no "archive" split, no
 * "blog vs article" framing. Every item is presented the same way: one of
 * Suthahar's technical articles.
 */
type Metric = { kind: 'read' | 'comments'; label: string } | null;

interface Entry {
  title: string;
  url: string;
  excerpt: string;
  image: string | null;
  external: boolean;
  primary: string; // home category label, shown on the card
  categories: string[]; // all normalised labels, for filtering
  catSlugs: string[]; // slugified labels, matched by the filter chips
  published: Date;
  metric: Metric;
}

const posts = await getPublishedPosts();
const articles = allArticles();

const postEntries: Entry[] = posts.map((post) => {
  const labels = [...new Set(postCategories(post).map((id) => CATEGORIES[id].label))];
  return {
    title: post.data.title,
    url: postUrl(post),
    excerpt: post.data.description,
    // Every post has a share card drawn for it, the same art its Blog tile shows.
    image: post.data.cover?.src ?? `/og/w800/${post.id}.webp`,
    external: false,
    primary: CATEGORIES[post.data.category].label,
    categories: labels,
    catSlugs: [...new Set(labels.map((l) => slugifyCategory(normaliseCategory(l))))],
    published: post.data.publishedAt,
    metric: { kind: 'read', label: `${readingTime(post.body ?? '')} min read` },
  };
});

const articleEntries: Entry[] = articles.map((article) => {
  const labels = [...new Set(article.categories.map(normaliseCategory))];
  return {
    title: article.title,
    url: article.url,
    excerpt: article.excerpt,
    image: article.image,
    external: true,
    primary: labels[0] ?? 'Article',
    categories: labels,
    catSlugs: labels.map((l) => slugifyCategory(l)),
    published: new Date(article.published),
    metric: article.comments > 0
      ? { kind: 'comments', label: `${article.comments} comment${article.comments === 1 ? '' : 's'}` }
      : null,
  };
});

const entries: Entry[] = [...postEntries, ...articleEntries].sort(
  (a, b) => b.published.getTime() - a.published.getTime(),
);
const total = entries.length;

// Unified category filter — counted across the whole library, largest first.
const catCounts = new Map<string, { label: string; count: number }>();
for (const entry of entries) {
  for (const label of new Set(entry.categories.map(normaliseCategory))) {
    const slug = slugifyCategory(label);
    if (!slug) continue;
    const cur = catCounts.get(slug) ?? { label, count: 0 };
    cur.count += 1;
    catCounts.set(slug, cur);
  }
}
const filterCategories = [...catCounts.entries()]
  .map(([slug, v]) => ({ slug, label: v.label, count: v.count }))
  .filter((c) => c.count >= 4)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

// From the wider library, so this slide does not repeat the Newest list beside it.
const featured = entries.filter((e) => e.image && e.external).slice(0, 3);

const slides: GlassSlide[] = [
  {
    tab: 'Library',
    kicker: 'MSDEVBUILD · Technical knowledge base',
    title: `${AUTHOR.name.split(' ')[0]}'s`,
    accent: 'technical articles',
    text: `${total}+ hands-on articles on Azure, AI, GitHub Copilot, .NET, Flutter, Python, Firebase, and modern software architecture.`,
    tiles: [
      { value: `${total}+`, label: 'articles' },
      { value: String(filterCategories.length), label: 'technologies' },
      { value: `Since ${Math.min(...entries.map((e) => e.published.getFullYear()))}`, label: 'oldest article here' },
    ],
    actions: [{ label: 'Browse by topic', href: '/topics/' }],
    panel: {
      demo: { kind: 'flow', labels: ['Search', 'Filter', 'Read'], caption: 'Search the whole library, or filter it by technology below.' },
      title: 'Newest',
      steps: entries.slice(0, 3).map((e) => ({ title: e.title, note: formatDate(e.published), href: e.url, external: e.external })),
    },
  },
  {
    tab: 'Featured',
    kicker: 'MSDEVBUILD · Featured',
    title: 'Start with these,',
    accent: 'the newest illustrated guides',
    text: 'The most recent articles that come with diagrams and artwork of their own.',
    panel: {
      demo: { kind: 'flow', labels: ['Problem', 'Approach', 'Result'], caption: 'From AI agents to everyday Azure, written to be used on a real project.' },
      title: 'Featured',
      steps: featured.map((e) => ({ title: e.title, note: e.primary, href: e.url, external: e.external })),
    },
  },
  {
    tab: 'Topics',
    kicker: 'MSDEVBUILD · Topics',
    title: 'Pick a technology,',
    accent: 'read everything on it',
    text: 'The library is grouped by technology, so one subject is a single click away.',
    tiles: filterCategories.slice(0, 3).map((c) => ({ value: String(c.count), label: c.label })),
    actions: [{ label: 'All topics →', href: '/topics/', primary: true }],
    panel: {
      demo: { kind: 'flow', labels: ['Topic', 'Articles', 'Depth'], caption: 'Choose a topic, then go as deep as you need.' },
      title: 'Largest topics',
      steps: filterCategories.slice(0, 3).map((c) => ({ title: c.label, note: `${c.count} articles`, href: '/topics/' })),
    },
  },
  {
    tab: 'Follow',
    kicker: 'MSDEVBUILD · Follow',
    title: 'New articles,',
    accent: 'wherever you read',
    text: 'New articles, sample code, and short videos land on these first.',
    follow: true,
    panel: { demoOnlyOnPhone: true, demo: { kind: 'social', caption: 'One new article reaches every channel.' } },
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/articles#page`,
    name: `Technical articles by ${AUTHOR.name}`,
    description: `${total} technical articles by ${AUTHOR.name} on Azure, AI, GitHub Copilot, .NET, Flutter, Python, Firebase, and modern software architecture.`,
    about: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
];
---

<BaseLayout
  title="Articles"
  description={`${total} technical articles by ${AUTHOR.name} on Azure, AI, GitHub Copilot, .NET, Flutter, Python and software architecture — all searchable.`}
  schema={schema}
  wide
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <!-- ══════════════ Hero: the carousel, then the search that filters the library ══════════════ -->
    <GlassCarousel slides={slides} label="Technical articles" />

    <!-- ══════════════ Search and technology filter, one control ══════════════ -->
    <section class="glass-premium mt-8 rounded-2xl p-4 sm:p-5" aria-label="Find an article">
        <!-- Powerful search: filters the whole library live, over static HTML. -->
        <div class="relative">
          <svg
            class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-muted"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          <label for="articles-search" class="sr-only">Search articles</label>
          <input
            id="articles-search"
            type="search"
            autocomplete="off"
            placeholder="Search articles, tools and topics…"
            class="w-full rounded-full border border-default bg-[var(--bg)] py-3.5 pr-4 pl-12 text-base shadow-sm transition-colors focus:border-[var(--accent)] focus:outline-none"
          />
        </div>

      <div class="mt-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-sm font-semibold tracking-wider uppercase text-muted">
          Browse by technology
        </h2>
        <p id="articles-count" role="status" aria-live="polite" class="text-sm text-muted">
          Showing all {total} articles
        </p>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-chip rounded-full border border-default px-3.5 py-1.5 text-sm font-medium transition-colors hover:bg-subtle"
        >
          All <span class="text-xs text-muted">{total}</span>
        </button>
        {filterCategories.map(({ label, count, slug }) => (
          <button
            type="button"
            data-filter={slug}
            aria-pressed="false"
            class="filter-chip rounded-full border border-default px-3.5 py-1.5 text-sm font-medium transition-colors hover:bg-subtle"
          >
            {label} <span class="text-xs text-muted">{count}</span>
          </button>
        ))}
      </div>
      </div>
    </section>

    <!-- ══════════════ Unified article grid ══════════════
         Every entry is rendered up front so crawlers see the full library and
         the search filters instantly. No archive / current split. -->
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <article
          data-article
          data-title={entry.title.toLowerCase()}
          data-search={`${entry.title} ${entry.excerpt} ${entry.categories.join(' ')}`.toLowerCase()}
          data-categories={entry.catSlugs.join(' ')}
          class="tile"
        >
          <div class="tile-media">
            {entry.image ? (
              <img
                src={entry.image}
                alt={entry.title}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="size-full object-cover"
              />
            ) : (
              <div class="tile-panel" aria-hidden="true">
                <span class="tile-panel-mark">MSDEVBUILD</span>
                <span class="tile-panel-topic">{entry.primary}</span>
              </div>
            )}
          </div>

          <div class="tile-body">
            <div class="tile-meta">
              <span class="tile-topic">{entry.primary}</span>
              <time datetime={entry.published.toISOString()}>{formatDate(entry.published)}</time>
            </div>

            <h3 class="tile-title line-clamp-3">
              <a
                href={entry.url}
                rel={entry.external ? 'noopener' : undefined}
                data-capture={entry.external ? capturePayload({ title: entry.title, url: entry.url, category: entry.primary, image: entry.image }) : undefined}
                class="after:absolute after:inset-0"
              >
                {entry.title}
              </a>
            </h3>

            <p class="tile-text line-clamp-2">{entry.excerpt}</p>

            <div class="tile-foot">
              {entry.metric && <span>{entry.metric.label}</span>}
              <span class="tile-cta" aria-hidden="true">Read <span>{entry.external ? '↗' : '→'}</span></span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p id="articles-empty" hidden class="mt-10 rounded-lg border border-default bg-subtle p-6 text-muted">
      No articles match that search. Try a different term or category.
    </p>

    <!-- The library is the deepest archive on the site and the page most
         reached from search, yet it never asked for an address. Above the ad:
         the ask should not be the thing after the advert. -->
    <div class="mt-14">
      <Newsletter source="articles" />
    </div>

    <!-- One display ad below the library, clear of the filter list. -->
    <div class="mt-12">
      <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
    </div>
  </div>
</BaseLayout>

<style>
  .filter-chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .filter-chip[aria-pressed='true'] span {
    color: rgb(255 255 255 / 0.75);
  }
</style>

<script>
  function initArticleFilters() {
    const search = document.getElementById('articles-search') as HTMLInputElement | null;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-article]')];
    const count = document.getElementById('articles-count');
    const empty = document.getElementById('articles-empty');

    if (!search || items.length === 0) return;

    // Deep link support: /articles/?category=azure arrives pre-filtered, so topic
    // links elsewhere on the site land on the right slice of the library.
    const requested = new URLSearchParams(location.search).get('category');
    const known = chips.some((c) => c.dataset.filter === requested);
    let activeFilter = requested && known ? requested : 'all';
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === activeFilter));
    }

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const matchesText = query === '' || item.dataset.search!.includes(query);
        const matchesFilter =
          activeFilter === 'all' || item.dataset.categories!.split(' ').includes(activeFilter);
        const visible = matchesText && matchesFilter;
        item.hidden = !visible;
        if (visible) shown++;
      }

      if (count) {
        count.textContent =
          shown === 0
            ? 'No matching articles'
            : shown === items.length
              ? `Showing all ${shown} articles`
              : shown === 1
                ? 'Showing 1 article'
                : `Showing ${shown} articles`;
      }
      if (empty) empty.hidden = shown > 0;
    };

    search.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeFilter = chip.dataset.filter!;
        for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
        apply();
      });
    }

    apply();
  }

  initArticleFilters();
  document.addEventListener('astro:page-load', initArticleFilters);
</script>
