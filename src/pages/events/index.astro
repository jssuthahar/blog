---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventListCard from '../../components/EventListCard.astro';
import AdUnit from '../../components/AdUnit.astro';
import GlassCarousel from '../../components/GlassCarousel.astro';
import type { GlassSlide } from '../../lib/carousels';
import { SITE, AUTHOR, ADSENSE_SLOT_DISPLAY } from '../../config';
import { getUpcomingEvents, getPastEvents, eventSchema, eventUrl, formatEventDate } from '../../lib/eventhub';

const upcoming = await getUpcomingEvents();
const past = await getPastEvents();

const eventSteps = (events: typeof past) =>
  events.slice(0, 3).map((e) => ({ title: e.data.title, note: formatEventDate(e), href: eventUrl(e) }));

const slides: GlassSlide[] = [
  {
    tab: 'Events',
    kicker: 'MSDEVBUILD · Events',
    title: 'Sessions, webinars',
    accent: 'and community meetups',
    text: 'Sessions on Microsoft Azure, applied AI, and .NET, most of them free and online. Pick one below and register to save your spot.',
    tiles: [
      { value: String(upcoming.length), label: 'upcoming' },
      { value: String(past.length), label: 'past events' },
      { value: 'Free', label: 'most of them' },
    ],
    panel: {
      demo: { kind: 'flow', labels: ['Pick one', 'Register', 'Join'], caption: 'Three steps from this page to your seat.' },
      title: upcoming.length > 0 ? 'Coming up' : 'Most recent',
      steps: eventSteps(upcoming.length > 0 ? upcoming : past),
    },
  },
  {
    tab: 'Past events',
    kicker: 'MSDEVBUILD · Past events',
    title: 'See what was covered,',
    accent: 'session by session',
    text: 'Every past event stays listed here, with what it covered and the technology behind it.',
    tiles: [{ value: String(past.length), label: 'past events' }],
    panel: {
      demo: { kind: 'flow', labels: ['Topic', 'Live demo', 'Q&A'], caption: 'How a session usually runs.' },
      title: 'Latest',
      steps: eventSteps(past),
    },
  },
  {
    tab: 'Stay informed',
    kicker: 'MSDEVBUILD · Stay informed',
    title: 'New sessions,',
    accent: 'announced here first',
    text: 'Join the list or follow along, and hear about the next session as soon as it is scheduled.',
    follow: true,
    actions: [{ label: 'Join the list →', href: '/#newsletter', primary: true }],
    panel: { demoOnlyOnPhone: true, demo: { kind: 'social', caption: 'One announcement reaches every channel.' } },
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/events#page`,
    name: `Events — ${AUTHOR.name}`,
    description: `Upcoming sessions, webinars, and community events hosted by ${AUTHOR.name}.`,
    about: { '@id': `${SITE.url}/#person` },
  },
  ...eventSchema(upcoming, SITE.url, `${SITE.url}/#person`),
];
---

<BaseLayout
  title="Azure & AI Developer Events"
  description={`Upcoming sessions, webinars, and community events hosted by ${AUTHOR.name} on Azure, applied AI, and .NET. Register to save your spot.`}
  schema={schema}
>
  <GlassCarousel slides={slides} label="Events" />

  {upcoming.length > 0 ? (
    <section class="mt-14" aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="section-title">
        Upcoming
      </h2>
      <div class="mt-6 space-y-3">
        {upcoming.map((event) => <EventListCard event={event} />)}
      </div>
    </section>
  ) : (
    <section class="mt-14">
      <div class="rounded-xl border border-default bg-subtle p-8 text-center">
        <p class="font-medium">No events scheduled right now.</p>
        <p class="mt-1.5 text-sm text-muted">
          New sessions are announced here first — <a href="/#newsletter" class="text-accent hover:underline">join the list</a> to hear about them.
        </p>
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="mt-16" aria-labelledby="past-heading">
      <h2 id="past-heading" class="section-title">
        Past events
      </h2>
      <div class="mt-6 space-y-3">
        {past.map((event) => <EventListCard event={event} past />)}
      </div>
    </section>
  )}

  <!-- One display ad at the foot of the events list. -->
  <AdUnit slot={ADSENSE_SLOT_DISPLAY} format="display" class="!max-w-none" />
</BaseLayout>
